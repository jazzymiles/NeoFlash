<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="NeoFlash.Editor.Preview"
    Publisher="CN=NeoFlash Contributors"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NeoFlash (Technical Preview)</DisplayName>
    <PublisherDisplayName>NeoFlash Contributors</PublisherDisplayName>
    <Description>NeoFlash 0.1.0-beta.1 Windows 11 x64 Technical Preview — Rust authoring environment for classic Flash workflows and HTML5 publishing.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.22000.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="NeoFlashEditor"
      Executable="neoflash-editor.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NeoFlash (Technical Preview)"
        Description="Classic Flash authoring and HTML5 publishing environment"
        BackgroundColor="#1E1E1E"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="neoflash-project">
            <uap:DisplayName>NeoFlash Authoring Project</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/vnd.neoflash.project+json">.nflash</uap:FileType>
              <uap:FileType>.fla</uap:FileType>
              <uap:FileType>.xfl</uap:FileType>
              <uap:FileType>.swf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
