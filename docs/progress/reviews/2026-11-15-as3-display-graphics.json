          "status": "working",
          "note": "Authored 4-frame and dynamic SimpleButton state objects, hitTestState hit-testing, enabled/useHandCursor/trackAsMenu, and soundTransform work in native Rust and HTML5."
        },
        {
          "catalogId": "AS3:constructor:flash/display/SimpleButton.html#SimpleButton()",
          "status": "working",
          "note": "Constructs dynamic SimpleButton instances with optional upState, overState, downState, and hitTestState DisplayObjects."
