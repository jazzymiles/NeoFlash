  "sources": [
    {
      "id": "source-main",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.geom.Point;\n import flash.geom.Rectangle;\n import flash.geom.Matrix;\n import flash.geom.Vector3D;\n import flash.geom.ColorTransform;\n import flash.geom.PerspectiveProjection;\n import flash.geom.Matrix3D;\n import fl.motion.Color;\n import fl.motion.MatrixTransformer;\n public dynamic class Main extends MovieClip {\n  public var checks:Array;\n  public var api:Array;\n  public var failures:Array;\n  public var step:int=0;\n  public var pose:Matrix;\n  public var motionTint:Color;\n  public function Main(){super();stop();run();}\n  public function near(a:Number,b:Number):Boolean{return Math.abs(a-b)<0.0001;}\n  public function xy(p:Point,x:Number,y:Number):Boolean{return near(p.x,x)&&near(p.y,y);}\n  public function check(id:String,ok:Boolean,members:String):void {\n   checks.push({id:id,pass:ok});if(!ok)failures.push(id);\n   var names:Array=members.split(\",\");for each(var name:String in names){if(name.length>0&&api.indexOf(name)<0)api.push(name);}\n  }\n  public function run():void {\n   checks=[];api=[];failures=[];step=0;\n   var p:Point=new Point(3,4);var q:Point=new Point(1,2);var out:Point=new Point();\n   check(\"point coordinates length\",p.x==3&&p.y==4&&p.length==5,\"Point.x,Point.y,Point.length\");\n   var c:Point=p.add(q);check(\"point add subtract\",xy(c,4,6)&&xy(p.subtract(q),2,2),\"Point.add,Point.subtract\");\n   c=p.clone();check(\"clone equals\",c!=p&&c.equals(p),\"Point.clone,Point.equals\");\n   c.copyFrom(q);c.setTo(6,8);c.normalize(5);c.offset(1,2);check(\"point mutations\",xy(c,4,6),\"Point.copyFrom,Point.setTo,Point.normalize,Point.offset\");\n   check(\"point statics\",Point.distance(new Point(),p)==5&&xy(Point.interpolate(p,q,0.5),2,3)&&xy(Point.polar(5,0),5,0),\"Point.distance,Point.interpolate,Point.polar\");\n   check(\"point string\",p.toString()==\"(x=3, y=4)\",\"Point.toString\");\n   check(\"add to output identity\",p.addToOutput(q,out)==out&&xy(out,4,6),\"Point.addToOutput\");\n   check(\"subtract aliased output\",out.subtractToOutput(q,out)==out&&xy(out,3,4),\"Point.subtractToOutput\");\n   check(\"interpolate output\",Point.interpolateToOutput(p,q,0.5,out)==out&&xy(out,2,3),\"Point.interpolateToOutput\");\n   check(\"polar null output\",xy(Point.polarToOutput(5,0,null),5,0),\"Point.polarToOutput\");\n   var r:Rectangle=new Rectangle(10,20,30,40);\n   check(\"rectangle slots\",r.x==10&&r.y==20&&r.width==30&&r.height==40,\"Rectangle.x,Rectangle.y,Rectangle.width,Rectangle.height\");\n   check(\"rectangle edges\",r.left==10&&r.top==20&&r.right==40&&r.bottom==60,\"Rectangle.left,Rectangle.top,Rectangle.right,Rectangle.bottom\");\n   check(\"rectangle point getters\",xy(r.topLeft,10,20)&&xy(r.bottomRight,40,60)&&xy(r.size,30,40),\"Rectangle.topLeft,Rectangle.bottomRight,Rectangle.size\");\n   var rc:Rectangle=r.clone();rc.left=5;rc.top=7;rc.right=50;rc.bottom=70;rc.topLeft=new Point(10,20);rc.bottomRight=new Point(40,60);rc.size=new Point(30,40);\n   check(\"rectangle copy-valued setters\",rc.equals(r),\"Rectangle.clone,Rectangle.equals\");\n   rc.copyFrom(r);rc.setTo(1,2,3,4);check(\"rectangle copy and set\",rc.x==1&&rc.bottom==6,\"Rectangle.copyFrom,Rectangle.setTo\");\n   rc.setEmpty();check(\"rectangle empty\",rc.isEmpty()&&rc.x==0&&rc.height==0,\"Rectangle.setEmpty,Rectangle.isEmpty\");\n   check(\"rectangle containment\",r.contains(10,20)&&!r.contains(40,60)&&r.containsPoint(new Point(15,25))&&r.containsRect(new Rectangle(11,21,2,2)),\"Rectangle.contains,Rectangle.containsPoint,Rectangle.containsRect\");\n   rc=r.intersection(new Rectangle(25,40,30,30));check(\"intersection and intersects\",rc.equals(new Rectangle(25,40,15,20))&&r.intersects(rc),\"Rectangle.intersection,Rectangle.intersects\");\n   rc=r.union(new Rectangle(0,0,1,1));check(\"rectangle union\",rc.equals(new Rectangle(0,0,40,60)),\"Rectangle.union\");\n   rc=r.clone();rc.offset(1,2);rc.offsetPoint(new Point(-1,-2));rc.inflate(1,2);rc.inflatePoint(new Point(-1,-2));check(\"rectangle offset inflate\",rc.equals(r),\"Rectangle.offset,Rectangle.offsetPoint,Rectangle.inflate,Rectangle.inflatePoint\");\n   check(\"rectangle string\",r.toString()==\"(x=10, y=20, w=30, h=40)\",\"Rectangle.toString\");\n   var m:Matrix=new Matrix();check(\"matrix defaults\",m.a==1&&m.b==0&&m.c==0&&m.d==1&&m.tx==0&&m.ty==0,\"Matrix.a,Matrix.b,Matrix.c,Matrix.d,Matrix.tx,Matrix.ty\");\n   m.createBox(2,3,0,10,20);check(\"create box point delta\",xy(m.transformPoint(new Point(4,5)),18,35)&&xy(m.deltaTransformPoint(new Point(4,5)),8,15),\"Matrix.createBox,Matrix.transformPoint,Matrix.deltaTransformPoint\");\n   var mc:Matrix=m.clone();mc.invert();check(\"matrix inverse\",xy(mc.transformPoint(new Point(18,35)),4,5),\"Matrix.clone,Matrix.invert\");\n   mc.identity();mc.scale(2,3);mc.translate(10,20);check(\"matrix identity scale translate\",mc.a==2&&mc.d==3&&mc.tx==10&&mc.ty==20,\"Matrix.identity,Matrix.scale,Matrix.translate\");\n   mc.identity();mc.rotate(Math.PI/2);check(\"matrix rotation\",xy(mc.transformPoint(new Point(1,0)),0,1),\"Matrix.rotate\");\n   mc.copyFrom(m);mc.concat(new Matrix(1,0,0,1,7,8));check(\"matrix composition\",xy(mc.transformPoint(new Point(4,5)),25,43),\"Matrix.copyFrom,Matrix.concat\");\n   mc.setTo(1,2,3,4,5,6);check(\"matrix set and string\",mc.toString()==\"(a=1, b=2, c=3, d=4, tx=5, ty=6)\",\"Matrix.setTo,Matrix.toString\");\n   mc.createGradientBox(1638.4,819.2,0,3,4);check(\"gradient box\",mc.a==1&&mc.d==0.5&&near(mc.tx,822.2)&&near(mc.ty,413.6),\"Matrix.createGradientBox\");\n   var v:Vector3D=new Vector3D(7,8,9,42);mc.identity();mc.copyRowFrom(0,v);mc.copyRowTo(0,v);check(\"matrix row transfer\",mc.a==7&&mc.c==8&&mc.tx==9&&v.x==7&&v.y==8&&v.z==9&&v.w==42,\"Matrix.copyRowFrom,Matrix.copyRowTo\");\n   mc.copyColumnFrom(1,new Vector3D(2,3,4));mc.copyColumnTo(2,v);check(\"column Flash compatibility\",mc.b==2&&mc.d==3&&mc.ty==4&&v.x==9&&v.y==4&&v.z==1&&v.w==42,\"Matrix.copyColumnFrom,Matrix.copyColumnTo\");\n   check(\"transform output identity\",m.transformPointToOutput(new Point(4,5),out)==out&&xy(out,18,35),\"Matrix.transformPointToOutput\");\n   check(\"delta aliased output\",m.deltaTransformPointToOutput(out,out)==out&&xy(out,36,105),\"Matrix.deltaTransformPointToOutput\");\n   var color:ColorTransform=new ColorTransform(0.5,0.6,0.7,0.8,1,2,3,4);\n   check(\"color slots\",color.redMultiplier==0.5&&color.greenMultiplier==0.6&&color.blueMultiplier==0.7&&color.alphaMultiplier==0.8&&color.redOffset==1&&color.greenOffset==2&&color.blueOffset==3&&color.alphaOffset==4,\"ColorTransform.redMultiplier,ColorTransform.greenMultiplier,ColorTransform.blueMultiplier,ColorTransform.alphaMultiplier,ColorTransform.redOffset,ColorTransform.greenOffset,ColorTransform.blueOffset,ColorTransform.alphaOffset\");\n   color.color=0x123456;check(\"color packed setter\",color.color==0x123456&&color.redMultiplier==0&&color.greenMultiplier==0&&color.blueMultiplier==0&&color.alphaMultiplier==0.8,\"ColorTransform.color\");\n   color=new ColorTransform(2,3,4,0.5,10,20,30,40);color.concat(new ColorTransform(3,4,5,0.5,7,8,9,10));check(\"retained concat profile\",color.redMultiplier==6&&color.redOffset==37&&color.alphaOffset==30,\"ColorTransform.concat\");\n   check(\"color string\",color.toString().indexOf(\"redMultiplier=6\")>0,\"ColorTransform.toString\");\n   var bounded:Boolean=false;try{new Matrix(0,0,0,0).invert();}catch(error:Error){bounded=error.message.indexOf(\"Singular\")>=0;}check(\"bounded singular diagnostic\",bounded,\"\");\n   var projection:PerspectiveProjection=new PerspectiveProjection();\n   check(\"projection defaults\",projection.fieldOfView==55&&projection.focalLength>0&&xy(projection.projectionCenter,250,250),\"PerspectiveProjection.fieldOfView,PerspectiveProjection.focalLength,PerspectiveProjection.projectionCenter\");\n   projection.fieldOfView=90;var pm:Matrix3D=projection.toMatrix3D();var raw:Vector.<Number>=pm.rawData;\n   check(\"projection focal and matrix\",near(p