            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.geom.Point;\nimport flash.geom.Rectangle;\nimport flash.geom.Matrix;\nimport flash.geom.ColorTransform;\nstop();\nvar lp:Point=new Point(3,4);\nvar lm:Matrix=new Matrix();lm.createBox(2,3,0,10,20);\nvar mapped:Point=lm.transformPoint(lp);\nvar lr:Rectangle=new Rectangle(0,0,100,100);\nvar lc:ColorTransform=new ColorTransform();lc.color=0x336699;\nvar legacyPassed:Number=0;\nif(lp.length==5)legacyPassed++;\nif(mapped.x==16&&mapped.y==32)legacyPassed++;\nif(lr.containsPoint(mapped)&&lr.right==100)legacyPassed++;\nif(lc.color==0x336699&&lc.redOffset==51)legacyPassed++;\nvar legacyColor:Color=new Color(marker);\nlegacyColor.setRGB(0x33bbcc);\nif(legacyColor.getRGB()==0x33bbcc&&legacyColor.getTransform().rb==51)legacyPassed++;\nlegacyColor.setTransform({ra:50,ga:50,ba:50,rb:20});\nvar legacyTransform:Object=legacyColor.getTransform();\nif(legacyTransform.ra==50&&legacyTransform.ga==50&&legacyTransform.rb==20&&legacyTransform.gb==187&&legacyTransform.aa==100)legacyPassed++;\ncaption.text=\"AS2 shared Rust geometry: \"+legacyPassed+\" / 6 checks\";\ntrace(\"GEOMETRY_HOUR_AS2 \"+legacyPassed+\"/6\");\n"
            }
          }
        ]
