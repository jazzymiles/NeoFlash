                "label": ""
              }
            ]
          }
        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "java_script",
              "source": "stop();\nvar owner = this;\nvar Event = NeoFlashEvents.Event;\nvar MouseEvent = NeoFlashEvents.MouseEvent;\nvar KeyboardEvent = NeoFlashEvents.KeyboardEvent;\nthis.stage.frameRate = 30;\nthis.clicks = 0;\nthis.listening = true;\nthis.pad.addEventListener(\"check\", function(event) { event.preventDefault(); });\ntrace(\"Custom cancellation\", this.pad.dispatchEvent(new Event(\"check\", true, true)));\nthis.stage.addEventListener(MouseEvent.CLICK, function(event) {\n  owner.lastCapturePhase = event.eventPhase;\n}, true);\nthis.onPadClick = function(event) {\n  owner.clicks += 1;\n  trace(\"Pad\", owner.clicks, \"capture\", owner.lastCapturePhase, \"phase\", event.eventPhase,\n    \"mouse\", owner.stage.mouseX, owner.stage.mouseY);\n};\nthis.pad.addEventListener(MouseEvent.CLICK, this.onPadClick);\nthis.toggle.addEventListener(MouseEvent.CLICK, function(event) {\n  owner.listening = !owner.listening;\n  if (owner.listening) owner.pad.addEventListener(MouseEvent.CLICK, owner.onPadClick);\n  else owner.pad.removeEventListener(MouseEvent.CLICK, owner.onPadClick);\n  trace(\"Pad listener\", owner.pad.hasEventListener(MouseEvent.CLICK));\n});\nthis.stage.addEventListener(KeyboardEvent.KEY_DOWN, function(event) {\n  if (event.keyCode === 37 || event.keyCode === 39) {\n    owner.pad.x += event.keyCode === 37 ? -10 : 10;\n    event.preventDefault();\n    trace(\"Keyboard\", event.keyCode, \"pad x\", owner.pad.x);\n  }\n});\nthis.stage.addEventListener(Event.RESIZE, function(event) {\n  trace(\"Resize\", owner.stage.stageWidth, owner.stage.stageHeight);\n});\ntrace(\"Stage ready\", this.stage.stageWidth, this.stage.stageHeight, this.stage.frameRate);\n"
            }
          }
        ]
      }
    },
