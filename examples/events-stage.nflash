                      "rotation": 0,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "text",
                      "text": "Watch the trace below. Restart clears subscriptions and resets the count.",
                      "font_family": "Arial",
                      "font_size": 16,
                      "color": [
                        228,
                        234,
                        248,
                        255
