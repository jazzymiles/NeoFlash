  "document_class": "app.MathExample",
  "sources": [
    {
      "id": "math-main",
      "path": "app/MathExample.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n public dynamic class MathExample extends MovieClip {\n  public var runs:int=0; public var checks:Array; public var failures:Array; public var members:Array;\n  public function MathExample(){super();stop();runReuse();}\n  public function near(a:Number,b:Number):Boolean{return Math.abs(a-b)<0.000001;}\n  public function check(name:String,pass:Boolean,member:String):void{checks.push(name);if(!pass)failures.push(name);if(member!=\"\"&&members.indexOf(member)<0)members.push(member);}\n  public function runReuse():void{\n   runs++;checks=[];failures=[];members=[];\n   check(\"absolute\",Math.abs(-7)==7,\"Math.abs\");check(\"acos\",near(Math.acos(0),Math.PI/2),\"Math.acos\");\n   check(\"asin\",near(Math.asin(1),Math.PI/2),\"Math.asin\");check(\"atan\",near(Math.atan(1),Math.PI/4),\"Math.atan\");\n   check(\"atan2\",near(Math.atan2(1,1),Math.PI/4),\"Math.atan2\");check(\"ceil\",Math.ceil(-1.2)==-1,\"Math.ceil\");\n   check(\"cos\",near(Math.cos(Math.PI),-1),\"Math.cos\");check(\"exp\",near(Math.exp(1),Math.E),\"Math.exp\");\n   check(\"floor\",Math.floor(-1.2)==-2,\"Math.floor\");check(\"log\",near(Math.log(Math.E),1),\"Math.log\");\n   check(\"max variadic\",Math.max(1,2,7)==7,\"Math.max\");check(\"min variadic\",Math.min(7,2,1)==1,\"Math.min\");\n   check(\"pow\",Math.pow(2,8)==256,\"Math.pow\");check(\"round\",Math.round(-1.5)==-1,\"Math.round\");\n   check(\"sin\",near(Math.sin(Math.PI/2),1),\"Math.sin\");check(\"sqrt\",Math.sqrt(81)==9,\"Math.sqrt\");\n   check(\"tan\",near(Math.tan(Math.PI/4),1),\"Math.tan\");var r:Number=Math.random();check(\"random range\",r>=0&&r<1,\"Math.random\");\n   check(\"nonfinite\",isNaN(Math.pow(1,Infinity))&&Math.min()==Infinity&&Math.max()==-Infinity,\"\");\n   check(\"signed zero\",1/Math.min(0,-0)==-Infinity&&1/Math.max(0,-0)==Infinity,\"\");\n   check(\"constants\",near(Math.LN2,Math.log(2))&&near(Math.LN10,Math.log(10))&&near(Math.LOG2E,1/Math.LN2)&&near(Math.LOG10E,1/Math.LN10)&&near(Math.SQRT2,Math.sqrt(2))&&near(Math.SQRT1_2,1/Math.SQRT2),\"\");\n   result.text=(checks.length-failures.length)+\" / \"+checks.length+\" AS3 checks passed · run \"+runs;\n   pipeline.text=\"Rust numeric functions · variadic extrema · nonfinite and signed-zero values\";\n   casing.text=\"AS2 min/max use the first two arguments; AS3 accepts many.\";\n   codec.text=\"Host entropy → Rust 31-bit fraction: \"+r;\n   counts.text=\"18 shared Math methods + AS2 random; 8 constants. Existing APIs moved to Rust.\";\n   trace(\"MATH_RESULT \"+JSON.stringify({checks:checks.length,passed:checks.length-failures.length,failed:failures.length,members:members,run:runs,failures:failures}));\n  }\n }\n}"
    }
  ]
}
