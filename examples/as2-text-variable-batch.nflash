        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "stop();\nvar boundValue:String = \"initial value\";\nvar alternateValue:String = \"alternate\";\nvar variableChecks:Number = 0;\nvar variableFailures:Number = 0;\nvar variableInputEvents:Number = 0;\nvar variableSerial:Number = 0;\nfunction checkVariable(label:String,ok:Boolean):Void {\n if(ok) {variableChecks++;} else {variableFailures++;}\n variableDetails.text += (ok ? \"PASS  \" : \"FAIL  \") + label + \"\\n\";\n variableStatus.text = \"AS2_TEXT_VARIABLE_RESULT \" + variableChecks + \" passed / \" + variableFailures + \" failed; input events \" + variableInputEvents;\n trace(\"AS2_TEXT_VARIABLE \" + label + \" \" + ok);\n}\ncreateTextField(\"variableInput\",getNextHighestDepth(),40,195,480,52);\nvariableInput.type=\"input\";variableInput.background=true;variableInput.backgroundColor=0xffffff;variableInput.border=true;variableInput.textColor=0x243747;\ncreateTextField(\"variableMirror\",getNextHighestDepth(),570,195,480,52);\nvariableMirror.background=true;variableMirror.backgroundColor=0xd5f6ec;variableMirror.border=true;variableMirror.textColor=0x243747;\ncheckVariable(\"unset variable is null\",variableInput.variable==null);\nvariableInput.variable=\"boundValue\";\nvariableMirror.variable=\"_root.boundValue\";\ncheckVariable(\"relative + root binding initialize fields\",variableInput.text==\"initial value\"&&variableMirror.text==\"initial value\");\nboundValue=\"script changed\";\ncheckVariable(\"variable refreshes on AS2 text read\",variableInput.text==\"script changed\"&&variableMirror.text==\"script changed\");\nvariableInput.text=\"field changed\";\ncheckVariable(\"programmatic text writes variable and mirror\",boundValue==\"field changed\"&&variableMirror.text==\"field changed\");\nvariableInput.variable=\"alternateValue\";\ncheckVariable(\"rebind selects new variable\",variableInput.text==\"alternate\"&&boundValue==\"field changed\");\nvariableInput.text=\"rebound edit\";\ncheckVariable(\"rebound edit updates only new variable\",alternateValue==\"rebound edit\"&&boundValue==\"field changed\");\nvariableInput.variable=null;\nvariableInput.text=\"detached\";\ncheckVariable(\"null detaches\",variableInput.variable==null&&alternateValue==\"rebound edit\");\ncreateTextField(\"variableSeed\",getNextHighestDepth(),40,280,1010,35);\nvariableSeed.text=\"seeded from current field\";\nvariableSeed.variable=\"createdFromText\";\ncheckVariable(\"missing MovieClip variable seeds from text\",_root.createdFromText==\"seeded from current field\");\nvariableSeed.variable=\"\";\ncheckVariable(\"empty path detaches\",variableSeed.variable==null);\nvariableInput.variable=\"_root.boundValue\";\nvariableInput.onChanged=function():Void {\n variableInputEvents++;\n var synced:Boolean=boundValue==variableInput.text&&variableMirror.text==variableInput.text;\n variableStatus.text=\"INPUT_SYNC \"+synced+\" | events \"+variableInputEvents+\" | variable: \"+boundValue;\n trace(\"AS2_TEXT_VARIABLE_INPUT \"+synced+\" \"+variableInputEvents);\n};\nfunction updateBoundVariable():Void {\n variableSerial++;\n boundValue=\"button update \"+variableSerial;\n variableStatus.text=\"BUTTON_SYNC \"+(variableInput.text==boundValue&&variableMirror.text==boundValue)+\" | variable: \"+boundValue;\n trace(\"AS2_TEXT_VARIABLE_BUTTON \"+(variableInput.text==boundValue&&variableMirror.text==boundValue));\n}\n"
            }
          }
        ]
      }
