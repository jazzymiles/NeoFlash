  "sources": [
    {
      "id": "src-15",
      "path": "city/types.ts",
      "language": "type_script",
      "source": "export type ZoneKind =\n    | \"empty\"\n    | \"water\"\n    | \"road\"\n    | \"powerline\"\n    | \"plant\"\n    | \"park\"\n    | \"residential\"\n    | \"commercial\"\n    | \"industrial\";\n\nexport type ToolId =\n    | \"residential\"\n    | \"commercial\"\n    | \"industrial\"\n    | \"road\"\n    | \"powerline\"\n    | \"plant\"\n    | \"park\"\n    | \"bulldoze\";\n\nexport type HeatmapMode = \"none\" | \"power\" | \"value\" | \"pollution\";\n\nexport type SimSpeed = 0 | 1 | 3;\n\nexport interface TileCell {\n    kind: ZoneKind;\n    level: number;\n    powered: boolean;\n    roadMask: number;\n    wireMask: number;\n    pollution: number;\n    landValue: number;\n    traffic: number;\n    growthProgress: number;\n    bridge: boolean;\n    variant: number;\n}\n\nexport interface DemandTriple {\n    residential: number;\n    commercial: number;\n    industrial: number;\n}\n\nexport interface BudgetSummary {\n    readonly taxRate: number;\n    readonly taxRevenue: number;\n    readonly roadMaintenance: number;\n    readonly powerMaintenance: number;\n    readonly parkMaintenance: number;\n    readonly netCashflow: number;\n}\n\nexport interface CityStats {\n    funds: number;\n    population: number;\n    year: number;\n    month: number;\n    tickCount: number;\n    taxRate: number;\n    poweredTiles: number;\n    zonedTiles: number;\n    developedBuildings: number;\n    powerCapacityMw: number;\n    powerUsedMw: number;\n    roadCount: number;\n    plantCount: number;\n    avgLandValue: number;\n    avgPollution: number;\n    demand: DemandTriple;\n    lastBudget: BudgetSummary;\n    advisorMessage: string;\n}\n\nexport interface ToolSpec {\n    readonly id: ToolId;\n    readonly label: string;\n    readonly shortKey: string;\n    readonly cost: number;\n    readonly accentColor: number;\n    readonly description: string;\n}\n\nexport interface ToolActionResult {\n    readonly ok: boolean;\n    readonly sfx: string;\n    readonly message: string;\n    readonly costPaid: number;\n}\n\nexport interface VehicleAgent {\n    gx: number;\n    gy: number;\n    dirX: number;\n    dirY: number;\n    progress: number;\n    speed: number;\n    color: number;\n}\n\nexport interface IsoPoint {\n    readonly sx: number;\n    readonly sy: number;\n}\n\nexport interface GridCoord {\n    readonly gx: number;\n    readonly gy: number;\n}\n\nexport interface GridReadable<T> {\n    width: number;\n    height: number;\n    inBounds(x: number, y: number): boolean;\n    get(x: number, y: number): T;\n}\n\nexport class Grid2D<T> implements GridReadable<T> {\n    width: number;\n    height: number;\n    cells: T[];\n\n    constructor(width: number, height: number, factory: (x: number, y: number) => T) {\n        this.width = width;\n        this.height = height;\n        const backing: T[] = [];\n        for (let y: number = 0; y < height; y++) {\n            for (let x: number = 0; x < width; x++) {\n                backing.push(factory(x, y));\n            }\n        }\n        this.cells = backing;\n    }\n\n    inBounds(x: number, y: number): boolean {\n        return x >= 0 && y >= 0 && x < this.width && y < this.height;\n    }\n\n    index(x: number, y: number): number {\n        return y * this.width + x;\n    }\n\n    get(x: number, y: number): T {\n        return this.cells[y * this.width + x];\n    }\n\n    set(x: number, y: number, value: T): void {\n        if (this.inBounds(x, y)) {\n            this.cells[y * this.width + x] = value;\n        }\n    }\n\n    forEach(visitor: (cell: T, x: number, y: number) => void): void {\n        for (let y: number = 0; y < this.height; y++) {\n            for (let x: number = 0; x < this.width; x++) {\n                visitor(this.cells[y * this.width + x], x, y);\n            }\n        }\n    }\n\n    countWhere(predicate: (cell: T, x: number, y: number) => boolean): number {\n        let count: number = 0;\n        for (let y: number = 0; y < this.height; y++) {\n            for (let x: number = 0; x < this.width; x++) {\n                if (predicate(this.cells[y * this.width + x], x, y)) {\n                    count += 1;\n                }\n            }\n        }\n        return count;\n    }\n}\n\nexport const GRID_SIZE: number = 16;\n\nexport const TOOL_CATALOG: ToolSpec[] = [\n    {\n        id: \"residential\",\n        label: \"RESIDENTIAL\",\n        shortKey: \"1\",\n        cost: 100,\n        accentColor: 0x22c55e,\n        description: \"Zone housing lots [1] ($100) - needs power & road access\",\n    },\n    {\n        id: \"commercial\",\n        label: \"COMMERCIAL\",\n        shortKey: \"2\",\n        cost: 150,\n        accentColor: 0x3b82f6,\n        description: \"Zone shops & offices [2] ($150) - thrives on high land value\",\n    },\n    {\n        id: \"industrial\",\n        label: \"INDUSTRIAL\",\n        shortKey: \"3\",\n        cost: 150,\n        accentColor: 0xf59e0b,\n        description: \"Zone factories & workshops [3] ($150) - drives city jobs\",\n    },\n    {\n        id: \"road\",\n        label: \"ROADWAY\",\n        shortKey: \"4\",\n        cost: 20,\n        accentColor: 0x94a3b8,\n        description: \"Pave roads & river bridges [4] ($20) - connects R/C/I zones\",\n    },\n    {\n        id: \"powerline\",\n        label: \"POWER LINE\",\n        shortKey: \"5\",\n        cost: 10,\n        accentColor: 0xfacc15,\n        description: \"String high-voltage pylons [5] ($10) - carries electricity\",\n    },\n    {\n        id: \"plant\",\n        label: \"COAL PLANT\",\n        shortKey: \"6\",\n        cost: 800,\n        accentColor: 0xef4444,\n        description: \"Build 60 MW Coal Power Plant [6] ($800) - powers grid via BFS\",\n    },\n    {\n        id: \"park\",\n        label: \"CITY PARK\",\n        shortKey: \"7\",\n        cost: 50,\n        accentColor: 0x10b981,\n        description: \"Plant civic park & fountain [7] ($50) - boosts land value, cuts smog\",\n    },\n    {\n        id: \"bulldoze\",\n        label: \"BULLDOZER\",\n        shortKey: \"8\",\n        cost: 5,\n        accentColor: 0xf97316,\n        description: \"Clear structures, roads, or zones [8] ($5)\",\n    },\n];\n\nexport function findToolSpec(id: ToolId): ToolSpec {\n    for (let i: number = 0; i < TOOL_CATALOG.length; i++) {\n        if (TOOL_CATALOG[i].id === id) {\n            return TOOL_CATALOG[i];\n        }\n    }\n    return TOOL_CATALOG[0];\n}\n\nexport function formatMoney(amount: number): string {\n    const neg: boolean = amount < 0;\n    const absVal: number = Math.floor(Math.abs(amount));\n    const raw: string = String(absVal);\n    let out: string = \"\";\n    for (let i: number = 0; i < raw.length; i++) {\n        const fromRight: number = raw.length - i;\n        out += raw.slice(i, i + 1);\n        if (fromRight > 1 && fromRight % 3 === 1) {\n            out += \",\";\n        }\n    }\n    return neg ? \"-$\" + out : \"$\" + out;\n}\n\nexport function monthAbbrev(month: number): string {\n    const names: string[] = [\n        \"JAN\", \"FEB\", \"MAR\", \"APR\", \"MAY\", \"JUN\",\n        \"JUL\", \"AUG\", \"SEP\", \"OCT\", \"NOV\", \"DEC\",\n    ];\n    const idx: number = ((month - 1) % 12 + 12) % 12;\n    return names[idx];\n}\n"
    },
    {
      "id": "src-16",
      "path": "city/sim.ts",
      "language": "type_script",
      "source": "import {\n    GRID_SIZE,\n    Grid2D,\n    findToolSpec,\n    type BudgetSummary,\n    type CityStats,\n    type DemandTriple,\n    type TileCell,\n    type ToolActionResult,\n    type ToolId,\n    type ToolSpec,\n    type VehicleAgent,\n    type ZoneKind,\n} from \"./types\";\n\nfunction makeFreshCell(gx: number, gy: number): TileCell {\n    const riverCenter: number = 11 + Math.round(Math.sin(gy * 0.42) * 1.3);\n    const isRiver: boolean = gx === riverCenter || gx === riverCenter + 1;\n    const isBay: boolean = gy >= 14 && gx >= 10;\n    const kind: ZoneKind = isRiver || isBay ? \"water\" : \"empty\";\n    return {\n        kind,\n        level: 0,\n        powered: false,\n        roadMask: 0,\n        wireMask: 0,\n        pollution: 0,\n        landValue: 35,\n        traffic: 0,\n        growthProgress: 0,\n        bridge: false,\n        variant: (gx * 7 + gy * 13) % 4,\n    };\n}\n\nexport function isZoneKind(kind: ZoneKind): boolean {\n    return kind === \"residential\" || kind === \"commercial\" || kind === \"industrial\";\n}\n\nexport function conductsPower(kind: ZoneKind): boolean {\n    return (\n        kind === \"plant\" ||\n        kind === \"powerline\" ||\n        kind === \"residential\" ||\n        kind === \"commercial\" ||\n        kind === \"industrial\" ||\n        kind === \"park\"\n    );\n}\n\nexport class CitySimulation {\n    grid: Grid2D<TileCell>;\n    stats: CityStats;\n    vehicles: VehicleAgent[];\n    rngState: number;\n\n    constructor() {\n        this.rngState = 20000101;\n        this.grid = new Grid2D<TileCell>(GRID_SIZE, GRID_SIZE, makeFreshCell);\n        this.vehicles = [];\n        const initBudget: BudgetSummary = {\n            taxRate: 7,\n            taxRevenue: 0,\n            roadMaintenance: 0,\n            powerMaintenance: 0,\n            parkMaintenance: 0,\n            netCashflow: 0,\n        };\n        const initDemand: DemandTriple = {\n            residential: 65,\n            commercial: 35,\n            industrial: 50,\n        };\n        this.stats = {\n            funds: 25000,\n            population: 0,\n            year: 2000,\n            month: 1,\n            tickCount: 0,\n            taxRate: 7,\n            poweredTiles: 0,\n            zonedTiles: 0,\n            developedBuildings: 0,\n            powerCapacityMw: 0,\n            powerUsedMw: 0,\n            roadCount: 0,\n            plantCount: 0,\n            avgLandValue: 40,\n            avgPollution: 0,\n            demand: initDemand,\n            lastBudget: initBudget,\n            advisorMessage: \"Welcome Mayor! Place a Coal Plant [6], Power Lines [5], Roads [4], & Zones [1-3] - or press [S] for Starter Metro.\",\n        };\n        this.recomputeAll();\n    }\n\n    nextRand(): number {\n        this.rngState = (this.rngState * 1664525 + 1013904223) & 0x7fffffff;\n        return this.rngState / 0x7fffffff;\n    }\n\n    resetTerrain(): void {\n        this.grid = new Grid2D<TileCell>(GRID_SIZE, GRID_SIZE, makeFreshCell);\n        this.vehicles = [];\n        this.stats.funds = 25000;\n        this.stats.population = 0;\n        this.stats.year = 2000;\n        this.stats.month = 1;\n        this.stats.tickCount = 0;\n        this.stats.taxRate = 7;\n        this.stats.advisorMessage = \"New terrain surveyed. Build power & roads or press [S] for Starter Metro.\";\n        this.recomputeAll();\n    }\n\n    setTaxRate(nextRate: number): number {\n        const clamped: number = Math.max(0, Math.min(20, Math.round(nextRate)));\n        this.stats.taxRate = clamped;\n        this.recomputeDemand();\n        this.stats.lastBudget = this.computeBudgetPreview();\n        this.stats.advisorMessage = \"Municipal tax rate set to \" + String(clamped) + \"%.\";\n        return clamped;\n    }\n\n    applyTool(gx: number, gy: number, tool: ToolId): ToolActionResult {\n        if (!this.grid.inBounds(gx, gy)) {\n            return { ok: false, sfx: \"\", message: \"Outside city limits.\", costPaid: 0 };\n        }\n        const cell: TileCell = this.grid.get(gx, gy);\n        const spec: ToolSpec = findToolSpec(tool);\n\n        if (tool === \"bulldoze\") {\n            if (cell.kind === \"empty\" || (cell.kind === \"water\" && !cell.bridge)) {\n                return { ok: false, sfx: \"\", message: \"Nothing to bulldoze on this parcel.\", costPaid: 0 };\n            }\n            if (this.stats.funds < spec.cost) {\n                return { ok: false, sfx: \"\", message: \"Insufficient municipal funds!\", costPaid: 0 };\n            }\n            this.stats.funds -= spec.cost;\n            if (cell.bridge) {\n                cell.kind = \"water\";\n                cell.bridge = false;\n            } else {\n                cell.kind = \"empty\";\n            }\n            cell.level = 0;\n            cell.growthProgress = 0;\n            cell.traffic = 0;\n            this.recomputeAll();\n            this.stats.advisorMessage = \"Cleared parcel (\" + String(gx) + \", \" + String(gy) + \").\";\n            return { ok: true, sfx: \"bulldoze\", message: this.stats.advisorMessage, costPaid: spec.cost };\n        }\n\n        const bridgeCostMultiplier: number = cell.kind === \"water\" ? 2 : 1;\n        const effectiveCost: number = spec.cost * bridgeCostMultiplier;\n\n        if (cell.kind === \"water\") {\n            if (tool !== \"road\" && tool !== \"powerline\") {\n                return {\n                    ok: false,\n                    sfx: \"\",\n                    message: \"Waterfront parcels only accept Road Bridges [4] or Power Spans [5].\",\n                    costPaid: 0,\n                };\n            }\n            if (cell.bridge) {\n                return { ok: false, sfx: \"\", message: \"Bridge span already built here.\", costPaid: 0 };\n            }\n        } else if (cell.kind === tool) {\n            return { ok: false, sfx: \"\", message: spec.label + \" already occupies this parcel.\", costPaid: 0 };\n        } else if (cell.kind !== \"empty\") {\n            if (!(cell.kind === \"powerline\" && tool === \"road\")) {\n                return {\n                    ok: false,\n                    sfx: \"\",\n                    message: \"Parcel occupied - clear with Bulldozer [8] first.\",\n                    costPaid: 0,\n                };\n            }\n        }\n\n        if (this.stats.funds < effectiveCost) {\n            return {\n                ok: false,\n                sfx: \"\",\n                message: \"Treasury too low for \" + spec.label + \" ($\" + String(effectiveCost) + \").\",\n                costPaid: 0,\n            };\n        }\n\n        const wasWater: boolean = cell.kind === \"water\";\n        this.stats.funds -= effectiveCost;\n        cell.kind = tool as ZoneKind;\n        cell.bridge = wasWater;\n        cell.level = 0;\n        cell.growthProgress = 0;\n        cell.variant = (gx * 11 + gy * 5 + this.stats.tickCount) % 4;\n\n        this.recomputeAll();\n\n        let sfxName: string = \"zone\";\n        if (tool === \"road\" || tool === \"powerline\") {\n            sfxName = \"road\";\n        } else if (tool === \"plant\") {\n            sfxName = \"power\";\n        }\n\n        const bridgeTag: string = wasWater ? \" bridge\" : \"\";\n        this.stats.advisorMessage =\n            \"Placed \" + spec.label + bridgeTag + \" at (\" + String(gx) + \", \" + String(gy) + \").\";\n        return {\n            ok: true,\n            sfx: sfxName,\n            message: this.stats.advisorMessage,\n            costPaid: effectiveCost,\n        };\n    }\n\n    loadStarterCity(): void {\n        this.grid = new Grid2D<TileCell>(GRID_SIZE, GRID_SIZE, makeFreshCell);\n        this.vehicles = [];\n        this.stats.funds = 19800;\n        this.stats.year = 2000;\n        this.stats.month = 3;\n        this.stats.tickCount = 0;\n        this.stats.taxRate = 7;\n\n        // Place twin Coal Plants in the industrial northwest/southwest corner\n        this.forcePlace(1, 1, \"plant\", 0);\n        this.forcePlace(1, 12, \"plant\", 0);\n\n        // Arterial road grid (avenues at x=3, x=6, x=9 and cross-streets at y=3, y=7, y=11 + river bridge at y=7!)\n        for (let y: number = 1; y <= 14; y++) {\n            this.forcePlace(3, y, \"road\", 0);\n            this.forcePlace(6, y, \"road\", 0);\n            this.forcePlace(9, y, \"road\", 0);\n        }\n        for (let x: number = 1; x <= 14; x++) {\n            this.forcePlace(x, 3, \"road\", 0);\n            this.forcePlace(x, 7, \"road\", 0);\n            if (x <= 10) {\n                this.forcePlace(x, 11, \"road\", 0);\n            }\n        }\n        // East-bank boulevard across the river\n        for (let y: number = 4; y <= 11; y++) {\n            if (this.grid.get(14, y).kind === \"empty\") {\n                this.forcePlace(14, y, \"road\", 0);\n            }\n        }\n\n        // Power lines linking plants into road-separated blocks & east bank\n        this.forcePlace(2, 1, \"powerline\", 0);\n        this.forcePlace(2, 2, \"powerline\", 0);\n        this.forcePlace(3, 2, \"powerline\", 0);\n        this.forcePlace(2, 12, \"powerline\", 0);\n        this.forcePlace(6, 3, \"road\", 0);\n        this.forcePlace(13, 6, \"powerline\", 0);\n        this.forcePlace(12, 6, \"powerline\", 0);\n        this.forcePlace(11, 6, \"powerline\", 0);\n        this.forcePlace(10, 6, \"powerline\", 0);\n\n        // Industrial west corridor\n        const indCoords: [number, number, number][] = [\n            [2, 4, 2], [2, 5, 2], [2, 6, 1],\n            [2, 8, 2], [2, 9, 3], [2, 10, 1],\n            [1, 4, 1], [1, 5, 2], [1, 9, 2],\n        ];\n        for (let i: number = 0; i < indCoords.length; i++) {\n            const ic: [number, number, number] = indCoords[i];\n            this.forcePlace(ic[0], ic[1], \"industrial\", ic[2]);\n        }\n\n        // Commercial midtown core\n        const comCoords: [number, number, number][] = [\n            [4, 4, 2], [5, 4, 3], [4, 5, 2], [5, 5, 3],\n            [4, 6, 2], [5, 6, 2], [7, 4, 2], [8, 4, 3],\n            [7, 6, 2], [8, 6, 3], [7, 8, 2], [8, 8, 2],\n        ];\n        for (let i: number = 0; i < comCoords.length; i++) {\n            const cc: [number, number, number] = comCoords[i];\n            this.forcePlace(cc[0], cc[1], \"commercial\", cc[2]);\n        }\n\n        // Waterfront parks & central plaza\n        const parkCoords: [number, number][] = [\n            [7, 5], [8, 5], [10, 4], [10, 5], [10, 8], [10, 9], [5, 8],\n        ];\n        for (let i: number = 0; i < parkCoords.length; i++) {\n            const pc: [number, number] = parkCoords[i];\n            this.forcePlace(pc[0], pc[1], \"park\", 0);\n        }\n\n        // Residential neighborhoods (midtown south, north hills, & riverfront east bank)\n        const resCoords: [number, number, number][] = [\n            [4, 2, 2], [5, 2, 2], [7, 2, 3], [8, 2, 2],\n            [4, 8, 3], [4, 9, 2], [5, 9, 3], [4, 10, 2], [5, 10, 2],\n            [7, 9, 3], [8, 9, 3], [7, 10, 2], [8, 10, 2],\n            [4, 12, 1], [5, 12, 2], [7, 12, 2], [8, 12, 1],\n            [13, 5, 2], [13, 8, 2], [13, 9, 1],\n        ];\n        for (let i: number = 0; i < resCoords.length; i++) {\n            const rc: [number, number, number] = resCoords[i];\n            this.forcePlace(rc[0], rc[1], \"residential\", rc[2]);\n        }\n\n        // Ensure cross-street power bridges between blocks (power jumps across 1 road tile!)\n        this.recomputeAll();\n        this.spawnVehiclesIfNeeded();\n        this.stats.advisorMessage =\n            \"Starter Metropolis loaded! Bustling R/C/I districts online - build more or inspect [H] Heatmaps & [B] Budget.\";\n    }\n\n    forcePlace(gx: number, gy: number, kind: ZoneKind, level: number): void {\n        if (!this.grid.inBounds(gx, gy)) {\n            return;\n        }\n        const c: TileCell = this.grid.get(gx, gy);\n        const wasWater: boolean = c.kind === \"water\";\n        if (wasWater && kind !== \"road\" && kind !== \"powerline\") {\n            return;\n        }\n        c.kind = kind;\n        c.bridge = wasWater;\n        c.level = level;\n        c.variant = (gx * 3 + gy * 7) % 4;\n    }\n\n    recomputeAll(): void {\n        this.recomputeMasks();\n        this.recomputePowerGrid();\n        this.recomputeEnvironment();\n        this.recomputePopulationAndStats();\n        this.recomputeDemand();\n        this.stats.lastBudget = this.computeBudgetPreview();\n    }\n\n    recomputeMasks(): void {\n        const dirs: [number, number, number][] = [\n            [0, -1, 1],\n            [1, 0, 2],\n            [0, 1, 4],\n            [-1, 0, 8],\n        ];\n        this.grid.forEach((cell: TileCell, gx: number, gy: number): void => {\n            let rMask: number = 0;\n            let wMask: number = 0;\n            for (let i: number = 0; i < dirs.length; i++) {\n                const d: [number, number, number] = dirs[i];\n                const nx: number = gx + d[0];\n                const ny: number = gy + d[1];\n                if (this.grid.inBounds(nx, ny)) {\n                    const nb: TileCell = this.grid.get(nx, ny);\n                    if (nb.kind === \"road\") {\n                        rMask = rMask | d[2];\n                    }\n                    if (conductsPower(nb.kind)) {\n                        wMask = wMask | d[2];\n                    }\n                }\n            }\n            cell.roadMask = rMask;\n            cell.wireMask = wMask;\n        });\n    }\n\n    recomputePowerGrid(): void {\n        let plantCount: number = 0;\n        const queueX: number[] = [];\n        const queueY: number[] = [];\n\n        this.grid.forEach((cell: TileCell, gx: number, gy: number): void => {\n            cell.powered = false;\n            if (cell.kind === \"plant\") {\n                plantCount += 1;\n                cell.powered = true;\n                queueX.push(gx);\n                queueY.push(gy);\n            }\n        });\n\n        const capacityTiles: number = plantCount * 85;\n        let energizedCount: number = plantCount;\n        const dirs: [number, number][] = [\n            [0, -1],\n            [1, 0],\n            [0, 1],\n            [-1, 0],\n        ];\n\n        let head: number = 0;\n        while (head < queueX.length && energizedCount < capacityTiles) {\n            const cx: number = queueX[head];\n            const cy: number = queueY[head];\n            head += 1;\n\n            for (let i: number = 0; i < dirs.length; i++) {\n                const d: [number, number] = dirs[i];\n                const nx: number = cx + d[0];\n                const ny: number = cy + d[1];\n                if (!this.grid.inBounds(nx, ny)) {\n                    continue;\n                }\n                const nb: TileCell = this.grid.get(nx, ny);\n                if (conductsPower(nb.kind) && !nb.powered && energizedCount < capacityTiles) {\n                    nb.powered = true;\n                    energizedCount += 1;\n                    queueX.push(nx);\n                    queueY.push(ny);\n                } else if (nb.kind === \"road\") {\n                    // Underground distribution conduit jumps directly across a single roadway!\n                    const rx: number = nx + d[0];\n                    const ry: number = ny + d[1];\n                    if (this.grid.inBounds(rx, ry)) {\n                        const across: TileCell = this.grid.get(rx, ry);\n                        if (conductsPower(across.kind) && !across.powered && energizedCount < capacityTiles) {\n                            across.powered = true;\n                            energizedCount += 1;\n                            queueX.push(rx);\n                            queueY.push(ry);\n                        }\n                    }\n                }\n            }\n        }\n\n        this.stats.plantCount = plantCount;\n        this.stats.powerCapacityMw = plantCount * 60;\n        this.stats.powerUsedMw = Math.min(\n            this.stats.powerCapacityMw + 20,\n            Math.round((energizedCount - plantCount) * 0.72),\n        );\n        this.stats.poweredTiles = energizedCount;\n    }\n\n    recomputeEnvironment(): void {\n        // 1. Pollution sources: Coal plants, developed industrial zones, heavy road traffic\n        const sources: [number, number, number][] = [];\n        const waterAndParks: [number, number, number][] = [];\n\n        this.grid.forEach((cell: TileCell, gx: number, gy: number): void => {\n            if (cell.kind === \"plant\") {\n                sources.push([gx, gy, 88]);\n            } else if (cell.kind === \"industrial\" && cell.level > 0) {\n                sources.push([gx, gy, 24 + cell.level * 18]);\n            } else if (cell.kind === \"road\" && cell.traffic > 35) {\n                sources.push([gx, gy, 18]);\n            }\n            if (cell.kind === \"water\") {\n                waterAndParks.push([gx, gy, 28]);\n            } else if (cell.kind === \"park\") {\n                waterAndParks.push([gx, gy, 38]);\n            }\n        });\n\n        let totalLandValue: number = 0;\n        let totalPollution: number = 0;\n        let landCount: number = 0;\n\n        this.grid.forEach((cell: TileCell, gx: number, gy: number): void => {\n            let poll: number = 0;\n            for (let i: number = 0; i < sources.length; i++) {\n                const src: [number, number, number] = sources[i];\n                const dist: number = Math.abs(gx - src[0]) + Math.abs(gy - src[1]);\n                if (dist <= 5) {\n                    poll += Math.max(0, src[2] - dist * 16);\n                }\n            }\n            if (cell.kind === \"park\") {\n                poll = Math.max(0, poll - 25);\n            }\n            cell.pollution = Math.min(100, Math.round(poll));\n\n            let val: number = 34;\n            const centerDist: number = Math.abs(gx - 6.5) + Math.abs(gy - 7.0);\n            val += Math.max(0, 22 - centerDist * 2.2);\n\n            for (let j: number = 0; j < waterAndParks.length; j++) {\n                const wp: [number, number, number] = waterAndParks[j];\n                const dist: number = Math.abs(gx - wp[0]) + Math.abs(gy - wp[1]);\n                if (dist <= 3) {\n                    val += Math.max(0, wp[2] - dist * 8);\n                }\n            }\n            val -= cell.pollution * 0.58;\n            cell.landValue = Math.max(5, Math.min(100, Math.round(val)));\n\n            if (cell.kind !== \"water\") {\n                totalLandValue += cell.landValue;\n                totalPollution += cell.pollution;\n                landCount += 1;\n            }\n        });\n\n        this.stats.avgLandValue = landCount > 0 ? Math.round(totalLandValue / landCount) : 40;\n        this.stats.avgPollution = landCount > 0 ? Math.round(totalPollution / landCount) : 0;\n    }\n\n    hasNearbyRoad(gx: number, gy: number): boolean {\n        for (let dy: number = -2; dy <= 2; dy++) {\n            for (let dx: number = -2; dx <= 2; dx++) {\n                if (Math.abs(dx) + Math.abs(dy) <= 2 && this.grid.inBounds(gx + dx, gy + dy)) {\n                    if (this.grid.get(gx + dx, gy + dy).kind === \"road\") {\n                        return true;\n                    }\n                }\n            }\n        }\n        return false;\n    }\n\n    recomputePopulationAndStats(): void {\n        let pop: number = 0;\n        let zoned: number = 0;\n        let developed: number = 0;\n        let roads: number = 0;\n\n        this.grid.forEach((cell: TileCell): void => {\n            if (cell.kind === \"road\") {\n                roads += 1;\n            }\n            if (isZoneKind(cell.kind)) {\n                zoned += 1;\n                if (cell.level > 0) {\n                    developed += 1;\n                    if (cell.kind === \"residential\") {\n                        pop += cell.level * cell.level * 48;\n                    } else if (cell.kind === \"commercial\") {\n                        pop += cell.level * 28;\n                    } else if (cell.kind === \"industrial\") {\n                        pop += cell.level * 22;\n                    }\n                }\n            }\n        });\n\n        // Compute road traffic from adjacent developed zones\n        this.grid.forEach((cell: TileCell, gx: number, gy: number): void => {\n            if (cell.kind !== \"road\") {\n                cell.traffic = 0;\n                return;\n            }\n            let density: number = 8;\n            for (let dy: number = -2; dy <= 2; dy++) {\n                for (let dx: number = -2; dx <= 2; dx++) {\n                    if (this.grid.inBounds(gx + dx, gy + dy)) {\n                        const nb: TileCell = this.grid.get(gx + dx, gy + dy);\n                        if (isZoneKind(nb.kind) && nb.level > 0 && nb.powered) {\n                            density += nb.level * 9;\n                        }\n                    }\n                }\n            }\n            cell.traffic = Math.min(100, density);\n        });\n\n        this.stats.population = pop;\n        this.stats.zonedTiles = zoned;\n        this.stats.developedBuildings = developed;\n        this.stats.roadCount = roads;\n    }\n\n    recomputeDemand(): void {\n        let resCap: number = 0;\n        let comCap: number = 0;\n        let indCap: number = 0;\n\n        this.grid.forEach((cell: TileCell): void => {\n            if (!cell.powered) {\n                return;\n            }\n            const weight: number = cell.level === 0 ? 0.35 : cell.level;\n            if (cell.kind === \"residential\") {\n                resCap += weight * 1.0;\n            } else if (cell.kind === \"commercial\") {\n                comCap += weight * 1.35;\n            } else if (cell.kind === \"industrial\") {\n                indCap += weight * 1.25;\n            }\n        });\n\n        const taxPenalty: number = (this.stats.taxRate - 7) * 7.5;\n        const jobsAvailable: number = comCap * 18 + indCap * 24 + 30;\n        const residents: number = resCap * 26 + 15;\n\n        const rRaw: number = 42 + (jobsAvailable - residents) * 0.65 - taxPenalty;\n        const cRaw: number = 28 + (residents * 0.55 - comCap * 20) * 0.7 - taxPenalty * 0.85;\n        const iRaw: number = 38 + (residents * 0.48 - indCap * 22) * 0.65 - taxPenalty * 0.55;\n\n        this.stats.demand = {\n            residential: Math.max(-100, Math.min(100, Math.round(rRaw))),\n            commercial: Math.max(-100, Math.min(100, Math.round(cRaw))),\n            industrial: Math.max(-100, Math.min(100, Math.round(iRaw))),\n        };\n    }\n\n    computeBudgetPreview(): BudgetSummary {\n        let parkCount: number = 0;\n        this.grid.forEach((cell: TileCell): void => {\n            if (cell.kind === \"park\") {\n                parkCount += 1;\n            }\n        });\n        const taxBase: number = Math.floor(this.stats.population * 1.45 + this.stats.developedBuildings * 32);\n        const taxRevenue: number = Math.round((taxBase * this.stats.taxRate) / 7);\n        const roadMaintenance: number = this.stats.roadCount * 6;\n        const powerMaintenance: number = this.stats.plantCount * 140;\n        const parkMaintenance: number = parkCount * 10;\n        const netCashflow: number = taxRevenue - roadMaintenance - powerMaintenance - parkMaintenance;\n        return {\n            taxRate: this.stats.taxRate,\n            taxRevenue,\n            roadMaintenance,\n            powerMaintenance,\n            parkMaintenance,\n            netCashflow,\n        };\n    }\n\n    stepSimulationTick(): boolean {\n        this.stats.tickCount += 1;\n        this.stepVehicles();\n        // Every 15 simulation ticks (~0.5s at 1x, faster at 3x) advances a civic month!\n        if (this.stats.tickCount % 15 !== 0) {\n            return false;\n        }\n        return this.stepMonth();\n    }\n\n    stepMonth(): boolean {\n        let anyBoom: boolean = false;\n        this.stats.month += 1;\n        if (this.stats.month > 12) {\n            this.stats.month = 1;\n            this.stats.year += 1;\n            const annual: BudgetSummary = this.computeBudgetPreview();\n            this.stats.funds += annual.netCashflow;\n            this.stats.lastBudget = annual;\n            const sign: string = annual.netCashflow >= 0 ? \"+\" : \"\";\n            this.stats.advisorMessage =\n                \"FY \" + String(this.stats.year) + \" Budget settled: \" + sign + \"$\" + String(annual.netCashflow) + \" net treasury.\";\n        }\n\n        // Evaluate RCI zone growth across the 16x16 grid\n        this.grid.forEach((cell: TileCell, gx: number, gy: number): void => {\n            if (!isZoneKind(cell.kind)) {\n                return;\n            }\n            const roadOk: boolean = this.hasNearbyRoad(gx, gy);\n            if (!cell.powered || !roadOk) {\n                if (cell.level > 1 && this.nextRand() < 0.08) {\n                    cell.level -= 1;\n                }\n                return;\n            }\n\n            let demandScore: number = 0;\n            if (cell.kind === \"residential\") {\n                demandScore = this.stats.demand.residential + (cell.landValue - 40) * 0.45;\n            } else if (cell.kind === \"commercial\") {\n                demandScore = this.stats.demand.commercial + (cell.landValue - 35) * 0.55;\n            } else {\n                demandScore = this.stats.demand.industrial + 18;\n            }\n\n            if (demandScore > -5 && cell.level < 3) {\n                const gain: number = 28 + Math.max(0, demandScore * 0.55) + this.nextRand() * 24;\n                cell.growthProgress += gain;\n                const threshold: number = cell.level === 0 ? 45 : cell.level === 1 ? 85 : 130;\n                if (cell.growthProgress >= threshold) {\n                    cell.level += 1;\n                    cell.growthProgress = 0;\n                    if (cell.level >= 2) {\n                        anyBoom = true;\n                    }\n                }\n            }\n        });\n\n        this.recomputeAll();\n        this.spawnVehiclesIfNeeded();\n\n        if (this.stats.plantCount > 0 && this.stats.powerUsedMw > this.stats.powerCapacityMw) {\n            this.stats.advisorMessage = \"BROWN-OUT WARNING: Power grid overloaded! Construct another Coal Plant [6].\";\n        }\n        return anyBoom;\n    }\n\n    spawnVehiclesIfNeeded(): void {\n        const targetVehicles: number = Math.min(18, Math.floor(this.stats.developedBuildings / 2) + 2);\n        if (this.stats.roadCount < 3) {\n            this.vehicles = [];\n            return;\n        }\n        const palette: number[] = [0xfef08a, 0x38bdf8, 0xf87171, 0xe2e8f0, 0x34d399];\n        let guard: number = 0;\n        while (this.vehicles.length < targetVehicles && guard < 60) {\n            guard += 1;\n            const rx: number = Math.floor(this.nextRand() * GRID_SIZE);\n            const ry: number = Math.floor(this.nextRand() * GRID_SIZE);\n            if (this.grid.get(rx, ry).kind === \"road\") {\n                const cIdx: number = this.vehicles.length % palette.length;\n                this.vehicles.push({\n                    gx: rx,\n                    gy: ry,\n                    dirX: 1,\n                    dirY: 0,\n                    progress: this.nextRand(),\n                    speed: 0.08 + this.nextRand() * 0.05,\n                    color: palette[cIdx],\n                });\n            }\n        }\n    }\n\n    stepVehicles(): void {\n        const dirs: [number, number][] = [\n            [1, 0],\n            [-1, 0],\n            [0, 1],\n            [0, -1],\n        ];\n        for (let i: number = 0; i < this.vehicles.length; i++) {\n            const v: VehicleAgent = this.vehicles[i];\n            if (!this.grid.inBounds(v.gx, v.gy) || this.grid.get(v.gx, v.gy).kind !== \"road\") {\n                v.gx = 3;\n                v.gy = 3;\n            }\n            v.progress += v.speed;\n            if (v.progress >= 1.0) {\n                v.progress -= 1.0;\n                const nextX: number = v.gx + v.dirX;\n                const nextY: number = v.gy + v.dirY;\n                if (this.grid.inBounds(nextX, nextY) && this.grid.get(nextX, nextY).kind === \"road\") {\n                    v.gx = nextX;\n                    v.gy = nextY;\n                }\n                // Pick a valid road neighbor (preferring non-reverse)\n                const options: [number, number][] = [];\n                for (let dIdx: number = 0; dIdx < dirs.length; dIdx++) {\n                    const d: [number, number] = dirs[dIdx];\n                    const tx: number = v.gx + d[0];\n                    const ty: number = v.gy + d[1];\n                    if (this.grid.inBounds(tx, ty) && this.grid.get(tx, ty).kind === \"road\") {\n                        if (!(d[0] === -v.dirX && d[1] === -v.dirY)) {\n                            options.push(d);\n                        }\n                    }\n                }\n                if (options.length > 0) {\n                    const pick: [number, number] = options[Math.floor(this.nextRand() * options.length)];\n                    v.dirX = pick[0];\n                    v.dirY = pick[1];\n                } else {\n                    v.dirX = -v.dirX;\n                    v.dirY = -v.dirY;\n                }\n            }\n        }\n    }\n}\n"
    },
    {
      "id": "src-17",
      "path": "city/iso_renderer.ts",
      "language": "type_script",
      "source": "import {\n    GRID_SIZE,\n    type GridCoord,\n    type HeatmapMode,\n    type IsoPoint,\n    type TileCell,\n    type ToolId,\n    type VehicleAgent,\n} from \"./types\";\nimport { CitySimulation, isZoneKind } from \"./sim\";\n\nexport const VIEWPORT_X: number = 182;\nexport const VIEWPORT_Y: number = 50;\nexport const VIEWPORT_W: number = 608;\nexport const VIEWPORT_H: number = 432;\n\nexport const ISO_ORIGIN_X: number = 486;\nexport const ISO_ORIGIN_Y: number = 144;\nexport const TILE_HALF_W: number = 18;\nexport const TILE_HALF_H: number = 9;\n\nexport function tileToScreen(gx: number, gy: number): IsoPoint {\n    return {\n        sx: ISO_ORIGIN_X + (gx - gy) * TILE_HALF_W,\n        sy: ISO_ORIGIN_Y + (gx + gy) * TILE_HALF_H,\n    };\n}\n\nexport function tileCenterScreen(gx: number, gy: number): IsoPoint {\n    const top: IsoPoint = tileToScreen(gx, gy);\n    return {\n        sx: top.sx,\n        sy: top.sy + TILE_HALF_H,\n    };\n}\n\nexport function screenToTile(mx: number, my: number): GridCoord | null {\n    if (\n        mx < VIEWPORT_X ||\n        mx > VIEWPORT_X + VIEWPORT_W ||\n        my < VIEWPORT_Y ||\n        my > VIEWPORT_Y + VIEWPORT_H\n    ) {\n        return null;\n    }\n    const u: number = (mx - ISO_ORIGIN_X) / TILE_HALF_W;\n    const v: number = (my - ISO_ORIGIN_Y) / TILE_HALF_H;\n    const gx: number = Math.floor((u + v) * 0.5);\n    const gy: number = Math.floor((v - u) * 0.5);\n    if (gx < 0 || gy < 0 || gx >= GRID_SIZE || gy >= GRID_SIZE) {\n        return null;\n    }\n    return { gx, gy };\n}\n\nfunction drawDiamond(\n    g: any,\n    cx: number,\n    ty: number,\n    hw: number,\n    hh: number,\n    fillColor: number,\n    fillAlpha: number,\n    strokeColor: number,\n    strokeAlpha: number,\n): void {\n    if (strokeAlpha > 0) {\n        g.lineStyle(1, strokeColor, strokeAlpha);\n    } else {\n        g.lineStyle(NaN);\n    }\n    g.beginFill(fillColor, fillAlpha);\n    g.moveTo(cx, ty);\n    g.lineTo(cx + hw, ty + hh);\n    g.lineTo(cx, ty + hh * 2);\n    g.lineTo(cx - hw, ty + hh);\n    g.lineTo(cx, ty);\n    g.endFill();\n}\n\nfunction drawIsoPrism(\n    g: any,\n    cx: number,\n    baseTopY: number,\n    hw: number,\n    hh: number,\n    height: number,\n    topColor: number,\n    leftColor: number,\n    rightColor: number,\n): void {\n    const roofY: number = baseTopY - height;\n    g.lineStyle(NaN);\n\n    // Left sunlit-medium face\n    g.beginFill(leftColor, 1);\n    g.moveTo(cx - hw, roofY + hh);\n    g.lineTo(cx, roofY + hh * 2);\n    g.lineTo(cx, baseTopY + hh * 2);\n    g.lineTo(cx - hw, baseTopY + hh);\n    g.lineTo(cx - hw, roofY + hh);\n    g.endFill();\n\n    // Right shaded face\n    g.beginFill(rightColor, 1);\n    g.moveTo(cx, roofY + hh * 2);\n    g.lineTo(cx + hw, roofY + hh);\n    g.lineTo(cx + hw, baseTopY + hh);\n    g.lineTo(cx, baseTopY + hh * 2);\n    g.lineTo(cx, roofY + hh * 2);\n    g.endFill();\n\n    // Top roof face\n    g.lineStyle(1, 0xffffff, 0.16);\n    g.beginFill(topColor, 1);\n    g.moveTo(cx, roofY);\n    g.lineTo(cx + hw, roofY + hh);\n    g.lineTo(cx, roofY + hh * 2);\n    g.lineTo(cx - hw, roofY + hh);\n    g.lineTo(cx, roofY);\n    g.endFill();\n    g.lineStyle(NaN);\n}\n\nfunction drawFacadeWindows(\n    g: any,\n    cx: number,\n    baseTopY: number,\n    hw: number,\n    hh: number,\n    height: number,\n    floors: number,\n    winColor: number,\n): void {\n    g.lineStyle(NaN);\n    for (let f: number = 0; f < floors; f++) {\n        const wy: number = baseTopY + hh - 4 - f * Math.max(5, Math.floor((height - 6) / Math.max(1, floors)));\n        // Left face windows\n        g.beginFill(winColor, 0.85);\n        g.drawRect(cx - hw + 3, wy, 3, 2.5);\n        g.drawRect(cx - 5, wy + 2, 3, 2.5);\n        g.endFill();\n        // Right face windows\n        g.beginFill(winColor, 0.6);\n        g.drawRect(cx + 3, wy + 2, 3, 2.5);\n        g.drawRect(cx + hw - 6, wy, 3, 2.5);\n        g.endFill();\n    }\n}\n\nfunction heatmapTintForCell(cell: TileCell, mode: HeatmapMode): [number, number] {\n    if (mode === \"power\") {\n        if (cell.kind === \"plant\") {\n            return [0x38bdf8, 0.65];\n        }\n        if (cell.kind === \"powerline\") {\n            return [cell.powered ? 0xfacc15 : 0xef4444, 0.62];\n        }\n        if (isZoneKind(cell.kind) || cell.kind === \"park\") {\n            return [cell.powered ? 0x22d3ee : 0xf43f5e, 0.56];\n        }\n        return [0x0f172a, 0.28];\n    }\n    if (mode === \"value\") {\n        if (cell.kind === \"water\") {\n            return [0x0284c7, 0.25];\n        }\n        if (cell.landValue >= 72) {\n            return [0x10b981, 0.58];\n        }\n        if (cell.landValue >= 52) {\n            return [0x84cc16, 0.48];\n        }\n        if (cell.landValue >= 34) {\n            return [0xfacc15, 0.44];\n        }\n        return [0xf97316, 0.5];\n    }\n    if (mode === \"pollution\") {\n        if (cell.pollution >= 60) {\n            return [0xdc2626, 0.66];\n        }\n        if (cell.pollution >= 30) {\n            return [0xf97316, 0.54];\n        }\n        if (cell.pollution >= 10) {\n            return [0xeab308, 0.38];\n        }\n        return [0x22c55e, 0.22];\n    }\n    return [0x000000, 0];\n}\n\nfunction drawRoadTile(g: any, cx: number, ty: number, cell: TileCell): void {\n    const hw: number = TILE_HALF_W;\n    const hh: number = TILE_HALF_H;\n    if (cell.bridge) {\n        // Water beneath bridge + steel deck piers\n        drawDiamond(g, cx, ty, hw, hh, 0x0284c7, 1, 0x0369a1, 0.5);\n        g.lineStyle(2, 0xcbd5e1, 0.9);\n        g.moveTo(cx - 10, ty + 4);\n        g.lineTo(cx + 10, ty + 14);\n        g.moveTo(cx - 10, ty + 14);\n        g.lineTo(cx + 10, ty + 4);\n    } else {\n        drawDiamond(g, cx, ty, hw, hh, 0x334155, 1, 0x475569, 0.65);\n    }\n\n    // Inner asphalt surface\n    drawDiamond(g, cx, ty + 2, hw - 4, hh - 2, 0x1e293b, 1, 0x000000, 0);\n\n    // Center lane markings connected to roadMask bits (1=N, 2=E, 4=S, 8=W)\n    const cy: number = ty + hh;\n    g.lineStyle(1.4, 0xfacc15, 0.85);\n    const mask: number = cell.roadMask;\n    if ((mask & 1) !== 0 || mask === 0) {\n        g.moveTo(cx, cy);\n        g.lineTo(cx + hw * 0.45, cy - hh * 0.45);\n    }\n    if ((mask & 4) !== 0 || mask === 0) {\n        g.moveTo(cx, cy);\n        g.lineTo(cx - hw * 0.45, cy + hh * 0.45);\n    }\n    if ((mask & 2) !== 0) {\n        g.moveTo(cx, cy);\n        g.lineTo(cx + hw * 0.45, cy + hh * 0.45);\n    }\n    if ((mask & 8) !== 0) {\n        g.moveTo(cx, cy);\n        g.lineTo(cx - hw * 0.45, cy - hh * 0.45);\n    }\n    g.lineStyle(NaN);\n}\n\nfunction drawPowerLineTile(g: any, cx: number, ty: number, cell: TileCell): void {\n    const hw: number = TILE_HALF_W;\n    const hh: number = TILE_HALF_H;\n    if (cell.bridge) {\n        drawDiamond(g, cx, ty, hw, hh, 0x0369a1, 1, 0x0ea5e9, 0.45);\n    } else {\n        drawDiamond(g, cx, ty, hw, hh, 0x1f3a2e, 1, 0x2d5442, 0.55);\n    }\n\n    const towerTopY: number = ty - 7;\n    const wireColor: number = cell.powered ? 0xfef08a : 0x94a3b8;\n    // Steel lattice pylon\n    g.lineStyle(1.5, 0x94a3b8, 0.95);\n    g.moveTo(cx - 4, ty + hh + 2);\n    g.lineTo(cx, towerTopY);\n    g.lineTo(cx + 4, ty + hh + 2);\n    g.moveTo(cx - 6, towerTopY + 4);\n    g.lineTo(cx + 6, towerTopY + 4);\n\n    // Overhead transmission lines to connected neighbors\n    g.lineStyle(1.2, wireColor, 0.9);\n    const mask: number = cell.wireMask;\n    if ((mask & 1) !== 0) {\n        g.moveTo(cx, towerTopY + 2);\n        g.lineTo(cx + hw * 0.5, towerTopY + 2 - hh * 0.5);\n    }\n    if ((mask & 4) !== 0) {\n        g.moveTo(cx, towerTopY + 2);\n        g.lineTo(cx - hw * 0.5, towerTopY + 2 + hh * 0.5);\n    }\n    if ((mask & 2) !== 0) {\n        g.moveTo(cx, towerTopY + 2);\n        g.lineTo(cx + hw * 0.5, towerTopY + 2 + hh * 0.5);\n    }\n    if ((mask & 8) !== 0) {\n        g.moveTo(cx, towerTopY + 2);\n        g.lineTo(cx - hw * 0.5, towerTopY + 2 - hh * 0.5);\n    }\n    g.lineStyle(NaN);\n}\n\nfunction drawCoalPlant(g: any, cx: number, ty: number, animPhase: number): void {\n    const hw: number = TILE_HALF_W;\n    const hh: number = TILE_HALF_H;\n    drawDiamond(g, cx, ty, hw, hh, 0x334155, 1, 0x64748b, 0.7);\n    // Main brick turbine hall\n    drawIsoPrism(g, cx, ty + 2, 13, 6.5, 18, 0xb91c1c, 0x991b1b, 0x7f1d1d);\n    drawFacadeWindows(g, cx, ty + 2, 13, 6.5, 16, 2, 0xfef08a);\n    // Twin smokestacks\n    drawIsoPrism(g, cx - 5, ty - 14, 3.5, 2, 13, 0xe2e8f0, 0x94a3b8, 0x475569);\n    drawIsoPrism(g, cx + 4, ty - 12, 3.5, 2, 13, 0xe2e8f0, 0x94a3b8, 0x475569);\n    // Animated steam puffs\n    const drift: number = Math.sin(animPhase * 0.12) * 2.5;\n    g.lineStyle(NaN);\n    g.beginFill(0xe2e8f0, 0.55);\n    g.drawCircle(cx - 5 + drift, ty - 31, 3.2);\n    g.drawCircle(cx + 4 - drift * 0.7, ty - 29, 2.8);\n    g.endFill();\n}\n\nfunction drawParkTile(g: any, cx: number, ty: number, variant: number): void {\n    drawDiamond(g, cx, ty, TILE_HALF_W, TILE_HALF_H, 0x15803d, 1, 0x22c55e, 0.55);\n    // Central fountain basin\n    drawDiamond(g, cx, ty + 5, 6, 3, 0x38bdf8, 0.95, 0xe2e8f0, 0.7);\n    // Crisp isometric trees\n    g.lineStyle(NaN);\n    g.beginFill(0x22c55e, 0.95);\n    g.drawCircle(cx - 7, ty + 5, 3.5);\n    g.drawCircle(cx + 7, ty + 6, 3.2);\n    if (variant % 2 === 0) {\n        g.beginFill(0x4ade80, 0.9);\n        g.drawCircle(cx, ty + 1, 3.0);\n        g.endFill();\n    } else {\n        g.endFill();\n    }\n}\n\nfunction drawZoneAndBuilding(g: any, cx: number, ty: number, cell: TileCell, animPhase: number): void {\n    const hw: number = TILE_HALF_W;\n    const hh: number = TILE_HALF_H;\n\n    let padColor: number = 0x166534;\n    let padBorder: number = 0x4ade80;\n    if (cell.kind === \"commercial\") {\n        padColor = 0x1e3a8a;\n        padBorder = 0x60a5fa;\n    } else if (cell.kind === \"industrial\") {\n        padColor = 0x78350f;\n        padBorder = 0xfbbf24;\n    }\n\n    drawDiamond(g, cx, ty, hw, hh, padColor, 0.92, padBorder, 0.75);\n\n    if (cell.level === 0) {\n        // Zoned vacant lot markers\n        drawDiamond(g, cx, ty + 4, hw - 8, hh - 4, padBorder, 0.28, padBorder, 0.65);\n    } else if (cell.kind === \"residential\") {\n        if (cell.level === 1) {\n            // Suburban cottage + pitched roof accent\n            drawIsoPrism(g, cx, ty + 2, 10, 5, 9, 0xf97316, 0xfde68a, 0xd97706);\n            drawFacadeWindows(g, cx, ty + 2, 10, 5, 9, 1, cell.powered ? 0xfef08a : 0x334155);\n        } else if (cell.level === 2) {\n            // Mid-rise apartment block\n            drawIsoPrism(g, cx, ty + 2, 12, 6, 20, 0x34d399, 0x10b981, 0x047857);\n            drawFacadeWindows(g, cx, ty + 2, 12, 6, 20, 3, cell.powered ? 0xfef9c3 : 0x1e293b);\n        } else {\n            // High-rise residential condominium tower\n            drawIsoPrism(g, cx, ty + 2, 13, 6.5, 36, 0x6ee7b7, 0x059669, 0x064e3b);\n            drawIsoPrism(g, cx, ty - 34, 7, 3.5, 6, 0xa7f3d0, 0x10b981, 0x047857);\n            drawFacadeWindows(g, cx, ty + 2, 13, 6.5, 34, 5, cell.powered ? 0xfef08a : 0x1e293b);\n        }\n    } else if (cell.kind === \"commercial\") {\n        if (cell.level === 1) {\n            // Retail corner shop\n            drawIsoPrism(g, cx, ty + 2, 11, 5.5, 11, 0x60a5fa, 0x3b82f6, 0x1d4ed8);\n            drawFacadeWindows(g, cx, ty + 2, 11, 5.5, 11, 1, cell.powered ? 0xe0f2fe : 0x1e293b);\n        } else if (cell.level === 2) {\n            // Glass office mid-rise\n            drawIsoPrism(g, cx, ty + 2, 12.5, 6.2, 25, 0x38bdf8, 0x0284c7, 0x0369a1);\n            drawFacadeWindows(g, cx, ty + 2, 12.5, 6.2, 24, 3, cell.powered ? 0xbae6fd : 0x1e293b);\n        } else {\n            // Gleaming corporate skyscraper + antenna spire\n            drawIsoPrism(g, cx, ty + 2, 13.5, 6.8, 46, 0x7dd3fc, 0x0ea5e9, 0x0c4a6e);\n            drawIsoPrism(g, cx, ty - 44, 8, 4, 8, 0xe0f2fe, 0x38bdf8, 0x0369a1);\n            drawFacadeWindows(g, cx, ty + 2, 13.5, 6.8, 44, 6, cell.powered ? 0xf0f9ff : 0x1e293b);\n            g.lineStyle(1.5, 0xf8fafc, 0.9);\n            g.moveTo(cx, ty - 50);\n            g.lineTo(cx, ty - 59);\n            g.lineStyle(NaN);\n        }\n    } else if (cell.kind === \"industrial\") {\n        if (cell.level === 1) {\n            // Light workshop\n            drawIsoPrism(g, cx, ty + 2, 11, 5.5, 10, 0xfbbf24, 0xd97706, 0x92400e);\n        } else if (cell.level === 2) {\n            // Twin warehouse + storage tank\n            drawIsoPrism(g, cx - 2, ty + 2, 12, 6, 17, 0xf59e0b, 0xb45309, 0x78350f);\n            drawIsoPrism(g, cx + 5, ty - 12, 3, 1.8, 9, 0x94a3b8, 0x64748b, 0x334155);\n            drawFacadeWindows(g, cx - 2, ty + 2, 12, 6, 16, 2, cell.powered ? 0xfde68a : 0x1e293b);\n        } else {\n            // Heavy manufacturing plant\n            drawIsoPrism(g, cx, ty + 2, 13.5, 6.8, 26, 0xfbbf24, 0xd97706, 0x78350f);\n            drawIsoPrism(g, cx - 4, ty - 22, 3.2, 1.8, 12, 0xcbd5e1, 0x64748b, 0x334155);\n            drawFacadeWindows(g, cx, ty + 2, 13.5, 6.8, 24, 3, cell.powered ? 0xfef08a : 0x1e293b);\n        }\n    }\n\n    // Blinking unpowered indicator diamond above unpowered zones\n    if (!cell.powered && Math.floor(animPhase / 10) % 2 === 0) {\n        const iconY: number = ty - (cell.level * 12 + 10);\n        drawDiamond(g, cx, iconY, 4.5, 3, 0xef4444, 0.95, 0xfef08a, 0.95);\n    }\n}\n\nexport function renderIsometricWorld(\n    worldSprite: any,\n    sim: CitySimulation,\n    heatmap: HeatmapMode,\n    animPhase: number,\n): void {\n    const g: any = worldSprite.graphics;\n    g.clear();\n\n    // Sky/blueprint backdrop inside the map viewport\n    g.lineStyle(1, 0x1e3a5f, 0.9);\n    g.beginFill(0x0b192c, 1);\n    g.drawRoundRect(VIEWPORT_X, VIEWPORT_Y, VIEWPORT_W, VIEWPORT_H, 8, 8);\n    g.endFill();\n\n    // Sleek viewport header strip behind overlay & power grid readout\n    g.lineStyle(1, 0x1e3a5f, 0.65);\n    g.beginFill(0x11243d, 0.78);\n    g.drawRoundRect(VIEWPORT_X + 8, VIEWPORT_Y + 5, VIEWPORT_W - 16, 24, 5, 5);\n    g.endFill();\n    g.lineStyle(NaN);\n\n    // Painter's algorithm diagonal traversal: (gx + gy) from 0 to 30\n    for (let sum: number = 0; sum <= (GRID_SIZE - 1) * 2; sum++) {\n        for (let gx: number = 0; gx < GRID_SIZE; gx++) {\n            const gy: number = sum - gx;\n            if (gy < 0 || gy >= GRID_SIZE) {\n                continue;\n            }\n            const cell: TileCell = sim.grid.get(gx, gy);\n            const pt: IsoPoint = tileToScreen(gx, gy);\n            const cx: number = pt.sx;\n            const ty: number = pt.sy;\n\n            if (cell.kind === \"empty\") {\n                const grassShade: number = (gx + gy) % 2 === 0 ? 0x1b4332 : 0x1e4d38;\n                drawDiamond(g, cx, ty, TILE_HALF_W, TILE_HALF_H, grassShade, 1, 0x2d6a4f, 0.45);\n            } else if (cell.kind === \"water\") {\n                const wave: number = Math.sin(animPhase * 0.08 + gx * 0.7 + gy * 0.5);\n                const waterCol: number = wave > 0 ? 0x0284c7 : 0x0369a1;\n                drawDiamond(g, cx, ty, TILE_HALF_W, TILE_HALF_H, waterCol, 1, 0x38bdf8, 0.35);\n                // Crisp water shimmer highlight\n                g.lineStyle(1, 0x7dd3fc, 0.45);\n                g.moveTo(cx - 5, ty + TILE_HALF_H + (wave > 0 ? -1 : 1));\n                g.lineTo(cx + 5, ty + TILE_HALF_H + (wave > 0 ? -1 : 1));\n                g.lineStyle(NaN);\n            } else if (cell.kind === \"road\") {\n                drawRoadTile(g, cx, ty, cell);\n            } else if (cell.kind === \"powerline\") {\n                drawPowerLineTile(g, cx, ty, cell);\n            } else if (cell.kind === \"plant\") {\n                drawCoalPlant(g, cx, ty, animPhase);\n            } else if (cell.kind === \"park\") {\n                drawParkTile(g, cx, ty, cell.variant);\n            } else {\n                drawZoneAndBuilding(g, cx, ty, cell, animPhase);\n            }\n\n            // Heatmap tint overlay\n            if (heatmap !== \"none\") {\n                const tint: [number, number] = heatmapTintForCell(cell, heatmap);\n                if (tint[1] > 0) {\n                    drawDiamond(g, cx, ty, TILE_HALF_W - 1, TILE_HALF_H - 0.5, tint[0], tint[1], tint[0], 0.85);\n                }\n            }\n\n            // 3D geological cutaway skirt along front-left (gy == 15) and front-right (gx == 15) edges\n            const skirtDepth: number = 11;\n            if (gy === GRID_SIZE - 1) {\n                const leftSkirt: number = cell.kind === \"water\" ? 0x075985 : 0x3f2e21;\n                g.lineStyle(NaN);\n                g.beginFill(leftSkirt, 1);\n                g.moveTo(cx - TILE_HALF_W, ty + TILE_HALF_H);\n                g.lineTo(cx, ty + TILE_HALF_H * 2);\n                g.lineTo(cx, ty + TILE_HALF_H * 2 + skirtDepth);\n                g.lineTo(cx - TILE_HALF_W, ty + TILE_HALF_H + skirtDepth);\n                g.lineTo(cx - TILE_HALF_W, ty + TILE_HALF_H);\n                g.endFill();\n            }\n            if (gx === GRID_SIZE - 1) {\n                const rightSkirt: number = cell.kind === \"water\" ? 0x0c4a6e : 0x291d15;\n                g.lineStyle(NaN);\n                g.beginFill(rightSkirt, 1);\n                g.moveTo(cx, ty + TILE_HALF_H * 2);\n                g.lineTo(cx + TILE_HALF_W, ty + TILE_HALF_H);\n                g.lineTo(cx + TILE_HALF_W, ty + TILE_HALF_H + skirtDepth);\n                g.lineTo(cx, ty + TILE_HALF_H * 2 + skirtDepth);\n                g.lineTo(cx, ty + TILE_HALF_H * 2);\n                g.endFill();\n            }\n        }\n    }\n\n    // Render animated road vehicles on top of roads\n    g.lineStyle(NaN);\n    for (let i: number = 0; i < sim.vehicles.length; i++) {\n        const v: VehicleAgent = sim.vehicles[i];\n        const fx: number = v.gx + v.dirX * (v.progress - 0.5) * 0.7;\n        const fy: number = v.gy + v.dirY * (v.progress - 0.5) * 0.7;\n        const vPt: IsoPoint = tileToScreen(fx, fy);\n        g.beginFill(v.color, 0.95);\n        g.drawRect(vPt.sx - 2, vPt.sy + TILE_HALF_H - 2, 4, 2.5);\n        g.endFill();\n    }\n}\n\nexport function renderHoverCursor(\n    hoverSprite: any,\n    hovered: GridCoord | null,\n    tool: ToolId,\n    canAfford: boolean,\n): void {\n    const g: any = hoverSprite.graphics;\n    g.clear();\n    if (hovered === null) {\n        return;\n    }\n    const pt: IsoPoint = tileToScreen(hovered.gx, hovered.gy);\n    let ringColor: number = canAfford ? 0x38bdf8 : 0xef4444;\n    if (tool === \"bulldoze\") {\n        ringColor = 0xf97316;\n    } else if (tool === \"residential\") {\n        ringColor = 0x4ade80;\n    } else if (tool === \"commercial\") {\n        ringColor = 0x60a5fa;\n    } else if (tool === \"industrial\") {\n        ringColor = 0xfbbf24;\n    }\n    drawDiamond(\n        g,\n        pt.sx,\n        pt.sy - 1,\n        TILE_HALF_W,\n        TILE_HALF_H,\n        ringColor,\n        0.22,\n        ringColor,\n        0.95,\n    );\n}\n"
    },
    {
      "id": "src-18",
      "path": "city/ui_controller.ts",
      "language": "type_script",
      "source": "import {\n    TOOL_CATALOG,\n    findToolSpec,\n    formatMoney,\n    monthAbbrev,\n    type BudgetSummary,\n    type GridCoord,\n    type HeatmapMode,\n    type IsoPoint,\n    type SimSpeed,\n    type TileCell,\n    type ToolActionResult,\n    type ToolId,\n    type ToolSpec,\n} from \"./types\";\nimport { CitySimulation } from \"./sim\";\nimport {\n    renderHoverCursor,\n    renderIsometricWorld,\n    screenToTile,\n    tileCenterScreen,\n} from \"./iso_renderer\";\n\ninterface ButtonHandle {\n    readonly id: string;\n    readonly sprite: Sprite;\n    readonly labelField: TextField;\n    readonly x: number;\n    readonly y: number;\n    readonly w: number;\n    readonly h: number;\n    readonly accent: number;\n}\n\nfunction createHudLabel(\n    text: string,\n    x: number,\n    y: number,\n    w: number,\n    h: number,\n    size: number,\n    color: number,\n    bold: boolean,\n    align: string,\n    selectable: boolean,\n): TextField {\n    const tf: TextField = new TextField();\n    tf.x = x;\n    tf.y = y;\n    tf.width = w;\n    tf.height = h;\n    tf.selectable = selectable;\n    tf.mouseEnabled = selectable;\n    tf.multiline = false;\n    tf.wordWrap = false;\n    const fmt: TextFormat = new TextFormat(\"Arial\", size, color, bold, false, false, null, null, align);\n    tf.defaultTextFormat = fmt;\n    tf.text = text;\n    tf.setTextFormat(fmt);\n    return tf;\n}\n\nfunction paintButtonChrome(btn: ButtonHandle, active: boolean): void {\n    const g: any = btn.sprite.graphics;\n    g.clear();\n    const bg: number = active ? 0x1e3a5f : 0x152238;\n    const border: number = active ? btn.accent : 0x334155;\n    g.lineStyle(active ? 1.8 : 1.0, border, 1);\n    g.beginFill(bg, 1);\n    g.drawRoundRect(0, 0, btn.w, btn.h, 5, 5);\n    g.endFill();\n\n    g.lineStyle(NaN);\n    g.beginFill(btn.accent, active ? 1.0 : 0.78);\n    g.drawRoundRect(3, 4, 4, btn.h - 8, 2, 2);\n    g.endFill();\n}\n\nexport class MicropolisApp {\n    root: MovieClip;\n    sim: CitySimulation;\n    activeTool: ToolId;\n    heatmap: HeatmapMode;\n    speed: SimSpeed;\n    budgetOpen: boolean;\n    hoveredTile: GridCoord | null;\n    draggingMap: boolean;\n    animFrame: number;\n    worldDirty: boolean;\n\n    worldSprite: Sprite;\n    hoverSprite: Sprite;\n    rciSprite: Sprite;\n    modalContainer: Sprite;\n    modalBgSprite: Sprite;\n\n    fundsField: TextField;\n    popField: TextField;\n    dateField: TextField;\n    powerField: TextField;\n    statusField: TextField;\n    overlayBadgeField: TextField;\n    rciValueField: TextField;\n\n    modalTitleField: TextField;\n    modalTaxField: TextField;\n    modalRevField: TextField;\n    modalMaintField: TextField;\n    modalNetField: TextField;\n\n    toolButtons: ButtonHandle[];\n    heatmapButtons: ButtonHandle[];\n    speedButton: ButtonHandle;\n    starterButton: ButtonHandle;\n    budgetButton: ButtonHandle;\n\n    sounds: Record<string, Sound>;\n\n    constructor(root: MovieClip) {\n        this.root = root;\n        this.sim = new CitySimulation();\n        this.activeTool = \"residential\";\n        this.heatmap = \"none\";\n        this.speed = 1;\n        this.budgetOpen = false;\n        this.hoveredTile = null;\n        this.draggingMap = false;\n        this.animFrame = 0;\n        this.worldDirty = true;\n\n        this.sounds = this.initSoundBank();\n\n        // 1. Isometric world layer & hover cursor layer\n        this.worldSprite = new Sprite();\n        this.worldSprite.name = \"isoWorldViewport\";\n        this.worldSprite.mouseEnabled = false;\n        this.worldSprite.mouseChildren = false;\n        this.root.addChild(this.worldSprite);\n\n        this.hoverSprite = new Sprite();\n        this.hoverSprite.name = \"isoHoverCursor\";\n        this.hoverSprite.mouseEnabled = false;\n        this.hoverSprite.mouseChildren = false;\n        this.root.addChild(this.hoverSprite);\n\n        // 2. Top HUD dynamic counters\n        this.fundsField = createHudLabel(\"FUNDS $25,000\", 232, 13, 128, 22, 12, 0x4ade80, true, \"left\", false);\n        this.popField = createHudLabel(\"POP 0\", 366, 13, 102, 22, 12, 0xf8fafc, true, \"left\", false);\n        this.dateField = createHudLabel(\"JAN 2000 · 1x\", 474, 13, 128, 22, 12, 0xfbbf24, true, \"left\", false);\n        this.powerField = createHudLabel(\"GRID: 0 / 0 MW\", 610, 58, 170, 18, 11, 0x7dd3fc, true, \"right\", false);\n        this.overlayBadgeField = createHudLabel(\"VIEW: NORMAL TERRAIN\", 198, 58, 230, 18, 11, 0x94a3b8, true, \"left\", false);\n        this.statusField = createHudLabel(\n            this.sim.stats.advisorMessage,\n            14,\n            494,\n            772,\n            20,\n            11,\n            0xe2e8f0,\n            false,\n            \"left\",\n            true,\n        );\n\n        this.root.addChild(this.fundsField);\n        this.root.addChild(this.popField);\n        this.root.addChild(this.dateField);\n        this.root.addChild(this.powerField);\n        this.root.addChild(this.overlayBadgeField);\n        this.root.addChild(this.statusField);\n\n        // 3. Header control buttons\n        let nextTabIndex: number = 1;\n        this.speedButton = this.makeButton(\"speedBtn\", \"1x RUN\", 608, 8, 56, 28, 0x38bdf8, nextTabIndex, (): void => {\n            this.cycleSpeed();\n        });\n        nextTabIndex += 1;\n        this.starterButton = this.makeButton(\"starterBtn\", \"METRO\", 668, 8, 56, 28, 0x22c55e, nextTabIndex, (): void => {\n            this.triggerStarterCity();\n        });\n        nextTabIndex += 1;\n        this.budgetButton = this.makeButton(\"budgetBtn\", \"BUDGET\", 728, 8, 64, 28, 0xfbbf24, nextTabIndex, (): void => {\n            this.toggleBudgetModal();\n        });\n        nextTabIndex += 1;\n\n        // 4. Left sidebar Tool Palette (8 tools)\n        this.toolButtons = [];\n        for (let i: number = 0; i < TOOL_CATALOG.length; i++) {\n            const spec: ToolSpec = TOOL_CATALOG[i];\n            const by: number = 56 + i * 33;\n            const caption: string = \"[\" + spec.shortKey + \"] \" + spec.label + \" $\" + String(spec.cost);\n            const toolId: ToolId = spec.id;\n            const btn: ButtonHandle = this.makeButton(\n                \"tool_\" + spec.id,\n                caption,\n                14,\n                by,\n                156,\n                29,\n                spec.accentColor,\n                nextTabIndex,\n                (): void => {\n                    this.selectTool(toolId);\n                },\n            );\n            nextTabIndex += 1;\n            this.toolButtons.push(btn);\n        }\n\n        // 5. R / C / I Demand Meter widget\n        this.rciSprite = new Sprite();\n        this.rciSprite.name = \"rciDemandMeter\";\n        this.rciSprite.x = 14;\n        this.rciSprite.y = 324;\n        this.rciSprite.mouseEnabled = false;\n        this.rciSprite.mouseChildren = false;\n        this.root.addChild(this.rciSprite);\n\n        const rciTitle: TextField = createHudLabel(\"R · C · I DEMAND\", 20, 328, 144, 16, 10, 0x94a3b8, true, \"center\", false);\n        this.root.addChild(rciTitle);\n        this.rciValueField = createHudLabel(\"R +65  C +35  I +50\", 18, 382, 148, 16, 10, 0xe2e8f0, false, \"center\", false);\n        this.root.addChild(this.rciValueField);\n\n        // 6. Heatmap selector buttons (2x2 grid)\n        const hmTitle: TextField = createHudLabel(\"MAP OVERLAY [H]\", 18, 405, 148, 15, 10, 0x94a3b8, true, \"center\", false);\n        this.root.addChild(hmTitle);\n\n        const hmSpecs: [HeatmapMode, string, number][] = [\n            [\"none\", \"TERRAIN\", 0x64748b],\n            [\"power\", \"POWER\", 0x38bdf8],\n            [\"value\", \"VALUE\", 0x10b981],\n            [\"pollution\", \"SMOG\", 0xef4444],\n        ];\n        this.heatmapButtons = [];\n        for (let i: number = 0; i < hmSpecs.length; i++) {\n            const hs: [HeatmapMode, string, number] = hmSpecs[i];\n            const col: number = i % 2;\n            const row: number = Math.floor(i / 2);\n            const bx: number = 14 + col * 80;\n            const by: number = 423 + row * 27;\n            const mode: HeatmapMode = hs[0];\n            const hBtn: ButtonHandle = this.makeButton(\n                \"hm_\" + mode,\n                hs[1],\n                bx,\n                by,\n                76,\n                23,\n                hs[2],\n                nextTabIndex,\n                (): void => {\n                    this.setHeatmap(mode);\n                },\n            );\n            nextTabIndex += 1;\n            this.heatmapButtons.push(hBtn);\n        }\n\n        // 7. Annual Municipal Budget & Tax Modal (hidden by default)\n        this.modalContainer = new Sprite();\n        this.modalContainer.name = \"budgetModal\";\n        this.modalContainer.x = 290;\n        this.modalContainer.y = 132;\n        this.modalContainer.visible = false;\n        this.root.addChild(this.modalContainer);\n\n        this.modalBgSprite = new Sprite();\n        this.modalBgSprite.mouseEnabled = false;\n        this.modalBgSprite.mouseChildren = false;\n        this.modalContainer.addChild(this.modalBgSprite);\n        this.paintModalBackdrop();\n\n        this.modalTitleField = createHudLabel(\"MUNICIPAL BUDGET & TAX\", 18, 14, 344, 22, 14, 0xf8fafc, true, \"center\", false);\n        this.modalTaxField = createHudLabel(\"Property & Civic Tax Rate: 7%\", 24, 52, 332, 20, 12, 0xfbbf24, true, \"center\", false);\n        this.modalRevField = createHudLabel(\"Projected Tax Revenue: $0 / yr\", 24, 118, 332, 20, 12, 0x4ade80, false, \"left\", false);\n        this.modalMaintField = createHudLabel(\"Infrastructure Upkeep: $0 / yr\", 24, 142, 332, 20, 12, 0xf87171, false, \"left\", false);\n        this.modalNetField = createHudLabel(\"Net Annual Balance: $0 / yr\", 24, 168, 332, 22, 13, 0x38bdf8, true, \"left\", false);\n\n        this.modalContainer.addChild(this.modalTitleField);\n        this.modalContainer.addChild(this.modalTaxField);\n        this.modalContainer.addChild(this.modalRevField);\n        this.modalContainer.addChild(this.modalMaintField);\n        this.modalContainer.addChild(this.modalNetField);\n\n        this.makeModalButton(\"taxMinusBtn\", \"TAX -1%\", 74, 80, 104, 26, 0x38bdf8, nextTabIndex, (): void => {\n            this.sim.setTaxRate(this.sim.stats.taxRate - 1);\n            this.playSfx(\"road\");\n            this.refreshUi();\n        });\n        nextTabIndex += 1;\n        this.makeModalButton(\"taxPlusBtn\", \"TAX +1%\", 202, 80, 104, 26, 0x38bdf8, nextTabIndex, (): void => {\n            this.sim.setTaxRate(this.sim.stats.taxRate + 1);\n            this.playSfx(\"road\");\n            this.refreshUi();\n        });\n        nextTabIndex += 1;\n        this.makeModalButton(\"closeBudgetBtn\", \"CLOSE [B]\", 132, 204, 116, 28, 0x22c55e, nextTabIndex, (): void => {\n            this.toggleBudgetModal();\n        });\n\n        this.bindStageEvents();\n        this.refreshButtonStates();\n        this.refreshUi();\n        this.redrawWorld();\n    }\n\n    initSoundBank(): Record<string, Sound> {\n        const bank: Record<string, Sound> = {};\n        const names: [string, string][] = [\n            [\"zone\", \"sfx_zone.wav\"],\n            [\"road\", \"sfx_road.wav\"],\n            [\"bulldoze\", \"sfx_bulldoze.wav\"],\n            [\"power\", \"sfx_power.wav\"],\n            [\"boom\", \"sfx_boom.wav\"],\n        ];\n        for (let i: number = 0; i < names.length; i++) {\n            const entry: [string, string] = names[i];\n            try {\n                const snd: Sound = new Sound();\n                snd.load(new URLRequest(entry[1]));\n                bank[entry[0]] = snd;\n            } catch (_err: any) {\n                // Audio optional in headless Node environments without AudioHost\n            }\n        }\n        return bank;\n    }\n\n    playSfx(key: string): void {\n        if (!key) {\n            return;\n        }\n        const snd: Sound = this.sounds[key];\n        if (snd) {\n            try {\n                snd.play(0, 0, new SoundTransform(0.42, 0));\n            } catch (_err: any) {\n                // Ignore blocked autoplay before user gesture\n            }\n        }\n    }\n\n    makeButton(\n        id: string,\n        caption: string,\n        x: number,\n        y: number,\n        w: number,\n        h: number,\n        accent: number,\n        tabIdx: number,\n        onClick: () => void,\n    ): ButtonHandle {\n        const sp: Sprite = new Sprite();\n        sp.name = id;\n        sp.x = x;\n        sp.y = y;\n        sp.buttonMode = true;\n        sp.useHandCursor = true;\n        sp.mouseChildren = false;\n        sp.tabEnabled = true;\n        sp.tabIndex = tabIdx;\n\n        const lbl: TextField = createHudLabel(caption, 10, Math.max(2, Math.floor((h - 16) / 2)), w - 14, 18, 10, 0xf1f5f9, true, \"left\", false);\n        sp.addChild(lbl);\n\n        const handle: ButtonHandle = { id, sprite: sp, labelField: lbl, x, y, w, h, accent };\n        paintButtonChrome(handle, false);\n        sp.addEventListener(MouseEvent.CLICK, (_ev: any): void => {\n            onClick();\n        });\n        this.root.addChild(sp);\n        return handle;\n    }\n\n    makeModalButton(\n        id: string,\n        caption: string,\n        x: number,\n        y: number,\n        w: number,\n        h: number,\n        accent: number,\n        tabIdx: number,\n        onClick: () => void,\n    ): ButtonHandle {\n        const sp: Sprite = new Sprite();\n        sp.name = id;\n        sp.x = x;\n        sp.y = y;\n        sp.buttonMode = true;\n        sp.useHandCursor = true;\n        sp.mouseChildren = false;\n        sp.tabEnabled = true;\n        sp.tabIndex = tabIdx;\n\n        const lbl: TextField = createHudLabel(caption, 8, 5, w - 16, 18, 11, 0xf8fafc, true, \"center\", false);\n        sp.addChild(lbl);\n\n        const handle: ButtonHandle = { id, sprite: sp, labelField: lbl, x, y, w, h, accent };\n        paintButtonChrome(handle, true);\n        sp.addEventListener(MouseEvent.CLICK, (_ev: any): void => {\n            onClick();\n        });\n        this.modalContainer.addChild(sp);\n        return handle;\n    }\n\n    paintModalBackdrop(): void {\n        const g: any = this.modalBgSprite.graphics;\n        g.clear();\n        g.lineStyle(2, 0x38bdf8, 0.95);\n        g.beginFill(0x0f172a, 0.97);\n        g.drawRoundRect(0, 0, 380, 246, 10, 10);\n        g.endFill();\n\n        g.lineStyle(1, 0x1e293b, 1);\n        g.beginFill(0x16243d, 1);\n        g.drawRoundRect(16, 44, 348, 68, 6, 6);\n        g.endFill();\n    }\n\n    bindStageEvents(): void {\n        const stg: any = this.root.stage;\n        if (stg) {\n            stg.addEventListener(MouseEvent.MOUSE_DOWN, (ev: any): void => {\n                if (this.budgetOpen) {\n                    return;\n                }\n                const sx: number = Number(ev.stageX ?? this.root.mouseX ?? -1);\n                const sy: number = Number(ev.stageY ?? this.root.mouseY ?? -1);\n                const coord: GridCoord | null = screenToTile(sx, sy);\n                if (coord !== null) {\n                    this.draggingMap = true;\n                    this.hoveredTile = coord;\n                    this.useActiveToolAt(coord.gx, coord.gy);\n                }\n            });\n\n            stg.addEventListener(MouseEvent.MOUSE_MOVE, (ev: any): void => {\n                const sx: number = Number(ev.stageX ?? this.root.mouseX ?? -1);\n                const sy: number = Number(ev.stageY ?? this.root.mouseY ?? -1);\n                const coord: GridCoord | null = screenToTile(sx, sy);\n                const changed: boolean =\n                    (coord === null) !== (this.hoveredTile === null) ||\n                    (coord !== null &&\n                        this.hoveredTile !== null &&\n                        (coord.gx !== this.hoveredTile.gx || coord.gy !== this.hoveredTile.gy));\n                this.hoveredTile = coord;\n                if (changed) {\n                    this.updateHoverOverlay();\n                    if (this.draggingMap && !this.budgetOpen && coord !== null) {\n                        this.useActiveToolAt(coord.gx, coord.gy);\n                    } else if (coord !== null) {\n                        this.inspectTileStatus(coord.gx, coord.gy);\n                    }\n                }\n            });\n\n            stg.addEventListener(MouseEvent.MOUSE_UP, (_ev: any): void => {\n                this.draggingMap = false;\n            });\n\n            stg.addEventListener(KeyboardEvent.KEY_DOWN, (ev: any): void => {\n                this.handleKeyDown(ev);\n            });\n        }\n\n        this.root.addEventListener(Event.ENTER_FRAME, (_ev: any): void => {\n            this.onFrameTick();\n        });\n    }\n\n    handleKeyDown(ev: any): void {\n        const key: string = String(ev.key || \"\");\n        const code: number = Number(ev.keyCode || 0);\n\n        if (key >= \"1\" && key <= \"8\") {\n            const idx: number = Number(key) - 1;\n            if (idx >= 0 && idx < TOOL_CATALOG.length) {\n                this.selectTool(TOOL_CATALOG[idx].id);\n            }\n            return;\n        }\n        if (code >= 49 && code <= 56) {\n            const idx2: number = code - 49;\n            if (idx2 >= 0 && idx2 < TOOL_CATALOG.length) {\n                this.selectTool(TOOL_CATALOG[idx2].id);\n            }\n            return;\n        }\n        if (key === \" \" || code === 32) {\n            this.cycleSpeed();\n            return;\n        }\n        if (key === \"h\" || key === \"H\" || code === 72) {\n            this.cycleHeatmap();\n            return;\n        }\n        if (key === \"b\" || key === \"B\" || code === 66) {\n            this.toggleBudgetModal();\n            return;\n        }\n        if ((key === \"Escape\" || code === 27) && this.budgetOpen) {\n            this.toggleBudgetModal();\n            return;\n        }\n        if (key === \"s\" || key === \"S\" || code === 83) {\n            this.triggerStarterCity();\n        }\n    }\n\n    selectTool(id: ToolId): void {\n        this.activeTool = id;\n        const spec: ToolSpec = findToolSpec(id);\n        this.sim.stats.advisorMessage = spec.description;\n        this.playSfx(\"road\");\n        this.refreshButtonStates();\n        this.refreshUi();\n        this.updateHoverOverlay();\n    }\n\n    cycleSpeed(): SimSpeed {\n        if (this.speed === 1) {\n            this.speed = 3;\n        } else if (this.speed === 3) {\n            this.speed = 0;\n        } else {\n            this.speed = 1;\n        }\n        this.refreshButtonStates();\n        this.refreshUi();\n        return this.speed;\n    }\n\n    setHeatmap(mode: HeatmapMode): void {\n        this.heatmap = mode;\n        this.worldDirty = true;\n        this.playSfx(\"road\");\n        this.refreshButtonStates();\n        this.refreshUi();\n        this.redrawWorld();\n    }\n\n    cycleHeatmap(): HeatmapMode {\n        const order: HeatmapMode[] = [\"none\", \"power\", \"value\", \"pollution\"];\n        let nextIdx: number = 0;\n        for (let i: number = 0; i < order.length; i++) {\n            if (order[i] === this.heatmap) {\n                nextIdx = (i + 1) % order.length;\n            }\n        }\n        this.setHeatmap(order[nextIdx]);\n        return this.heatmap;\n    }\n\n    toggleBudgetModal(): boolean {\n        this.budgetOpen = !this.budgetOpen;\n        this.modalContainer.visible = this.budgetOpen;\n        this.playSfx(\"road\");\n        this.refreshButtonStates();\n        this.refreshUi();\n        return this.budgetOpen;\n    }\n\n    triggerStarterCity(): void {\n        this.sim.loadStarterCity();\n        this.worldDirty = true;\n        this.playSfx(\"boom\");\n        this.refreshUi();\n        this.redrawWorld();\n    }\n\n    useActiveToolAt(gx: number, gy: number): ToolActionResult {\n        const res: ToolActionResult = this.sim.applyTool(gx, gy, this.activeTool);\n        if (res.ok) {\n            this.worldDirty = true;\n            this.playSfx(res.sfx);\n            this.redrawWorld();\n        }\n        this.refreshUi();\n        this.updateHoverOverlay();\n        return res;\n    }\n\n    inspectTileStatus(gx: number, gy: number): void {\n        if (!this.sim.grid.inBounds(gx, gy)) {\n            return;\n        }\n        const c: TileCell = this.sim.grid.get(gx, gy);\n        const pwrText: string = c.powered ? \"Powered\" : \"Unpowered\";\n        const lvText: string = c.level > 0 ? \" Lv.\" + String(c.level) : \"\";\n        this.statusField.text =\n            \"Parcel (\" +\n            String(gx) +\n            \", \" +\n            String(gy) +\n            \"): \" +\n            c.kind.toUpperCase() +\n            lvText +\n            \" · \" +\n            pwrText +\n            \" · LandVal \" +\n            String(c.landValue) +\n            \" · Smog \" +\n            String(c.pollution);\n    }\n\n    stepTicks(count: number): void {\n        let boomed: boolean = false;\n        for (let i: number = 0; i < count; i++) {\n            this.animFrame += 1;\n            if (this.sim.stepSimulationTick()) {\n                boomed = true;\n            }\n        }\n        if (boomed) {\n            this.playSfx(\"boom\");\n        }\n        this.worldDirty = true;\n        this.refreshUi();\n        this.redrawWorld();\n    }\n\n    onFrameTick(): void {\n        this.animFrame += 1;\n        if (this.speed > 0) {\n            let boomed: boolean = false;\n            for (let s: number = 0; s < this.speed; s++) {\n                if (this.sim.stepSimulationTick()) {\n                    boomed = true;\n                }\n            }\n            if (boomed) {\n                this.playSfx(\"boom\");\n            }\n            if (this.animFrame % 2 === 0 || this.worldDirty) {\n                this.redrawWorld();\n                this.refreshUi();\n            }\n        } else if (this.worldDirty) {\n            this.redrawWorld();\n            this.refreshUi();\n        }\n    }\n\n    refreshButtonStates(): void {\n        for (let i: number = 0; i < this.toolButtons.length; i++) {\n            const tb: ButtonHandle = this.toolButtons[i];\n            paintButtonChrome(tb, TOOL_CATALOG[i].id === this.activeTool);\n        }\n        const hmModes: HeatmapMode[] = [\"none\", \"power\", \"value\", \"pollution\"];\n        for (let i: number = 0; i < this.heatmapButtons.length; i++) {\n            paintButtonChrome(this.heatmapButtons[i], hmModes[i] === this.heatmap);\n        }\n        const speedLabel: string = this.speed === 0 ? \"PAUSED\" : this.speed === 3 ? \"3x FAST\" : \"1x RUN\";\n        this.speedButton.labelField.text = speedLabel;\n        paintButtonChrome(this.speedButton, this.speed > 0);\n        paintButtonChrome(this.budgetButton, this.budgetOpen);\n    }\n\n    renderRciBars(): void {\n        const g: any = this.rciSprite.graphics;\n        g.clear();\n        g.lineStyle(1, 0x334155, 1);\n        g.beginFill(0x111e33, 1);\n        g.drawRoundRect(0, 0, 156, 74, 6, 6);\n        g.endFill();\n\n        // Zero baseline at x = 78\n        g.lineStyle(1, 0x64748b, 0.8);\n        g.moveTo(78, 22);\n        g.lineTo(78, 56);\n        g.lineStyle(NaN);\n\n        const bars: [number, number, number][] = [\n            [25, this.sim.stats.demand.residential, 0x22c55e],\n            [36, this.sim.stats.demand.commercial, 0x3b82f6],\n            [47, this.sim.stats.demand.industrial, 0xf59e0b],\n        ];\n        for (let i: number = 0; i < bars.length; i++) {\n            const b: [number, number, number] = bars[i];\n            const val: number = b[1];\n            const barW: number = Math.max(2, Math.round((Math.abs(val) / 100) * 62));\n            const startX: number = val >= 0 ? 78 : 78 - barW;\n            g.beginFill(b[2], 0.95);\n            g.drawRoundRect(startX, b[0], barW, 7, 2, 2);\n            g.endFill();\n        }\n    }\n\n    refreshUi(): void {\n        const st = this.sim.stats;\n        this.fundsField.text = \"FUNDS \" + formatMoney(st.funds);\n        this.popField.text = \"POP \" + String(st.population);\n        const spdTag: string = this.speed === 0 ? \"PAUSE\" : String(this.speed) + \"x\";\n        this.dateField.text = monthAbbrev(st.month) + \" \" + String(st.year) + \" · \" + spdTag;\n        this.powerField.text =\n            \"GRID: \" + String(st.powerUsedMw) + \" / \" + String(st.powerCapacityMw) + \" MW\";\n\n        let hmName: string = \"VIEW: NORMAL TERRAIN\";\n        if (this.heatmap === \"power\") {\n            hmName = \"VIEW: POWER GRID BFS\";\n        } else if (this.heatmap === \"value\") {\n            hmName = \"VIEW: LAND VALUE\";\n        } else if (this.heatmap === \"pollution\") {\n            hmName = \"VIEW: SMOG & POLLUTION\";\n        }\n        this.overlayBadgeField.text = hmName;\n\n        const rSign: string = st.demand.residential >= 0 ? \"+\" : \"\";\n        const cSign: string = st.demand.commercial >= 0 ? \"+\" : \"\";\n        const iSign: string = st.demand.industrial >= 0 ? \"+\" : \"\";\n        this.rciValueField.text =\n            \"R \" +\n            rSign +\n            String(st.demand.residential) +\n            \"  C \" +\n            cSign +\n            String(st.demand.commercial) +\n            \"  I \" +\n            iSign +\n            String(st.demand.industrial);\n\n        if (this.hoveredTile === null) {\n            this.statusField.text = st.advisorMessage;\n        }\n\n        this.renderRciBars();\n\n        if (this.budgetOpen) {\n            const b: BudgetSummary = st.lastBudget;\n            const totalMaint: number = b.roadMaintenance + b.powerMaintenance + b.parkMaintenance;\n            this.modalTaxField.text = \"Property & Civic Tax Rate: \" + String(b.taxRate) + \"%\";\n            this.modalRevField.text = \"Projected Tax Revenue: +\" + formatMoney(b.taxRevenue) + \" / yr\";\n            this.modalMaintField.text = \"Road, Power & Park Upkeep: -\" + formatMoney(totalMaint) + \" / yr\";\n            const netSign: string = b.netCashflow >= 0 ? \"+\" : \"\";\n            this.modalNetField.text = \"Net Annual Cashflow: \" + netSign + formatMoney(b.netCashflow) + \" / yr\";\n        }\n    }\n\n    updateHoverOverlay(): void {\n        const spec: ToolSpec = findToolSpec(this.activeTool);\n        const canAfford: boolean = this.sim.stats.funds >= spec.cost;\n        renderHoverCursor(this.hoverSprite, this.hoveredTile, this.activeTool, canAfford);\n    }\n\n    redrawWorld(): void {\n        renderIsometricWorld(this.worldSprite, this.sim, this.heatmap, this.animFrame);\n        this.worldDirty = false;\n    }\n\n    tileCenter(gx: number, gy: number): IsoPoint {\n        return tileCenterScreen(gx, gy);\n    }\n}\n"
    }
  ],
