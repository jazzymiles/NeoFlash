        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "type_script",
              "source": "import { MicropolisApp } from \"./city/ui_controller\";\nimport type { HeatmapMode, IsoPoint, ToolActionResult, ToolId } from \"./city/types\";\n\nstop();\n\nconst app: MicropolisApp = new MicropolisApp(this);\nthis.cityApp = app;\nthis.selectTool = (tool: ToolId): void => {\n    app.selectTool(tool);\n};\nthis.applyToolAt = (gx: number, gy: number): ToolActionResult => {\n    return app.useActiveToolAt(gx, gy);\n};\nthis.loadStarterCity = (): void => {\n    app.triggerStarterCity();\n};\nthis.stepTicks = (count: number): void => {\n    app.stepTicks(count);\n};\nthis.cycleHeatmap = (): HeatmapMode => {\n    return app.cycleHeatmap();\n};\nthis.toggleBudgetModal = (): boolean => {\n    return app.toggleBudgetModal();\n};\nthis.tileScreenCenter = (gx: number, gy: number): IsoPoint => {\n    return app.tileCenter(gx, gy);\n};\nthis.getCitySummary = (): any => {\n    return {\n        funds: app.sim.stats.funds,\n        population: app.sim.stats.population,\n        year: app.sim.stats.year,\n        month: app.sim.stats.month,\n        poweredTiles: app.sim.stats.poweredTiles,\n        developedBuildings: app.sim.stats.developedBuildings,\n        zonedTiles: app.sim.stats.zonedTiles,\n        plantCount: app.sim.stats.plantCount,\n        roadCount: app.sim.stats.roadCount,\n        heatmap: app.heatmap,\n        budgetOpen: app.budgetOpen,\n        activeTool: app.activeTool,\n        speed: app.speed,\n    };\n};\n\ntrace(\"MICROPOLIS_READY=1\");\n"
            }
          }
        ]
      }
