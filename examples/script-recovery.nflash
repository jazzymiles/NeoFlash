            "visible": true,
            "locked": false,
            "keyframes": [
              {
                "frame": 0,
                "elements": [
                  {
                    "id": "as3-card",
                    "name": "as3-card",
                    "transform": {
                      "x": 60.0,
                      "y": 220.0,
                      "scale_x": 1.0,
                      "scale_y": 1.0,
                      "rotation": 0.0,
                      "alpha": 1.0
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "card",
                      "playback": "independent"
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "var attempts:int;\nvar cleanups:int;\nfunction outcome(step:int):String {\n  switch (step % 3) {\n    case 1: throw new RangeError(\"Try again\", 17);\n    case 2: return \"Accepted\";\n    default: return \"Ready\";\n  }\n}\nattempts++;\nvar result:String;\ntry {\n  result = outcome(attempts);\n} catch (problem:RangeError) {\n  result = problem.message;\n} finally {\n  cleanups++;\n}\ntrace(\"AS3\", result, \"cleanup\", cleanups);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS3 recovery",
                      "description": "Cycles through Try again, Accepted and Ready. Cleanup runs after each activation.",
                      "role": "button",
                      "tab_order": 10,
                      "disabled": false
                    }
                  },
                  {
                    "id": "as2-card",
                    "name": "as2-card",
                    "transform": {
                      "x": 500.0,
                      "y": 220.0,
                      "scale_x": 1.0,
                      "scale_y": 1.0,
                      "rotation": 0.0,
                      "alpha": 1.0
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "card",
                      "playback": "independent"
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "var attempts;\nvar cleanups;\nif (attempts == undefined) attempts = 0;\nif (cleanups == undefined) cleanups = 0;\nfunction outcome(step:Number):String {\n  switch (step % 3) {\n    case 1: throw \"Try again\";\n    case 2: return \"Accepted\";\n    default: return \"Ready\";\n  }\n}\nattempts++;\nvar result;\ntry {\n  result = outcome(attempts);\n} catch (problem) {\n  result = problem;\n} finally {\n  cleanups++;\n}\ntrace(\"AS2\", result, \"cleanup\", cleanups);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS2 recovery",
                      "description": "Cycles through Try again, Accepted and Ready. Cleanup runs after each activation.",
                      "role": "button",
                      "tab_order": 20,
                      "disabled": false
                    }
                  }
                ],
                "tween": null,
                "label": ""
              }
            ]
          }
        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script3",
              "source": "stop(); trace(\"Choose AS3 or AS2. Each card starts at Try again.\");"
            }
          }
        ]
