            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "stop();\nvar connectionChecks:Number=0;\nvar connectionFailures:Number=0;\nvar peerReceived:Number=0;\nvar peerLabel:String=\"unbound\";\nfunction connectionCheck(label:String,ok:Boolean):Void {\n if(ok)connectionChecks++;else connectionFailures++;\n connectionDetails.text+=(ok?\"PASS  \":\"FAIL  \")+label+\"\\n\";\n connectionSummary.text=\"AS2_CONNECTIONS_RESULT \"+connectionChecks+\" passed / \"+connectionFailures+\" failed\";\n trace(\"AS2_CONNECTIONS \"+label+\" \"+ok);\n}\nvar numberBox:Object=new Number(\"42\");\nvar sameNumber:Object=numberBox;\nnumberBox.label=\"boxed\";\nconnectionCheck(\"Number box identity/value/arithmetic\",typeof(numberBox)==\"object\"&&numberBox==sameNumber&&numberBox!==new Number(42)&&numberBox.valueOf()==42&&numberBox.toString()==\"42\"&&numberBox+8==50&&numberBox.label==\"boxed\");\nvar booleanBox:Object=new Boolean(false);\nconnectionCheck(\"Boolean box keeps object truthiness\",typeof(booleanBox)==\"object\"&&!booleanBox.valueOf()&&booleanBox.toString()==\"false\"&&Boolean(booleanBox)&&new Boolean(booleanBox).valueOf());\nvar stringBox:Object=new String(\"Rust 😀\");\nconnectionCheck(\"String box uses Rust UTF16 methods\",typeof(stringBox)==\"object\"&&stringBox.length==7&&stringBox.substring(0,4)==\"Rust\"&&stringBox.toUpperCase()==\"RUST 😀\"&&stringBox.valueOf()==\"Rust 😀\");\nconnectionCheck(\"Box defaults and primitive-box conversion\",new Number().valueOf()==0&&!new Boolean().valueOf()&&new String().valueOf()==\"\"&&new Number(new String(\"42\")).valueOf()==42);\nvar selfReceiver:LocalConnection=new LocalConnection();\nvar messageSender:LocalConnection=new LocalConnection();\nselfReceiver.isPerUser=true;\nconnectionCheck(\"origin domain + browser-user scope\",selfReceiver.domain().length>0&&selfReceiver.isPerUser);\nvar selfName:String=\"_neoflash_self_\"+getTimer()+\"_\"+Math.floor(Math.random()*100000000);\nvar selfAck:Boolean=false;\nselfReceiver.receiveBatch=function(label:String,payload:Object):Void {\n connectionCheck(\"real AMF message preserves values/references\",label==\"Rust → HTML5\"&&payload.count==7&&payload.left==payload.right&&payload.self==payload);\n};\nmessageSender.onStatus=function(info:Object):Void {\n if(info.operation==\"send\"&&!selfAck){selfAck=true;connectionCheck(\"LocalConnection delivery acknowledgement\",info.level==\"status\");}\n else peerStatus.text=\"Sender status: \"+info.level+\" / \"+info.operation;\n};\nselfReceiver.onStatus=function(info:Object):Void {\n if(info.operation==\"connect\"&&info.level==\"status\"){\n  var shared:Object={value:\"shared\"};var payload:Object={count:7,left:shared,right:shared};payload.self=payload;\n  connectionCheck(\"send accepts a bounded AMF command\",messageSender.send(selfName,\"receiveBatch\",\"Rust → HTML5\",payload));\n }else if(info.operation==\"connect\")connectionCheck(\"self receiver reservation\",false);\n};\nvar acceptedLocal:Boolean=selfReceiver.connect(selfName);\nvar duplicateLocal:LocalConnection=new LocalConnection();\nconnectionCheck(\"local name reservation rejects duplicate\",acceptedLocal&&!duplicateLocal.connect(selfName));\nvar peerConnection:LocalConnection=new LocalConnection();\npeerConnection.receivePeer=function(label:String,payload:Object):Void {\n peerReceived++;\n peerStatus.text=\"PEER_RECEIVED \"+peerReceived+\" | \"+label+\" | sender \"+payload.sender+\" | AMF value \"+payload.value;\n trace(\"AS2_CONNECTIONS_PEER \"+peerLabel+\" \"+peerReceived+\" \"+label);\n};\npeerConnection.onStatus=function(info:Object):Void {\n if(info.operation==\"connect\")peerStatus.text=\"PEER_\"+(info.level==\"status\"?\"READY\":\"DENIED\")+\" \"+peerLabel+\" | \"+info.description;\n else peerStatus.text=\"Peer send status \"+info.level;\n};\nfunction listenPeerA():Void {peerConnection.close();peerLabel=\"A\";peerStatus.text=\"Claiming receiver A...\";if(!peerConnection.connect(\"neoflash_as2_peer_a\"))peerStatus.text=\"Receiver A request rejected\";}\nfunction listenPeerB():Void {peerConnection.close();peerLabel=\"B\";peerStatus.text=\"Claiming receiver B...\";if(!peerConnection.connect(\"neoflash_as2_peer_b\"))peerStatus.text=\"Receiver B request rejected\";}\nfunction sendPeerA():Void {messageSender.send(\"neoflash_as2_peer_a\",\"receivePeer\",\"hello A\",{sender:peerLabel,value:42});}\nfunction sendPeerB():Void {messageSender.send(\"neoflash_as2_peer_b\",\"receivePeer\",\"hello B\",{sender:peerLabel,value:43});}\nfunction closePeer():Void {peerConnection.close();peerStatus.text=\"PEER_CLOSED \"+peerLabel;}\nvar remotingStarted:Boolean=false;\nfunction runRemotingBatch():Void {\n if(remotingStarted)return;remotingStarted=true;\n var remote:NetConnection=new NetConnection();\n remote.onStatus=function(info:Object):Void {if(info.code==\"NetConnection.Connect.Closed\")return;connectionCheck(\"unexpected transport error: \"+info.description,false);};\n var accepted:Boolean=remote.connect(\"/__as2_amf\");\n connectionCheck(\"HTTP endpoint configured without RTMP claim\",accepted&&!remote.isConnected&&remote.uri.indexOf(\"/__as2_amf\")>=0);\n var completions:Number=0;\n var returned:Object={onResult:function(value:Object):Void {\n  connectionCheck(\"real AMF HTTP response + reference identity\",value[0]==\"Rust AMF\"&&value[1]==42&&value[2]==value[3]&&value[2].self==value[2]&&value[2].source==\"browser\");\n  completions++;\n  if(completions==2){remote.close();connectionCheck(\"remote close clears endpoint\",!remote.isConnected&&remote.uri==undefined);}\n },onStatus:function(value:Object):Void {connectionCheck(\"unexpected AMF fault\",false);}};\n var payload:Object={source:\"browser\"};payload.self=payload;\n remote.call(\"demo.echo\",returned,\"Rust AMF\",42,payload,payload);\n var faultResult:Object={onResult:function(value:Object):Void{connectionCheck(\"server fault must not become result\",false);},onStatus:function(value:Object):Void{\n  connectionCheck(\"real AMF server status responder\",value.code==\"Demo.Rejected\"&&value.level==\"error\");\n  completions++;\n  if(completions==2){remote.close();connectionCheck(\"remote close clears endpoint\",!remote.isConnected&&remote.uri==undefined);}\n }};\n remote.call(\"demo.fail\",faultResult,\"deliberate\");\n}\n"
            }
          }
        ]
      }
