  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\nimport flash.display.MovieClip;\nimport flash.display.Sprite;\nimport flash.events.MouseEvent;\nimport flash.geom.Point;\nimport flash.geom.Rectangle;\npublic dynamic class Main extends MovieClip {\n    public var card:MovieClip;\n    public var pickArea:Sprite;\n    public var dragging:Boolean=false;\n    public var mode:int=0;\n    public var presses:int=0;\n    public var releases:int=0;\n    public var moves:int=0;\n    public var collisions:int=0;\n    public var lastTarget:String=\"none\";\n    public var lastDrop:String=\"none\";\n    public var lastHit:Boolean=false;\n    public var shapeHit:Boolean=false;\n    public var localPressX:Number=0;\n    public var localPressY:Number=0;\n    public var legacyPresses:int=0;\n    public var legacyReleases:int=0;\n    public var legacyOutside:int=0;\n    public var legacyOver:int=0;\n    public var legacyOut:int=0;\n    public var legacyHit:Boolean=false;\n    public var legacyDrop:String=\"\";\n    public var legacyState:String=\"Ready\";\n    public function Main(){\n        stop(); card=as3Rig.card;\n        title.selectable=false; eyebrow.selectable=false; instructions.selectable=false;\n        label3.selectable=false; label2.selectable=false; status3.selectable=false; status2.selectable=false; footer.selectable=false;\n        modeButton.caption.selectable=false; resetButton.caption.selectable=false; resetButton.caption.text=\"Reset positions\";\n        as3Rig.note.selectable=false; legacyRig.note.selectable=false;\n        as3Rig.dock.caption.selectable=false; as3Rig.dock.caption.mouseEnabled=false;\n        legacyRig.dock.caption.selectable=false; legacyRig.dock.caption.mouseEnabled=false; legacyRig.dock.mouseChildren=false;\n        card.caption.selectable=false; card.caption.mouseEnabled=false;\n        legacyRig.card.caption.selectable=false;\n        card.buttonMode=true; card.useHandCursor=true; card.mouseChildren=false;\n        as3Rig.dock.mouseChildren=false;\n        pickArea=card.invisibleHitArea; pickArea.mouseEnabled=false; pickArea.visible=false; card.hitArea=pickArea;\n        card.addEventListener(MouseEvent.MOUSE_DOWN,beginDrag);\n        stage.addEventListener(MouseEvent.MOUSE_MOVE,moveDrag);\n        stage.addEventListener(MouseEvent.MOUSE_UP,endDrag);\n        refresh(); refreshLegacy();\n    }\n    public function beginDrag(event:MouseEvent):void{\n        presses++; lastTarget=event.target.name; localPressX=card.mouseX; localPressY=card.mouseY;\n        dragging=true; card.startDrag(false,new Rectangle(20,20,230,125)); refresh();\n    }\n    public function moveDrag(event:MouseEvent):void{if(dragging){moves++;refresh();}}\n    public function endDrag(event:MouseEvent):void{\n        if(!dragging)return;\n        card.stopDrag(); dragging=false; releases++;\n        lastHit=card.hitTestObject(as3Rig.dock);\n        shapeHit=as3Rig.dock.hitTestPoint(event.stageX,event.stageY,true);\n        if(lastHit)collisions++;\n        lastDrop=card.dropTarget==null?\"none\":card.dropTarget.name;\n        refresh();\n    }\n    public function changeMode():void{\n        mode=(mode+1)%3; card.mouseChildren=mode==1; card.mouseEnabled=mode!=2;\n        if(mode==2){card.stopDrag();dragging=false;}\n        refresh();\n    }\n    public function resetCards():void{\n        card.stopDrag();dragging=false;card.x=20;card.y=20;mode=0;card.mouseChildren=false;card.mouseEnabled=true;\n        lastDrop=\"none\";lastHit=false;shapeHit=false;refresh();\n    }\n    public function refresh():void{\n        var state:String=mode==0?\"GROUP target\":(mode==1?\"CHILD targets\":\"CARD disabled\");\n        status3.text=state+\" | \"+(dragging?\"dragging\":\"ready\")+\"\\n\"+\n          \"position \"+Math.round(card.x)+\", \"+Math.round(card.y)+\" | press/release \"+presses+\"/\"+releases+\"\\n\"+\n          \"target \"+lastTarget+\" | local \"+Math.round(localPressX)+\", \"+Math.round(localPressY)+\"\\n\"+\n          \"bbox hit \"+lastHit+\" | point hit \"+shapeHit+\" | drop \"+lastDrop;\n        modeButton.caption.text=\"Target mode: \"+mode;\n    }\n    public function refreshLegacy():void{\n        status2.text=legacyState+\" | press/release \"+legacyPresses+\"/\"+legacyReleases+\"\\n\"+\n          \"outside releases \"+legacyOutside+\" | roll in/out \"+legacyOver+\"/\"+legacyOut+\"\\n\"+\n          \"bbox hit \"+legacyHit+\" | drop \"+legacyDrop;\n    }\n}\n}"
    }
  ]
}
