              "source": "stop();\ncard.useHandCursor=true;\ncard.onPress=function():Void{this.startDrag(false,20,20,250,145);_root.legacyPresses++;_root.legacyState=\"Dragging\";_root.refreshLegacy();};\ncard.onRelease=function():Void{this.stopDrag();_root.legacyReleases++;_root.legacyHit=this.hitTest(this._parent.dock);_root.legacyDrop=this._droptarget;_root.legacyState=\"Released\";_root.refreshLegacy();};\ncard.onReleaseOutside=function():Void{this.stopDrag();_root.legacyOutside++;_root.legacyHit=this.hitTest(this._parent.dock);_root.legacyDrop=this._droptarget;_root.legacyState=\"Released outside\";_root.refreshLegacy();};\ncard.onRollOver=function():Void{_root.legacyOver++;_root.refreshLegacy();};\ncard.onRollOut=function():Void{_root.legacyOut++;_root.refreshLegacy();};\n"
            }
          }
        ]
