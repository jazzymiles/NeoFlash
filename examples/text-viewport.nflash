    {
      "id": "legacy-panel-symbol",
      "name": "AS2 catalog",
      "kind": "movie_clip",
      "timeline": {
        "frame_count": 1,
        "layers": [
          {
            "id": "legacy-panel-symbol-layer",
            "name": "Content",
