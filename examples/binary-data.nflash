  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n  import flash.display.MovieClip;\n  import flash.utils.ByteArray;\n  import flash.utils.Endian;\n  public class Main extends MovieClip {\n    public var packet:ByteArray;\n    public var decoded:ByteArray;\n    public var result:String;\n    public var packetBytes:uint;\n    public function Main() {\n      super();\n      stop();\n      packet = new ByteArray();\n      packet.writeUnsignedInt(0x4e464231);\n      packet.endian = Endian.LITTLE_ENDIAN;\n      packet.writeBoolean(true);\n      packet.writeByte(-7);\n      packet.writeShort(-1024);\n      packet.writeInt(-1234567);\n      packet.writeUnsignedInt(0xfedcba98);\n      packet.writeFloat(1.25);\n      packet.writeDouble(3.141592653589793);\n      packet.writeUTF(\"NeoFlash π 🦀\");\n      packet.writeUTFBytes(\"done\");\n      packetBytes = packet.length;\n      var wire:ByteArray = new ByteArray();\n      wire.position = 3;\n      wire.writeBytes(packet);\n      wire.position = 3;\n      decoded = new ByteArray();\n      decoded.position = 7;\n      wire.readBytes(decoded, 0, packetBytes);\n      var copyPosition:uint = decoded.position;\n      decoded.position = 0;\n      var magic:uint = decoded.readUnsignedInt();\n      decoded.endian = Endian.LITTLE_ENDIAN;\n      var active:Boolean = decoded.readBoolean();\n      var small:int = decoded.readByte();\n      var shortValue:int = decoded.readShort();\n      var signedValue:int = decoded.readInt();\n      var unsignedValue:uint = decoded.readUnsignedInt();\n      var fraction:Number = decoded.readFloat();\n      var precise:Number = decoded.readDouble();\n      var label:String = decoded.readUTF();\n      var tail:String = decoded.readUTFBytes(4);\n      result = label + \" / \" + tail;\n      status.text = result;\n      measurements.text = \"Values: \" + active + \", \" + small + \", \" + shortValue + \", \" + signedValue + \", \" + unsignedValue + \", \" + fraction;\n      packetInfo.text = \"Packet: \" + packetBytes + \" bytes | header: \" + packet[0] + \", \" + packet[1] + \", \" + packet[2] + \", \" + packet[3];\n      lifecycle.text = \"Copy kept destination position \" + copyPosition + \" | remaining bytes \" + decoded.bytesAvailable;\n      wire.clear();\n      trace(\"binary values\", magic, active, small, shortValue, signedValue, unsignedValue, fraction, precise);\n      trace(\"binary ready\", packetBytes, result, decoded.bytesAvailable, wire.length);\n    }\n  }\n}\n"
    }
  ]
}
