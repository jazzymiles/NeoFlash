  "sources": [
    {
      "id": "source-0",
      "path": "app/SharedState.as",
      "language": "action_script3",
      "source": "package app {\n  public class SharedState {\n    public static var instances:int = 0;\n    public static var clicks:int = 0;\n  }\n}"
    },
    {
      "id": "source-1",
      "path": "app/Widget.as",
      "language": "action_script3",
      "source": "package app {\n  import flash.display.MovieClip;\n  import flash.events.Event;\n  import flash.events.MouseEvent;\n  import app.SharedState;\n  public class Widget extends MovieClip {\n    public var count:int = 0;\n    public var ticks:uint = 0;\n    public var homeX:Number;\n    public function Widget() {\n      super();\n      homeX = x;\n      SharedState.instances++;\n      addEventListener(MouseEvent.CLICK, clicked);\n      addEventListener(Event.ENTER_FRAME, advanced);\n    }\n    public function clicked(e:MouseEvent):void {\n      count++;\n      SharedState.clicks++;\n      x += 6;\n      trace(\"component click\", name, count, SharedState.clicks);\n    }\n    public function advanced(e:Event):void {\n      ticks++;\n      rotation += 0.15;\n    }\n    public function reset():void {\n      count = 0;\n      x = homeX;\n      rotation = 0;\n    }\n  }\n}"
    },
    {
      "id": "source-2",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n  import flash.display.MovieClip;\n  import flash.events.Event;\n  import flash.events.KeyboardEvent;\n  import app.Widget;\n  import app.SharedState;\n  public class Main extends MovieClip {\n    public var left:Widget;\n    public var right:Widget;\n    public function Main() {\n      super();\n      stop();\n      left = Widget(getChildByName(\"left\"));\n      right = Widget(getChildByName(\"right\"));\n      stage.addEventListener(KeyboardEvent.KEY_DOWN, keyPressed);\n      stage.addEventListener(Event.RESIZE, resized);\n      trace(\"project ready\", SharedState.instances, left.count, right.count);\n    }\n    public function keyPressed(e:KeyboardEvent):void {\n      if (e.keyCode == 32) {\n        left.reset();\n        right.reset();\n        trace(\"reset components\", left.count, right.count, SharedState.clicks);\n        e.preventDefault();\n      }\n    }\n    public function resized(e:Event):void {\n      trace(\"stage resize\", stage.stageWidth, stage.stageHeight);\n    }\n  }\n}"
    }
  ]
}
