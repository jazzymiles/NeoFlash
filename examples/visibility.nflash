                  {
                    "id": "legacy",
                    "name": "legacy",
                    "transform": {
                      "x": 80,
                      "y": 136,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "card",
                      "playback": "independent"
                    },
                    "scripts": [
                      {
                        "event": "load",
                        "script": {
                          "language": "action_script2",
                          "source": "ticks = 0; clicks = 0; loads = 0;"
                        }
                      },
                      {
                        "event": "enter_frame",
                        "script": {
                          "language": "action_script2",
                          "source": "ticks += 1;"
                        }
                      },
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "clicks += 1; trace(\"AS2 card\", clicks, \"ticks\", ticks);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS2 card",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "modern",
                    "name": "modern",
                    "transform": {
                      "x": 440,
                      "y": 136,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "card",
                      "playback": "independent"
                    },
                    "scripts": [
                      {
                        "event": "load",
                        "script": {
                          "language": "action_script3",
                          "source": "this.ticks = 0; this.clicks = 0; this.loads = 0;"
                        }
                      },
                      {
                        "event": "enter_frame",
                        "script": {
                          "language": "action_script3",
                          "source": "this.ticks += 1;"
                        }
                      },
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "this.clicks += 1; trace(\"AS3 card\", this.clicks, \"ticks\", this.ticks);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS3 card",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "hide-as2",
                    "name": "hide-as2",
                    "transform": {
                      "x": 56,
                      "y": 292,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "hide-as2-symbol",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "var card = _root.legacy; card._visible = false; trace(\"AS2 hidden\", card._visible, \"ticks\", card.ticks, \"frame\", card._currentframe, \"loads\", card.loads, \"clicks\", card.clicks);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Hide AS2",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "show-as2",
                    "name": "show-as2",
                    "transform": {
                      "x": 228,
                      "y": 292,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "show-as2-symbol",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "var card = _root.legacy; card._visible = true; trace(\"AS2 shown\", card._visible, \"ticks\", card.ticks, \"frame\", card._currentframe, \"loads\", card.loads, \"clicks\", card.clicks);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Show AS2",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "hide-as3",
                    "name": "hide-as3",
                    "transform": {
                      "x": 400,
                      "y": 292,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "hide-as3-symbol",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "var card = this.root.modern; card.visible = false; trace(\"AS3 hidden\", card.visible, \"ticks\", card.ticks, \"frame\", card.currentFrame, \"loads\", card.loads, \"clicks\", card.clicks);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Hide AS3",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "show-as3",
                    "name": "show-as3",
                    "transform": {
                      "x": 572,
                      "y": 292,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "show-as3-symbol",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "var card = this.root.modern; card.visible = true; trace(\"AS3 shown\", card.visible, \"ticks\", card.ticks, \"frame\", card.currentFrame, \"loads\", card.loads, \"clicks\", card.clicks);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Show AS3",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "create-children",
                    "name": "create-children",
                    "transform": {
                      "x": 56,
                      "y": 346,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "create-children-symbol",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "this.root.legacy.gotoAndStop(1); this.root.modern.gotoAndStop(1); this.root.legacy.gotoAndStop(61); this.root.modern.gotoAndStop(61); trace(\"children requested\");"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Create children",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "inspect",
                    "name": "inspect",
                    "transform": {
                      "x": 228,
                      "y": 346,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "inspect-symbol",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "trace(\"state\", this.root.legacy._visible, this.root.modern.visible, \"ticks\", this.root.legacy.ticks, this.root.modern.ticks, \"frames\", this.root.legacy.currentFrame, this.root.modern.currentFrame, \"loads\", this.root.legacy.loads, this.root.modern.loads, \"child\", this.root.modern.face.visible);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Inspect state",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "show-all",
                    "name": "show-all",
                    "transform": {
                      "x": 400,
                      "y": 346,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "show-all-symbol",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "this.root.legacy.visible = true; this.root.modern.visible = true; this.root.modern.face.visible = true; trace(\"all shown\");"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Show all",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "child-toggle",
                    "name": "child-toggle",
                    "transform": {
                      "x": 572,
                      "y": 346,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "child-toggle-symbol",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "var face = this.root.modern.face; face.visible = !face.visible; trace(\"child local\", face.visible, \"parent local\", this.root.modern.visible);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Toggle AS3 face",
                      "role": "button",
                      "description": "",
                      "tab_order": 0,
                      "disabled": false
                    }
