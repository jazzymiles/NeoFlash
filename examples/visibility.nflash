                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "text",
                      "text": "Create children seeks both clips through frames 1 and 61, then stops their frame clocks.",
                      "font_family": "Arial",
                      "font_size": 13,
                      "color": [
                        232,
