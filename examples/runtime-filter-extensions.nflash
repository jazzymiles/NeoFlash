        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.filters.ConvolutionFilter;import flash.filters.BevelFilter;import flash.filters.GradientGlowFilter;import flash.filters.GradientBevelFilter;\nthis.legacyCard=createEmptyMovieClip(\"legacyCard\",getNextHighestDepth());this.legacyCard._x=60;this.legacyCard._y=518;this.legacyCard.beginFill(0x54b7a5,100);this.legacyCard.moveTo(0,0);this.legacyCard.lineTo(918,0);this.legacyCard.lineTo(918,42);this.legacyCard.lineTo(0,42);this.legacyCard.lineTo(0,0);this.legacyCard.endFill();\nthis.legacyClicks=0;this.legacyCard.onPress=function(){_root.legacyClicks++;_root.legacyReport.text=\"AS2 clicks \"+_root.legacyClicks;trace(\"filter extension AS2 click\",_root.legacyClicks);};\nvar c=new ConvolutionFilter(1,1,[1],1,0,true,true,0,0);var b=new BevelFilter();var g=new GradientGlowFilter(0,0,[0,0xffffff],[0,1],[0,255]);var v=new GradientBevelFilter(4,45,[0,0,0xffffff],[1,0,1],[0,128,255]);\nthis.legacyChecks=c.clone().matrix[0]==1&&b.clone().highlightColor==0xffffff&&g.clone().ratios[1]==255&&v.clone().type==\"inner\";\nthis.applyLegacy=function(value:Number){if(value==2){this.legacyCard.filters=[];}else if(value==0){this.legacyCard.filters=[new BevelFilter(4,45,0xeafff7,1,0x174134,1,4,4,1.5,2,\"inner\",false),new ConvolutionFilter(1,1,[1],1,3,true,true,0,0)];}else{this.legacyCard.filters=[new GradientGlowFilter(0,0,[0,0x87ffe2],[0,1],[0,255],12,12,2,2,\"outer\",false),new GradientBevelFilter(4,135,[0x14263c,0,0xffffcc],[1,0,1],[0,128,255],4,4,2,1,\"inner\",false)];}this.legacyReport.text=\"AS2 four-class clones \"+this.legacyChecks+\" / phase \"+value+\" / filters \"+this.legacyCard.filters.length;};this.applyLegacy(0);trace(\"filter extensions AS2\",this.legacyChecks);"
            }
          }
        ]
      }
    },
