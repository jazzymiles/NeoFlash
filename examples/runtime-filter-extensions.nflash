  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;import flash.display.Sprite;import flash.display.Shape;import flash.display.Bitmap;import flash.display.BitmapData;\n import flash.geom.Rectangle;import flash.geom.Point;\n import flash.text.TextField;import flash.text.TextFormat;import flash.events.MouseEvent;\n import flash.filters.BitmapFilter;import flash.filters.ConvolutionFilter;import flash.filters.BevelFilter;import flash.filters.GradientGlowFilter;import flash.filters.GradientBevelFilter;import flash.filters.BitmapFilterType;\n public dynamic class Main extends MovieClip {\n  public var cards:Array=[];public var phase:int=0;public var clicks:int=0;public var shared:BitmapData;public var checks:int=0;public var total:int=0;public var copySafe:Boolean=false;\n  public function Main(){super();stop();shared=new BitmapData(12,12,true,0);for(var y:int=0;y<12;y++){for(var x:int=0;x<12;x++){shared.setPixel32(x,y,(x+y)%2==0?0xfff4bd4f:0xff4978df);}}\n   cards.push(makeCard(\"convolutionCard\",60));cards.push(makeCard(\"bevelCard\",310));cards.push(makeCard(\"gradientGlowCard\",560));cards.push(makeCard(\"gradientBevelCard\",810));verifyFamily();apply();trace(\"filter extensions AS3\",checks,total,47,copySafe);\n  }\n  public function check(value:Boolean):void{total++;if(value)checks++;else trace(\"filter extension failed\",total);}\n  public function verifyFamily():void {\n   var c:ConvolutionFilter=new ConvolutionFilter(3,1,[1,0,0],1,0,true,false,0xaabbcc,0.25);\n   var b:BevelFilter=new BevelFilter(3,45,0xffffff,0.9,0x17324d,0.8,4,6,2,1,BitmapFilterType.INNER,false);\n   var g:GradientGlowFilter=new GradientGlowFilter(4,90,[0,0x04aaff,0xfff090],[0,0.7,1],[0,128,255],8,8,2,2,BitmapFilterType.OUTER,false);\n   var v:GradientBevelFilter=new GradientBevelFilter(4,45,[0x152d55,0,0xffff99],[1,0,1],[0,128,255],4,4,1,1,BitmapFilterType.FULL,false);\n   var values:Array=[c,b,g,v];var names:Array=[[\"matrixX\",\"matrixY\",\"matrix\",\"divisor\",\"bias\",\"preserveAlpha\",\"clamp\",\"color\",\"alpha\"],[\"distance\",\"angle\",\"highlightColor\",\"highlightAlpha\",\"shadowColor\",\"shadowAlpha\",\"blurX\",\"blurY\",\"strength\",\"quality\",\"type\",\"knockout\"],[\"distance\",\"angle\",\"colors\",\"alphas\",\"ratios\",\"blurX\",\"blurY\",\"strength\",\"quality\",\"type\",\"knockout\"],[\"distance\",\"angle\",\"colors\",\"alphas\",\"ratios\",\"blurX\",\"blurY\",\"strength\",\"quality\",\"type\",\"knockout\"]];\n   for(var i:int=0;i<values.length;i++){var f:BitmapFilter=values[i];var copied:BitmapFilter=f.clone();check(copied!==f);var same:Boolean=true;for(var j:int=0;j<names[i].length;j++){var key:String=names[i][j];var before:*=f[key];f[key]=before;var a:*=copied[key];if(before is Array){if(before.join(\",\")!=a.join(\",\"))same=false;}else if(before!==a)same=false;}check(same);}\n   var matrix:Array=c.matrix;matrix[0]=99;check(c.matrix[0]==1);var colors:Array=g.colors;colors[1]=0;check(g.colors[1]==0x04aaff);var alphas:Array=v.alphas;alphas[0]=0;check(v.alphas[0]==1);var ratios:Array=v.ratios;ratios[1]=5;check(v.ratios[1]==128);\n   var original:BitmapData=new BitmapData(1,1,true,0xff204060);var out:BitmapData=new BitmapData(1,1,true,0);out.applyFilter(original,new Rectangle(0,0,1,1),new Point(0,0),c);check(out.getPixel32(0,0)==0xffaabbcc);check(original.getPixel32(0,0)==0xff204060);\n   c.clamp=true;out.applyFilter(original,new Rectangle(0,0,1,1),new Point(0,0),c);check(out.getPixel32(0,0)==0xff204060);c.divisor=0;out.applyFilter(original,new Rectangle(0,0,1,1),new Point(0,0),c);check(out.getPixel32(0,0)==0xff204060);\n   var bounds:Rectangle=original.generateFilterRect(new Rectangle(0,0,1,1),c);check(bounds.width==1&&bounds.height==1);check(BitmapFilterType.INNER==\"inner\"&&BitmapFilterType.OUTER==\"outer\"&&BitmapFilterType.FULL==\"full\");\n   cards[0].filters=[c];c.bias=90;var detached:Array=cards[0].filters;detached[0].bias=45;copySafe=cards[0].filters[0].bias==0;check(copySafe);\n   var bad:ConvolutionFilter=new ConvolutionFilter(3,3,[1]);var rejected:Boolean=false;try{cards[0].filters=[bad];}catch(error:Error){rejected=true;}check(rejected&&cards[0].filters[0].bias==0);\n   out.dispose();original.dispose();\n  }\n  public function makeCard(id:String,xpos:Number):Sprite{\n   var card:Sprite=new Sprite();card.name=id;card.x=xpos;card.y=241;card.graphics.beginFill(0x3b8ea5);card.graphics.drawRoundRect(0,0,188,128,18,18);card.graphics.endFill();\n   var dots:Shape=new Shape();dots.graphics.beginFill(0xf08e9f,0.8);dots.graphics.drawCircle(48,45,28);dots.graphics.drawCircle(78,45,28);dots.graphics.endFill();card.addChild(dots);\n   var picture:Bitmap=new Bitmap(shared);picture.x=128;picture.y=24;picture.scaleX=4;picture.scaleY=4;card.addChild(picture);\n   var caption:TextField=new TextField();caption.name=\"caption\";caption.defaultTextFormat=new TextFormat(\"Arial\",19,0xffffff,true);caption.width=170;caption.height=30;caption.x=14;caption.y=90;caption.text=\"Scene + pixels\";caption.selectable=false;card.addChild(caption);\n   card.addEventListener(MouseEvent.CLICK,clicked);addChild(card);return card;\n  }\n  public function clicked(event:MouseEvent):void{clicks++;status.text=\"Card clicks \"+clicks+\" / \"+event.currentTarget.name;trace(\"filter extension click\",clicks,event.currentTarget.name);}\n  public function apply():void{\n   if(phase==2){for(var i:int=0;i<cards.length;i++)cards[i].filters=[];phaseText.text=\"Filters cleared / source vector, text and bitmap content remains\";}\n   else{\n    cards[0].filters=[new ConvolutionFilter(3,3,phase==0?[0,-1,0,-1,5,-1,0,-1,0]:[-2,-1,0,-1,1,1,0,1,2],1,phase==0?0:80,true,true,0,0)];\n    cards[1].filters=[new BevelFilter(phase==0?5:9,phase==0?45:135,0xfff0bd,1,0x17365c,1,6,6,2,2,phase==0?BitmapFilterType.INNER:BitmapFilterType.FULL,false)];\n    cards[2].filters=[new GradientGlowFilter(phase==0?0:8,45,[0x182533,0x4878f7,0xe278d8,0xffe697],[0,0.7,0.9,1],[0,70,170,255],phase==0?20:12,16,2,2,phase==0?BitmapFilterType.OUTER:BitmapFilterType.INNER,false)];\n    cards[3].filters=[new GradientBevelFilter(phase==0?6:10,phase==0?45:135,[0x131e3c,0x2d8db2,0,0xf5c67a,0xfff8e7],[1,0.9,0,0.9,1],[0,64,128,196,255],8,8,2,2,phase==0?BitmapFilterType.INNER:BitmapFilterType.FULL,phase==1)];\n    phaseText.text=phase==0?\"Sharpen / inner bevel / outer gradient glow / inner gradient bevel\":\"Emboss / full bevel / inner gradient glow / full knockout bevel\";\n   }\n   copyReport.text=\"AS3 checks \"+checks+\" / \"+total+\" • 47 member paths • copied values \"+copySafe;\n  }\n  public function advance():void{phase=(phase+1)%3;apply();status.text=\"Style phase \"+phase+\" / clicks \"+clicks;trace(\"filter extension phase\",phase,checks,total);}\n }\n}"
    }
  ]
}
