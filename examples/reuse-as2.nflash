        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "stop();\nruns = 0;\nfunction runReuse() {\n  runs += 1;\n  var checks = 0;\n  var passed = 0;\n  var records = \"\";\n  function check(id:String, actual, expected) {\n    checks++;\n    var ok = actual === expected;\n    if (ok) passed++;\n    if (records != \"\") records += \",\";\n    records += '{\"id\":\"' + id + '\",\"pass\":' + ok + ',\"actualEncoded\":\"' + escape(String(actual)) + '\",\"expectedEncoded\":\"' + escape(String(expected)) + '\"}';\n  }\n  var raw = \"title:neo|level:3|tag:flash\";\n  var rows = raw.split(\"|\");\n  var output = \"\";\n  for (var i = 0; i < rows.length; i++) {\n    var separator = rows[i].indexOf(\":\");\n    var key = rows[i].substring(0, separator).toUpperCase();\n    var value = rows[i].slice(separator + 1);\n    output = output.concat(output == \"\" ? \"\" : \";\", key, \"=\", value);\n  }\n  check(\"String.charAt\", raw.charAt(0), \"t\");\n  check(\"String.charCodeAt\", raw.charCodeAt(0), 116);\n  check(\"String.concat\", \"Neo\".concat(\"Flash\"), \"NeoFlash\");\n  check(\"String.fromCharCode\", String.fromCharCode(65, 0, 66), \"A\");\n  check(\"String.indexOf\", raw.indexOf(\"|\"), 9);\n  check(\"String.lastIndexOf\", raw.lastIndexOf(\"|\"), 17);\n  check(\"String.slice\", raw.slice(-5), \"flash\");\n  check(\"String.split\", rows.length, 3);\n  check(\"String.substr\", \"abcdef\".substr(1, -2), \"bcde\");\n  check(\"String.substring\", \"abcdef\".substring(4, 1), \"bcd\");\n  check(\"String.toLowerCase\", \"İ\".toLowerCase(), \"i\");\n  check(\"String.toUpperCase\", \"straße\".toUpperCase(), \"STRAßE\");\n  check(\"String.toString\", \"value\".toString(), \"value\");\n  check(\"String.valueOf\", \"value\".valueOf(), \"value\");\n  check(\"escape\", escape(\"A @é+\"), \"A%20%40%C3%A9%2B\");\n  check(\"unescape\", unescape(\"A+%40%C3%A9%2B\"), \"A @é+\");\n  check(\"chr\", chr(65), \"A\");\n  check(\"ord\", ord(\"é\"), 233);\n  check(\"length\", length(\"😀\"), 2);\n  check(\"substring\", substring(\"abcdef\", 2, 3), \"bcd\");\n  check(\"mbchr\", mbchr(233), \"é\");\n  check(\"mbord\", mbord(\"\\ud800\"), 65533);\n  check(\"mblength\", mblength(\"neo\"), 3);\n  check(\"mbsubstring\", mbsubstring(\"abcdef\", 3, -1), \"cdef\");\n  check(\"utf16.lone-surrogate\", \"\\ud800\".slice(0, 1).charCodeAt(0), 55296);\n  check(\"pipeline\", output, \"TITLE=neo;LEVEL=3;TAG=flash\");\n  var encode = escape;\n  check(\"alias\", encode(\"a+b\"), \"a%2Bb\");\n  _root.result.text = passed + \" / \" + checks + \" checks passed · run \" + runs;\n  _root.pipeline.text = output;\n  _root.casing.text = 'Historical casing: straße → ' + \"straße\".toUpperCase() + ' / İ → ' + \"İ\".toLowerCase();\n  _root.codec.text = 'escape: ' + escape(\"A @é+\") + ' / unescape: ' + unescape(\"A+%40%C3%A9%2B\");\n  _root.counts.text = \"24 exercised APIs: 14 moved to Rust + 10 new globals. No full AS2 claim.\";\n  var report = '{\"suite\":\"as2-rust-reuse\",\"run\":' + runs + ',\"passed\":' + passed + ',\"checks\":' + checks + ',\"uniqueApis\":24,\"movedToRust\":14,\"newGlobals\":10,\"results\":[' + records + ']}';\n  _root.report = report;\n  trace(report);\n}\nrunReuse();\n"
            }
          }
        ]
      }
