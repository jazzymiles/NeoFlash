        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.geom.Matrix;\nimport flash.geom.ColorTransform;\nimport flash.geom.Transform;\nvar legacyClip:MovieClip=createEmptyMovieClip(\"legacyShape\",getNextHighestDepth());\nlegacyClip.beginFill(0xffffff,100); legacyClip.moveTo(0,0); legacyClip.lineTo(224,0); legacyClip.lineTo(224,48); legacyClip.lineTo(0,48); legacyClip.lineTo(0,0); legacyClip.endFill();\nvar legacyTransform:Transform=new Transform(legacyClip);\nlegacyTransform.matrix=new Matrix(1,0.06,0.2,1,68,488);\nvar legacyTint:ColorTransform=new ColorTransform(); legacyTint.color=0x23c7b0;\nlegacyTransform.colorTransform=legacyTint;\nlegacyReadout.text=\"AS2: Matrix + ColorTransform + bound Transform | rotation \"+legacyClip._rotation;\n"
            }
          }
        ]
      }
