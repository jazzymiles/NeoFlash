  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.display.Sprite;\n import flash.display.Bitmap;\n import flash.display.BitmapData;\n import flash.geom.Matrix;\n import flash.geom.Rectangle;\n import flash.geom.Transform;\n import flash.geom.ColorTransform;\n public class Main extends MovieClip {\n  public var rig:Sprite;\n  public var card:TransformCard;\n  public var shared:BitmapData;\n  public var leftView:Bitmap;\n  public var rightView:Bitmap;\n  public var phase:int=0;\n  public function Main() {\n   super(); stop();\n   rig=new Sprite(); rig.name=\"skewRig\"; addChild(rig);\n   card=new TransformCard(); rig.addChild(card);\n   shared=new BitmapData(16,16,true,0xffeaf3ff);\n   shared.fillRect(new Rectangle(0,0,16,4),0x00ffffff);\n   shared.fillRect(new Rectangle(2,5,5,9),0xff5fa6d1);\n   shared.fillRect(new Rectangle(9,5,5,9),0xffe1a35c);\n   leftView=new Bitmap(shared); leftView.name=\"coolView\";\n   leftView.x=552; leftView.y=244; leftView.scaleX=6; leftView.scaleY=6; addChild(leftView);\n   rightView=new Bitmap(shared); rightView.name=\"warmView\";\n   rightView.x=752; rightView.y=244; rightView.scaleX=6; rightView.scaleY=6; addChild(rightView);\n   restore();\n   trace(\"transforms ready\",phase,TransformCard.created,shared.getPixel32(2,5));\n  }\n  public function restore():void {\n   if(card.parent!=rig) {removeChild(card);rig.addChild(card);}\n   rig.transform.matrix=new Matrix(1,0.08,0.28,1,96,234);\n   card.transform.matrix=new Matrix(1,0,0,1,14,6);\n   rig.transform.colorTransform=new ColorTransform();\n   leftView.transform.colorTransform=new ColorTransform(0.45,0.9,1,1,0,12,0,0);\n   rightView.transform.colorTransform=new ColorTransform(1,0.6,0.35,1,12,0,0,0);\n   card.caption.text=\"Linked card / skew retained\";\n   status.text=\"Ready: skewed nested card, two tinted views, one unchanged pixel buffer.\";\n  }\n  public function cycle():void {\n   phase=(phase+1)%3;\n   if(phase==1) {\n    rig.rotation=rig.rotation+12; rig.scaleX=rig.scaleX*1.1; rig.scaleY=rig.scaleY*0.85;\n    rig.transform.colorTransform=new ColorTransform(0.65,0.9,1,0.7,18,4,0,30);\n    var tint:ColorTransform=new ColorTransform(0.45,0.9,1,0.6,0,12,0,70);\n    leftView.transform.colorTransform=tint;\n    card.caption.text=\"Rotated + scaled + tinted\";\n    status.text=\"1 / Scalar rotate + scale keep the skew. Alpha offset reveals the cool bitmap top row.\";\n   } else if(phase==2) {\n    var world:Matrix=card.transform.concatenatedMatrix;\n    rig.removeChild(card); addChild(card); card.transform.matrix=world;\n    card.caption.text=\"Detached / same linked card\";\n    status.text=\"2 / Detached into the scene at the same world position. Its linked constructor did not run again.\";\n   } else {\n    restore();\n    status.text=\"0 / Reattached to the rig and restored. Shared pixel data remained unchanged.\";\n   }\n   legacyClip._rotation=phase*4;\n   legacyReadout.text=\"AS2: Matrix + ColorTransform + bound Transform | rotation \"+legacyClip._rotation;\n   var bound:Transform=Transform(rig.transform);\n   var combined:ColorTransform=card.transform.concatenatedColorTransform;\n   trace(\"transforms phase\",phase,TransformCard.created,bound is Transform,combined is ColorTransform,shared.getPixel32(2,5));\n  }\n }\n}"
    },
    {
      "id": "card-source",
      "path": "app/TransformCard.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n public class TransformCard extends MovieClip {\n  public static var created:int=0;\n  public function TransformCard() {super();stop();created++;}\n }\n}"
    }
  ]
}
