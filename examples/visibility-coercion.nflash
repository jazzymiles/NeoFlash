                  {
                    "id": "zero",
                    "name": "zero",
                    "transform": {
                      "x": 24,
                      "y": 318,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "zero-art",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "_root.card._visible = true; _root.card._visible = \"0\"; trace(\"AS2 zero\", _root.card._visible);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS2 zero",
                      "description": "",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "invalid",
                    "name": "invalid",
                    "transform": {
                      "x": 178,
                      "y": 318,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "invalid-art",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "var card = _root.card; card._visible = false; card._visible = \"false\"; var a = card._visible; card._visible = \"\"; var b = card._visible; card._visible = \"true\"; var c = card._visible; card._visible = \"NaN\"; var d = card._visible; card._visible = \"Infinity\"; var e = card._visible; trace(\"AS2 invalid\", a, b, c, d, e);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS2 invalid",
                      "description": "",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "primitives",
                    "name": "primitives",
                    "transform": {
                      "x": 332,
                      "y": 318,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "primitives-art",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "var card = _root.card; card._visible = false; card._visible = true; var a = card._visible; card._visible = 0; var b = card._visible; card._visible = -2; var c = card._visible; card._visible = null; var d = card._visible; card._visible = undefined; var e = card._visible; card._visible = NaN; var f = card._visible; card._visible = Infinity; var g = card._visible; card._visible = -Infinity; var h = card._visible; trace(\"AS2 primitives\", a, b, c, d, e, f, g, h);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS2 primitives",
                      "description": "",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "decimals",
                    "name": "decimals",
                    "transform": {
                      "x": 486,
                      "y": 318,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "decimals-art",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "var card = _root.card; card._visible = \"-0\"; var a = card._visible; card._visible = \"+0\"; var b = card._visible; card._visible = \"1\"; var c = card._visible; card._visible = \"-.5\"; var d = card._visible; trace(\"AS2 decimals\", a, b, c, d);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS2 decimals",
                      "description": "",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "modern-check",
                    "name": "modern-check",
                    "transform": {
                      "x": 640,
                      "y": 318,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "modern-check-art",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "var card = this.root.modern; card.visible = \"0\"; var a = card.visible; card.visible = \"false\"; var b = card.visible; card.visible = null; var c = card.visible; card.visible = undefined; var d = card.visible; card.visible = NaN; var e = card.visible; trace(\"AS3 Boolean\", a, b, c, d, e);"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "AS3 Boolean",
                      "description": "",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
