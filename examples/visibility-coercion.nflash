                      "y": 382,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "text",
                      "text": "Read the exact trace below the stage. Each check can be repeated.",
                      "font_family": "Arial",
                      "font_size": 14,
                      "color": [
                        233,
                        240,
                        249,
                        255
                      ]
                    },
                    "scripts": []
                  }
                ],
                "tween": null,
                "label": ""
              }
