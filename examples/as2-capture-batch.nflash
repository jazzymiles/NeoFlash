  "sources": [
    {
      "id": "as2-capture-main",
      "path": "app/CaptureMain.as",
      "language": "action_script2",
      "source": "class app.CaptureMain extends MovieClip {\n public var camera:Camera;\n public var microphone:Microphone;\n public var checks:Number=0;\n public var passed:Number=0;\n public var timer:Number=0;\n public function CaptureMain(){super();stop();Camera.refresh(function(ok:Boolean,error:String):Void{_root.discovered(ok,error);});}\n public function check(label:String,ok:Boolean):Void{checks++;if(ok)passed++;trace(\"AS2_CAPTURE_CHECK \"+label+\" \"+ok);}\n public function discovered(ok:Boolean,error:String):Void{\n  var cameras:Array=Camera.names;var microphones:Array=Microphone.names;\n  check(\"discovery arrays\",cameras instanceof Array&&microphones instanceof Array);\n  check(\"discovery result is explicit\",typeof ok==\"boolean\"&&typeof error==\"string\");\n  camera=Camera.get();microphone=Microphone.get();\n  check(\"enumerated identity or absence\",(camera==null?cameras.length==0:camera==Camera.get()&&camera.index==0)&&(microphone==null?microphones.length==0:microphone==Microphone.get()&&microphone.index==0));\n  check(\"out of range devices\",Camera.get(10000)==null&&Microphone.get(10000)==null);\n  check(\"no invented active measurements\",(camera==null||camera.activityLevel==-1&&camera.currentFps==0&&camera.width==0&&camera.height==0&&camera.muted)&&(microphone==null||microphone.activityLevel==-1&&microphone.muted));\n  if(camera!=null){camera.setMode(320,240,20,true);camera.setMotionLevel(20,500);camera.onStatus=function(info:Object):Void{_root.status.text=info.code;trace(\"AS2_CAPTURE_STATUS \"+info.code);};camera.onActivity=function(active:Boolean):Void{trace(\"AS2_CAPTURE_CAMERA_ACTIVITY \"+active);};}\n  check(\"camera policy when enumerated\",camera==null||camera.fps==20&&camera.motionLevel==20&&camera.motionTimeOut==500);\n  if(microphone!=null){microphone.setGain(0);microphone.setSilenceLevel(10,500);microphone.onStatus=function(info:Object):Void{_root.status.text=info.code;trace(\"AS2_CAPTURE_STATUS \"+info.code);};microphone.onActivity=function(active:Boolean):Void{trace(\"AS2_CAPTURE_MICROPHONE_ACTIVITY \"+active);};}\n  check(\"microphone policy when enumerated\",microphone==null||microphone.gain==0&&microphone.silenceLevel==10&&microphone.silenceTimeOut==500);\n  preview.attachVideo(null);attachAudio(null);check(\"idle detach\",preview.videoWidth==0&&preview.videoHeight==0);\n  result.text=\"Metadata / policy checks \"+passed+\" / \"+checks;\n  detail.text=\"Enumerated cameras: \"+cameras.length+\" | microphones: \"+microphones.length+\" | discovery available: \"+ok;\n  trace(\"AS2_CAPTURE_RESULT \"+passed+\"/\"+checks+\" hardware=not-requested\");\n }\n public function printScene():Void{var job:PrintJob=new PrintJob();if(!job.start()){status.text=\"Print popup was blocked or closed.\";return;}var first:Boolean=job.addPage(0,{xMin:0,yMin:0,xMax:500,yMax:650},{printAsBitmap:true});var second:Boolean=job.addPage(0,{xMin:500,yMin:0,xMax:1000,yMax:650},{printAsBitmap:true});if(first||second){status.text=\"Two raster pages prepared; cancel in the browser to avoid printing.\";trace(\"AS2_PRINT_PAGES \"+first+\" \"+second+\" page=\"+job.pageWidth+\"x\"+job.pageHeight+\" paper=\"+job.paperWidth+\"x\"+job.paperHeight+\" \"+job.orientation);job.send();}}\n public function startCamera():Void{if(camera==null){status.text=\"No camera is currently enumerated.\";return;}preview.attachVideo(camera);status.text=\"Camera permission requested by your click.\";startMeter();}\n public function startMicrophone():Void{if(microphone==null){status.text=\"No microphone is currently enumerated.\";return;}attachAudio(microphone);status.text=\"Microphone permission requested; gain remains zero.\";startMeter();}\n public function startMeter():Void{if(timer==0)timer=setInterval(this,\"measure\",500);}\n public function measure():Void{var line:String=\"\";if(camera!=null)line=\"Camera: \"+camera.width+\" x \"+camera.height+\" | activity \"+camera.activityLevel;if(microphone!=null)line=line+\"\\nMicrophone activity: \"+microphone.activityLevel;activity.text=line;}\n public function stopCapture():Void{preview.attachVideo(null);attachAudio(false);if(timer!=0){clearInterval(timer);timer=0;}status.text=\"Capture released. Detached video retains its last frame.\";measure();trace(\"AS2_CAPTURE_DETACHED\");}\n}\n"
    }
  ],
  "resources": []
}
