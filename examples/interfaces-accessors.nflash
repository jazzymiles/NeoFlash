  "sources": [
    {
      "id": "source-0",
      "path": "app/IReadable.as",
      "language": "action_script3",
      "source": "package app {\n    public interface IReadable {\n        function get value():int;\n        function get label():String;\n    }\n}\n"
    },
    {
      "id": "source-1",
      "path": "app/IResettable.as",
      "language": "action_script3",
      "source": "package app {\n    public interface IResettable { function reset():void; }\n}\n"
    },
    {
      "id": "source-2",
      "path": "app/ICounter.as",
      "language": "action_script3",
      "source": "package app {\n    public interface ICounter extends IReadable, IResettable {\n        function set value(next:int):void;\n        function increment(amount:int):int;\n    }\n}\n"
    },
    {
      "id": "source-3",
      "path": "app/Counter.as",
      "language": "action_script3",
      "source": "package app {\n    public class Counter implements ICounter {\n        public var stored:int = 0;\n        public var reads:int = 0;\n        public var writes:int = 0;\n        public static var createdStore:int = 0;\n        public function Counter(seed:int) { value = seed; createdStore++; }\n        public function get value():int { reads++; return stored; }\n        public function set value(next:int):void { writes++; stored = next; }\n        public function get label():String { return \"counter:\" + stored; }\n        public function set command(next:int):void { value = next; }\n        public static function get created():int { return createdStore; }\n        public static function set created(next:int):void { createdStore = next; }\n        public function increment(amount:int):int { value += amount; return value; }\n        public function post():int { return value++; }\n        public function reset():void { value = 0; }\n        public function accept(other:ICounter):ICounter { return other; }\n    }\n}\n"
    },
    {
      "id": "source-4",
      "path": "app/BoundedCounter.as",
      "language": "action_script3",
      "source": "package app {\n    public class BoundedCounter extends Counter {\n        public function BoundedCounter(seed:int) { super(seed); }\n        public override function set value(next:int):void {\n            super.value = next < 0 ? 0 : next > 9 ? 9 : next;\n        }\n        public override function get label():String { return \"bounded:\" + super.value; }\n    }\n}\n"
    },
    {
      "id": "source-5",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n    import flash.display.MovieClip;\n    import flash.events.MouseEvent;\n    public class Main extends MovieClip {\n        public var model:ICounter;\n        public var other:ICounter;\n        public var clicks:int = 0;\n        public function Main() {\n            super(); stop();\n            model = new BoundedCounter(2);\n            other = new Counter(7);\n            addEventListener(MouseEvent.CLICK, clicked);\n            render();\n            trace(\"interfaces ready\", Counter.created, model.value, other.value);\n        }\n        public function clicked(event:MouseEvent):void {\n            clicks++;\n            model.increment(1);\n            render();\n            trace(\"interfaces click\", clicks, model.value, other.value);\n        }\n        public function render():void {\n            status.text = model.label + \" | other:\" + other.value;\n            measurements.text = \"Clicks: \" + clicks + \" | model bound: 0…9 | created: \" + Counter.created;\n        }\n    }\n}\n"
    }
  ]
}
