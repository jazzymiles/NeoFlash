  "document_class": "app.NumberFormatExample",
  "sources": [
    {
      "id": "math-main",
      "path": "app/NumberFormatExample.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;import flash.globalization.NumberFormatter;import flash.globalization.NumberParseResult;\n public dynamic class NumberFormatExample extends MovieClip {\n  public var runs:int=0;public var checks:Array;public var failures:Array;\n  public function NumberFormatExample(){super();stop();runReuse();}\n  public function check(name:String,pass:Boolean):void{checks.push(name);if(!pass)failures.push(name);}\n  public function runReuse():void{\n   runs++;checks=[];failures=[];\n   var en:NumberFormatter=new NumberFormatter(\"en-US\");en.useGrouping=true;en.fractionalDigits=2;en.trailingZeros=true;\n   var english:String=en.formatNumber(1234567.5);check(\"US rendering\",english==\"1,234,567.50\");check(\"locale identity\",en.requestedLocaleIDName==\"en-US\"&&en.actualLocaleIDName.length>0&&en.lastOperationStatus==\"noError\");\n   var keys:Array=[\"decimalSeparator\",\"digitsType\",\"fractionalDigits\",\"groupingPattern\",\"groupingSeparator\",\"leadingZero\",\"negativeNumberFormat\",\"negativeSymbol\",\"trailingZeros\",\"useGrouping\"];var same:Boolean=true;for(var i:int=0;i<keys.length;i++){var key:String=keys[i];var original:*=en[key];en[key]=original;if(en[key]!==original)same=false;}check(\"ten mutable properties\",same);\n   en.groupingPattern=\"3;2;*\";check(\"Indian grouping\",en.formatNumber(1234567.5)==\"12,34,567.50\");en.groupingPattern=\"3;*\";\n   var expected:Array=[\"(1,234.50)\",\"-1,234.50\",\"- 1,234.50\",\"1,234.50-\",\"1,234.50 -\"];var signs:Boolean=true;for(i=0;i<5;i++){en.negativeNumberFormat=i;var negative:String=en.formatNumber(-1234.5);if(negative!=expected[i]||en.parseNumber(negative)!=-1234.5)signs=false;}check(\"five negative formats round trip\",signs);en.negativeNumberFormat=1;\n   en.leadingZero=false;check(\"leading zero\",en.formatNumber(0.5)==\".50\");en.trailingZeros=false;check(\"trailing zeros\",en.formatNumber(0.5)==\".5\");en.leadingZero=true;\n   en.useGrouping=false;en.fractionalDigits=0;check(\"int conversion\",en.formatInt(4294967295)==\"-1\");check(\"uint conversion\",en.formatUint(-1)==\"4294967295\");check(\"fixed notation\",en.formatNumber(1e21)==\"1000000000000000000000\");\n   en.fractionalDigits=2;en.useGrouping=true;var parsed:NumberParseResult=en.parse(\"💡 total -1,234.50 USD\");check(\"parse result\",parsed.value==-1234.5&&parsed.startIndex==9&&parsed.endIndex==18);check(\"strict parse\",isNaN(en.parseNumber(\"total 12\"))&&en.parseNumber(\" 12.5 \")==12.5);check(\"failed parse\",isNaN(en.parse(\"nothing\").value)&&en.parse(\"nothing\").startIndex==2147483647&&en.lastOperationStatus==\"parseError\");\n   var direct:NumberParseResult=new NumberParseResult(2.5,4,7);check(\"parse result constructor\",direct.value==2.5&&direct.startIndex==4&&direct.endIndex==7);\n   var fr:NumberFormatter=new NumberFormatter(\"fr-FR\");fr.useGrouping=true;fr.fractionalDigits=2;fr.trailingZeros=true;var french:String=fr.formatNumber(1234567.5);check(\"French round trip\",fr.decimalSeparator==\",\"&&fr.parseNumber(french)==1234567.5);\n   var ar:NumberFormatter=new NumberFormatter(\"ar-EG\");ar.useGrouping=true;ar.fractionalDigits=2;ar.trailingZeros=true;var arabic:String=ar.formatNumber(1234567.5);check(\"Arabic digit round trip\",ar.digitsType==0x660&&ar.parseNumber(arabic)==1234567.5);\n   en.digitsType=0x966;var indic:String=en.formatNumber(1234.5);check(\"explicit digit set\",indic.indexOf(\"१\")>=0&&en.parseNumber(indic)==1234.5);en.digitsType=0x30;\n   en.negativeSymbol=\"~\";check(\"custom negative symbol\",en.parseNumber(en.formatNumber(-2.5))==-2.5);\n   var rejected:Boolean=false;try{en.fractionalDigits=999;}catch(error:Error){rejected=true;}check(\"invalid setter atomic\",rejected&&en.fractionalDigits==2&&en.lastOperationStatus==\"illegalArgumentError\");\n   result.text=(checks.length-failures.length)+\" / \"+checks.length+\" checks passed · run \"+runs;\n   pipeline.text=\"en-US  \"+english;casing.text=\"fr-FR  \"+french;codec.text=\"ar-EG  \"+arabic;\n   counts.text=\"21 member paths · 2 constructors · all number algorithms and formatter state in Rust\";\n   trace(\"NUMBER_FORMAT_RESULT \"+JSON.stringify({checks:checks.length,passed:checks.length-failures.length,failed:failures.length,run:runs,failures:failures,english:english,french:french,arabic:arabic}));\n  }\n }\n}"
    }
  ]
}
