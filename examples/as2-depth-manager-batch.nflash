        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import mx.managers.DepthManager;\nstop();\nvar checks:Number=0;var passed:Number=0;var failures:String=\"\";\nfunction check(name:String,ok:Boolean):Void{checks++;if(ok)passed++;else failures+=name+\"; \";trace(\"AS2_DEPTH_CHECK \"+name+\" \"+ok);}\nvar holder:MovieClip=_root.createEmptyMovieClip(\"depthHolder\",500);holder._x=90;holder._y=190;\nvar a:MovieClip=holder.createChildAtDepth(\"DepthA\",DepthManager.kTop,{_x:0,_y:0,tag:\"a\"});\nvar b:MovieClip=holder.createChildAtDepth(\"DepthA\",DepthManager.kBottom,{_x:110,_y:30,tag:\"b\"});\nvar c:MovieClip=holder.createChildAtDepth(\"DepthA\",DepthManager.kTopmost,{_x:220,_y:60,tag:\"c\"});\ncheck(\"documented constant values\",DepthManager.kTop==201&&DepthManager.kBottom==202&&DepthManager.kTopmost==203&&DepthManager.kNotopmost==204&&DepthManager.kCursor==101&&DepthManager.kTooltip==102);\ncheck(\"real linked instances and initialization\",a._parent==holder&&b._parent==holder&&c._parent==holder&&a.ready==\"a\"&&b.ready==\"b\"&&c.ready==\"c\"&&a.observedDepth>0&&a._name!=b._name);\ncheck(\"bottom normal and topmost creation\",b.getDepth()<a.getDepth()&&a.getDepth()<c.getDepth());\na.setDepthTo(DepthManager.kTop);b.setDepthTo(DepthManager.kTop);\ncheck(\"topmost remains above normal raises\",c.getDepth()>b.getDepth()&&b.getDepth()>a.getDepth());\nc.setDepthTo(DepthManager.kNotopmost);a.setDepthTo(DepthManager.kTop);\ncheck(\"remove topmost tier\",a.getDepth()>c.getDepth()&&c.getDepth()>b.getDepth());\nb.setDepthAbove(a);check(\"relative above\",b.getDepth()>a.getDepth());\nb.setDepthBelow(c);check(\"relative below\",b.getDepth()<c.getDepth());\na.setDepthTo(DepthManager.kBottom);\ncheck(\"bottom and stable twenty-depth shuffle\",a.getDepth()<b.getDepth()&&b.getDepth()<c.getDepth()&&a.getDepth()%20==0&&b.getDepth()%20==0&&c.getDepth()%20==0&&a.setDepthTo===a.setDepthTo);\n_root.result.text=\"DepthManager \"+passed+\" / \"+checks;\n_root.note.text=failures==\"\"?\"A behind B behind C. All three are real linked AS2 MovieClips. Restart repeats the batch.\":failures;\ntrace(\"AS2_DEPTH_RESULT \"+passed+\"/\"+checks+\" \"+failures);\n"
            }
          }
        ]
      }
