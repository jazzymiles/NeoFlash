              "language": "action_script3",
              "source": "stop();\ntrace(\"AS3 decimal\", typeof parseInt(\"0777\"), parseInt(\"0777\"));\ntrace(\"AS3 edge\", parseInt(\"08\"), parseInt(\"-0x10\"), parseInt(\"10\",0), 1/parseInt(\"-0\"));\nvar n:Number=1;\ntrace(\"AS3 precision20\", typeof n.toFixed(20), n.toFixed(20));\ntry { n.toFixed(21); } catch(e:RangeError) { trace(\"AS3 precision21\", e.name, e.errorID); }\ntry { NaN.toFixed(-1); } catch(e:RangeError) { trace(\"AS3 NaN range\", e.name, e.errorID); }\ntrace(\"AS3 convert\", (7.25).toFixed(1.9), n.toFixed(4294967296), (-0).toFixed(2), Infinity.toFixed(2));\nvar parse:Function=parseInt;\nfunction shadow(parseInt:Function) { return parseInt(\"0777\"); }\nvar tools={toFixed:function(value) {return \"custom:\"+value;}};\nvar custom:Function=tools.toFixed;\ntrace(\"AS3 binding\", parse(\"0777\"), shadow(function(value) {return \"local:\"+value;}), tools.toFixed(21), custom(22));\nvar plain={toFixed:17};\ntrace(\"AS3 custom field\", plain.toFixed === 17);\nvar key:String=\"toFixed\";\ntry { var unsupportedMethod:Function=n[key]; unsupportedMethod(21); } catch(e:Error) { trace(\"AS3 dynamic method\", e.message.indexOf(\"Unsupported AS3 Number.toFixed method value\") == 0); }\n"
            }
          }
        ]
