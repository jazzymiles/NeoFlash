              "language": "action_script2",
              "source": "stop();\ntrace(\"AS2 octal\", typeof parseInt(\"0777\"), parseInt(\"0777\"));\ntrace(\"AS2 edge\", parseInt(\"08\"), parseInt(\"0x10\"), isNaN(parseInt(\"10\",0)), typeof parseInt(), 1/parseInt(\"-0\"));\nvar parse:Function=parseInt;\nfunction shadow(parseInt:Function) { return parseInt(\"0777\"); }\nvar tools={parseInt:function(value) { return \"custom:\"+value; }};\ntrace(\"AS2 binding\", parse(\"0777\"), shadow(function(value) { return \"local:\"+value; }), tools.parseInt(\"0777\"));\n"
            }
          }
        ]
