  "sources": [
    {
      "id": "src-47",
      "path": "fallout/VaultData.as",
      "language": "action_script2",
      "source": "class fallout.VaultData {\n  public static var MAP_W:Number = 36;\n  public static var MAP_H:Number = 28;\n\n  // Hex Tile Legend (odd-r foreshortened pointy-top hexagons):\n  //  0 = Solid cavern limestone wall (3D hex column; blocks walk & LoS)\n  //  1 = Damp cavern stone hex (walkable)\n  //  2 = Vault 13 steel/concrete airlock hex (walkable)\n  //  3 = Jagged stalagmite spire (blocks walk & LoS; grants adjacent tactical cover)\n  //  4 = Bioluminescent radioactive sludge pool (blocks walk, transparent to LoS, emits rads adjacent)\n  //  5 = Vault 13 Giant Gear Blast Door bulkhead (blocks walk & LoS)\n  //  6 = Bone-strewn gravel / excavation floor (walkable)\n  //  7 = Sunlit California Wasteland Exit Grid (walkable — stepping here escapes the cavern!)\n  //  8 = Pre-War sandbag / crate barricade (blocks walk, transparent to LoS, grants +15 AC cover!)\n  // 10 = Rusted Vault steel grated catwalk bridge over rad-sludge (walkable!)\n  public static function createGrid():Array {\n    var rows:Array = [\n      //012345678901234567890123456789012345  (36 cols x 28 rows = 1,008 hexes)\n      \"....................................\", // y=0\n      \"..22222.............................\", // y=1  Airlock N alcove: Locker(2,2), Terminal(4,2)\n      \".5222222............1111111111......\", // y=2  Crystal Canyon N rim\n      \".5222222111.......11116611116611....\", // y=3  Blast Door #13 (1,2..3); Crate(29,4)\n      \"..2222221111111..111311111311611....\", // y=4  Spawn(3,4), Ed's Remains(5,4)\n      \"..222221113116111111116611111111....\", // y=5  Crossroads entry + NE Canyon mouth\n      \"...222..11181166611111113116611.....\", // y=6  Prospector Pack(14,6), Barricade(11,6)\n      \"........1111166661811111111611......\", // y=7  Campfire(13,7), Drum(11,7), Barricade(18,7)\n      \".........11311661111..111311611.....\", // y=8  Radscorpions in NE Canyon (23,6),(28,8)\n      \"..........11111111.....11111611.....\", // y=9\n      \"...........11611........1111611.....\", // y=10 South tunnel(11..15) & East flank(28..30)\n      \"..........111611.........113611.....\", // y=11\n      \".........1116611..........11611.....\", // y=12\n      \".......111166111..........11611.....\", // y=13 Sump North Shore\n      \".....111444==44411........116611....\", // y=14 Flooded Rad-Sump begins ('=' = Catwalk 10)\n      \"...11114444==444411......1166611....\", // y=15 Grotto ledge West + Brood N Choke\n      \"..116144444==444441.....116316611...\", // y=16 Grotto Shrine(3,16); Drum(11,16)\n      \"..11114444111144441....1161111611...\", // y=17 Central Sump Rock Hub (10..13,17..19)\n      \"...11444==1661====11..11618113611...\", // y=18 West & East Catwalk Bridges!\n      \"....444==41661444==1111661116661177.\", // y=19 East Catwalk -> Brood Chasm -> Exit(33..34)\n      \"...111==4441144444==116631166661777.\", // y=20 Brood Mother(28,20), Sunlit Exit(32..34)\n      \"...12221444444444441166111866611777.\", // y=21 Hazmat Island(3..7,20..23) + Chasm floor\n      \"...1222114444444441116116666111.77..\", // y=22 Hazmat Footlocker(5,22)\n      \"....12211144444411..1166663111......\", // y=23 Bone Cache(24,23)\n      \".....111..114411.....11166111.......\", // y=24\n      \"............11.........11111........\", // y=25\n      \"....................................\", // y=26\n      \"....................................\"  // y=27\n    ];\n\n    var grid:Array = [];\n    var r:Number = 0;\n    while (r < MAP_H) {\n      var line:String = rows[r];\n      var c:Number = 0;\n      while (c < MAP_W) {\n        var ch:String = line.charAt(c);\n        var code:Number = 0;\n        if (ch == \"1\") { code = 1; }\n        else if (ch == \"2\") { code = 2; }\n        else if (ch == \"3\") { code = 3; }\n        else if (ch == \"4\") { code = 4; }\n        else if (ch == \"5\") { code = 5; }\n        else if (ch == \"6\") { code = 6; }\n        else if (ch == \"7\") { code = 7; }\n        else if (ch == \"8\") { code = 8; }\n        else if (ch == \"=\") { code = 10; }\n        grid.push(code);\n        c = c + 1;\n      }\n      r = r + 1;\n    }\n    return grid;\n  }\n\n  // XML catalog demonstrating real AS2 XML DOM parsing in NeoFlash\n  public static function loadCatalogXml():Object {\n    var src:String =\n      \"<vault13>\" +\n        \"<weapons>\" +\n          \"<weapon id='pistol10mm' name='10mm Colt 6520' min='6' max='13' range='10' apSingle='4' apAimed='5' mag='12' skill='smallGuns'/>\" +\n          \"<weapon id='knife' name='Vault Combat Knife' min='4' max='9' range='1' apSingle='3' apAimed='4' mag='0' skill='melee'/>\" +\n          \"<weapon id='shotgun' name='Sawed-Off 12ga' min='12' max='21' range='6' apSingle='4' apAimed='5' mag='2' skill='smallGuns'/>\" +\n        \"</weapons>\" +\n        \"<vats>\" +\n          \"<part id='eyes' label='EYES' penalty='35' critBonus='45' dmgMult='200' effect='blind'/>\" +\n          \"<part id='head' label='HEAD' penalty='20' critBonus='25' dmgMult='150' effect='stun'/>\" +\n          \"<part id='torso' label='TORSO' penalty='0' critBonus='5' dmgMult='100' effect='none'/>\" +\n          \"<part id='groin' label='GROIN' penalty='15' critBonus='20' dmgMult='125' effect='stun'/>\" +\n          \"<part id='legs' label='LEGS' penalty='15' critBonus='15' dmgMult='115' effect='cripple'/>\" +\n        \"</vats>\" +\n        \"<holodisk title='VAULT 13 OVERSEER DIRECTIVE 2161'>\" +\n          \"Water Chip controller failure imminent (150 days reserve). \" +\n          \"Technician Ed and a pre-War salvage scout vanished in the outer hex caverns. \" +\n          \"Hack Security Terminal 13-A for seismic sector scans, watch for volatile rad-drums on the sump catwalks, \" +\n          \"and fight through the Radscorpion canyon or Brood Chasm to reach the surface toward Vault 15.\" +\n        \"</holodisk>\" +\n      \"</vault13>\";\n\n    var doc:XML = new XML();\n    doc.ignoreWhite = true;\n    doc.parseXML(src);\n\n    var weapons:Object = {};\n    var vatsParts:Array = [];\n    var holoTitle:String = \"VAULT 13 HOLODISK\";\n    var holoBody:String = \"\";\n\n    var rootNode:XMLNode = doc.firstChild;\n    if (rootNode != null) {\n      var sections:Array = rootNode.childNodes;\n      var i:Number = 0;\n      while (i < sections.length) {\n        var sec:XMLNode = sections[i];\n        if (sec.nodeName == \"weapons\") {\n          var wNodes:Array = sec.childNodes;\n          var wIdx:Number = 0;\n          while (wIdx < wNodes.length) {\n            var wn:XMLNode = wNodes[wIdx];\n            var wid:String = String(wn.attributes.id);\n            weapons[wid] = {\n              id: wid,\n              name: String(wn.attributes.name),\n              minDmg: Number(wn.attributes.min),\n              maxDmg: Number(wn.attributes.max),\n              range: Number(wn.attributes.range),\n              apSingle: Number(wn.attributes.apSingle),\n              apAimed: Number(wn.attributes.apAimed),\n              magSize: Number(wn.attributes.mag),\n              skill: String(wn.attributes.skill)\n            };\n            wIdx = wIdx + 1;\n          }\n        } else if (sec.nodeName == \"vats\") {\n          var pNodes:Array = sec.childNodes;\n          var pIdx:Number = 0;\n          while (pIdx < pNodes.length) {\n            var pn:XMLNode = pNodes[pIdx];\n            vatsParts.push({\n              id: String(pn.attributes.id),\n              label: String(pn.attributes.label),\n              penalty: Number(pn.attributes.penalty),\n              critBonus: Number(pn.attributes.critBonus),\n              dmgMult: Number(pn.attributes.dmgMult),\n              effect: String(pn.attributes.effect)\n            });\n            pIdx = pIdx + 1;\n          }\n        } else if (sec.nodeName == \"holodisk\") {\n          holoTitle = String(sec.attributes.title);\n          if (sec.firstChild != null) {\n            holoBody = String(sec.firstChild.nodeValue);\n          }\n        }\n        i = i + 1;\n      }\n    }\n\n    if (weapons.pistol10mm == undefined) {\n      weapons.pistol10mm = { id: \"pistol10mm\", name: \"10mm Colt 6520\", minDmg: 6, maxDmg: 13, range: 10, apSingle: 4, apAimed: 5, magSize: 12, skill: \"smallGuns\" };\n      weapons.knife = { id: \"knife\", name: \"Vault Combat Knife\", minDmg: 4, maxDmg: 9, range: 1, apSingle: 3, apAimed: 4, magSize: 0, skill: \"melee\" };\n      weapons.shotgun = { id: \"shotgun\", name: \"Sawed-Off 12ga\", minDmg: 12, maxDmg: 21, range: 6, apSingle: 4, apAimed: 5, magSize: 2, skill: \"smallGuns\" };\n    }\n    if (vatsParts.length == 0) {\n      vatsParts = [\n        { id: \"eyes\", label: \"EYES\", penalty: 35, critBonus: 45, dmgMult: 200, effect: \"blind\" },\n        { id: \"head\", label: \"HEAD\", penalty: 20, critBonus: 25, dmgMult: 150, effect: \"stun\" },\n        { id: \"torso\", label: \"TORSO\", penalty: 0, critBonus: 5, dmgMult: 100, effect: \"none\" },\n        { id: \"groin\", label: \"GROIN\", penalty: 15, critBonus: 20, dmgMult: 125, effect: \"stun\" },\n        { id: \"legs\", label: \"LEGS\", penalty: 15, critBonus: 15, dmgMult: 115, effect: \"cripple\" }\n      ];\n    }\n\n    return {\n      weapons: weapons,\n      vatsParts: vatsParts,\n      holoTitle: holoTitle,\n      holoBody: holoBody\n    };\n  }\n\n  // Enemy archetypes across the 5 cavern regions (14 hostiles):\n  // 1 = Cave Rat (9 HP, 6 AP, AC 2, 1-4 dmg, 35 XP)\n  // 2 = Mutated / Glowing Pig-Rat (17 HP, 7 AP, AC 4, 3-6 dmg, 70 XP)\n  // 3 = Cavern Brood Mother Boss (42 HP, 8 AP, AC 8, 5-11 dmg, 200 XP)\n  // 4 = Cave Radscorpion (24 HP, 7 AP, AC 7, 4-8 dmg + Venom sting, 105 XP)\n  public static function createEnemies():Array {\n    return [\n      // Zone 2: Prospector Crossroads\n      { id: 0,  kind: 1, name: \"Cave Rat\",            tx: 11, ty: 5,  hp: 9,  maxHp: 9,  ap: 6, ac: 2, minDmg: 1, maxDmg: 4,  xp: 35 },\n      { id: 1,  kind: 1, name: \"Tunnel Rat\",          tx: 12, ty: 8,  hp: 10, maxHp: 10, ap: 6, ac: 2, minDmg: 2, maxDmg: 4,  xp: 40 },\n      { id: 2,  kind: 2, name: \"Scavenger Mole-Rat\",  tx: 16, ty: 7,  hp: 17, maxHp: 17, ap: 7, ac: 4, minDmg: 3, maxDmg: 6,  xp: 70 },\n      // Zone 3: Flooded Rad-Waste Sump & Catwalks\n      { id: 3,  kind: 2, name: \"Irradiated Pig-Rat\",  tx: 11, ty: 13, hp: 16, maxHp: 16, ap: 7, ac: 4, minDmg: 3, maxDmg: 6,  xp: 70 },\n      { id: 4,  kind: 2, name: \"Glowing Sump Rat\",    tx: 12, ty: 18, hp: 18, maxHp: 18, ap: 7, ac: 5, minDmg: 3, maxDmg: 7,  xp: 80 },\n      { id: 5,  kind: 1, name: \"Catwalk Cave Rat\",    tx: 6,  ty: 21, hp: 11, maxHp: 11, ap: 6, ac: 3, minDmg: 2, maxDmg: 5,  xp: 45 },\n      // Zone 4: Bioluminescent Crystal & Radscorpion Canyon (NE Flank)\n      { id: 6,  kind: 1, name: \"Crystal Cave Rat\",    tx: 21, ty: 5,  hp: 10, maxHp: 10, ap: 6, ac: 3, minDmg: 2, maxDmg: 5,  xp: 40 },\n      { id: 7,  kind: 4, name: \"Young Radscorpion\",   tx: 23, ty: 6,  hp: 22, maxHp: 22, ap: 7, ac: 6, minDmg: 4, maxDmg: 7,  xp: 95 },\n      { id: 8,  kind: 4, name: \"Canyon Radscorpion\",  tx: 28, ty: 8,  hp: 25, maxHp: 25, ap: 7, ac: 7, minDmg: 4, maxDmg: 8,  xp: 110 },\n      // Zone 5: Brood Mother's Chasm & Sunlit Exit\n      { id: 9,  kind: 1, name: \"Brood Nest Rat\",      tx: 21, ty: 19, hp: 12, maxHp: 12, ap: 6, ac: 3, minDmg: 2, maxDmg: 5,  xp: 45 },\n      { id: 10, kind: 2, name: \"Brood Stalker Rat\",   tx: 23, ty: 18, hp: 19, maxHp: 19, ap: 7, ac: 5, minDmg: 3, maxDmg: 7,  xp: 80 },\n      { id: 11, kind: 2, name: \"Chasm Guard Rat\",     tx: 26, ty: 16, hp: 19, maxHp: 19, ap: 7, ac: 5, minDmg: 3, maxDmg: 7,  xp: 80 },\n      { id: 12, kind: 4, name: \"Armored Radscorpion\", tx: 26, ty: 22, hp: 26, maxHp: 26, ap: 7, ac: 8, minDmg: 4, maxDmg: 9,  xp: 120 },\n      { id: 13, kind: 3, name: \"Cavern Brood Mother\", tx: 29, ty: 20, hp: 42, maxHp: 42, ap: 8, ac: 8, minDmg: 5, maxDmg: 11, xp: 200 }\n    ];\n  }\n\n  // Interactive containers, corpses & Vault terminals across the 5 zones:\n  public static function createContainers():Array {\n    return [\n      {\n        id: \"ed_remains\",\n        kind: \"corpse\",\n        name: \"Ed's Remains\",\n        examine: \"You see: Ed. Ed's dead. His torn Vault 13 suit clutches spare 10mm magazines.\",\n        tx: 5, ty: 4, looted: false,\n        ammo10mm: 24, shells12ga: 0, stimpaks: 1, flares: 1, grenades: 0, radaway: 0,\n        armor: false, shotgun: false, skillMag: false, holodisk: false\n      },\n      {\n        id: \"airlock_terminal\",\n        kind: \"terminal\",\n        name: \"Vault-Tec Terminal 13-A\",\n        examine: \"You see: Airlock Security & Seismology Console. Running Science diagnostics...\",\n        tx: 4, ty: 2, looted: false,\n        ammo10mm: 0, shells12ga: 0, stimpaks: 0, flares: 0, grenades: 0, radaway: 0,\n        armor: false, shotgun: false, skillMag: false, holodisk: false\n      },\n      {\n        id: \"vault_locker\",\n        kind: \"locker\",\n        name: \"Airlock Armory Locker\",\n        examine: \"You see: Vault-Tec Emergency Ordinance Locker #13-A.\",\n        tx: 2, ty: 2, looted: false,\n        ammo10mm: 16, shells12ga: 0, stimpaks: 2, flares: 0, grenades: 2, radaway: 0,\n        armor: false, shotgun: false, skillMag: false, holodisk: true\n      },\n      {\n        id: \"prospector_pack\",\n        kind: \"prospector\",\n        name: \"Dead Prospector's Pack\",\n        examine: \"You see: A grizzled wasteland scout slumped beside campfire ashes, clutching a Sawed-Off 12ga.\",\n        tx: 14, ty: 6, looted: false,\n        ammo10mm: 8, shells12ga: 8, stimpaks: 1, flares: 1, grenades: 1, radaway: 0,\n        armor: false, shotgun: true, skillMag: false, holodisk: false\n      },\n      {\n        id: \"grotto_shrine\",\n        kind: \"bones\",\n        name: \"Sump Grotto Skeleton\",\n        examine: \"You see: Pre-War survivor bones with a dry oilskin issue of 'Guns and Bullets'!\",\n        tx: 3, ty: 16, looted: false,\n        ammo10mm: 12, shells12ga: 4, stimpaks: 1, flares: 0, grenades: 0, radaway: 0,\n        armor: false, shotgun: false, skillMag: true, holodisk: false\n      },\n      {\n        id: \"hazmat_footlocker\",\n        kind: \"footlocker\",\n        name: \"Hazmat Island Footlocker\",\n        examine: \"You see: Sealed Vault maintenance footlocker on the southern sludge island.\",\n        tx: 5, ty: 22, looted: false,\n        ammo10mm: 16, shells12ga: 6, stimpaks: 2, flares: 0, grenades: 2, radaway: 1,\n        armor: true, shotgun: false, skillMag: false, holodisk: false\n      },\n      {\n        id: \"canyon_crate\",\n        kind: \"footlocker\",\n        name: \"Miner's Munitions Crate\",\n        examine: \"You see: Reinforced wooden blasting crate tucked behind glowing cavern crystals.\",\n        tx: 29, ty: 4, looted: false,\n        ammo10mm: 18, shells12ga: 8, stimpaks: 1, flares: 1, grenades: 2, radaway: 0,\n        armor: false, shotgun: false, skillMag: false, holodisk: false\n      },\n      {\n        id: \"chasm_bones\",\n        kind: \"bones\",\n        name: \"Brood Lair Bone Heap\",\n        examine: \"You see: Gnawed caravan bones dragged beneath the Brood Mother's perch.\",\n        tx: 24, ty: 23, looted: false,\n        ammo10mm: 14, shells12ga: 6, stimpaks: 2, flares: 0, grenades: 0, radaway: 0,\n        armor: false, shotgun: false, skillMag: false, holodisk: false\n      }\n    ];\n  }\n\n  // Shootable / chain-detonating Volatile Rad-Fuel Barrels (2-hex AoE blast!):\n  public static function createBarrels():Array {\n    return [\n      { id: 0, tx: 11, ty: 7,  alive: true }, // Crossroads ambush drum\n      { id: 1, tx: 12, ty: 13, alive: true }, // North Sump shore drum\n      { id: 2, tx: 13, ty: 19, alive: true }, // Sump Hub catwalk drum\n      { id: 3, tx: 22, ty: 18, alive: true }, // Brood Chasm west choke drum\n      { id: 4, tx: 27, ty: 17, alive: true }  // Brood Chasm north choke drum\n    ];\n  }\n\n  // Light-emitting & atmospheric cavern props:\n  // blocking == false for floor campfires so paths stay wide; blocking == true for stanchions/crystals/timbers\n  public static function createProps():Array {\n    return [\n      { kind: \"beacon\",   tx: 2,  ty: 5,  blocking: true  },\n      { kind: \"beacon\",   tx: 6,  ty: 3,  blocking: true  },\n      { kind: \"campfire\", tx: 13, ty: 7,  blocking: true  },\n      { kind: \"crystal\",  tx: 22, ty: 3,  blocking: true  },\n      { kind: \"crystal\",  tx: 27, ty: 6,  blocking: true  },\n      { kind: \"crystal\",  tx: 30, ty: 10, blocking: true  },\n      { kind: \"rad_sign\", tx: 9,  ty: 13, blocking: true  },\n      { kind: \"timber\",   tx: 31, ty: 18, blocking: true  },\n      { kind: \"timber\",   tx: 30, ty: 22, blocking: true  }\n    ];\n  }\n}\n"
    },
    {
      "id": "src-48",
      "path": "fallout/PathLos.as",
      "language": "action_script2",
      "source": "class fallout.PathLos {\n  // Foreshortened pointy-top odd-r hexagonal screen geometry:\n  // Each hex has width 48 (HALF_W = 24), vertical radius 16 (32 tall), row step 24.\n  public static var HEX_W:Number = 48;\n  public static var HALF_W:Number = 24;\n  public static var HEX_RY:Number = 16;\n  public static var ROW_H:Number = 24;\n\n  // Direction offsets for odd-r horizontal pointy-top hexes (0=NE, 1=E, 2=SE, 3=SW, 4=W, 5=NW)\n  public static function dirDx(odd:Number, dir:Number):Number {\n    if (odd == 1) {\n      if (dir == 0 || dir == 1 || dir == 2) { return 1; }\n      if (dir == 4) { return -1; }\n      return 0;\n    }\n    if (dir == 1) { return 1; }\n    if (dir == 3 || dir == 4 || dir == 5) { return -1; }\n    return 0;\n  }\n\n  public static function dirDy(dir:Number):Number {\n    if (dir == 0 || dir == 5) { return -1; }\n    if (dir == 2 || dir == 3) { return 1; }\n    return 0;\n  }\n\n  public static function isWalkableTile(tile:Number):Boolean {\n    return tile == 1 || tile == 2 || tile == 6 || tile == 7 || tile == 10;\n  }\n\n  public static function blocksSightTile(tile:Number):Boolean {\n    return tile == 0 || tile == 3 || tile == 5;\n  }\n\n  public static function providesCoverTile(tile:Number):Boolean {\n    return tile == 3 || tile == 8;\n  }\n\n  // World pixel center of hex (gx, gy) relative to map origin (0,0)\n  public static function hexWorldX(gx:Number, gy:Number):Number {\n    var odd:Number = ((gy % 2) + 2) % 2;\n    return gx * 48 + odd * 24;\n  }\n\n  public static function hexWorldY(gy:Number):Number {\n    return gy * 24;\n  }\n\n  // Exact pixel-to-hex conversion via fractional axial coordinates + cube rounding!\n  public static function worldToHex(wx:Number, wy:Number):Object {\n    var fr:Number = wy / 24.0;\n    var fq:Number = (wx / 48.0) - fr * 0.5;\n    var fs:Number = -fq - fr;\n\n    var rq:Number = Math.round(fq);\n    var rr:Number = Math.round(fr);\n    var rs:Number = Math.round(fs);\n\n    var dq:Number = Math.abs(rq - fq);\n    var dr:Number = Math.abs(rr - fr);\n    var ds:Number = Math.abs(rs - fs);\n\n    if (dq > dr && dq > ds) {\n      rq = -rr - rs;\n    } else if (dr > ds) {\n      rr = -rq - rs;\n    }\n\n    var odd:Number = ((rr % 2) + 2) % 2;\n    var gx:Number = rq + Math.floor((rr - odd) / 2);\n    return { tx: gx, ty: rr };\n  }\n\n  public static function toAxialQ(gx:Number, gy:Number):Number {\n    var odd:Number = ((gy % 2) + 2) % 2;\n    return gx - Math.floor((gy - odd) / 2);\n  }\n\n  // Neighbor hex in direction dir (0..5)\n  public static function neighborHex(gx:Number, gy:Number, dir:Number):Object {\n    var odd:Number = ((gy % 2) + 2) % 2;\n    return { tx: gx + dirDx(odd, dir), ty: gy + dirDy(dir) };\n  }\n\n  // Exact integer hexagonal step distance on the 6-neighbor Fallout hex grid!\n  public static function hexDist(ax:Number, ay:Number, bx:Number, by:Number):Number {\n    var aq:Number = toAxialQ(ax, ay);\n    var bq:Number = toAxialQ(bx, by);\n    var dq:Number = aq - bq;\n    var dr:Number = ay - by;\n    return (Math.abs(dq) + Math.abs(dq + dr) + Math.abs(dr)) * 0.5;\n  }\n\n  // Euclidean distance in hex-width units (used for smooth circular torch/crystal falloff)\n  public static function worldHexDist(ax:Number, ay:Number, bx:Number, by:Number):Number {\n    var dx:Number = (hexWorldX(ax, ay) - hexWorldX(bx, by)) / 48.0;\n    var dy:Number = (hexWorldY(ay) - hexWorldY(by)) / 32.0;\n    return Math.sqrt(dx * dx + dy * dy);\n  }\n\n  // Hexagonal Line-of-Sight using axial linear interpolation + cube rounding\n  public static function hasLineOfSight(\n    grid:Array, mapW:Number, mapH:Number,\n    x0:Number, y0:Number, x1:Number, y1:Number\n  ):Boolean {\n    var n:Number = hexDist(x0, y0, x1, y1);\n    if (n <= 1) { return true; }\n\n    var q0:Number = toAxialQ(x0, y0) + 0.00001;\n    var r0:Number = y0 + 0.00002;\n    var q1:Number = toAxialQ(x1, y1) + 0.00001;\n    var r1:Number = y1 + 0.00002;\n\n    var step:Number = 1;\n    while (step < n) {\n      var t:Number = step / n;\n      var fq:Number = q0 + (q1 - q0) * t;\n      var fr:Number = r0 + (r1 - r0) * t;\n      var fs:Number = -fq - fr;\n\n      var rq:Number = Math.round(fq);\n      var rr:Number = Math.round(fr);\n      var rs:Number = Math.round(fs);\n      var dq:Number = Math.abs(rq - fq);\n      var dr:Number = Math.abs(rr - fr);\n      var ds:Number = Math.abs(rs - fs);\n      if (dq > dr && dq > ds) { rq = -rr - rs; }\n      else if (dr > ds) { rr = -rq - rs; }\n\n      var odd:Number = ((rr % 2) + 2) % 2;\n      var cx:Number = rq + Math.floor((rr - odd) / 2);\n      var cy:Number = rr;\n      if (cx < 0 || cy < 0 || cx >= mapW || cy >= mapH) {\n        return false;\n      }\n      if (blocksSightTile(grid[cy * mapW + cx])) {\n        return false;\n      }\n      step = step + 1;\n    }\n    return true;\n  }\n\n  // Tactical Hex Cover: returns +15 AC bonus if target stands behind an adjacent stalagmite/barricade\n  // relative to the attacker!\n  public static function calcCoverBonus(\n    grid:Array, mapW:Number, mapH:Number,\n    attackerX:Number, attackerY:Number,\n    targetX:Number, targetY:Number\n  ):Number {\n    var baseDist:Number = hexDist(attackerX, attackerY, targetX, targetY);\n    if (baseDist <= 1) { return 0; }\n    var d:Number = 0;\n    while (d < 6) {\n      var nb:Object = neighborHex(targetX, targetY, d);\n      if (nb.tx >= 0 && nb.ty >= 0 && nb.tx < mapW && nb.ty < mapH) {\n        var nt:Number = grid[nb.ty * mapW + nb.tx];\n        if (providesCoverTile(nt)) {\n          if (hexDist(attackerX, attackerY, nb.tx, nb.ty) < baseDist) {\n            return 15;\n          }\n        }\n      }\n      d = d + 1;\n    }\n    return 0;\n  }\n\n  // Updates fogState (0 = unexplored, 1 = explored shroud, 2 = currently visible)\n  // and lightMap (0.0 .. 1.0) around Vault Dweller + local cavern light sources!\n  public static function updateVisibility(\n    grid:Array, mapW:Number, mapH:Number,\n    px:Number, py:Number, sightRadius:Number,\n    fogState:Array, lightMap:Array\n  ):Void {\n    var total:Number = mapW * mapH;\n    var i:Number = 0;\n    while (i < total) {\n      if (fogState[i] == 2) {\n        fogState[i] = 1;\n      }\n      lightMap[i] = 0.24;\n      i = i + 1;\n    }\n\n    var minY:Number = Math.max(0, py - sightRadius - 2);\n    var maxY:Number = Math.min(mapH - 1, py + sightRadius + 2);\n    var y:Number = minY;\n    while (y <= maxY) {\n      var x:Number = 0;\n      while (x < mapW) {\n        var hd:Number = hexDist(px, py, x, y);\n        if (hd <= sightRadius) {\n          var idx:Number = y * mapW + x;\n          if (hasLineOfSight(grid, mapW, mapH, px, py, x, y)) {\n            fogState[idx] = 2;\n            var falloff:Number = 1.0 - (hd / (sightRadius + 2.0)) * 0.68;\n            if (falloff < 0.32) { falloff = 0.32; }\n\n            var t:Number = grid[idx];\n            // Environmental lighting: Sunlit Exit, Airlock 13, Prospector Campfire (13,7), Crystal Canyon\n            if (t == 7) {\n              falloff = 1.0;\n            } else if (x >= 30 && y >= 18 && y <= 23) {\n              falloff = Math.min(1.0, falloff + 0.30);\n            } else if (t == 2) {\n              falloff = Math.min(1.0, falloff + 0.18);\n            } else if (hexDist(x, y, 13, 7) <= 4) {\n              falloff = Math.min(1.0, falloff + 0.24);\n            } else if (hexDist(x, y, 22, 3) <= 3 || hexDist(x, y, 27, 6) <= 3 || hexDist(x, y, 30, 10) <= 3) {\n              falloff = Math.min(1.0, falloff + 0.20);\n            } else if (t == 10 || t == 4) {\n              falloff = Math.min(1.0, falloff + 0.14);\n            }\n            lightMap[idx] = falloff;\n          }\n        }\n        x = x + 1;\n      }\n      y = y + 1;\n    }\n  }\n\n  // 6-Direction Hexagonal A* Pathfinder (1 AP per hex step, smooth world-line tie-breaker!)\n  public static function findPath(\n    grid:Array, mapW:Number, mapH:Number,\n    blockedMask:Array,\n    sx:Number, sy:Number, gx:Number, gy:Number,\n    allowAdjacentGoal:Boolean\n  ):Array {\n    if (sx == gx && sy == gy) { return []; }\n    if (gx < 0 || gy < 0 || gx >= mapW || gy >= mapH) { return []; }\n\n    var goalIdx:Number = gy * mapW + gx;\n    var goalWalkable:Boolean = isWalkableTile(grid[goalIdx]) && !blockedMask[goalIdx];\n    if (!goalWalkable && !allowAdjacentGoal) {\n      return [];\n    }\n\n    var total:Number = mapW * mapH;\n    var gScore:Array = [];\n    var fScore:Array = [];\n    var cameFrom:Array = [];\n    var closed:Array = [];\n    var i:Number = 0;\n    while (i < total) {\n      gScore[i] = 999999;\n      fScore[i] = 999999;\n      cameFrom[i] = -1;\n      closed[i] = false;\n      i = i + 1;\n    }\n\n    var startIdx:Number = sy * mapW + sx;\n    gScore[startIdx] = 0;\n    fScore[startIdx] = hexDist(sx, sy, gx, gy) * 10 + worldHexDist(sx, sy, gx, gy) * 0.25;\n    var open:Array = [startIdx];\n\n    var foundIdx:Number = -1;\n    var safety:Number = 0;\n    while (open.length > 0 && safety < 1100) {\n      safety = safety + 1;\n      var bestPos:Number = 0;\n      var bestIdx:Number = open[0];\n      var bestF:Number = fScore[bestIdx];\n      var k:Number = 1;\n      while (k < open.length) {\n        var cand:Number = open[k];\n        if (fScore[cand] < bestF) {\n          bestF = fScore[cand];\n          bestIdx = cand;\n          bestPos = k;\n        }\n        k = k + 1;\n      }\n      open.splice(bestPos, 1);\n\n      var cx:Number = bestIdx % mapW;\n      var cy:Number = Math.floor(bestIdx / mapW);\n\n      if (goalWalkable && bestIdx == goalIdx) {\n        foundIdx = bestIdx;\n        break;\n      }\n      if (!goalWalkable && allowAdjacentGoal && hexDist(cx, cy, gx, gy) == 1) {\n        foundIdx = bestIdx;\n        break;\n      }\n\n      closed[bestIdx] = true;\n      var odd:Number = ((cy % 2) + 2) % 2;\n      var dIdx:Number = 0;\n      while (dIdx < 6) {\n        var nx:Number = cx + dirDx(odd, dIdx);\n        var ny:Number = cy + dirDy(dIdx);\n        if (nx >= 0 && ny >= 0 && nx < mapW && ny < mapH) {\n          var nIdx:Number = ny * mapW + nx;\n          if (!closed[nIdx] && isWalkableTile(grid[nIdx]) && (!blockedMask[nIdx] || (goalWalkable && nIdx == goalIdx))) {\n            var tentativeG:Number = gScore[bestIdx] + 10;\n            if (tentativeG < gScore[nIdx]) {\n              cameFrom[nIdx] = bestIdx;\n              gScore[nIdx] = tentativeG;\n              fScore[nIdx] = tentativeG + hexDist(nx, ny, gx, gy) * 10 + worldHexDist(nx, ny, gx, gy) * 0.25;\n              var inOpen:Boolean = false;\n              var oi:Number = 0;\n              while (oi < open.length) {\n                if (open[oi] == nIdx) { inOpen = true; break; }\n                oi = oi + 1;\n              }\n              if (!inOpen) {\n                open.push(nIdx);\n              }\n            }\n          }\n        }\n        dIdx = dIdx + 1;\n      }\n    }\n\n    if (foundIdx < 0 || foundIdx == startIdx) {\n      return [];\n    }\n\n    var rev:Array = [];\n    var cur:Number = foundIdx;\n    var rebuildGuard:Number = 0;\n    while (cur != startIdx && cur >= 0 && rebuildGuard < 140) {\n      rev.push({ tx: cur % mapW, ty: Math.floor(cur / mapW) });\n      cur = cameFrom[cur];\n      rebuildGuard = rebuildGuard + 1;\n    }\n    rev.reverse();\n    return rev;\n  }\n\n  // Authentic Fallout 1 Hex To-Hit percentage (clamped 5% .. 95%)\n  public static function calcHitChance(\n    skillPct:Number, perception:Number, hexDistance:Number, maxRange:Number,\n    targetAc:Number, coverAc:Number, partPenalty:Number, flareActive:Boolean, isShotgun:Boolean\n  ):Number {\n    if (hexDistance > maxRange) { return 0; }\n    var chance:Number = skillPct + (perception - 5) * 6 - Math.max(0, hexDistance - 1) * 4 - targetAc - coverAc - partPenalty;\n    if (isShotgun && hexDistance <= 4) {\n      chance = chance + 14; // Close-quarters 12ga spread bonus\n    }\n    if (!flareActive && hexDistance > 5) {\n      chance = chance - 8;  // Dim cavern penalty beyond torchlight\n    }\n    chance = Math.round(chance);\n    if (chance < 5) { chance = 5; }\n    if (chance > 95) { chance = 95; }\n    return chance;\n  }\n}\n"
    },
    {
      "id": "src-49",
      "path": "fallout/ArtGen.as",
      "language": "action_script2",
      "source": "import flash.display.BitmapData;\nimport flash.geom.Rectangle;\n\nclass fallout.ArtGen {\n  // Foreshortened pointy-top hex metrics:\n  // V0=(0,-16), V1=(+24,-8), V2=(+24,+8), V3=(0,+16), V4=(-24,+8), V5=(-24,-8)\n  public static var HALF_W:Number = 24;\n  public static var HEX_RY:Number = 16;\n  public static var HEX_EY:Number = 8;\n\n  public static function argb(a:Number, r:Number, g:Number, b:Number):Number {\n    var ca:Number = Math.max(0, Math.min(255, Math.floor(a)));\n    var cr:Number = Math.max(0, Math.min(255, Math.floor(r)));\n    var cg:Number = Math.max(0, Math.min(255, Math.floor(g)));\n    var cb:Number = Math.max(0, Math.min(255, Math.floor(b)));\n    return ca * 16777216 + cr * 65536 + cg * 256 + cb;\n  }\n\n  public static function rgb(r:Number, g:Number, b:Number):Number {\n    var cr:Number = Math.max(0, Math.min(255, Math.floor(r)));\n    var cg:Number = Math.max(0, Math.min(255, Math.floor(g)));\n    var cb:Number = Math.max(0, Math.min(255, Math.floor(b)));\n    return cr * 65536 + cg * 256 + cb;\n  }\n\n  public static function shadeColor(baseRgb:Number, mult:Number):Number {\n    var r:Number = Math.floor(((baseRgb / 65536) % 256) * mult);\n    var g:Number = Math.floor(((baseRgb / 256) % 256) * mult);\n    var b:Number = Math.floor((baseRgb % 256) * mult);\n    return rgb(r, g, b);\n  }\n\n  public static function hash2d(x:Number, y:Number, seed:Number):Number {\n    var n:Number = (x * 374761 + y * 668265 + seed * 144269) % 1000003;\n    if (n < 0) { n = n + 1000003; }\n    return ((n * 9301 + 49297) % 233280) / 233280;\n  }\n\n  // Synthesize crisp 88x40 procedural BitmapData icons for all 3 weapons + Frag Grenade!\n  // slotKind: 1 = 10mm Colt 6520, 2 = Combat Knife, 3 = Sawed-Off 12ga Shotgun, 4 = Frag Grenade\n  public static function makeWeaponIcon(slotKind:Number):BitmapData {\n    var bmp:BitmapData = new BitmapData(88, 40, true, 0);\n    if (slotKind == 1) {\n      // Colt 6520 10mm revolver-autoloader\n      bmp.fillRect(new Rectangle(18, 10, 48, 8), argb(255, 118, 126, 134));\n      bmp.fillRect(new Rectangle(20, 8,  42, 3), argb(255, 168, 178, 186));\n      bmp.fillRect(new Rectangle(50, 18, 14, 5), argb(255, 78, 86, 92));\n      bmp.fillRect(new Rectangle(64, 11, 6,  5), argb(255, 48, 52, 56));\n      bmp.fillRect(new Rectangle(61, 6,  3,  3), argb(255, 210, 190, 90));\n      bmp.fillRect(new Rectangle(18, 18, 14, 16), argb(255, 112, 66, 36));\n      bmp.fillRect(new Rectangle(20, 20, 10, 12), argb(255, 142, 86, 46));\n      bmp.fillRect(new Rectangle(32, 18, 10, 7),  argb(255, 90, 96, 104));\n      bmp.fillRect(new Rectangle(35, 19, 3,  4),  argb(255, 190, 180, 140));\n    } else if (slotKind == 2) {\n      // Vault-Tec Combat Knife\n      bmp.fillRect(new Rectangle(16, 18, 22, 7), argb(255, 84, 96, 62));\n      bmp.fillRect(new Rectangle(37, 13, 4,  17), argb(255, 160, 148, 88));\n      bmp.fillRect(new Rectangle(41, 16, 32, 8), argb(255, 188, 198, 208));\n      bmp.fillRect(new Rectangle(41, 15, 28, 2), argb(255, 232, 240, 248));\n      bmp.fillRect(new Rectangle(73, 18, 5,  4), argb(255, 210, 220, 230));\n    } else if (slotKind == 3) {\n      // Double-Barrel Sawed-Off 12ga Shotgun (blued twin barrels + walnut stock & forend)\n      bmp.fillRect(new Rectangle(30, 11, 46, 5), argb(255, 74, 82, 92));\n      bmp.fillRect(new Rectangle(30, 15, 46, 4), argb(255, 52, 58, 66));\n      bmp.fillRect(new Rectangle(32, 10, 42, 2), argb(255, 148, 158, 170));\n      bmp.fillRect(new Rectangle(38, 19, 22, 6), argb(255, 126, 72, 34));  // Walnut forend\n      bmp.fillRect(new Rectangle(24, 15, 10, 8), argb(255, 108, 114, 122));// Break-action receiver\n      bmp.fillRect(new Rectangle(10, 19, 16, 13), argb(255, 118, 66, 32)); // Sawed pistol-grip stock\n      bmp.fillRect(new Rectangle(12, 21, 12, 9), argb(255, 148, 88, 44));\n    } else {\n      // Mk II Fragmentation Grenade (olive drab pineapple body + brass spoon/pin)\n      bmp.fillRect(new Rectangle(34, 11, 20, 22), argb(255, 68, 92, 48));\n      bmp.fillRect(new Rectangle(32, 15, 24, 14), argb(255, 84, 112, 58));\n      bmp.fillRect(new Rectangle(36, 18, 16, 2), argb(255, 42, 56, 30));\n      bmp.fillRect(new Rectangle(36, 24, 16, 2), argb(255, 42, 56, 30));\n      bmp.fillRect(new Rectangle(40, 6,  8,  5), argb(255, 168, 156, 92));\n      bmp.fillRect(new Rectangle(48, 8,  8,  14), argb(255, 140, 148, 132)); // Safety lever\n      bmp.fillRect(new Rectangle(34, 6,  5,  5), argb(255, 234, 179, 8));   // Pull ring\n    }\n    return bmp;\n  }\n\n  // Draw a true 6-sided foreshortened pointy-top hexagon centered at (cx, cy)!\n  public static function drawHex(\n    mc:MovieClip, cx:Number, cy:Number, scale:Number,\n    fillCol:Number, fillAlpha:Number,\n    lineCol:Number, lineAlpha:Number, lineW:Number\n  ):Void {\n    var hw:Number = HALF_W * scale;\n    var ry:Number = HEX_RY * scale;\n    var ey:Number = HEX_EY * scale;\n    if (lineW > 0) {\n      mc.lineStyle(lineW, lineCol, lineAlpha);\n    } else {\n      mc.lineStyle(undefined);\n    }\n    mc.beginFill(fillCol, fillAlpha);\n    mc.moveTo(cx,      cy - ry);\n    mc.lineTo(cx + hw, cy - ey);\n    mc.lineTo(cx + hw, cy + ey);\n    mc.lineTo(cx,      cy + ry);\n    mc.lineTo(cx - hw, cy + ey);\n    mc.lineTo(cx - hw, cy - ey);\n    mc.lineTo(cx,      cy - ry);\n    mc.endFill();\n  }\n\n  // Draw 3D 6-sided hexagonal prism walls, Vault 13 Blast Door, stalagmites & cover barricades!\n  public static function drawWallColumn(\n    mc:MovieClip, cx:Number, cy:Number, tile:Number, light:Number, gx:Number, gy:Number\n  ):Void {\n    if (tile == 5) {\n      // Giant Vault 13 Hexagonal Blast Door Bulkhead (#13)!\n      var bh:Number = 44;\n      var topC:Number = shadeColor(0x4B5563, light);\n      var leftC:Number = shadeColor(0x374151, light);\n      var rightC:Number = shadeColor(0x27303F, light);\n      mc.lineStyle(1, shadeColor(0x111827, light), 92);\n\n      // Front-left hex prism face (V5..V4..V3)\n      mc.beginFill(leftC, 100);\n      mc.moveTo(cx - HALF_W, cy + HEX_EY);\n      mc.lineTo(cx,          cy + HEX_RY);\n      mc.lineTo(cx,          cy + HEX_RY - bh);\n      mc.lineTo(cx - HALF_W, cy + HEX_EY - bh);\n      mc.endFill();\n\n      // Front-right hex prism face (V3..V2)\n      mc.beginFill(rightC, 100);\n      mc.moveTo(cx,          cy + HEX_RY);\n      mc.lineTo(cx + HALF_W, cy + HEX_EY);\n      mc.lineTo(cx + HALF_W, cy + HEX_EY - bh);\n      mc.lineTo(cx,          cy + HEX_RY - bh);\n      mc.endFill();\n\n      // Hexagonal steel top cap\n      drawHex(mc, cx, cy - bh, 1.0, topC, 100, shadeColor(0x1F2937, light), 90, 1);\n\n      // Iconic Vault-Tec toothed Gear Emblem & \"13\" on the SE bulkhead face\n      var gearX:Number = cx + 11;\n      var gearY:Number = cy - 12;\n      mc.lineStyle(2.2, shadeColor(0xEAB308, Math.min(1.15, light + 0.25)), 100);\n      mc.beginFill(shadeColor(0x475569, light + 0.1), 100);\n      mc.moveTo(gearX - 9, gearY - 5);\n      mc.lineTo(gearX - 3, gearY - 11);\n      mc.lineTo(gearX + 4, gearY - 11);\n      mc.lineTo(gearX + 9, gearY - 4);\n      mc.lineTo(gearX + 7, gearY + 5);\n      mc.lineTo(gearX,     gearY + 10);\n      mc.lineTo(gearX - 7, gearY + 6);\n      mc.lineTo(gearX - 9, gearY - 5);\n      mc.endFill();\n      mc.lineStyle(2, 0xFACC15, 100);\n      mc.moveTo(gearX - 3, gearY - 4);\n      mc.lineTo(gearX - 3, gearY + 4);\n      mc.moveTo(gearX + 0, gearY - 4);\n      mc.lineTo(gearX + 4, gearY - 4);\n      mc.lineTo(gearX + 4, gearY);\n      mc.lineTo(gearX + 1, gearY);\n      mc.moveTo(gearX + 4, gearY);\n      mc.lineTo(gearX + 4, gearY + 4);\n      mc.lineTo(gearX + 0, gearY + 4);\n      return;\n    }\n\n    if (tile == 3) {\n      // Jagged limestone stalagmite cluster atop a hexagonal cavern floor tile\n      drawHex(mc, cx, cy, 1.0, shadeColor(0x4A4035, light), 100, shadeColor(0x29221B, light), 78, 1);\n      mc.lineStyle(1, shadeColor(0x1E1914, light), 88);\n      mc.beginFill(shadeColor(0x6E5D4B, light), 100);\n      mc.moveTo(cx - 11, cy + 4);\n      mc.lineTo(cx - 2,  cy - 29);\n      mc.lineTo(cx + 2,  cy + 7);\n      mc.endFill();\n\n      mc.beginFill(shadeColor(0x524537, light), 100);\n      mc.moveTo(cx + 2,  cy + 7);\n      mc.lineTo(cx - 2,  cy - 29);\n      mc.lineTo(cx + 11, cy + 3);\n      mc.endFill();\n\n      mc.beginFill(shadeColor(0x7C6A56, light), 100);\n      mc.moveTo(cx + 5,  cy + 6);\n      mc.lineTo(cx + 10, cy - 15);\n      mc.lineTo(cx + 15, cy + 4);\n      mc.endFill();\n      return;\n    }\n\n    if (tile == 8) {\n      // Waist-high pre-War sandbag & steel barricade (provides +15 AC tactical hex cover!)\n      drawHex(mc, cx, cy, 1.0, shadeColor(0x524538, light), 100, shadeColor(0x26201A, light), 75, 1);\n      var bagL:Number = shadeColor(0x857558, light);\n      var bagR:Number = shadeColor(0x695B43, light);\n      var bagT:Number = shadeColor(0x9E8C6B, light);\n      var bh2:Number = 13;\n      mc.lineStyle(1, shadeColor(0x29231A, light), 90);\n      mc.beginFill(bagL, 100);\n      mc.moveTo(cx - 18, cy + 5);\n      mc.lineTo(cx,      cy + 11);\n      mc.lineTo(cx,      cy + 11 - bh2);\n      mc.lineTo(cx - 18, cy + 5 - bh2);\n      mc.endFill();\n      mc.beginFill(bagR, 100);\n      mc.moveTo(cx,      cy + 11);\n      mc.lineTo(cx + 18, cy + 5);\n      mc.lineTo(cx + 18, cy + 5 - bh2);\n      mc.lineTo(cx,      cy + 11 - bh2);\n      mc.endFill();\n      drawHex(mc, cx, cy - bh2, 0.75, bagT, 100, shadeColor(0x3B3325, light), 85, 1);\n      return;\n    }\n\n    // Standard 3D hexagonal basalt/limestone cavern wall column (tile == 0)\n    var jitter:Number = Math.floor((hash2d(gx, gy, 7) - 0.5) * 8);\n    var wh:Number = 30 + jitter;\n    var rockTop:Number = shadeColor(0x3E352C, light);\n    var rockL:Number = shadeColor(0x57493C, light);\n    var rockR:Number = shadeColor(0x2E261F, light);\n\n    mc.lineStyle(1, shadeColor(0x1A1511, light), 85);\n    // Left front facet (V4 -> V3)\n    mc.beginFill(rockL, 100);\n    mc.moveTo(cx - HALF_W, cy + HEX_EY);\n    mc.lineTo(cx,          cy + HEX_RY);\n    mc.lineTo(cx,          cy + HEX_RY - wh);\n    mc.lineTo(cx - HALF_W, cy + HEX_EY - wh);\n    mc.endFill();\n\n    // Right front facet (V3 -> V2)\n    mc.beginFill(rockR, 100);\n    mc.moveTo(cx,          cy + HEX_RY);\n    mc.lineTo(cx + HALF_W, cy + HEX_EY);\n    mc.lineTo(cx + HALF_W, cy + HEX_EY - wh);\n    mc.lineTo(cx,          cy + HEX_RY - wh);\n    mc.endFill();\n\n    // Hexagonal cap\n    drawHex(mc, cx, cy - wh, 1.0, rockTop, 100, shadeColor(0x211B16, light), 85, 1);\n  }\n\n  // Draw the Vault Dweller (#13 jumpsuit or Combat Leather Armor, Pistol / Knife / Sawed-Off 12ga!)\n  public static function drawVaultDweller(\n    mc:MovieClip, sx:Number, sy:Number,\n    facingX:Number, facingY:Number, walkBob:Number,\n    hasLeatherArmor:Boolean, activeSlot:Number, muzzleFlash:Boolean\n  ):Void {\n    // Hexagonal ground shadow\n    drawHex(mc, sx, sy + 2, 0.52, 0x000000, 46, 0x000000, 0, 0);\n\n    var bob:Number = Math.sin(walkBob) * 2.2;\n    var legSwing:Number = Math.sin(walkBob) * 4.0;\n    var suitBlue:Number = 0x2563EB;\n    var suitDark:Number = 0x1D4ED8;\n    var trimGold:Number = 0xFACC15;\n\n    mc.lineStyle(1, 0x0F172A, 90);\n    mc.beginFill(suitDark, 100);\n    mc.moveTo(sx - 6, sy - 12 + bob);\n    mc.lineTo(sx - 2, sy - 12 + bob);\n    mc.lineTo(sx - 3 + legSwing * 0.5, sy + 1);\n    mc.lineTo(sx - 7 + legSwing * 0.5, sy + 1);\n    mc.endFill();\n\n    mc.beginFill(suitDark, 100);\n    mc.moveTo(sx + 2, sy - 12 + bob);\n    mc.lineTo(sx + 6, sy - 12 + bob);\n    mc.lineTo(sx + 7 - legSwing * 0.5, sy + 1);\n    mc.lineTo(sx + 3 - legSwing * 0.5, sy + 1);\n    mc.endFill();\n\n    var torsoFill:Number = hasLeatherArmor ? 0x452719 : suitBlue;\n    mc.beginFill(torsoFill, 100);\n    mc.moveTo(sx - 8, sy - 27 + bob);\n    mc.lineTo(sx + 8, sy - 27 + bob);\n    mc.lineTo(sx + 7, sy - 11 + bob);\n    mc.lineTo(sx - 7, sy - 11 + bob);\n    mc.endFill();\n\n    if (hasLeatherArmor) {\n      // Reinforced wasteland shoulder pauldron\n      mc.beginFill(0x6B3E26, 100);\n      mc.moveTo(sx - 10, sy - 28 + bob);\n      mc.lineTo(sx - 3,  sy - 28 + bob);\n      mc.lineTo(sx - 4,  sy - 23 + bob);\n      mc.lineTo(sx - 10, sy - 24 + bob);\n      mc.endFill();\n    }\n\n    mc.lineStyle(2, trimGold, 100);\n    mc.moveTo(sx, sy - 27 + bob);\n    mc.lineTo(sx, sy - 12 + bob);\n    mc.moveTo(sx - 6, sy - 12 + bob);\n    mc.lineTo(sx + 6, sy - 12 + bob);\n\n    mc.lineStyle(1, 0x1E1B18, 90);\n    mc.beginFill(0xE6B89C, 100);\n    mc.moveTo(sx - 5, sy - 36 + bob);\n    mc.lineTo(sx + 5, sy - 36 + bob);\n    mc.lineTo(sx + 5, sy - 27 + bob);\n    mc.lineTo(sx - 5, sy - 27 + bob);\n    mc.endFill();\n    mc.beginFill(0x3B2618, 100);\n    mc.moveTo(sx - 5, sy - 38 + bob);\n    mc.lineTo(sx + 5, sy - 38 + bob);\n    mc.lineTo(sx + 5, sy - 34 + bob);\n    mc.lineTo(sx - 5, sy - 34 + bob);\n    mc.endFill();\n\n    var aimDx:Number = facingX * 11;\n    var aimDy:Number = facingY * 6;\n    mc.lineStyle(2.5, hasLeatherArmor ? 0x5C3422 : suitBlue, 100);\n    mc.moveTo(sx - 7, sy - 24 + bob);\n    mc.lineTo(sx - 9, sy - 17 + bob);\n    mc.lineStyle(2, 0x4ADE80, 100);\n    mc.moveTo(sx - 9, sy - 18 + bob);\n    mc.lineTo(sx - 9, sy - 16 + bob);\n\n    mc.lineStyle(2.5, hasLeatherArmor ? 0x5C3422 : suitBlue, 100);\n    mc.moveTo(sx + 5, sy - 24 + bob);\n    mc.lineTo(sx + 4 + aimDx * 0.7, sy - 20 + bob + aimDy * 0.7);\n\n    if (activeSlot == 1 || activeSlot == 3) {\n      var barrelCol:Number = (activeSlot == 3) ? 0x64748B : 0x94A3B8;\n      var barrelLen:Number = (activeSlot == 3) ? 1.65 : 1.35;\n      mc.lineStyle(activeSlot == 3 ? 3.0 : 2.2, barrelCol, 100);\n      mc.moveTo(sx + 4 + aimDx * 0.7, sy - 20 + bob + aimDy * 0.7);\n      mc.lineTo(sx + 4 + aimDx * barrelLen, sy - 20 + bob + aimDy * barrelLen);\n      if (muzzleFlash) {\n        var mx:Number = sx + 4 + aimDx * (barrelLen + 0.25);\n        var my:Number = sy - 20 + bob + aimDy * (barrelLen + 0.25);\n        var fSize:Number = (activeSlot == 3) ? 9 : 6;\n        mc.lineStyle(undefined);\n        mc.beginFill(0xFEF08A, 95);\n        mc.moveTo(mx - fSize, my);\n        mc.lineTo(mx, my - fSize);\n        mc.lineTo(mx + fSize, my);\n        mc.lineTo(mx, my + fSize);\n        mc.endFill();\n      }\n    } else {\n      mc.lineStyle(2, 0xE2E8F0, 100);\n      mc.moveTo(sx + 4 + aimDx * 0.7, sy - 20 + bob + aimDy * 0.7);\n      mc.lineTo(sx + 4 + aimDx * 1.45, sy - 22 + bob + aimDy * 1.45);\n    }\n  }\n\n  // Draw Cave Rat / Pig-Rat / Brood Mother (kind 1..3) OR Armored Cave Radscorpion (kind 4)!\n  public static function drawEnemy(\n    mc:MovieClip, sx:Number, sy:Number,\n    kind:Number, alive:Boolean, hpRatio:Number, animTick:Number, targeted:Boolean\n  ):Void {\n    if (!alive) {\n      mc.lineStyle(undefined);\n      mc.beginFill(kind == 4 ? 0x365314 : 0x7F1D1D, 85);\n      mc.moveTo(sx - 13, sy);\n      mc.lineTo(sx + 2, sy - 6);\n      mc.lineTo(sx + 14, sy + 1);\n      mc.lineTo(sx - 2, sy + 6);\n      mc.endFill();\n      mc.beginFill(kind == 4 ? 0x44403C : (kind == 3 ? 0x3F2E26 : 0x574437), 95);\n      mc.moveTo(sx - 10, sy - 3);\n      mc.lineTo(sx + 9, sy - 4);\n      mc.lineTo(sx + 11, sy + 2);\n      mc.lineTo(sx - 8, sy + 2);\n      mc.endFill();\n      return;\n    }\n\n    var scale:Number = (kind == 3) ? 1.42 : ((kind == 4) ? 1.22 : ((kind == 2) ? 1.15 : 0.94));\n    var scur:Number = Math.sin(animTick * 0.25 + sx * 0.1) * 1.5;\n\n    if (targeted) {\n      drawHex(mc, sx, sy, 0.86, 0xEF4444, 22, 0xEF4444, 95, 1.8);\n    } else {\n      drawHex(mc, sx, sy + 1, 0.55 * scale, 0x000000, 40, 0x000000, 0, 0);\n    }\n\n    if (kind == 4) {\n      // Cave Radscorpion: chitinous segmented carapace, 6 legs, twin claws & overhead venomous stinger!\n      mc.lineStyle(1.4, 0x1C1917, 95);\n      // Chitin legs\n      mc.moveTo(sx - 8, sy - 2); mc.lineTo(sx - 15, sy + 5 + scur * 0.4);\n      mc.moveTo(sx - 2, sy - 2); mc.lineTo(sx - 6,  sy + 7 - scur * 0.4);\n      mc.moveTo(sx + 4, sy - 2); mc.lineTo(sx + 8,  sy + 6 + scur * 0.4);\n\n      // Segmented dark-amber chitin body\n      mc.beginFill(0x57412D, 100);\n      mc.moveTo(sx - 12, sy - 4);\n      mc.lineTo(sx - 4,  sy - 11);\n      mc.lineTo(sx + 9,  sy - 10);\n      mc.lineTo(sx + 13, sy - 3);\n      mc.lineTo(sx + 5,  sy + 2);\n      mc.lineTo(sx - 10, sy + 1);\n      mc.endFill();\n\n      // Twin snapping pincer claws\n      mc.lineStyle(2, 0x785A3C, 100);\n      mc.moveTo(sx + 10, sy - 7);\n      mc.lineTo(sx + 19, sy - 11 + scur * 0.5);\n      mc.moveTo(sx + 10, sy - 3);\n      mc.lineTo(sx + 19, sy + 2 - scur * 0.5);\n\n      // Arched segmented tail & glowing green venom stinger!\n      mc.lineStyle(2.2, 0x6B4F37, 100);\n      mc.moveTo(sx - 11, sy - 6);\n      mc.lineTo(sx - 16, sy - 15);\n      mc.lineTo(sx - 8,  sy - 23 + scur * 0.6);\n      mc.lineTo(sx + 1,  sy - 21 + scur * 0.6);\n      mc.lineStyle(undefined);\n      mc.beginFill(0x84CC16, 100);\n      mc.moveTo(sx + 1, sy - 23 + scur * 0.6);\n      mc.lineTo(sx + 6, sy - 19 + scur * 0.6);\n      mc.lineTo(sx + 1, sy - 18 + scur * 0.6);\n      mc.endFill();\n    } else {\n      // Cave Rat / Pig-Rat / Giant Brood Mother\n      var furCol:Number = (kind == 3) ? 0x4A251D : ((kind == 2) ? 0x6B4C35 : 0x78614E);\n      var spineCol:Number = (kind == 3) ? 0xDC2626 : ((kind == 2) ? 0x65A30D : 0x574537);\n\n      mc.lineStyle(1.8, 0xBE7C76, 90);\n      mc.moveTo(sx - 9 * scale, sy - 5 * scale);\n      mc.lineTo(sx - 18 * scale, sy - 2 * scale + scur);\n\n      mc.lineStyle(1, 0x1C140E, 90);\n      mc.beginFill(furCol, 100);\n      mc.moveTo(sx - 10 * scale, sy - 3 * scale);\n      mc.lineTo(sx - 5 * scale, sy - 13 * scale + scur * 0.4);\n      mc.lineTo(sx + 6 * scale, sy - 11 * scale);\n      mc.lineTo(sx + 13 * scale, sy - 5 * scale);\n      mc.lineTo(sx + 8 * scale, sy + 1);\n      mc.lineTo(sx - 8 * scale, sy + 1);\n      mc.endFill();\n\n      mc.lineStyle(1.6, spineCol, 95);\n      mc.moveTo(sx - 5 * scale, sy - 12 * scale);\n      mc.lineTo(sx + 5 * scale, sy - 10 * scale);\n\n      mc.lineStyle(undefined);\n      mc.beginFill(kind == 3 ? 0xFACC15 : 0xEF4444, 100);\n      mc.moveTo(sx + 7 * scale, sy - 9 * scale);\n      mc.lineTo(sx + 10 * scale, sy - 9 * scale);\n      mc.lineTo(sx + 10 * scale, sy - 7 * scale);\n      mc.lineTo(sx + 7 * scale, sy - 7 * scale);\n      mc.endFill();\n    }\n\n    // Overhead HP bar when wounded or targeted\n    if (hpRatio < 0.999 || targeted) {\n      var bw:Number = 28 * scale;\n      var bx:Number = sx - bw * 0.5;\n      var by:Number = sy - (kind == 4 ? 28 : 20 * scale);\n      mc.lineStyle(1, 0x090D0A, 90);\n      mc.beginFill(0x1F2937, 90);\n      mc.moveTo(bx, by);\n      mc.lineTo(bx + bw, by);\n      mc.lineTo(bx + bw, by + 4);\n      mc.lineTo(bx, by + 4);\n      mc.endFill();\n\n      mc.lineStyle(undefined);\n      mc.beginFill(hpRatio > 0.45 ? 0x4ADE80 : 0xEF4444, 100);\n      var fw:Number = Math.max(2, bw * hpRatio);\n      mc.moveTo(bx, by);\n      mc.lineTo(bx + fw, by);\n      mc.lineTo(bx + fw, by + 4);\n      mc.lineTo(bx, by + 4);\n      mc.endFill();\n    }\n  }\n\n  // Draw Containers, Vault Terminals, Shootable Explosive Rad-Drums, Campfires & Crystals!\n  public static function drawContainerOrProp(\n    mc:MovieClip, sx:Number, sy:Number, kind:String, looted:Boolean, highlight:Boolean, animTick:Number\n  ):Void {\n    var outlineCol:Number = highlight ? 0xFACC15 : 0x111827;\n    var outlineW:Number = highlight ? 2.0 : 1.0;\n\n    if (kind == \"corpse\" || kind == \"prospector\") {\n      var suitCol:Number = (kind == \"prospector\") ? 0x5C4033 : 0x1E3A8A;\n      mc.lineStyle(outlineW, outlineCol, 90);\n      mc.beginFill(suitCol, 100);\n      mc.moveTo(sx - 12, sy - 1);\n      mc.lineTo(sx + 6, sy - 5);\n      mc.lineTo(sx + 10, sy + 2);\n      mc.lineTo(sx - 8, sy + 5);\n      mc.endFill();\n      if (kind == \"corpse\") {\n        mc.lineStyle(1.8, 0xEAB308, 95);\n        mc.moveTo(sx - 4, sy - 2);\n        mc.lineTo(sx + 4, sy);\n      }\n      mc.lineStyle(1, 0x334155, 90);\n      mc.beginFill(0xE2E8F0, 100);\n      mc.moveTo(sx - 15, sy - 4);\n      mc.lineTo(sx - 9, sy - 6);\n      mc.lineTo(sx - 8, sy);\n      mc.lineTo(sx - 14, sy + 1);\n      mc.endFill();\n      if (!looted) {\n        mc.lineStyle(2.2, kind == \"prospector\" ? 0xFACC15 : 0x93C5FD, 100);\n        mc.moveTo(sx + 7, sy + 3);\n        mc.lineTo(sx + 15, sy);\n      }\n      return;\n    }\n\n    if (kind == \"terminal\") {\n      // Vault-Tec Mainframe CRT Console!\n      mc.lineStyle(outlineW, outlineCol, 95);\n      mc.beginFill(0x334155, 100);\n      mc.moveTo(sx - 11, sy - 24);\n      mc.lineTo(sx + 11, sy - 24);\n      mc.lineTo(sx + 12, sy + 2);\n      mc.lineTo(sx - 12, sy + 2);\n      mc.endFill();\n      // Glowing green phosphor CRT screen\n      mc.lineStyle(1, 0x14532D, 90);\n      mc.beginFill(looted ? 0x166534 : 0x22C55E, 95);\n      mc.moveTo(sx - 8, sy - 21);\n      mc.lineTo(sx + 8, sy - 21);\n      mc.lineTo(sx + 8, sy - 11);\n      mc.lineTo(sx - 8, sy - 11);\n      mc.endFill();\n      return;\n    }\n\n    if (kind == \"locker\" || kind == \"footlocker\") {\n      var boxFill:Number = (kind == \"locker\") ? 0x475569 : 0x78350F;\n      var lidFill:Number = (kind == \"locker\") ? 0x64748B : 0x92400E;\n      mc.lineStyle(outlineW, outlineCol, 95);\n      mc.beginFill(boxFill, 100);\n      mc.moveTo(sx - 11, sy - 10);\n      mc.lineTo(sx + 11, sy - 10);\n      mc.lineTo(sx + 11, sy + 3);\n      mc.lineTo(sx - 11, sy + 3);\n      mc.endFill();\n      mc.beginFill(lidFill, 100);\n      mc.moveTo(sx - 12, sy - 14);\n      mc.lineTo(sx + 12, sy - 14);\n      mc.lineTo(sx + 11, sy - 10);\n      mc.lineTo(sx - 11, sy - 10);\n      mc.endFill();\n      mc.lineStyle(undefined);\n      mc.beginFill(looted ? 0x475569 : 0x4ADE80, 100);\n      mc.moveTo(sx - 2, sy - 7);\n      mc.lineTo(sx + 2, sy - 7);\n      mc.lineTo(sx + 2, sy - 4);\n      mc.lineTo(sx - 2, sy - 4);\n      mc.endFill();\n      return;\n    }\n\n    if (kind == \"bones\") {\n      mc.lineStyle(outlineW, outlineCol, 85);\n      mc.beginFill(0xD6D3D1, 100);\n      mc.moveTo(sx - 9, sy - 3);\n      mc.lineTo(sx + 8, sy + 2);\n      mc.lineTo(sx + 6, sy + 5);\n      mc.lineTo(sx - 10, sy);\n      mc.endFill();\n      if (!looted) {\n        mc.beginFill(0xEF4444, 100);\n        mc.moveTo(sx + 2, sy - 6);\n        mc.lineTo(sx + 7, sy - 6);\n        mc.lineTo(sx + 7, sy - 2);\n        mc.lineTo(sx + 2, sy - 2);\n        mc.endFill();\n      }\n      return;\n    }\n\n    if (kind == \"explosive_barrel\") {\n      if (looted) {\n        // Detonated scorched crater!\n        drawHex(mc, sx, sy, 0.72, 0x18181B, 78, 0x451A03, 70, 1);\n        return;\n      }\n      if (highlight) {\n        drawHex(mc, sx, sy, 0.85, 0xF97316, 22, 0xEF4444, 95, 1.8);\n      }\n      // Red/yellow volatile rad-fuel drum!\n      mc.lineStyle(1, 0x14532D, 85);\n      mc.beginFill(0x84CC16, 55);\n      mc.moveTo(sx - 12, sy + 1);\n      mc.lineTo(sx + 12, sy + 3);\n      mc.lineTo(sx + 5, sy + 7);\n      mc.lineTo(sx - 9, sy + 5);\n      mc.endFill();\n\n      mc.lineStyle(outlineW, highlight ? 0xFACC15 : 0x1F2937, 95);\n      mc.beginFill(0xDC2626, 100);\n      mc.moveTo(sx - 8, sy - 19);\n      mc.lineTo(sx + 8, sy - 19);\n      mc.lineTo(sx + 8, sy + 1);\n      mc.lineTo(sx - 8, sy + 1);\n      mc.endFill();\n      // Hazard yellow stripe\n      mc.beginFill(0xFACC15, 100);\n      mc.moveTo(sx - 8, sy - 12);\n      mc.lineTo(sx + 8, sy - 12);\n      mc.lineTo(sx + 8, sy - 7);\n      mc.lineTo(sx - 8, sy - 7);\n      mc.endFill();\n      return;\n    }\n\n    if (kind == \"campfire\") {\n      var flick:Number = Math.sin(animTick * 0.35) * 3.0;\n      drawHex(mc, sx, sy + 1, 0.58, 0x7C2D12, 42, 0x000000, 0, 0);\n      mc.lineStyle(2, 0x451A03, 95);\n      mc.moveTo(sx - 9, sy + 3); mc.lineTo(sx + 9, sy - 2);\n      mc.moveTo(sx - 8, sy - 2); mc.lineTo(sx + 8, sy + 3);\n      mc.lineStyle(undefined);\n      mc.beginFill(0xF97316, 92);\n      mc.moveTo(sx - 7, sy);\n      mc.lineTo(sx, sy - 16 - flick);\n      mc.lineTo(sx + 7, sy);\n      mc.endFill();\n      mc.beginFill(0xFEF08A, 95);\n      mc.moveTo(sx - 4, sy);\n      mc.lineTo(sx, sy - 10 - flick * 0.6);\n      mc.lineTo(sx + 4, sy);\n      mc.endFill();\n      return;\n    }\n\n    if (kind == \"crystal\") {\n      mc.lineStyle(1, 0x064E3B, 90);\n      mc.beginFill(0x10B981, 90);\n      mc.moveTo(sx - 8, sy + 2);\n      mc.lineTo(sx - 3, sy - 22);\n      mc.lineTo(sx + 3, sy + 3);\n      mc.endFill();\n      mc.beginFill(0x34D399, 95);\n      mc.moveTo(sx + 1, sy + 3);\n      mc.lineTo(sx + 7, sy - 17);\n      mc.lineTo(sx + 11, sy + 2);\n      mc.endFill();\n      return;\n    }\n\n    if (kind == \"beacon\" || kind == \"rad_sign\") {\n      mc.lineStyle(1, 0x1E293B, 90);\n      mc.beginFill(0x475569, 100);\n      mc.moveTo(sx - 3, sy - 16);\n      mc.lineTo(sx + 3, sy - 16);\n      mc.lineTo(sx + 4, sy + 1);\n      mc.lineTo(sx - 4, sy + 1);\n      mc.endFill();\n      mc.lineStyle(undefined);\n      mc.beginFill(kind == \"rad_sign\" ? 0xA3E635 : 0xF59E0B, 95);\n      mc.moveTo(sx - 5, sy - 22);\n      mc.lineTo(sx + 5, sy - 22);\n      mc.lineTo(sx + 5, sy - 15);\n      mc.lineTo(sx - 5, sy - 15);\n      mc.endFill();\n      return;\n    }\n\n    if (kind == \"timber\") {\n      mc.lineStyle(1, 0x291D12, 90);\n      mc.beginFill(0x784B2A, 100);\n      mc.moveTo(sx - 4, sy - 28);\n      mc.lineTo(sx + 4, sy - 28);\n      mc.lineTo(sx + 4, sy + 2);\n      mc.lineTo(sx - 4, sy + 2);\n      mc.endFill();\n    }\n  }\n}\n"
    }
  ],
