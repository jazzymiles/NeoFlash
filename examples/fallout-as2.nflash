            "script": {
              "language": "action_script2",
              "source": "import flash.display.BitmapData;\nimport flash.filters.GlowFilter;\nimport fallout.VaultData;\nimport fallout.PathLos;\nimport fallout.ArtGen;\n\nstop();\n\n// --- Stage & Viewport Geometry (800x520 @ 30 fps) ---\nvar STAGE_W:Number = 800;\nvar STAGE_H:Number = 520;\nvar VIEW_W:Number = 800;\nvar VIEW_H:Number = 392;\nvar MAP_W:Number = VaultData.MAP_W;\nvar MAP_H:Number = VaultData.MAP_H;\n\n// --- Load XML Catalog (3 Weapons, V.A.T.S. Parts, Overseer Holodisk) ---\nvar catalog:Object = VaultData.loadCatalogXml();\nvar weaponDefs:Object = catalog.weapons;\nvar vatsParts:Array = catalog.vatsParts;\n\n// --- Stage Symbol Containers (authored via --headless batch) ---\nvar worldHolder:MovieClip = this.worldViewport;\nif (worldHolder == undefined) {\n  worldHolder = this.createEmptyMovieClip(\"worldFallback\", 5);\n}\nvar terrainBands:Array = [];\nvar tbi:Number = 0;\nwhile (tbi < 7) {\n  terrainBands.push(worldHolder.createEmptyMovieClip(\"terrainBand_\" + tbi, 8 + tbi));\n  tbi = tbi + 1;\n}\nvar radGlowClip:MovieClip = worldHolder.createEmptyMovieClip(\"radGlowClip\", 16);\nradGlowClip.filters = [new GlowFilter(0x4ADE80, 0.85, 10, 10, 2, 1, false, false)];\nvar cursorClip:MovieClip = worldHolder.createEmptyMovieClip(\"cursorClip\", 20);\nvar entitiesClip:MovieClip = worldHolder.createEmptyMovieClip(\"entitiesClip\", 30);\nvar fxClip:MovieClip = worldHolder.createEmptyMovieClip(\"fxClip\", 40);\n\n// Live Top-Right Hex Radar Minimap (split into 2 band clips to stay well under 4096-op Graphics batch cap)\nvar radarClip:MovieClip = this.createEmptyMovieClip(\"radarClip\", 480);\nvar radarBandB:MovieClip = this.createEmptyMovieClip(\"radarBandB\", 481);\nvar showRadar:Boolean = true;\n\nvar weaponBayHolder:MovieClip = this.weaponBayClip;\nif (weaponBayHolder == undefined) {\n  weaponBayHolder = this.createEmptyMovieClip(\"weaponBayFallback\", 510);\n  weaponBayHolder._x = 374;\n  weaponBayHolder._y = 444;\n}\nvar weaponIconClip:MovieClip = weaponBayHolder.createEmptyMovieClip(\"iconBmpHolder\", 10);\nvar pistolBmp:BitmapData = ArtGen.makeWeaponIcon(1);\nvar knifeBmp:BitmapData = ArtGen.makeWeaponIcon(2);\nvar shotgunBmp:BitmapData = ArtGen.makeWeaponIcon(3);\nvar grenadeBmp:BitmapData = ArtGen.makeWeaponIcon(4);\n\nvar apRackHolder:MovieClip = this.apRackClip;\nif (apRackHolder == undefined) {\n  apRackHolder = this.createEmptyMovieClip(\"apRackFallback\", 520);\n  apRackHolder._x = 400;\n  apRackHolder._y = 412;\n}\nvar apCanvas:MovieClip = apRackHolder.createEmptyMovieClip(\"apLeds\", 10);\n\nvar hudButtonsDecor:MovieClip = this.createEmptyMovieClip(\"hudButtonsDecor\", 530);\n\nvar overlayHolder:MovieClip = this.modalOverlay;\nif (overlayHolder == undefined) {\n  overlayHolder = this.createEmptyMovieClip(\"modalFallback\", 900);\n}\nvar modalBgClip:MovieClip = overlayHolder.createEmptyMovieClip(\"modalBg\", 10);\nvar modalMapClipA:MovieClip = overlayHolder.createEmptyMovieClip(\"modalMapA\", 11);\nvar modalMapClipB:MovieClip = overlayHolder.createEmptyMovieClip(\"modalMapB\", 12);\noverlayHolder.createTextField(\"modalTitleTf\", 20, 136, 44, 528, 26);\noverlayHolder.createTextField(\"modalBodyTf\", 30, 140, 76, 520, 286);\nvar modalTitleTf:TextField = overlayHolder.modalTitleTf;\nvar modalBodyTf:TextField = overlayHolder.modalBodyTf;\nmodalTitleTf.selectable = false;\nmodalBodyTf.selectable = false;\nmodalBodyTf.multiline = true;\nmodalBodyTf.wordWrap = true;\nmodalBodyTf.html = true;\n\nvar titleFmt:TextFormat = new TextFormat();\ntitleFmt.font = \"Courier New\";\ntitleFmt.size = 15;\ntitleFmt.bold = true;\ntitleFmt.color = 0x4ADE80;\n\nvar bodyFmt:TextFormat = new TextFormat();\nbodyFmt.font = \"Courier New\";\nbodyFmt.size = 12;\nbodyFmt.color = 0xBBF7D0;\nmodalBodyTf.setNewTextFormat(bodyFmt);\n\nvar vatsRowFmt:TextFormat = new TextFormat();\nvatsRowFmt.font = \"Courier New\";\nvatsRowFmt.size = 12;\nvatsRowFmt.bold = true;\nvatsRowFmt.color = 0x86EFAC;\n\nvar vatsRowTfs:Array = [];\nvar vri:Number = 0;\nwhile (vri < 5) {\n  var vrName:String = \"vatsRowTf_\" + vri;\n  overlayHolder.createTextField(vrName, 40 + vri, 152, 92 + vri * 44, 252, 22);\n  var vrtf:TextField = overlayHolder[vrName];\n  vrtf.selectable = false;\n  vrtf.html = true;\n  vrtf.setNewTextFormat(vatsRowFmt);\n  vatsRowTfs.push(vrtf);\n  vri = vri + 1;\n}\n\n// Floating damage / bark TextField pool & expanding blast rings\nvar floatTexts:Array = [];\nvar floatPoolIdx:Number = 0;\nvar blastEffects:Array = [];\n\n// --- Sound Bank (12 PCM WAV assets imported via --headless import) ---\nvar sfx:Object = {};\nfunction bindSfx(id:String):Sound {\n  var s:Sound = new Sound();\n  s.attachSound(id);\n  s.setVolume(75);\n  return s;\n}\nsfx.pistol = bindSfx(\"pistol10mm\");\nsfx.shotgun = bindSfx(\"shotgun\");\nsfx.knife = bindSfx(\"knife\");\nsfx.explosion = bindSfx(\"explosion\");\nsfx.ratSqueak = bindSfx(\"rat_squeak\");\nsfx.ratDeath = bindSfx(\"rat_death\");\nsfx.klaxon = bindSfx(\"klaxon\");\nsfx.pipboy = bindSfx(\"pipboy\");\nsfx.stimpak = bindSfx(\"stimpak\");\nsfx.step = bindSfx(\"step\");\nsfx.hurt = bindSfx(\"hurt\");\nsfx.escape = bindSfx(\"escape\");\n\nfunction playSound(snd:Sound, pan:Number, vol:Number):Void {\n  if (snd == undefined) { return; }\n  snd.setPan(Math.max(-100, Math.min(100, Math.round(pan))));\n  snd.setVolume(Math.max(0, Math.min(100, Math.round(vol))));\n  snd.start(0, 1);\n}\n\n// --- S.P.E.C.I.A.L. Character & Hex Grid State ---\nvar gridMode:String = \"hex\";\nvar hexNeighborCount:Number = 6;\n\nvar specStats:Object = {\n  st: 6, pe: 7, en: 6, ch: 5, intel: 7, ag: 8, lk: 7,\n  smallGuns: 78, melee: 65, throwing: 72, science: 75, firstAid: 55\n};\n\nvar grid:Array = [];\nvar fogState:Array = [];\nvar lightMap:Array = [];\nvar blockedMask:Array = [];\nvar enemies:Array = [];\nvar containers:Array = [];\nvar barrels:Array = [];\nvar propsList:Array = [];\n\nvar playerTx:Number = 3;\nvar playerTy:Number = 4;\nvar drawWx:Number = 0;\nvar drawWy:Number = 0;\nvar stepFromWx:Number = 0;\nvar stepFromWy:Number = 0;\nvar facingDx:Number = 1.0;\nvar facingDy:Number = 0.2;\nvar walkQueue:Array = [];\nvar stepProgress:Number = 1.0;\nvar walkBobPhase:Number = 0.0;\nvar pendingContainerIdx:Number = -1;\n\nvar level:Number = 1;\nvar xp:Number = 0;\nvar maxHp:Number = 36;\nvar hp:Number = 36;\nvar rads:Number = 0;\nvar poisonTurns:Number = 0;\nvar maxAp:Number = 9;\nvar ap:Number = 9;\nvar baseAc:Number = 8;\nvar hasLeatherArmor:Boolean = false;\nvar unlockedLeatherArmor:Boolean = false;\nvar unlockedShotgun:Boolean = false;\nvar terminalHacked:Boolean = false;\nvar hasHolodisk:Boolean = false;\n\nvar activeSlot:Number = 1; // 1 = 10mm Pistol, 2 = Combat Knife, 3 = Sawed-Off 12ga\nvar fireMode:Number = 0;   // 0 = SINGLE, 1 = AIMED (V.A.T.S.), 2 = RELOAD\nvar grenadeMode:Boolean = false;\nvar magAmmo:Number = 12;\nvar reserveAmmo:Number = 16;\nvar shotgunMag:Number = 2;\nvar shells12ga:Number = 0;\nvar grenades:Number = 1;\nvar stimpaks:Number = 1;\nvar radaways:Number = 0;\nvar flares:Number = 0;\nvar flareTurns:Number = 0;\n\nvar inCombat:Boolean = false;\nvar combatTurn:String = \"player\";\nvar turnNumber:Number = 1;\nvar aiActorIdx:Number = 0;\nvar aiWaitFrames:Number = 0;\n\nvar modalMode:String = \"\"; // \"\" | \"vats\" | \"inv\" | \"cha\" | \"pip\" | \"end\"\nvar pipTab:Number = 0;     // 0 = Objectives/Holodisk, 1 = Hex Automap\nvar vatsTargetIdx:Number = -1;\n\nvar shotsFired:Number = 0;\nvar shotsHit:Number = 0;\nvar killsCount:Number = 0;\nvar gameOver:Boolean = false;\nvar escapedCavern:Boolean = false;\n\nvar camX:Number = 260;\nvar camY:Number = 100;\nvar camPanX:Number = 0;\nvar camPanY:Number = 0;\nvar shakeTimer:Number = 0;\nvar terrainDirty:Boolean = true;\nvar radarDirty:Boolean = true;\n\nvar muzzleTimer:Number = 0;\nvar tracerTimer:Number = 0;\nvar tracerWx0:Number = 0;\nvar tracerWy0:Number = 0;\nvar tracerWx1:Number = 0;\nvar tracerWy1:Number = 0;\nvar tracerCol:Number = 0xFEF08A;\n\nvar hoverTx:Number = -1;\nvar hoverTy:Number = -1;\nvar hoverPath:Array = [];\nvar hoverEnemyIdx:Number = -1;\nvar hoverContainerIdx:Number = -1;\nvar hoverBarrelIdx:Number = -1;\n\nvar logLines:Array = [];\nvar tickCounter:Number = 0;\nvar fpsValue:Number = 30;\nvar fpsFrames:Number = 0;\nvar fpsLastMs:Number = getTimer();\n\n// --- Hex Screen Coordinate Helpers ---\nfunction hexScreenX(tx:Number, ty:Number):Number {\n  return PathLos.hexWorldX(tx, ty) + camX;\n}\nfunction hexScreenY(ty:Number):Number {\n  return PathLos.hexWorldY(ty) + camY;\n}\nfunction screenToHex(sx:Number, sy:Number):Object {\n  return PathLos.worldToHex(sx - camX, sy - camY);\n}\n\n// --- CRT Log & Floating Popups ---\nfunction escHtml(raw:String):String {\n  var s:String = String(raw);\n  s = s.split(\"&\").join(\"&amp;\");\n  s = s.split(\"<\").join(\"&lt;\");\n  s = s.split(\">\").join(\"&gt;\");\n  return s;\n}\n\nfunction addLog(msg:String, hexColor:String):Void {\n  var col:String = (hexColor != undefined && hexColor != \"\") ? hexColor : \"#4ADE80\";\n  logLines.push(\"<font color='\" + col + \"'>• \" + escHtml(msg) + \"</font>\");\n  if (logLines.length > 40) {\n    logLines.shift();\n  }\n  refreshLogField();\n  trace(\"[FALLOUT-HEX] \" + msg);\n}\n\nfunction refreshLogField():Void {\n  if (this.logText == undefined) { return; }\n  this.logText.html = true;\n  this.logText.htmlText = \"<font face='Courier New' size='11' color='#4ADE80'>\" + logLines.join(\"<br>\") + \"</font>\";\n  if (this.logText.maxscroll != undefined && this.logText.maxscroll > 1) {\n    this.logText.scroll = this.logText.maxscroll;\n  }\n}\n\nfunction scrollLog(delta:Number):Void {\n  if (this.logText == undefined) { return; }\n  var nextScroll:Number = this.logText.scroll + delta;\n  if (nextScroll < 1) { nextScroll = 1; }\n  if (this.logText.maxscroll != undefined && nextScroll > this.logText.maxscroll) {\n    nextScroll = this.logText.maxscroll;\n  }\n  this.logText.scroll = nextScroll;\n}\n\nfunction spawnFloatText(tx:Number, ty:Number, label:String, colorNum:Number):Void {\n  floatPoolIdx = (floatPoolIdx + 1) % 28;\n  var name:String = \"flt_\" + floatPoolIdx;\n  var holder:MovieClip = fxClip.createEmptyMovieClip(name, 200 + floatPoolIdx);\n  holder.createTextField(\"tf\", 1, -66, -34, 132, 22);\n  var tf:TextField = holder.tf;\n  tf.selectable = false;\n  var fmt:TextFormat = new TextFormat();\n  fmt.font = \"Arial\";\n  fmt.size = 12;\n  fmt.bold = true;\n  fmt.align = \"center\";\n  fmt.color = colorNum;\n  tf.text = label;\n  tf.setTextFormat(fmt);\n  floatTexts.push({\n    mc: holder,\n    wx: PathLos.hexWorldX(tx, ty),\n    wy: PathLos.hexWorldY(ty),\n    rise: 0,\n    ttl: 36\n  });\n}\n\nfunction spawnBlastEffect(tx:Number, ty:Number):Void {\n  blastEffects.push({\n    wx: PathLos.hexWorldX(tx, ty),\n    wy: PathLos.hexWorldY(ty),\n    age: 0,\n    maxAge: 16\n  });\n  shakeTimer = 10;\n}\n\n// --- Blocking & Hex Entity Queries ---\nfunction rebuildBlockedMask(excludeEnemyIdx:Number, includePlayer:Boolean):Void {\n  var total:Number = MAP_W * MAP_H;\n  var i:Number = 0;\n  while (i < total) {\n    blockedMask[i] = false;\n    i = i + 1;\n  }\n  i = 0;\n  while (i < containers.length) {\n    var c:Object = containers[i];\n    if (c.kind == \"locker\" || c.kind == \"footlocker\" || c.kind == \"terminal\") {\n      blockedMask[c.ty * MAP_W + c.tx] = true;\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < barrels.length) {\n    var br:Object = barrels[i];\n    if (br.alive) {\n      blockedMask[br.ty * MAP_W + br.tx] = true;\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < propsList.length) {\n    var p:Object = propsList[i];\n    if (p.blocking) {\n      blockedMask[p.ty * MAP_W + p.tx] = true;\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && i != excludeEnemyIdx) {\n      blockedMask[e.ty * MAP_W + e.tx] = true;\n    }\n    i = i + 1;\n  }\n  if (includePlayer) {\n    blockedMask[playerTy * MAP_W + playerTx] = true;\n  }\n}\n\nfunction enemyAtHex(tx:Number, ty:Number):Number {\n  var i:Number = 0;\n  while (i < enemies.length) {\n    if (enemies[i].alive && enemies[i].tx == tx && enemies[i].ty == ty) {\n      return i;\n    }\n    i = i + 1;\n  }\n  return -1;\n}\n\nfunction containerAtHex(tx:Number, ty:Number):Number {\n  var i:Number = 0;\n  while (i < containers.length) {\n    if (containers[i].tx == tx && containers[i].ty == ty) {\n      return i;\n    }\n    i = i + 1;\n  }\n  return -1;\n}\n\nfunction barrelAtHex(tx:Number, ty:Number):Number {\n  var i:Number = 0;\n  while (i < barrels.length) {\n    if (barrels[i].alive && barrels[i].tx == tx && barrels[i].ty == ty) {\n      return i;\n    }\n    i = i + 1;\n  }\n  return -1;\n}\n\nfunction currentAc():Number {\n  return baseAc + (hasLeatherArmor ? 8 : 0);\n}\n\nfunction currentSightRadius():Number {\n  return (flareTurns > 0) ? 11 : 8;\n}\n\nfunction activeWeaponDef():Object {\n  if (activeSlot == 3 && unlockedShotgun) { return weaponDefs.shotgun; }\n  if (activeSlot == 2) { return weaponDefs.knife; }\n  return weaponDefs.pistol10mm;\n}\n\nfunction cycleWeaponSlot():Void {\n  grenadeMode = false;\n  if (activeSlot == 1) {\n    activeSlot = 2;\n  } else if (activeSlot == 2) {\n    activeSlot = unlockedShotgun ? 3 : 1;\n  } else {\n    activeSlot = 1;\n  }\n  fireMode = 0;\n}\n\nfunction currentAttackAp():Number {\n  if (grenadeMode) { return 4; }\n  var w:Object = activeWeaponDef();\n  if (fireMode == 2) { return 2; }\n  return (fireMode == 1) ? w.apAimed : w.apSingle;\n}\n\nfunction checkXpLevelUp():Void {\n  var nextThreshold:Number = level * 250;\n  while (xp >= nextThreshold) {\n    level = level + 1;\n    maxHp = maxHp + 7;\n    hp = Math.min(maxHp, hp + 7);\n    specStats.smallGuns = Math.min(95, specStats.smallGuns + 7);\n    specStats.melee = Math.min(95, specStats.melee + 6);\n    playSound(sfx.pipboy, 0, 85);\n    addLog(\"LEVEL UP! Reached Level \" + level + \" (+7 Max HP, +7% Small Guns)!\", \"#FACC15\");\n    spawnFloatText(playerTx, playerTy, \"LEVEL \" + level + \"!\", 0xFACC15);\n    nextThreshold = level * 250;\n  }\n}\n\n// --- HUD Buttons & Readout Refresh ---\nfunction drawHudButtonsChrome():Void {\n  hudButtonsDecor.clear();\n  var btns:Array = [\n    { x: 274, y: 404, w: 16, h: 50, label: \"^\", fill: 0x1E2923 },\n    { x: 274, y: 458, w: 16, h: 50, label: \"v\", fill: 0x1E2923 },\n    { x: 302, y: 400, w: 60, h: 25, label: \"INV [I]\", fill: 0x3B332B },\n    { x: 302, y: 429, w: 60, h: 25, label: \"CHA [O]\", fill: 0x3B332B },\n    { x: 302, y: 458, w: 60, h: 25, label: \"PIP [P]\", fill: 0x3B332B },\n    { x: 302, y: 487, w: 60, h: 25, label: \"STIM[H]\", fill: 0x422826 },\n    { x: 370, y: 488, w: 47, h: 24, label: \"SWAP[B]\", fill: 0x333833 },\n    { x: 420, y: 488, w: 47, h: 24, label: \"MODE[M]\", fill: 0x333833 },\n    { x: 470, y: 488, w: 47, h: 24, label: \"VATS[V]\", fill: 0x263B2D },\n    { x: 520, y: 488, w: 46, h: 24, label: \"GREN[G]\", fill: 0x42321F },\n    { x: 694, y: 428, w: 96, h: 40, label: \"END TURN\", fill: 0x4A3520 },\n    { x: 694, y: 472, w: 96, h: 40, label: \"COMBAT\",   fill: 0x263A29 }\n  ];\n  var i:Number = 0;\n  while (i < btns.length) {\n    var b:Object = btns[i];\n    hudButtonsDecor.lineStyle(1.5, 0x6B6054, 95);\n    hudButtonsDecor.beginFill(b.fill, 100);\n    hudButtonsDecor.moveTo(b.x, b.y);\n    hudButtonsDecor.lineTo(b.x + b.w, b.y);\n    hudButtonsDecor.lineTo(b.x + b.w, b.y + b.h);\n    hudButtonsDecor.lineTo(b.x, b.y + b.h);\n    hudButtonsDecor.endFill();\n\n    var tfName:String = \"btnLbl_\" + i;\n    if (hudButtonsDecor[tfName] == undefined) {\n      hudButtonsDecor.createTextField(tfName, 50 + i, b.x - 1, b.y + Math.floor((b.h - 15) * 0.5), b.w + 2, 17);\n    }\n    var tf:TextField = hudButtonsDecor[tfName];\n    tf.selectable = false;\n    var fmt:TextFormat = new TextFormat();\n    fmt.font = \"Arial\";\n    fmt.size = 9;\n    fmt.bold = true;\n    fmt.align = \"center\";\n    fmt.color = 0xE7E5E4;\n    tf.text = b.label;\n    tf.setTextFormat(fmt);\n    i = i + 1;\n  }\n}\n\nfunction pad3(n:Number):String {\n  var v:Number = Math.max(0, Math.floor(n));\n  if (v < 10) { return \"00\" + v; }\n  if (v < 100) { return \"0\" + v; }\n  return String(v);\n}\n\nfunction updateHud():Void {\n  if (grenadeMode) {\n    weaponIconClip.attachBitmap(grenadeBmp, 1, \"auto\", false);\n  } else if (activeSlot == 3 && unlockedShotgun) {\n    weaponIconClip.attachBitmap(shotgunBmp, 1, \"auto\", false);\n  } else if (activeSlot == 2) {\n    weaponIconClip.attachBitmap(knifeBmp, 1, \"auto\", false);\n  } else {\n    weaponIconClip.attachBitmap(pistolBmp, 1, \"auto\", false);\n  }\n\n  var w:Object = activeWeaponDef();\n  if (this.weaponNameText != undefined) {\n    this.weaponNameText.text = grenadeMode ? \"FRAG GRENADE (2-HEX)\" : w.name.toUpperCase();\n  }\n  if (this.weaponModeText != undefined) {\n    if (grenadeMode) {\n      this.weaponModeText.text = \"THROW (4 AP)\\nFRAGS: \" + grenades;\n    } else {\n      var modeStr:String = (fireMode == 0) ? (\"SINGLE (\" + w.apSingle + \" AP)\")\n        : ((fireMode == 1) ? (\"AIMED (\" + w.apAimed + \" AP)\") : \"RELOAD (2 AP)\");\n      var ammoStr:String = \"MELEE (INF)\";\n      if (activeSlot == 1) { ammoStr = \"10mm: \" + magAmmo + \"/\" + reserveAmmo; }\n      else if (activeSlot == 3 && unlockedShotgun) { ammoStr = \"12ga: \" + shotgunMag + \"/\" + shells12ga; }\n      this.weaponModeText.text = modeStr + \"\\n\" + ammoStr;\n    }\n  }\n  if (this.hpText != undefined) {\n    this.hpText.text = pad3(hp) + \" / \" + pad3(maxHp);\n  }\n  if (this.acText != undefined) {\n    this.acText.text = \"AC \" + pad3(currentAc()) + (hasLeatherArmor ? \" [LTH]\" : \"\");\n  }\n  if (this.xpText != undefined) {\n    var statusTag:String = (poisonTurns > 0) ? (\"PSN:\" + poisonTurns) : (\"RAD:\" + rads);\n    this.xpText.text = \"LV \" + level + \" · XP \" + xp + \"\\nSTIM:\" + stimpaks + \" \" + statusTag;\n  }\n  if (this.stateText != undefined) {\n    if (!inCombat) {\n      this.stateText.text = \"HEX EXPLORE\";\n    } else if (combatTurn == \"player\") {\n      this.stateText.text = \"YOUR TURN\";\n    } else {\n      this.stateText.text = \"ENEMY AI\";\n    }\n  }\n\n  var previewCost:Number = 0;\n  if (inCombat && combatTurn == \"player\") {\n    if (grenadeMode && hoverTx >= 0) {\n      previewCost = 4;\n    } else if (hoverEnemyIdx >= 0 || hoverBarrelIdx >= 0) {\n      previewCost = currentAttackAp();\n    } else if (hoverPath.length > 0) {\n      previewCost = hoverPath.length;\n    }\n  }\n  apCanvas.clear();\n  var p:Number = 0;\n  while (p < 10) {\n    var lx:Number = p * 15;\n    var col:Number = 0x1F2922;\n    if (!inCombat) {\n      col = (p < maxAp) ? 0x4ADE80 : 0x1F2922;\n    } else if (p < ap) {\n      if (p >= ap - previewCost) {\n        col = 0xFACC15;\n      } else {\n        col = 0x4ADE80;\n      }\n    }\n    apCanvas.lineStyle(1, 0x0A0F0B, 90);\n    apCanvas.beginFill(col, 100);\n    apCanvas.moveTo(lx - 4, -4);\n    apCanvas.lineTo(lx + 4, -4);\n    apCanvas.lineTo(lx + 4, 4);\n    apCanvas.lineTo(lx - 4, 4);\n    apCanvas.endFill();\n    p = p + 1;\n  }\n}\n\n// --- Combat Lifecycle ---\nfunction enterCombat(reason:String):Void {\n  if (inCombat) { return; }\n  inCombat = true;\n  combatTurn = \"player\";\n  turnNumber = 1;\n  ap = maxAp;\n  walkQueue = [];\n  pendingContainerIdx = -1;\n  playSound(sfx.klaxon, 0, 80);\n  addLog(reason, \"#FACC15\");\n  updateHud();\n}\n\nfunction tryEndCombat():Void {\n  if (!inCombat) {\n    enterCombat(\"Turn-based hexagonal combat engaged manually.\");\n    return;\n  }\n  if (combatTurn != \"player\") { return; }\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && e.alerted && PathLos.hexDist(playerTx, playerTy, e.tx, e.ty) <= 9) {\n      addLog(\"Cannot end combat — hostile \" + e.name + \" is within 9 hexes!\", \"#F87171\");\n      playSound(sfx.hurt, 0, 45);\n      return;\n    }\n    i = i + 1;\n  }\n  inCombat = false;\n  ap = maxAp;\n  grenadeMode = false;\n  playSound(sfx.pipboy, 0, 65);\n  addLog(\"Combat ended. Returning to real-time hex exploration.\", \"#86EFAC\");\n  updateHud();\n}\n\nfunction checkAutoEndCombat():Void {\n  if (!inCombat) { return; }\n  var anyThreat:Boolean = false;\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && (e.alerted || fogState[e.ty * MAP_W + e.tx] == 2)) {\n      anyThreat = true;\n      break;\n    }\n    i = i + 1;\n  }\n  if (!anyThreat) {\n    inCombat = false;\n    ap = maxAp;\n    grenadeMode = false;\n    addLog(\"Sector clear — combat ended.\", \"#86EFAC\");\n    updateHud();\n  }\n}\n\nfunction endPlayerTurn():Void {\n  if (!inCombat || combatTurn != \"player\" || gameOver || escapedCavern) { return; }\n  walkQueue = [];\n  grenadeMode = false;\n  modalMode = \"\";\n  renderModal();\n\n  // Radscorpion venom tick at end of turn\n  if (poisonTurns > 0) {\n    poisonTurns = poisonTurns - 1;\n    hp = Math.max(1, hp - 2);\n    addLog(\"Radscorpion venom burns in your veins (-2 HP)!\", \"#A3E635\");\n    spawnFloatText(playerTx, playerTy, \"-2 VENOM\", 0xA3E635);\n  }\n\n  combatTurn = \"enemy\";\n  aiActorIdx = 0;\n  aiWaitFrames = 5;\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && !e.alerted) {\n      if (PathLos.hexDist(playerTx, playerTy, e.tx, e.ty) <= 8 &&\n          PathLos.hasLineOfSight(grid, MAP_W, MAP_H, playerTx, playerTy, e.tx, e.ty)) {\n        e.alerted = true;\n      }\n    }\n    if (e.alive) {\n      e.curAp = e.crippled ? Math.max(2, Math.floor(e.ap * 0.5)) : e.ap;\n      if (e.stunned) {\n        e.curAp = Math.max(0, e.curAp - 3);\n        e.stunned = false;\n      }\n    }\n    i = i + 1;\n  }\n  updateHud();\n}\n\n// --- Explosions, Barrels, Grenades, Looting & Combat ---\nfunction detonateHex(cx:Number, cy:Number, maxBlastDmg:Number, sourceLabel:String):Void {\n  playSound(sfx.explosion, 0, 95);\n  spawnBlastEffect(cx, cy);\n  radarDirty = true;\n\n  // Damage all living enemies within 2 hexes!\n  var ei:Number = 0;\n  while (ei < enemies.length) {\n    var en:Object = enemies[ei];\n    if (en.alive) {\n      var hd:Number = PathLos.hexDist(cx, cy, en.tx, en.ty);\n      if (hd <= 2) {\n        en.alerted = true;\n        var dmg:Number = (hd == 0) ? maxBlastDmg\n          : ((hd == 1) ? Math.round(maxBlastDmg * 0.85) : Math.round(maxBlastDmg * 0.55));\n        dmg = Math.max(5, dmg - Math.floor(Math.random() * 4));\n        en.hp = en.hp - dmg;\n        if (en.hp <= 0) {\n          en.hp = 0;\n          en.alive = false;\n          killsCount = killsCount + 1;\n          xp = xp + en.xp;\n          addLog(sourceLabel + \" blasts \" + en.name + \" for \" + dmg + \" dmg — OBLITERATED! (+\" + en.xp + \" XP)\", \"#FACC15\");\n          spawnFloatText(en.tx, en.ty, \"BOOM -\" + dmg + \"!\", 0xFACC15);\n        } else {\n          addLog(sourceLabel + \" scorches \" + en.name + \" for \" + dmg + \" blast dmg (\" + en.hp + \"/\" + en.maxHp + \" HP)!\", \"#FB923C\");\n          spawnFloatText(en.tx, en.ty, \"-\" + dmg + \" BLAST\", 0xFB923C);\n        }\n      }\n    }\n    ei = ei + 1;\n  }\n\n  // Player splash check if standing right next to blast!\n  var pDist:Number = PathLos.hexDist(cx, cy, playerTx, playerTy);\n  if (pDist <= 1) {\n    var selfDmg:Number = hasLeatherArmor ? 5 : 8;\n    hp = Math.max(1, hp - selfDmg);\n    addLog(\"Shockwave singes you for \" + selfDmg + \" dmg!\", \"#EF4444\");\n    spawnFloatText(playerTx, playerTy, \"-\" + selfDmg + \" HP\", 0xEF4444);\n  }\n\n  // Chain-detonate any intact volatile barrels within 2 hexes!\n  var bi:Number = 0;\n  while (bi < barrels.length) {\n    var br:Object = barrels[bi];\n    if (br.alive && PathLos.hexDist(cx, cy, br.tx, br.ty) <= 2) {\n      br.alive = false;\n      addLog(\"CHAIN REACTION! Volatile Rad-Drum at (\" + br.tx + \",\" + br.ty + \") erupts!\", \"#F97316\");\n      detonateHex(br.tx, br.ty, 22, \"Rad-Drum Blast\");\n    }\n    bi = bi + 1;\n  }\n\n  checkXpLevelUp();\n  checkAutoEndCombat();\n  updateHud();\n}\n\nfunction shootBarrel(bIdx:Number):Void {\n  if (bIdx < 0 || bIdx >= barrels.length || !barrels[bIdx].alive) { return; }\n  var br:Object = barrels[bIdx];\n  if (activeSlot == 2 && PathLos.hexDist(playerTx, playerTy, br.tx, br.ty) > 1) {\n    addLog(\"Equip a firearm [1/3] or Frag Grenade [G] to detonate distant Rad-Drums!\", \"#FACC15\");\n    return;\n  }\n  var w:Object = activeWeaponDef();\n  var dist:Number = PathLos.hexDist(playerTx, playerTy, br.tx, br.ty);\n  if (dist > w.range) {\n    addLog(\"Volatile Rad-Drum is out of weapon range (\" + dist + \" > \" + w.range + \" hexes).\", \"#F87171\");\n    return;\n  }\n  if (!PathLos.hasLineOfSight(grid, MAP_W, MAP_H, playerTx, playerTy, br.tx, br.ty)) {\n    addLog(\"Line of sight to Volatile Rad-Drum is blocked!\", \"#F87171\");\n    return;\n  }\n  if (inCombat && ap < w.apSingle) {\n    addLog(\"Need \" + w.apSingle + \" AP to fire at Rad-Drum!\", \"#F87171\");\n    return;\n  }\n  if (activeSlot == 1 && magAmmo <= 0) {\n    addLog(\"10mm Pistol empty — press [R] to reload!\", \"#FACC15\");\n    return;\n  }\n  if (activeSlot == 3 && shotgunMag <= 0) {\n    addLog(\"Sawed-Off 12ga empty — press [R] to reload!\", \"#FACC15\");\n    return;\n  }\n\n  if (inCombat) { ap = ap - w.apSingle; }\n  if (activeSlot == 1) { magAmmo = magAmmo - 1; playSound(sfx.pistol, 0, 90); }\n  else if (activeSlot == 3) { shotgunMag = shotgunMag - 1; playSound(sfx.shotgun, 0, 92); }\n  else { playSound(sfx.knife, 0, 80); }\n\n  muzzleTimer = 5;\n  tracerTimer = 5;\n  tracerWx0 = PathLos.hexWorldX(playerTx, playerTy);\n  tracerWy0 = PathLos.hexWorldY(playerTy);\n  tracerWx1 = PathLos.hexWorldX(br.tx, br.ty);\n  tracerWy1 = PathLos.hexWorldY(br.ty);\n  tracerCol = 0xFB923C;\n\n  br.alive = false;\n  addLog(\"Direct hit on Volatile Rad-Drum (\" + br.tx + \",\" + br.ty + \") — KA-BOOM!\", \"#FACC15\");\n  if (!inCombat) {\n    // Wake any nearby survivors into combat if they survived the blast\n    var nearAlive:Boolean = false;\n    detonateHex(br.tx, br.ty, 22, \"Rad-Drum\");\n    var ei:Number = 0;\n    while (ei < enemies.length) {\n      if (enemies[ei].alive && enemies[ei].alerted) { nearAlive = true; break; }\n      ei = ei + 1;\n    }\n    if (nearAlive) {\n      enterCombat(\"Cavern hostiles screech from the blast shockwave!\");\n    }\n  } else {\n    detonateHex(br.tx, br.ty, 22, \"Rad-Drum\");\n  }\n}\n\nfunction throwGrenadeAt(tx:Number, ty:Number):Void {\n  if (grenades <= 0) {\n    grenadeMode = false;\n    addLog(\"Out of Frag Grenades!\", \"#F87171\");\n    updateHud();\n    return;\n  }\n  var dist:Number = PathLos.hexDist(playerTx, playerTy, tx, ty);\n  if (dist > 8) {\n    addLog(\"Target hex is beyond throwing range (\" + dist + \" > 8 hexes)!\", \"#F87171\");\n    return;\n  }\n  if (!PathLos.hasLineOfSight(grid, MAP_W, MAP_H, playerTx, playerTy, tx, ty)) {\n    addLog(\"Cavern ceiling/rock blocks grenade arc to (\" + tx + \",\" + ty + \")!\", \"#F87171\");\n    return;\n  }\n  if (inCombat && ap < 4) {\n    addLog(\"Need 4 AP to throw a Frag Grenade!\", \"#F87171\");\n    return;\n  }\n  if (inCombat) { ap = ap - 4; }\n  grenades = grenades - 1;\n  grenadeMode = false;\n\n  tracerTimer = 6;\n  tracerWx0 = PathLos.hexWorldX(playerTx, playerTy);\n  tracerWy0 = PathLos.hexWorldY(playerTy);\n  tracerWx1 = PathLos.hexWorldX(tx, ty);\n  tracerWy1 = PathLos.hexWorldY(ty);\n  tracerCol = 0xF97316;\n\n  addLog(\"Hucked Mk II Frag Grenade at hex (\" + tx + \",\" + ty + \")!\", \"#FACC15\");\n  detonateHex(tx, ty, 24, \"Frag Grenade\");\n  var ei:Number = 0;\n  while (!inCombat && ei < enemies.length) {\n    if (enemies[ei].alive && enemies[ei].alerted) {\n      enterCombat(\"Survivors charge toward the grenade blast!\");\n      break;\n    }\n    ei = ei + 1;\n  }\n  updateHud();\n}\n\nfunction revealSectorScan(cx:Number, cy:Number, radius:Number):Void {\n  var y:Number = Math.max(0, cy - radius);\n  var maxY:Number = Math.min(MAP_H - 1, cy + radius);\n  while (y <= maxY) {\n    var x:Number = 0;\n    while (x < MAP_W) {\n      if (PathLos.hexDist(cx, cy, x, y) <= radius) {\n        var idx:Number = y * MAP_W + x;\n        if (fogState[idx] == 0 && grid[idx] != 0) {\n          fogState[idx] = 1;\n        }\n      }\n      x = x + 1;\n    }\n    y = y + 1;\n  }\n}\n\nfunction lootContainer(idx:Number):Void {\n  if (idx < 0 || idx >= containers.length) { return; }\n  var c:Object = containers[idx];\n  if (PathLos.hexDist(playerTx, playerTy, c.tx, c.ty) > 1) {\n    addLog(c.examine, \"#A7F3D0\");\n    return;\n  }\n  if (c.looted) {\n    addLog(c.name + (c.kind == \"terminal\" ? \" — seismic data already downloaded.\" : \" is empty.\"), \"#94A3B8\");\n    return;\n  }\n  if (inCombat && ap < 2) {\n    addLog(\"Need 2 AP to interact with \" + c.name + \"!\", \"#F87171\");\n    return;\n  }\n  if (inCombat) { ap = ap - 2; }\n  c.looted = true;\n  radarDirty = true;\n\n  if (c.kind == \"terminal\") {\n    terminalHacked = true;\n    xp = xp + 50;\n    // Reveal seismic map landmarks across all 5 cavern sectors!\n    revealSectorScan(14, 6, 3);  // Prospector Campfire\n    revealSectorScan(11, 16, 3); // Rad-Sump Catwalks\n    revealSectorScan(5, 22, 2);  // Hazmat Island\n    revealSectorScan(28, 5, 3);  // Crystal Canyon Crate\n    revealSectorScan(32, 20, 3); // Sunlit Wasteland Exit!\n    terrainDirty = true;\n    playSound(sfx.pipboy, 0, 90);\n    addLog(\"[SCIENCE 75%] Hacked Terminal 13-A! Downloaded Cavern Hex Seismology Map (+50 XP)!\", \"#4ADE80\");\n    spawnFloatText(c.tx, c.ty, \"MAP HACKED!\", 0x4ADE80);\n    checkXpLevelUp();\n    updateHud();\n    return;\n  }\n\n  addLog(c.examine, \"#BBF7D0\");\n  var foundParts:Array = [];\n  if (c.shotgun) {\n    unlockedShotgun = true;\n    activeSlot = 3;\n    fireMode = 0;\n    shotgunMag = 2;\n    foundParts.push(\"Sawed-Off 12ga Shotgun [Slot 3]\");\n  }\n  if (c.ammo10mm > 0) {\n    reserveAmmo = reserveAmmo + c.ammo10mm;\n    foundParts.push(\"+\" + c.ammo10mm + \"x 10mm\");\n  }\n  if (c.shells12ga > 0) {\n    shells12ga = shells12ga + c.shells12ga;\n    foundParts.push(\"+\" + c.shells12ga + \"x 12ga Shells\");\n  }\n  if (c.grenades > 0) {\n    grenades = grenades + c.grenades;\n    foundParts.push(\"+\" + c.grenades + \" Frag Grenade\");\n  }\n  if (c.stimpaks > 0) {\n    stimpaks = stimpaks + c.stimpaks;\n    foundParts.push(\"+\" + c.stimpaks + \" Stimpak\");\n  }\n  if (c.radaway > 0) {\n    radaways = radaways + c.radaway;\n    foundParts.push(\"+\" + c.radaway + \" RadAway\");\n  }\n  if (c.flares > 0) {\n    flares = flares + c.flares;\n    foundParts.push(\"+\" + c.flares + \" Flare\");\n  }\n  if (c.armor) {\n    unlockedLeatherArmor = true;\n    hasLeatherArmor = true;\n    foundParts.push(\"Combat Leather Armor (AC +8, DR 25%)\");\n  }\n  if (c.skillMag) {\n    specStats.smallGuns = Math.min(95, specStats.smallGuns + 10);\n    xp = xp + 35;\n    foundParts.push(\"'Guns & Bullets' (+10% Small Guns)\");\n  }\n  if (c.holodisk) {\n    hasHolodisk = true;\n    foundParts.push(\"Overseer Holodisk\");\n  }\n  xp = xp + 30;\n  playSound(sfx.pipboy, 0, 80);\n  addLog(\"Looted \" + c.name + \": \" + foundParts.join(\", \") + \" (+30 XP).\", \"#FACC15\");\n  spawnFloatText(c.tx, c.ty, c.shotgun ? \"SAWED-OFF 12GA!\" : \"LOOTED!\", 0xFACC15);\n  checkXpLevelUp();\n  updateHud();\n}\n\nfunction useStimpak():Void {\n  if (gameOver || escapedCavern) { return; }\n  if (stimpaks <= 0) {\n    addLog(\"Out of Stimpaks!\", \"#F87171\");\n    playSound(sfx.hurt, 0, 45);\n    return;\n  }\n  if (hp >= maxHp && poisonTurns <= 0) {\n    addLog(\"Already at full health (\" + hp + \"/\" + maxHp + \").\", \"#86EFAC\");\n    return;\n  }\n  if (inCombat && combatTurn == \"player\") {\n    if (ap < 2) {\n      addLog(\"Need 2 AP to inject Stimpak!\", \"#F87171\");\n      return;\n    }\n    ap = ap - 2;\n  }\n  stimpaks = stimpaks - 1;\n  var heal:Number = 15 + Math.floor(specStats.firstAid * 0.1);\n  var before:Number = hp;\n  hp = Math.min(maxHp, hp + heal);\n  poisonTurns = 0;\n  playSound(sfx.stimpak, 0, 85);\n  addLog(\"Injected Stimpak: +\" + (hp - before) + \" HP (\" + hp + \"/\" + maxHp + \") & purged venom.\", \"#4ADE80\");\n  spawnFloatText(playerTx, playerTy, \"+\" + (hp - before) + \" HP\", 0x4ADE80);\n  updateHud();\n}\n\nfunction useRadAway():Void {\n  if (radaways <= 0) {\n    addLog(\"No RadAway chems in inventory.\", \"#94A3B8\");\n    return;\n  }\n  radaways = radaways - 1;\n  rads = Math.max(0, rads - 25);\n  playSound(sfx.stimpak, 0, 80);\n  addLog(\"Administered RadAway: scrubbed radiation down to \" + rads + \" RAD.\", \"#4ADE80\");\n  updateHud();\n}\n\nfunction reloadActiveWeapon():Void {\n  grenadeMode = false;\n  if (activeSlot == 2) {\n    addLog(\"Vault Combat Knife does not require ammunition.\", \"#94A3B8\");\n    return;\n  }\n  if (activeSlot == 3 && unlockedShotgun) {\n    var sw:Object = weaponDefs.shotgun;\n    if (shotgunMag >= sw.magSize) {\n      addLog(\"Sawed-Off 12ga barrels are already loaded (2/2).\", \"#86EFAC\");\n      return;\n    }\n    if (shells12ga <= 0) {\n      addLog(\"Out of 12ga shotgun shells!\", \"#F87171\");\n      return;\n    }\n    if (inCombat && combatTurn == \"player\") {\n      if (ap < 2) { addLog(\"Need 2 AP to reload!\", \"#F87171\"); return; }\n      ap = ap - 2;\n    }\n    var sNeed:Number = sw.magSize - shotgunMag;\n    var sTake:Number = Math.min(sNeed, shells12ga);\n    shotgunMag = shotgunMag + sTake;\n    shells12ga = shells12ga - sTake;\n    fireMode = 0;\n    playSound(sfx.pipboy, 0, 78);\n    addLog(\"Reloaded Sawed-Off 12ga (\" + shotgunMag + \"/2, reserve \" + shells12ga + \").\", \"#86EFAC\");\n    spawnFloatText(playerTx, playerTy, \"12GA LOADED\", 0x86EFAC);\n    updateHud();\n    return;\n  }\n\n  var w:Object = weaponDefs.pistol10mm;\n  if (magAmmo >= w.magSize) {\n    addLog(\"10mm Pistol magazine is already full (12/12).\", \"#86EFAC\");\n    return;\n  }\n  if (reserveAmmo <= 0) {\n    addLog(\"No 10mm reserve ammunition remaining!\", \"#F87171\");\n    return;\n  }\n  if (inCombat && combatTurn == \"player\") {\n    if (ap < 2) { addLog(\"Need 2 AP to reload!\", \"#F87171\"); return; }\n    ap = ap - 2;\n  }\n  var needed:Number = w.magSize - magAmmo;\n  var take:Number = Math.min(needed, reserveAmmo);\n  magAmmo = magAmmo + take;\n  reserveAmmo = reserveAmmo - take;\n  fireMode = 0;\n  playSound(sfx.pipboy, 0, 75);\n  addLog(\"Reloaded 10mm Colt 6520 (\" + magAmmo + \"/12, reserve \" + reserveAmmo + \").\", \"#86EFAC\");\n  spawnFloatText(playerTx, playerTy, \"RELOADED\", 0x86EFAC);\n  updateHud();\n}\n\nfunction executeAttack(enemyIdx:Number, partObj:Object):Void {\n  if (enemyIdx < 0 || enemyIdx >= enemies.length) { return; }\n  var target:Object = enemies[enemyIdx];\n  if (!target.alive) { return; }\n\n  if (!inCombat) {\n    enterCombat(\"You initiate hex combat with \" + target.name + \"!\");\n  }\n  if (combatTurn != \"player\") { return; }\n\n  var w:Object = activeWeaponDef();\n  var isAimed:Boolean = (partObj != null);\n  var apCost:Number = isAimed ? w.apAimed : w.apSingle;\n  var dist:Number = PathLos.hexDist(playerTx, playerTy, target.tx, target.ty);\n\n  if (activeSlot == 2 && dist > 1) {\n    addLog(target.name + \" is \" + dist + \" hexes away — step adjacent or swap to firearm [B]!\", \"#F87171\");\n    return;\n  }\n  if (dist > w.range) {\n    addLog(target.name + \" is out of hex range (\" + dist + \" > \" + w.range + \" hexes)!\", \"#F87171\");\n    return;\n  }\n  if (!PathLos.hasLineOfSight(grid, MAP_W, MAP_H, playerTx, playerTy, target.tx, target.ty)) {\n    addLog(\"Hex line of sight to \" + target.name + \" is blocked by cavern rock!\", \"#F87171\");\n    return;\n  }\n  if (ap < apCost) {\n    addLog(\"Not enough Action Points (\" + ap + \"/\" + apCost + \" AP)!\", \"#F87171\");\n    playSound(sfx.hurt, 0, 40);\n    return;\n  }\n  if (activeSlot == 1 && magAmmo <= 0) {\n    addLog(\"Click! 10mm Pistol empty — press [R] to reload (2 AP)!\", \"#FACC15\");\n    fireMode = 2;\n    updateHud();\n    return;\n  }\n  if (activeSlot == 3 && unlockedShotgun && shotgunMag <= 0) {\n    addLog(\"Click! Sawed-Off 12ga empty — press [R] to reload (2 AP)!\", \"#FACC15\");\n    fireMode = 2;\n    updateHud();\n    return;\n  }\n\n  ap = ap - apCost;\n  var isShotgun:Boolean = (activeSlot == 3 && unlockedShotgun);\n  if (activeSlot == 1) {\n    magAmmo = magAmmo - 1;\n    muzzleTimer = 5;\n    playSound(sfx.pistol, 0, 90);\n  } else if (isShotgun) {\n    shotgunMag = shotgunMag - 1;\n    muzzleTimer = 6;\n    playSound(sfx.shotgun, 0, 95);\n  } else {\n    playSound(sfx.knife, 0, 85);\n  }\n\n  var pWx:Number = PathLos.hexWorldX(playerTx, playerTy);\n  var pWy:Number = PathLos.hexWorldY(playerTy);\n  var tWx:Number = PathLos.hexWorldX(target.tx, target.ty);\n  var tWy:Number = PathLos.hexWorldY(target.ty);\n  var sdx:Number = tWx - pWx;\n  var sdy:Number = tWy - pWy;\n  var slen:Number = Math.sqrt(sdx * sdx + sdy * sdy);\n  if (slen > 0.01) {\n    facingDx = sdx / slen;\n    facingDy = sdy / slen;\n  }\n\n  target.alerted = true;\n  shotsFired = shotsFired + 1;\n\n  var skillVal:Number = (activeSlot == 2) ? specStats.melee : specStats.smallGuns;\n  var penalty:Number = isAimed ? partObj.penalty : 0;\n  var coverAc:Number = PathLos.calcCoverBonus(grid, MAP_W, MAP_H, playerTx, playerTy, target.tx, target.ty);\n  var hitPct:Number = PathLos.calcHitChance(\n    skillVal, specStats.pe, dist, w.range, target.ac, coverAc, penalty, flareTurns > 0, isShotgun\n  );\n  var roll:Number = 1 + Math.floor(Math.random() * 100);\n\n  tracerTimer = 5;\n  tracerWx0 = pWx;\n  tracerWy0 = pWy;\n  tracerWx1 = tWx;\n  tracerWy1 = tWy;\n\n  if (roll > hitPct) {\n    tracerCol = 0x94A3B8;\n    addLog(\"Missed \" + target.name + \" (\" + hitPct + \"% hex chance\" + (coverAc > 0 ? \", cover\" : \"\") + \").\", \"#94A3B8\");\n    spawnFloatText(target.tx, target.ty, \"MISS\", 0xCBD5E1);\n    updateHud();\n    return;\n  }\n\n  shotsHit = shotsHit + 1;\n  tracerCol = isShotgun ? 0xFB923C : 0xFEF08A;\n\n  var rawDmg:Number = w.minDmg + Math.floor(Math.random() * (w.maxDmg - w.minDmg + 1));\n  if (activeSlot == 2) {\n    rawDmg = rawDmg + Math.max(0, specStats.st - 5);\n  }\n  var critChance:Number = specStats.lk * 2 + (isAimed ? partObj.critBonus : 0);\n  var isCrit:Boolean = (1 + Math.floor(Math.random() * 100)) <= critChance;\n  var partLabel:String = isAimed ? (\" in the \" + partObj.label) : \"\";\n\n  if (isCrit) {\n    var mult:Number = isAimed ? (partObj.dmgMult / 100.0) : 1.75;\n    rawDmg = Math.max(rawDmg + 5, Math.round(rawDmg * mult));\n    if (isAimed && partObj.effect == \"blind\") { target.blinded = true; }\n    else if (isAimed && partObj.effect == \"cripple\") { target.crippled = true; }\n    else if (isAimed && partObj.effect == \"stun\") { target.stunned = true; }\n  }\n\n  target.hp = target.hp - rawDmg;\n  radarDirty = true;\n  if (target.hp <= 0) {\n    target.hp = 0;\n    target.alive = false;\n    killsCount = killsCount + 1;\n    xp = xp + target.xp;\n    playSound(sfx.ratDeath, 0, 85);\n    if (isCrit) {\n      addLog(\"CRITICAL! \" + target.name + \" hit\" + partLabel + \" for \" + rawDmg + \" dmg and blasted apart! (+\" + target.xp + \" XP)\", \"#FACC15\");\n      spawnFloatText(target.tx, target.ty, \"CRIT -\" + rawDmg + \"!\", 0xFACC15);\n    } else {\n      addLog(target.name + \" hit\" + partLabel + \" for \" + rawDmg + \" dmg and killed. (+\" + target.xp + \" XP)\", \"#4ADE80\");\n      spawnFloatText(target.tx, target.ty, \"-\" + rawDmg + \" KILL\", 0x4ADE80);\n    }\n    checkXpLevelUp();\n    checkAutoEndCombat();\n  } else {\n    playSound(sfx.ratSqueak, 0, 75);\n    if (isCrit) {\n      addLog(\"Critical Hit! \" + target.name + \" hit\" + partLabel + \" for \" + rawDmg + \" dmg (\" + target.hp + \"/\" + target.maxHp + \" HP)!\", \"#FACC15\");\n      spawnFloatText(target.tx, target.ty, \"CRIT -\" + rawDmg, 0xFACC15);\n    } else {\n      addLog(\"Hit \" + target.name + partLabel + \" for \" + rawDmg + \" dmg (\" + target.hp + \"/\" + target.maxHp + \" HP).\", \"#86EFAC\");\n      spawnFloatText(target.tx, target.ty, \"-\" + rawDmg, 0xEF4444);\n    }\n  }\n  updateHud();\n}\n\n// --- SharedObject Quick-Save / Quick-Load ---\nfunction saveProgressToSol():Void {\n  var so:SharedObject = SharedObject.getLocal(\"neoflash_fallout_v13_hex\");\n  var enemySnap:Array = [];\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    enemySnap.push({ tx: e.tx, ty: e.ty, hp: e.hp, alive: e.alive, alerted: e.alerted, crippled: e.crippled, blinded: e.blinded });\n    i = i + 1;\n  }\n  var contSnap:Array = [];\n  i = 0;\n  while (i < containers.length) {\n    contSnap.push(containers[i].looted);\n    i = i + 1;\n  }\n  var barrelSnap:Array = [];\n  i = 0;\n  while (i < barrels.length) {\n    barrelSnap.push(barrels[i].alive);\n    i = i + 1;\n  }\n  so.data.saved = true;\n  so.data.playerTx = playerTx;\n  so.data.playerTy = playerTy;\n  so.data.hp = hp;\n  so.data.maxHp = maxHp;\n  so.data.xp = xp;\n  so.data.level = level;\n  so.data.rads = rads;\n  so.data.poisonTurns = poisonTurns;\n  so.data.ap = ap;\n  so.data.activeSlot = activeSlot;\n  so.data.magAmmo = magAmmo;\n  so.data.reserveAmmo = reserveAmmo;\n  so.data.shotgunMag = shotgunMag;\n  so.data.shells12ga = shells12ga;\n  so.data.grenades = grenades;\n  so.data.stimpaks = stimpaks;\n  so.data.radaways = radaways;\n  so.data.flares = flares;\n  so.data.hasLeatherArmor = hasLeatherArmor;\n  so.data.unlockedLeatherArmor = unlockedLeatherArmor;\n  so.data.unlockedShotgun = unlockedShotgun;\n  so.data.terminalHacked = terminalHacked;\n  so.data.hasHolodisk = hasHolodisk;\n  so.data.inCombat = inCombat;\n  so.data.killsCount = killsCount;\n  so.data.enemies = enemySnap;\n  so.data.containers = contSnap;\n  so.data.barrels = barrelSnap;\n  so.flush();\n  playSound(sfx.pipboy, 0, 80);\n  addLog(\"Pip-Boy 2000: Hex cavern checkpoint saved to SharedObject.\", \"#FACC15\");\n}\n\nfunction loadProgressFromSol():Boolean {\n  var so:SharedObject = SharedObject.getLocal(\"neoflash_fallout_v13_hex\");\n  if (so.data == undefined || so.data.saved != true) {\n    addLog(\"Pip-Boy 2000: No saved state found in SharedObject.\", \"#F87171\");\n    return false;\n  }\n  playerTx = so.data.playerTx;\n  playerTy = so.data.playerTy;\n  drawWx = PathLos.hexWorldX(playerTx, playerTy);\n  drawWy = PathLos.hexWorldY(playerTy);\n  hp = so.data.hp;\n  maxHp = so.data.maxHp;\n  xp = so.data.xp;\n  level = so.data.level;\n  rads = so.data.rads;\n  poisonTurns = so.data.poisonTurns || 0;\n  ap = so.data.ap;\n  activeSlot = so.data.activeSlot || 1;\n  magAmmo = so.data.magAmmo;\n  reserveAmmo = so.data.reserveAmmo;\n  shotgunMag = so.data.shotgunMag || 0;\n  shells12ga = so.data.shells12ga || 0;\n  grenades = so.data.grenades || 0;\n  stimpaks = so.data.stimpaks;\n  radaways = so.data.radaways || 0;\n  flares = so.data.flares;\n  hasLeatherArmor = so.data.hasLeatherArmor;\n  unlockedLeatherArmor = so.data.unlockedLeatherArmor;\n  unlockedShotgun = so.data.unlockedShotgun;\n  terminalHacked = so.data.terminalHacked;\n  hasHolodisk = so.data.hasHolodisk;\n  inCombat = so.data.inCombat;\n  combatTurn = \"player\";\n  killsCount = so.data.killsCount;\n  walkQueue = [];\n  camPanX = 0;\n  camPanY = 0;\n  gameOver = false;\n  escapedCavern = false;\n\n  var es:Array = so.data.enemies;\n  var i:Number = 0;\n  while (es != undefined && i < enemies.length && i < es.length) {\n    enemies[i].tx = es[i].tx;\n    enemies[i].ty = es[i].ty;\n    enemies[i].hp = es[i].hp;\n    enemies[i].alive = es[i].alive;\n    enemies[i].alerted = es[i].alerted;\n    enemies[i].crippled = es[i].crippled;\n    enemies[i].blinded = es[i].blinded;\n    i = i + 1;\n  }\n  var cs:Array = so.data.containers;\n  i = 0;\n  while (cs != undefined && i < containers.length && i < cs.length) {\n    containers[i].looted = cs[i];\n    i = i + 1;\n  }\n  var bs:Array = so.data.barrels;\n  i = 0;\n  while (bs != undefined && i < barrels.length && i < bs.length) {\n    barrels[i].alive = bs[i];\n    i = i + 1;\n  }\n  if (terminalHacked) {\n    revealSectorScan(14, 6, 3);\n    revealSectorScan(11, 16, 3);\n    revealSectorScan(5, 22, 2);\n    revealSectorScan(28, 5, 3);\n    revealSectorScan(32, 20, 3);\n  }\n  PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n  terrainDirty = true;\n  radarDirty = true;\n  modalMode = \"\";\n  renderModal();\n  updateHud();\n  playSound(sfx.pipboy, 0, 85);\n  addLog(\"Pip-Boy 2000: Loaded hex checkpoint (\" + playerTx + \",\" + playerTy + \").\", \"#4ADE80\");\n  return true;\n}\n\n// --- Modal Overlays (V.A.T.S., Inventory, S.P.E.C.I.A.L., Pip-Boy 2000 Hex Scanner, End) ---\nfunction renderModal():Void {\n  modalBgClip.clear();\n  modalMapClipA.clear();\n  modalMapClipB.clear();\n  var rClr:Number = 0;\n  while (rClr < vatsRowTfs.length) {\n    vatsRowTfs[rClr].htmlText = \"\";\n    rClr = rClr + 1;\n  }\n  if (modalMode == \"\") {\n    modalTitleTf.text = \"\";\n    modalBodyTf.htmlText = \"\";\n    radarDirty = true;\n    renderCornerRadar();\n    return;\n  }\n\n  modalBgClip.lineStyle(undefined);\n  modalBgClip.beginFill(0x050806, 84);\n  modalBgClip.moveTo(0, 0);\n  modalBgClip.lineTo(VIEW_W, 0);\n  modalBgClip.lineTo(VIEW_W, VIEW_H);\n  modalBgClip.lineTo(0, VIEW_H);\n  modalBgClip.endFill();\n\n  modalBgClip.lineStyle(2, 0x4ADE80, 95);\n  modalBgClip.beginFill(0x0B160E, 96);\n  modalBgClip.moveTo(120, 30);\n  modalBgClip.lineTo(680, 30);\n  modalBgClip.lineTo(680, 370);\n  modalBgClip.lineTo(120, 370);\n  modalBgClip.endFill();\n\n  if (modalMode == \"vats\" && vatsTargetIdx >= 0 && vatsTargetIdx < enemies.length) {\n    var tgt:Object = enemies[vatsTargetIdx];\n    var w:Object = activeWeaponDef();\n    var dist:Number = PathLos.hexDist(playerTx, playerTy, tgt.tx, tgt.ty);\n    var skillVal:Number = (activeSlot == 2) ? specStats.melee : specStats.smallGuns;\n    var coverAc:Number = PathLos.calcCoverBonus(grid, MAP_W, MAP_H, playerTx, playerTy, tgt.tx, tgt.ty);\n    var isShotgun:Boolean = (activeSlot == 3 && unlockedShotgun);\n\n    modalTitleTf.text = \"V.A.T.S. HEX TARGETING — \" + tgt.name.toUpperCase() + \" (\" + tgt.hp + \"/\" + tgt.maxHp + \" HP · \" + dist + \" HEX)\";\n    modalTitleTf.setTextFormat(titleFmt);\n\n    var wx:Number = 540;\n    var wy:Number = 198;\n    modalBgClip.lineStyle(1.5, 0x22C55E, 90);\n    modalBgClip.beginFill(0x14532D, 35);\n    if (tgt.kind == 4) {\n      // Wireframe Radscorpion silhouette!\n      modalBgClip.moveTo(wx - 50, wy + 12);\n      modalBgClip.lineTo(wx - 20, wy - 18);\n      modalBgClip.lineTo(wx + 34, wy - 16);\n      modalBgClip.lineTo(wx + 58, wy + 4);\n      modalBgClip.lineTo(wx + 24, wy + 22);\n      modalBgClip.lineTo(wx - 40, wy + 22);\n      modalBgClip.endFill();\n      // Wireframe stinger tail & claws\n      modalBgClip.moveTo(wx - 46, wy);\n      modalBgClip.lineTo(wx - 68, wy - 36);\n      modalBgClip.lineTo(wx - 30, wy - 64);\n      modalBgClip.lineTo(wx + 4,  wy - 52);\n      modalBgClip.moveTo(wx + 48, wy - 8); modalBgClip.lineTo(wx + 82, wy - 26);\n      modalBgClip.moveTo(wx + 48, wy + 8); modalBgClip.lineTo(wx + 82, wy + 24);\n    } else {\n      // Wireframe Rodent silhouette\n      modalBgClip.moveTo(wx - 58, wy + 18);\n      modalBgClip.lineTo(wx - 28, wy - 36);\n      modalBgClip.lineTo(wx + 24, wy - 32);\n      modalBgClip.lineTo(wx + 66, wy - 8);\n      modalBgClip.lineTo(wx + 40, wy + 26);\n      modalBgClip.lineTo(wx - 44, wy + 26);\n      modalBgClip.endFill();\n    }\n    modalBgClip.lineStyle(1, 0x86EFAC, 80);\n    modalBgClip.moveTo(wx + 38, wy - 16); modalBgClip.lineTo(wx + 54, wy - 16);\n    modalBgClip.moveTo(wx + 46, wy - 24); modalBgClip.lineTo(wx + 46, wy - 8);\n\n    var sy:Number = 86;\n    modalBgClip.lineStyle(1, 0x14532D, 45);\n    while (sy < 336) {\n      modalBgClip.moveTo(436, sy);\n      modalBgClip.lineTo(660, sy);\n      sy = sy + 8;\n    }\n\n    var i:Number = 0;\n    while (i < vatsParts.length) {\n      var pt:Object = vatsParts[i];\n      var pct:Number = PathLos.calcHitChance(\n        skillVal, specStats.pe, dist, w.range, tgt.ac, coverAc, pt.penalty, flareTurns > 0, isShotgun\n      );\n      var by:Number = 84 + i * 44;\n      modalBgClip.lineStyle(1.5, 0x4ADE80, 90);\n      modalBgClip.beginFill(0x132A1B, 90);\n      modalBgClip.moveTo(142, by);\n      modalBgClip.lineTo(416, by);\n      modalBgClip.lineTo(416, by + 36);\n      modalBgClip.lineTo(142, by + 36);\n      modalBgClip.endFill();\n      if (i < vatsRowTfs.length) {\n        vatsRowTfs[i].htmlText =\n          \"<font face='Courier New' size='12' color='#86EFAC'><b>[\" + (i + 1) + \"] \" + pt.label + \"</b> · </font>\" +\n          \"<font face='Courier New' size='12' color='#FACC15'><b>\" + pct + \"%</b></font>\" +\n          \"<font face='Courier New' size='11' color='#4ADE80'> (+\" + pt.critBonus + \"%CRIT)</font>\";\n      }\n      i = i + 1;\n    }\n    var coverNote:String = (coverAc > 0) ? \" · <font color='#FACC15'>TARGET IN HEX COVER (-15%)</font>\" : \"\";\n    modalBodyTf.htmlText =\n      \"<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>\" +\n      \"<font face='Courier New' size='11' color='#86EFAC'>Cost: <b>\" + w.apAimed + \" AP</b> · Click zone or press <b>[1-5]</b> · <b>[ESC]</b> Cancel\" + coverNote + \"</font>\";\n    return;\n  }\n\n  if (modalMode == \"inv\") {\n    modalTitleTf.text = \"VAULT-TEC INVENTORY & ARSENAL\";\n    modalTitleTf.setTextFormat(titleFmt);\n    var sgLine:String = unlockedShotgun\n      ? (\"<b>[3] Sawed-Off 12ga Shotgun</b> — Dmg 12-21, Rng 6 hex \" + (activeSlot == 3 ? \"<font color='#4ADE80'>[ACTIVE]</font>\" : \"\"))\n      : \"<font color='#64748B'>[3] Sawed-Off 12ga — Not found yet (Search Prospector's Campfire)</font>\";\n    var armorStatus:String = unlockedLeatherArmor\n      ? (hasLeatherArmor ? \"<font color='#4ADE80'>EQUIPPED (+8 AC, 25% DR)</font>\" : \"<font color='#FACC15'>IN PACK (Press [4] to wear)</font>\")\n      : \"Not found yet (Search Hazmat Island across Sump Catwalk)\";\n    modalBodyTf.htmlText =\n      \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n      \"<font color='#FACC15'><b>WEAPONS &amp; ARMOR:</b></font><br>\" +\n      \"<b>[1] 10mm Colt 6520 Pistol</b> — Dmg 6-13, Rng 10 hex \" + (activeSlot == 1 ? \"<font color='#4ADE80'>[ACTIVE]</font>\" : \"\") + \"<br>\" +\n      \"<b>[2] Vault Combat Knife</b> — Dmg 4-9+ST, 1 hex \" + (activeSlot == 2 ? \"<font color='#4ADE80'>[ACTIVE]</font>\" : \"\") + \"<br>\" +\n      sgLine + \"<br>\" +\n      \"<b>[4] Combat Leather Armor</b> — \" + armorStatus + \"<br><br>\" +\n      \"<font color='#FACC15'><b>CHEMS, EXPLOSIVES &amp; TOOLS:</b></font><br>\" +\n      \"<b>[5] Inject Stimpak (\" + stimpaks + \" left)</b> — Heals +\" + (15 + Math.floor(specStats.firstAid * 0.1)) + \" HP &amp; cures Venom<br>\" +\n      \"<b>[6] Use RadAway (\" + radaways + \" left)</b> — Scrubs -25 RAD (Current: \" + rads + \" RAD)<br>\" +\n      \"<b>[7] Ignite Cavern Flare (\" + flares + \" left)</b> — +3 Hex Sight &amp; +8% Aim (\" + flareTurns + \" turns)<br>\" +\n      \"<b>[G] Frag Grenades (\" + grenades + \" left)</b> — 2-Hex AoE Blast · 10mm: <b>\" + magAmmo + \"/\" + reserveAmmo + \"</b> · 12ga: <b>\" + shotgunMag + \"/\" + shells12ga + \"</b><br><br>\" +\n      \"<font color='#86EFAC'>Press [1-7] or click row · [I] or [ESC] Return to Cavern</font>\" +\n      \"</font>\";\n    return;\n  }\n\n  if (modalMode == \"cha\") {\n    modalTitleTf.text = \"VAULT DWELLER — S.P.E.C.I.A.L. RECORD (LEVEL \" + level + \")\";\n    modalTitleTf.setTextFormat(titleFmt);\n    var accPct:Number = accPctSafe(shotsHit, shotsFired);\n    modalBodyTf.htmlText =\n      \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n      \"<font color='#FACC15'><b>PRIMARY STATISTICS:</b></font><br>\" +\n      \"STRENGTH: <b>0\" + specStats.st + \"</b> · PERCEPTION: <b>0\" + specStats.pe + \"</b> · ENDURANCE: <b>0\" + specStats.en + \"</b><br>\" +\n      \"CHARISMA: <b>0\" + specStats.ch + \"</b> · INTELLIGENCE: <b>0\" + specStats.intel + \"</b> · AGILITY: <b>0\" + specStats.ag + \"</b> · LUCK: <b>0\" + specStats.lk + \"</b><br><br>\" +\n      \"<font color='#FACC15'><b>TAGGED SKILLS:</b></font><br>\" +\n      \"• Small Guns: <b>\" + specStats.smallGuns + \"%</b> · Melee Weapons: <b>\" + specStats.melee + \"%</b><br>\" +\n      \"• Throwing: <b>\" + specStats.throwing + \"%</b> · Science: <b>\" + specStats.science + \"%</b> · First Aid: <b>\" + specStats.firstAid + \"%</b><br><br>\" +\n      \"<font color='#FACC15'><b>HEX EXPEDITION RECORD:</b></font><br>\" +\n      \"HP: <b>\" + hp + \"/\" + maxHp + \"</b> · Armor Class: <b>\" + currentAc() + \"</b> · Action Points: <b>\" + maxAp + \"</b><br>\" +\n      \"XP: <b>\" + xp + \" / \" + (level * 250) + \"</b> · Hostiles Eliminated: <b>\" + killsCount + \"/\" + enemies.length + \"</b> · Accuracy: <b>\" + accPct + \"%</b><br><br>\" +\n      \"<font color='#86EFAC'>Press [O] or [ESC] or click anywhere to close</font>\" +\n      \"</font>\";\n    return;\n  }\n\n  if (modalMode == \"pip\") {\n    modalTitleTf.text = \"PIP-BOY 2000 · \" + (pipTab == 0 ? \"DIRECTIVES & HOLODISKS\" : \"HEXAGONAL CAVERN AUTOMAP (36x28)\");\n    modalTitleTf.setTextFormat(titleFmt);\n    if (pipTab == 0) {\n      var edDone:String = containers[0].looted ? \"<font color='#4ADE80'>[DONE]</font>\" : \"<font color='#FACC15'>[ACTIVE]</font>\";\n      var termDone:String = terminalHacked ? \"<font color='#4ADE80'>[HACKED]</font>\" : \"<font color='#FACC15'>[4,2]</font>\";\n      var sgDone:String = unlockedShotgun ? \"<font color='#4ADE80'>[ACQUIRED]</font>\" : \"<font color='#FACC15'>[14,6]</font>\";\n      var ratsDone:String = (killsCount >= enemies.length) ? \"<font color='#4ADE80'>[ALL CLEARED]</font>\" : (\"(\" + killsCount + \"/\" + enemies.length + \" neutralized)\");\n      var holoTxt:String = hasHolodisk ? (\"<br><font color='#FACC15'><b>\" + escHtml(catalog.holoTitle) + \":</b></font><br>\" + escHtml(catalog.holoBody)) : \"<br><i>Loot Airlock Armory Locker (2,2) for Overseer Holodisk &amp; Frag Grenades.</i>\";\n      modalBodyTf.htmlText =\n        \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n        \"<font color='#FACC15'><b>VAULT 13 CAVERN COMPLEX OBJECTIVES:</b></font><br>\" +\n        \"1. Loot Ed's Remains (5,4) \" + edDone + \" &amp; Hack Security Terminal \" + termDone + \"<br>\" +\n        \"2. Recover Prospector's Sawed-Off 12ga at Campfire \" + sgDone + \"<br>\" +\n        \"3. Cross Rad-Sump Catwalks or Radscorpion Canyon \" + ratsDone + \"<br>\" +\n        \"4. Defeat the Brood Mother &amp; reach Sunlit Exit Grid (33,20)<br>\" +\n        holoTxt + \"<br><br>\" +\n        \"<font color='#86EFAC'><b>[1]</b> Directives · <b>[2]</b> Hex Automap · <b>[5/F5]</b> Save · <b>[9/F9]</b> Load · <b>[P/ESC]</b> Close</font>\" +\n        \"</font>\";\n    } else {\n      modalBodyTf.htmlText =\n        \"<font face='Courier New' size='11' color='#BBF7D0'>\" +\n        \"Green = Dweller · Red = Hostiles · Cyan = Loot · Orange = Rad-Drums · Gold = Exit (Click map to pan!)<br>\" +\n        \"<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>\" +\n        \"<font color='#86EFAC'><b>[1]</b> Directives · <b>[2]</b> Hex Automap · <b>[5/F5]</b> Save · <b>[9/F9]</b> Load · <b>[P/ESC]</b> Close</font>\" +\n        \"</font>\";\n      // Draw 36x28 staggered hex-offset scanner inside modalBgClip!\n      var ox:Number = 186;\n      var oy:Number = 104;\n      var stepX:Number = 11;\n      var stepY:Number = 8;\n      var my:Number = 0;\n      while (my < MAP_H) {\n        var rowShift:Number = (my % 2) * 5;\n        var mx:Number = 0;\n        while (mx < MAP_W) {\n          var idx:Number = my * MAP_W + mx;\n          var fs:Number = fogState[idx];\n          if (fs > 0) {\n            var t:Number = grid[idx];\n            var cCol:Number = 0x153820;\n            if (t == 0 || t == 3) { cCol = 0x09140C; }\n            else if (t == 5) { cCol = 0x3B82F6; }\n            else if (t == 4) { cCol = 0x65A30D; }\n            else if (t == 10) { cCol = 0x94A3B8; }\n            else if (t == 8) { cCol = 0xA16207; }\n            else if (t == 7) { cCol = 0xFACC15; }\n            else if (fs == 2) { cCol = 0x22543D; }\n            var px:Number = ox + mx * stepX + rowShift;\n            var py:Number = oy + my * stepY;\n            var mClip:MovieClip = (my < 14) ? modalMapClipA : modalMapClipB;\n            mClip.lineStyle(undefined);\n            mClip.beginFill(cCol, 100);\n            mClip.moveTo(px, py);\n            mClip.lineTo(px + 9, py);\n            mClip.lineTo(px + 9, py + 7);\n            mClip.lineTo(px, py + 7);\n            mClip.endFill();\n          }\n          mx = mx + 1;\n        }\n        my = my + 1;\n      }\n      var ci:Number = 0;\n      while (ci < containers.length) {\n        var co:Object = containers[ci];\n        if (!co.looted && fogState[co.ty * MAP_W + co.tx] > 0) {\n          var cxp:Number = ox + co.tx * stepX + (co.ty % 2) * 5 + 2;\n          var cyp:Number = oy + co.ty * stepY + 1;\n          modalBgClip.beginFill(0x38BDF8, 100);\n          modalBgClip.moveTo(cxp, cyp); modalBgClip.lineTo(cxp + 5, cyp);\n          modalBgClip.lineTo(cxp + 5, cyp + 5); modalBgClip.lineTo(cxp, cyp + 5);\n          modalBgClip.endFill();\n        }\n        ci = ci + 1;\n      }\n      var bi:Number = 0;\n      while (bi < barrels.length) {\n        var br:Object = barrels[bi];\n        if (br.alive && fogState[br.ty * MAP_W + br.tx] > 0) {\n          var bxp:Number = ox + br.tx * stepX + (br.ty % 2) * 5 + 2;\n          var byp:Number = oy + br.ty * stepY + 1;\n          modalBgClip.beginFill(0xF97316, 100);\n          modalBgClip.moveTo(bxp, byp); modalBgClip.lineTo(bxp + 5, byp);\n          modalBgClip.lineTo(bxp + 5, byp + 5); modalBgClip.lineTo(bxp, byp + 5);\n          modalBgClip.endFill();\n        }\n        bi = bi + 1;\n      }\n      var ei:Number = 0;\n      while (ei < enemies.length) {\n        var en:Object = enemies[ei];\n        if (en.alive && fogState[en.ty * MAP_W + en.tx] == 2) {\n          var exp:Number = ox + en.tx * stepX + (en.ty % 2) * 5 + 2;\n          var eyp:Number = oy + en.ty * stepY + 1;\n          modalBgClip.beginFill(0xEF4444, 100);\n          modalBgClip.moveTo(exp, eyp); modalBgClip.lineTo(exp + 5, eyp);\n          modalBgClip.lineTo(exp + 5, eyp + 5); modalBgClip.lineTo(exp, eyp + 5);\n          modalBgClip.endFill();\n        }\n        ei = ei + 1;\n      }\n      var uxp:Number = ox + playerTx * stepX + (playerTy % 2) * 5 + 1;\n      var uyp:Number = oy + playerTy * stepY;\n      modalBgClip.beginFill(0x4ADE80, 100);\n      modalBgClip.moveTo(uxp, uyp); modalBgClip.lineTo(uxp + 7, uyp);\n      modalBgClip.lineTo(uxp + 7, uyp + 7); modalBgClip.lineTo(uxp, uyp + 7);\n      modalBgClip.endFill();\n    }\n    return;\n  }\n\n  if (modalMode == \"end\") {\n    if (escapedCavern) {\n      modalTitleTf.text = \"VAULT 13 HEX CAVERNS CLEARED — THE WASTELAND AWAITS\";\n      modalTitleTf.setTextFormat(titleFmt);\n      modalBodyTf.htmlText =\n        \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n        \"<font color='#FACC15'><b>YOU STEP OUT INTO THE BLINDING CALIFORNIA DESERT SUN...</b></font><br><br>\" +\n        \"Behind you, the hexagonal basalt mouth of Mount Whitney seals Vault 13 in shadow. \" +\n        \"Ahead lies Shady Sands, Vault 15, and the search for the Water Chip.<br><br>\" +\n        \"• Final Level: <b>\" + level + \" (\" + xp + \" XP)</b><br>\" +\n        \"• Remaining Health: <b>\" + hp + \"/\" + maxHp + \" HP</b> (Radiation: \" + rads + \" RAD)<br>\" +\n        \"• Cavern Hostiles Eliminated: <b>\" + killsCount + \" / \" + enemies.length + \"</b><br>\" +\n        \"• Weapons Accuracy: <b>\" + accPctSafe(shotsHit, shotsFired) + \"%</b> · Arsenal: <b>\" + (unlockedShotgun ? \"Colt 6520 + Sawed-Off 12ga\" : \"Colt 6520\") + \"</b><br><br>\" +\n        \"<font color='#4ADE80'><b>Press [R] or click here to start a new Vault 13 expedition!</b></font>\" +\n        \"</font>\";\n    } else {\n      modalTitleTf.text = \"YOUR BONES JOIN ED'S IN THE DARK...\";\n      modalTitleTf.setTextFormat(titleFmt);\n      modalBodyTf.htmlText =\n        \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n        \"<font color='#EF4444'><b>YOU HAVE DIED.</b></font><br><br>\" +\n        \"Without the Water Chip, Vault 13's reserves run dry. Cave rats and radscorpions claim the dark.<br><br>\" +\n        \"• XP Earned: <b>\" + xp + \"</b> · Hostiles Killed: <b>\" + killsCount + \" / \" + enemies.length + \"</b><br><br>\" +\n        \"<font color='#FACC15'><b>Press [R] to restart from Airlock 13, or [F9] to load Pip-Boy Save.</b></font>\" +\n        \"</font>\";\n    }\n  }\n}\n\nfunction accPctSafe(h:Number, f:Number):Number {\n  if (f <= 0) { return 100; }\n  return Math.round((h * 100) / f);\n}\n\n// --- Level Initialization & Reset ---\nfunction resetGame():Void {\n  grid = VaultData.createGrid();\n  var total:Number = MAP_W * MAP_H;\n  fogState = [];\n  lightMap = [];\n  var i:Number = 0;\n  while (i < total) {\n    fogState[i] = 0;\n    lightMap[i] = 0.0;\n    i = i + 1;\n  }\n\n  var rawEnemies:Array = VaultData.createEnemies();\n  enemies = [];\n  i = 0;\n  while (i < rawEnemies.length) {\n    var re:Object = rawEnemies[i];\n    enemies.push({\n      id: re.id, kind: re.kind, name: re.name,\n      tx: re.tx, ty: re.ty, hp: re.hp, maxHp: re.maxHp,\n      ap: re.ap, curAp: re.ap, ac: re.ac,\n      minDmg: re.minDmg, maxDmg: re.maxDmg, xp: re.xp,\n      alive: true, alerted: false, crippled: false, blinded: false, stunned: false\n    });\n    i = i + 1;\n  }\n\n  containers = VaultData.createContainers();\n  barrels = VaultData.createBarrels();\n  propsList = VaultData.createProps();\n\n  playerTx = 3;\n  playerTy = 4;\n  drawWx = PathLos.hexWorldX(playerTx, playerTy);\n  drawWy = PathLos.hexWorldY(playerTy);\n  stepFromWx = drawWx;\n  stepFromWy = drawWy;\n  facingDx = 1.0;\n  facingDy = 0.15;\n  walkQueue = [];\n  stepProgress = 1.0;\n  pendingContainerIdx = -1;\n\n  level = 1;\n  xp = 0;\n  maxHp = 36;\n  hp = 36;\n  rads = 0;\n  poisonTurns = 0;\n  maxAp = 9;\n  ap = 9;\n  specStats.smallGuns = 78;\n  specStats.melee = 65;\n  hasLeatherArmor = false;\n  unlockedLeatherArmor = false;\n  unlockedShotgun = false;\n  terminalHacked = false;\n  hasHolodisk = false;\n\n  activeSlot = 1;\n  fireMode = 0;\n  grenadeMode = false;\n  magAmmo = 12;\n  reserveAmmo = 16;\n  shotgunMag = 2;\n  shells12ga = 0;\n  grenades = 1;\n  stimpaks = 1;\n  radaways = 0;\n  flares = 0;\n  flareTurns = 0;\n\n  inCombat = false;\n  combatTurn = \"player\";\n  turnNumber = 1;\n  shotsFired = 0;\n  shotsHit = 0;\n  killsCount = 0;\n  gameOver = false;\n  escapedCavern = false;\n  modalMode = \"\";\n  camPanX = 0;\n  camPanY = 0;\n  blastEffects = [];\n\n  logLines = [];\n  PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n  camX = Math.round(VIEW_W * 0.45 - drawWx);\n  camY = Math.round(VIEW_H * 0.50 - drawWy);\n  terrainDirty = true;\n  radarDirty = true;\n\n  addLog(\"Airlock 13 seals behind you. 36x28 hex caverns stretch East.\", \"#86EFAC\");\n  addLog(\"Loot Ed's Remains (5,4) & hack Security Terminal (4,2) for sector scans!\", \"#FACC15\");\n  renderModal();\n  updateHud();\n}\n\n// --- Hexagonal Terrain & Live Radar Rendering ---\nfunction renderTerrainIfDirty():Void {\n  if (!terrainDirty) { return; }\n  terrainDirty = false;\n  var bc:Number = 0;\n  while (bc < terrainBands.length) {\n    terrainBands[bc].clear();\n    bc = bc + 1;\n  }\n  radGlowClip.clear();\n\n  var ty:Number = 0;\n  while (ty < MAP_H) {\n    var tBand:MovieClip = terrainBands[Math.floor(ty / 4)];\n    var sy:Number = hexScreenY(ty);\n    if (sy >= -56 && sy <= VIEW_H + 64) {\n      var tx:Number = 0;\n      while (tx < MAP_W) {\n        var idx:Number = ty * MAP_W + tx;\n        var fs:Number = fogState[idx];\n        if (fs > 0) {\n          var sx:Number = hexScreenX(tx, ty);\n          if (sx >= -56 && sx <= VIEW_W + 56) {\n            var tile:Number = grid[idx];\n            var light:Number = (fs == 2) ? lightMap[idx] : 0.25;\n\n            if (tile == 0 || tile == 5 || tile == 3 || tile == 8) {\n              var nearOpen:Boolean = (tile != 0);\n              if (!nearOpen) {\n                var nd:Number = 0;\n                while (nd < 6) {\n                  var nb:Object = PathLos.neighborHex(tx, ty, nd);\n                  if (nb.tx >= 0 && nb.ty >= 0 && nb.tx < MAP_W && nb.ty < MAP_H) {\n                    if (grid[nb.ty * MAP_W + nb.tx] != 0) {\n                      nearOpen = true;\n                      break;\n                    }\n                  }\n                  nd = nd + 1;\n                }\n              }\n              if (nearOpen) {\n                ArtGen.drawWallColumn(tBand, sx, sy, tile, light, tx, ty);\n              }\n            } else if (tile == 4) {\n              // Bioluminescent radioactive sludge hexagon\n              ArtGen.drawHex(tBand, sx, sy, 1.0, ArtGen.shadeColor(0x166534, light + 0.25), 100, 0x14532D, 92, 1);\n              ArtGen.drawHex(radGlowClip, sx, sy, 0.88, 0x4ADE80, (fs == 2) ? 55 : 22, 0x86EFAC, 60, 1);\n            } else if (tile == 10) {\n              // Rusted Vault Steel Catwalk Bridge suspended over glowing green ooze!\n              ArtGen.drawHex(radGlowClip, sx, sy, 0.92, 0x4ADE80, (fs == 2) ? 38 : 16, 0x4ADE80, 0, 0);\n              ArtGen.drawHex(tBand, sx, sy, 1.0, ArtGen.shadeColor(0x334155, light + 0.12), 100, ArtGen.shadeColor(0xEAB308, light), 85, 1.4);\n              // Steel catwalk grating ribs\n              tBand.lineStyle(1, ArtGen.shadeColor(0x64748B, light + 0.1), 85);\n              tBand.moveTo(sx - 15, sy - 5); tBand.lineTo(sx + 15, sy - 5);\n              tBand.moveTo(sx - 17, sy);     tBand.lineTo(sx + 17, sy);\n              tBand.moveTo(sx - 15, sy + 5); tBand.lineTo(sx + 15, sy + 5);\n            } else if (tile == 7) {\n              // Sunlit California Wasteland Exit Grid hexagon!\n              ArtGen.drawHex(tBand, sx, sy, 1.0, ArtGen.shadeColor(0xD97706, Math.max(0.68, light)), 100, 0xFACC15, 95, 1.6);\n              ArtGen.drawHex(tBand, sx, sy, 0.72, 0xF59E0B, 45, 0xFEF08A, 70, 1);\n              if (fs == 2) {\n                tBand.lineStyle(undefined);\n                tBand.beginFill(0xFEF08A, 16);\n                tBand.moveTo(sx - 20, sy - 86);\n                tBand.lineTo(sx + 20, sy - 86);\n                tBand.lineTo(sx + 24, sy);\n                tBand.lineTo(sx - 24, sy);\n                tBand.endFill();\n              }\n            } else {\n              // Standard walkable hexes: 2 = Vault steel, 6 = bone/gravel, 1 = damp cavern stone\n              var grit:Number = (ArtGen.hash2d(tx, ty, 31) - 0.5) * 0.12;\n              var baseHex:Number = (tile == 2) ? 0x475569 : ((tile == 6) ? 0x635341 : 0x524538);\n              var floorCol:Number = ArtGen.shadeColor(baseHex, Math.max(0.17, light + grit));\n              var edgeCol:Number = ArtGen.shadeColor(0x231D17, Math.max(0.22, light));\n              ArtGen.drawHex(tBand, sx, sy, 1.0, floorCol, 100, edgeCol, 82, 1.1);\n\n              // Subtle inner hex bevel on Vault airlock plating & hazard threshold\n              if (tile == 2) {\n                ArtGen.drawHex(tBand, sx, sy, 0.78, floorCol, 0, ArtGen.shadeColor(0x64748B, light), 40, 1);\n                if (tx == 7) {\n                  tBand.lineStyle(2, ArtGen.shadeColor(0xEAB308, light), 85);\n                  tBand.moveTo(sx, sy - 11);\n                  tBand.lineTo(sx, sy + 11);\n                }\n              }\n            }\n          }\n        }\n        tx = tx + 1;\n      }\n    }\n    ty = ty + 1;\n  }\n}\n\nfunction renderCornerRadar():Void {\n  radarClip.clear();\n  radarBandB.clear();\n  if (!showRadar || modalMode != \"\") { return; }\n\n  var rx:Number = 648;\n  var ry:Number = 34;\n  var rw:Number = 144;\n  var rh:Number = 92;\n\n  radarClip.lineStyle(1.5, 0x3E5C43, 92);\n  radarClip.beginFill(0x071109, 88);\n  radarClip.moveTo(rx, ry);\n  radarClip.lineTo(rx + rw, ry);\n  radarClip.lineTo(rx + rw, ry + rh);\n  radarClip.lineTo(rx, ry + rh);\n  radarClip.endFill();\n\n  var cellW:Number = 3.7;\n  var cellH:Number = 3.0;\n  var ox:Number = rx + 5;\n  var oy:Number = ry + 4;\n\n  var my:Number = 0;\n  while (my < MAP_H) {\n    var sh:Number = (my % 2) * 1.8;\n    var rTarget:MovieClip = (my < 14) ? radarClip : radarBandB;\n    var mx:Number = 0;\n    while (mx < MAP_W) {\n      var idx:Number = my * MAP_W + mx;\n      var fs:Number = fogState[idx];\n      if (fs > 0) {\n        var t:Number = grid[idx];\n        if (t != 0) {\n          var rc:Number = (t == 7) ? 0xFACC15 : ((t == 4) ? 0x65A30D : ((t == 10) ? 0x94A3B8 : ((fs == 2) ? 0x276749 : 0x133320)));\n          var px:Number = ox + mx * cellW + sh;\n          var py:Number = oy + my * cellH;\n          rTarget.lineStyle(undefined);\n          rTarget.beginFill(rc, 100);\n          rTarget.moveTo(px, py);\n          rTarget.lineTo(px + 3, py);\n          rTarget.lineTo(px + 3, py + 2.6);\n          rTarget.lineTo(px, py + 2.6);\n          rTarget.endFill();\n        }\n      }\n      mx = mx + 1;\n    }\n    my = my + 1;\n  }\n\n  // Unlooted supplies (cyan) & live hostiles (red)\n  var ci:Number = 0;\n  while (ci < containers.length) {\n    var co:Object = containers[ci];\n    if (!co.looted && fogState[co.ty * MAP_W + co.tx] > 0) {\n      var cpx:Number = ox + co.tx * cellW + (co.ty % 2) * 1.8;\n      var cpy:Number = oy + co.ty * cellH;\n      radarClip.beginFill(0x38BDF8, 100);\n      radarClip.moveTo(cpx, cpy); radarClip.lineTo(cpx + 3, cpy);\n      radarClip.lineTo(cpx + 3, cpy + 3); radarClip.lineTo(cpx, cpy + 3);\n      radarClip.endFill();\n    }\n    ci = ci + 1;\n  }\n  var ei:Number = 0;\n  while (ei < enemies.length) {\n    var en:Object = enemies[ei];\n    if (en.alive && fogState[en.ty * MAP_W + en.tx] == 2) {\n      var epx:Number = ox + en.tx * cellW + (en.ty % 2) * 1.8;\n      var epy:Number = oy + en.ty * cellH;\n      radarClip.beginFill(0xEF4444, 100);\n      radarClip.moveTo(epx, epy); radarClip.lineTo(epx + 3.2, epy);\n      radarClip.lineTo(epx + 3.2, epy + 3.2); radarClip.lineTo(epx, epy + 3.2);\n      radarClip.endFill();\n    }\n    ei = ei + 1;\n  }\n\n  // Vault Dweller bright green marker\n  var ppx:Number = ox + playerTx * cellW + (playerTy % 2) * 1.8;\n  var ppy:Number = oy + playerTy * cellH;\n  radarClip.beginFill(0x4ADE80, 100);\n  radarClip.moveTo(ppx - 1, ppy - 1); radarClip.lineTo(ppx + 4, ppy - 1);\n  radarClip.lineTo(ppx + 4, ppy + 4); radarClip.lineTo(ppx - 1, ppy + 4);\n  radarClip.endFill();\n}\n\nfunction renderHoverAndEntities():Void {\n  cursorClip.clear();\n  entitiesClip.clear();\n\n  // 1. Hexagonal hover cursor, A* hex path & 2-hex Grenade AoE rosette!\n  if (modalMode == \"\" && !gameOver && !escapedCavern && hoverTx >= 0 && hoverTy >= 0 && hoverTx < MAP_W && hoverTy < MAP_H) {\n    if (grenadeMode) {\n      var inThrowRange:Boolean = PathLos.hexDist(playerTx, playerTy, hoverTx, hoverTy) <= 8;\n      var gy:Number = Math.max(0, hoverTy - 2);\n      var gMaxY:Number = Math.min(MAP_H - 1, hoverTy + 2);\n      while (gy <= gMaxY) {\n        var gx:Number = Math.max(0, hoverTx - 3);\n        var gMaxX:Number = Math.min(MAP_W - 1, hoverTx + 3);\n        while (gx <= gMaxX) {\n          var ghd:Number = PathLos.hexDist(hoverTx, hoverTy, gx, gy);\n          if (ghd <= 2) {\n            var gCol:Number = inThrowRange ? ((ghd == 0) ? 0xEF4444 : 0xF97316) : 0x64748B;\n            ArtGen.drawHex(cursorClip, hexScreenX(gx, gy), hexScreenY(gy), 0.92, gCol, (ghd == 0) ? 35 : 18, gCol, 90, 1.5);\n          }\n          gx = gx + 1;\n        }\n        gy = gy + 1;\n      }\n    } else if (hoverPath.length > 0 && (!inCombat || combatTurn == \"player\")) {\n      var pi:Number = 0;\n      while (pi < hoverPath.length) {\n        var stepNode:Object = hoverPath[pi];\n        var psx:Number = hexScreenX(stepNode.tx, stepNode.ty);\n        var psy:Number = hexScreenY(stepNode.ty);\n        var affordable:Boolean = (!inCombat) || ((pi + 1) <= ap);\n        var stepCol:Number = affordable ? 0x4ADE80 : 0xEF4444;\n        var isLast:Boolean = (pi == hoverPath.length - 1);\n        ArtGen.drawHex(\n          cursorClip, psx, psy, isLast ? 0.88 : 0.42,\n          stepCol, isLast ? 28 : 22, stepCol, 92, isLast ? 1.8 : 1.2\n        );\n        pi = pi + 1;\n      }\n    } else if (fogState[hoverTy * MAP_W + hoverTx] > 0) {\n      var hsx:Number = hexScreenX(hoverTx, hoverTy);\n      var hsy:Number = hexScreenY(hoverTy);\n      var hCol:Number = (hoverEnemyIdx >= 0 || hoverBarrelIdx >= 0) ? 0xEF4444\n        : ((hoverContainerIdx >= 0) ? 0xFACC15 : 0x86EFAC);\n      ArtGen.drawHex(cursorClip, hsx, hsy, 0.94, hCol, 16, hCol, 90, 1.8);\n    }\n  }\n\n  // 2. Collect visible entities & Y-sort back-to-front by worldY\n  var drawList:Array = [];\n  var i:Number = 0;\n  while (i < containers.length) {\n    var co:Object = containers[i];\n    if (fogState[co.ty * MAP_W + co.tx] > 0) {\n      var csy:Number = hexScreenY(co.ty);\n      var csx:Number = hexScreenX(co.tx, co.ty);\n      if (csx >= -50 && csx <= VIEW_W + 50 && csy >= -40 && csy <= VIEW_H + 50) {\n        drawList.push({ kind: \"container\", idx: i, sortKey: co.ty * 100 + co.tx - 15 });\n      }\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < barrels.length) {\n    var br:Object = barrels[i];\n    if (fogState[br.ty * MAP_W + br.tx] > 0) {\n      var bsy:Number = hexScreenY(br.ty);\n      var bsx:Number = hexScreenX(br.tx, br.ty);\n      if (bsx >= -50 && bsx <= VIEW_W + 50 && bsy >= -40 && bsy <= VIEW_H + 50) {\n        drawList.push({ kind: \"barrel\", idx: i, sortKey: br.ty * 100 + br.tx + (br.alive ? 4 : -35) });\n      }\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < propsList.length) {\n    var pr:Object = propsList[i];\n    if (fogState[pr.ty * MAP_W + pr.tx] > 0) {\n      var psy2:Number = hexScreenY(pr.ty);\n      var psx2:Number = hexScreenX(pr.tx, pr.ty);\n      if (psx2 >= -50 && psx2 <= VIEW_W + 50 && psy2 >= -40 && psy2 <= VIEW_H + 50) {\n        drawList.push({ kind: \"prop\", idx: i, sortKey: pr.ty * 100 + pr.tx });\n      }\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < enemies.length) {\n    var en:Object = enemies[i];\n    var eFog:Number = fogState[en.ty * MAP_W + en.tx];\n    if ((!en.alive && eFog > 0) || (en.alive && eFog == 2)) {\n      var esy:Number = hexScreenY(en.ty);\n      var esx:Number = hexScreenX(en.tx, en.ty);\n      if (esx >= -60 && esx <= VIEW_W + 60 && esy >= -50 && esy <= VIEW_H + 50) {\n        drawList.push({\n          kind: \"enemy\",\n          idx: i,\n          sortKey: en.ty * 100 + en.tx + (en.alive ? 10 : -40)\n        });\n      }\n    }\n    i = i + 1;\n  }\n  drawList.push({ kind: \"player\", idx: 0, sortKey: (drawWy / 24.0) * 100 + (drawWx / 48.0) + 12 });\n\n  // Insertion sort\n  var a:Number = 1;\n  while (a < drawList.length) {\n    var curItem:Object = drawList[a];\n    var b:Number = a - 1;\n    while (b >= 0 && drawList[b].sortKey > curItem.sortKey) {\n      drawList[b + 1] = drawList[b];\n      b = b - 1;\n    }\n    drawList[b + 1] = curItem;\n    a = a + 1;\n  }\n\n  i = 0;\n  while (i < drawList.length) {\n    var item:Object = drawList[i];\n    if (item.kind == \"container\") {\n      var cObj:Object = containers[item.idx];\n      ArtGen.drawContainerOrProp(\n        entitiesClip, hexScreenX(cObj.tx, cObj.ty), hexScreenY(cObj.ty),\n        cObj.kind, cObj.looted, hoverContainerIdx == item.idx, tickCounter\n      );\n    } else if (item.kind == \"barrel\") {\n      var bObj:Object = barrels[item.idx];\n      ArtGen.drawContainerOrProp(\n        entitiesClip, hexScreenX(bObj.tx, bObj.ty), hexScreenY(bObj.ty),\n        \"explosive_barrel\", !bObj.alive, hoverBarrelIdx == item.idx, tickCounter\n      );\n    } else if (item.kind == \"prop\") {\n      var pObj:Object = propsList[item.idx];\n      ArtGen.drawContainerOrProp(\n        entitiesClip, hexScreenX(pObj.tx, pObj.ty), hexScreenY(pObj.ty),\n        pObj.kind, false, false, tickCounter\n      );\n    } else if (item.kind == \"enemy\") {\n      var eObj:Object = enemies[item.idx];\n      ArtGen.drawEnemy(\n        entitiesClip, hexScreenX(eObj.tx, eObj.ty), hexScreenY(eObj.ty),\n        eObj.kind, eObj.alive, eObj.hp / eObj.maxHp, tickCounter, hoverEnemyIdx == item.idx\n      );\n    } else if (item.kind == \"player\") {\n      if (!gameOver) {\n        ArtGen.drawVaultDweller(\n          entitiesClip, drawWx + camX, drawWy + camY,\n          facingDx, facingDy, walkBobPhase,\n          hasLeatherArmor, activeSlot, muzzleTimer > 0\n        );\n      } else {\n        ArtGen.drawContainerOrProp(\n          entitiesClip, hexScreenX(playerTx, playerTy), hexScreenY(playerTy),\n          \"corpse\", true, false, tickCounter\n        );\n      }\n    }\n    i = i + 1;\n  }\n\n  // 3. Tracers, Expanding Hex Blast Shockwaves & Floating Damage Popups\n  fxClip.clear();\n  if (tracerTimer > 0) {\n    tracerTimer = tracerTimer - 1;\n    fxClip.lineStyle(2.4, tracerCol, 92);\n    fxClip.moveTo(tracerWx0 + camX, tracerWy0 + camY - 22);\n    fxClip.lineTo(tracerWx1 + camX, tracerWy1 + camY - 10);\n  }\n  if (muzzleTimer > 0) { muzzleTimer = muzzleTimer - 1; }\n\n  var bi2:Number = blastEffects.length - 1;\n  while (bi2 >= 0) {\n    var bl:Object = blastEffects[bi2];\n    bl.age = bl.age + 1;\n    if (bl.age >= bl.maxAge) {\n      blastEffects.splice(bi2, 1);\n    } else {\n      var prog:Number = bl.age / bl.maxAge;\n      var bScale:Number = 0.6 + prog * 2.4;\n      var bAlpha:Number = Math.round((1.0 - prog) * 85);\n      ArtGen.drawHex(fxClip, bl.wx + camX, bl.wy + camY, bScale, 0xF97316, bAlpha * 0.5, 0xFEF08A, bAlpha, 2.5);\n    }\n    bi2 = bi2 - 1;\n  }\n\n  var fi:Number = floatTexts.length - 1;\n  while (fi >= 0) {\n    var ft:Object = floatTexts[fi];\n    ft.ttl = ft.ttl - 1;\n    ft.rise = ft.rise + 0.75;\n    if (ft.ttl <= 0) {\n      if (ft.mc.tf != undefined) {\n        ft.mc.tf.text = \"\";\n        ft.mc.tf.removeTextField();\n      }\n      ft.mc._visible = false;\n      ft.mc.removeMovieClip();\n      floatTexts.splice(fi, 1);\n    } else {\n      ft.mc._x = ft.wx + camX;\n      ft.mc._y = ft.wy + camY - ft.rise;\n      ft.mc._alpha = Math.min(100, ft.ttl * 5);\n    }\n    fi = fi - 1;\n  }\n}\n\n// --- Player Hex Arrival & Environmental Triggers ---\nfunction onPlayerEnteredHex():Void {\n  PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n  terrainDirty = true;\n  radarDirty = true;\n\n  var curTile:Number = grid[playerTy * MAP_W + playerTx];\n  if (curTile == 7) {\n    escapedCavern = true;\n    walkQueue = [];\n    inCombat = false;\n    xp = xp + 300;\n    checkXpLevelUp();\n    playSound(sfx.escape, 0, 95);\n    addLog(\"FREEDOM! You emerge from Vault 13's hex caverns into the sunlit Wasteland! (+300 XP)\", \"#FACC15\");\n    modalMode = \"end\";\n    renderModal();\n    updateHud();\n    return;\n  }\n\n  // Geiger check across all 6 adjacent hexes (catwalk bridges shield slightly, raw shore exposes!)\n  var nearRad:Boolean = false;\n  var d:Number = 0;\n  while (d < 6) {\n    var nb:Object = PathLos.neighborHex(playerTx, playerTy, d);\n    if (nb.tx >= 0 && nb.ty >= 0 && nb.tx < MAP_W && nb.ty < MAP_H) {\n      if (grid[nb.ty * MAP_W + nb.tx] == 4) {\n        nearRad = true;\n        break;\n      }\n    }\n    d = d + 1;\n  }\n  if (nearRad && curTile != 10) {\n    var radGain:Number = hasLeatherArmor ? 1 : 2;\n    rads = rads + radGain;\n    addLog(\"Geiger counter clicks beside glowing sludge (+\" + radGain + \" RAD).\", \"#A3E635\");\n  }\n\n  // Spot hostile rats / radscorpions within 6 hexes -> engage Turn-Based Hex Combat!\n  if (!inCombat) {\n    var ei:Number = 0;\n    while (ei < enemies.length) {\n      var en:Object = enemies[ei];\n      if (en.alive && fogState[en.ty * MAP_W + en.tx] == 2 &&\n          PathLos.hexDist(playerTx, playerTy, en.tx, en.ty) <= 6) {\n        en.alerted = true;\n        enterCombat(\"Hostile \" + en.name + \" spotted at \" + PathLos.hexDist(playerTx, playerTy, en.tx, en.ty) + \" hexes — COMBAT STARTED!\");\n        return;\n      }\n      ei = ei + 1;\n    }\n  }\n\n  if (pendingContainerIdx >= 0 && walkQueue.length == 0) {\n    var targetC:Number = pendingContainerIdx;\n    pendingContainerIdx = -1;\n    lootContainer(targetC);\n  }\n  updateHud();\n}\n\n// Smart 6-Hex Directional Step:\n// dirList tries primary hex direction first, then graceful adjacent hex fallback!\nfunction tryHexStepDirs(dirA:Number, dirB:Number):Void {\n  if (gameOver || escapedCavern || modalMode != \"\") { return; }\n  if (inCombat && combatTurn != \"player\") { return; }\n  if (stepProgress < 1.0 || walkQueue.length > 0) { return; }\n\n  rebuildBlockedMask(-1, false);\n  var dirs:Array = (dirB >= 0) ? [dirA, dirB] : [dirA];\n  var di:Number = 0;\n  while (di < dirs.length) {\n    var nb:Object = PathLos.neighborHex(playerTx, playerTy, dirs[di]);\n    var nx:Number = nb.tx;\n    var ny:Number = nb.ty;\n    if (nx >= 0 && ny >= 0 && nx < MAP_W && ny < MAP_H) {\n      var eIdx:Number = enemyAtHex(nx, ny);\n      if (eIdx >= 0) {\n        executeAttack(eIdx, null);\n        return;\n      }\n      var cIdx:Number = containerAtHex(nx, ny);\n      if (cIdx >= 0 && (containers[cIdx].kind == \"locker\" || containers[cIdx].kind == \"footlocker\" || containers[cIdx].kind == \"terminal\")) {\n        lootContainer(cIdx);\n        return;\n      }\n      var nTile:Number = grid[ny * MAP_W + nx];\n      if (PathLos.isWalkableTile(nTile) && !blockedMask[ny * MAP_W + nx]) {\n        if (inCombat) {\n          if (ap < 1) {\n            addLog(\"Out of Action Points — press [SPACE] to End Turn!\", \"#FACC15\");\n            return;\n          }\n          ap = ap - 1;\n        }\n        camPanX = Math.round(camPanX * 0.4);\n        camPanY = Math.round(camPanY * 0.4);\n        walkQueue = [{ tx: nx, ty: ny }];\n        if (cIdx >= 0 && !containers[cIdx].looted) {\n          pendingContainerIdx = cIdx;\n        }\n        updateHud();\n        return;\n      }\n    }\n    di = di + 1;\n  }\n}\n\n// --- Enemy Hex AI Turn Execution ---\nfunction stepEnemyAi():Void {\n  if (aiWaitFrames > 0) {\n    aiWaitFrames = aiWaitFrames - 1;\n    return;\n  }\n\n  while (aiActorIdx < enemies.length) {\n    var e:Object = enemies[aiActorIdx];\n    if (!e.alive || !e.alerted || e.curAp <= 0) {\n      aiActorIdx = aiActorIdx + 1;\n    } else {\n      break;\n    }\n  }\n\n  if (aiActorIdx >= enemies.length) {\n    combatTurn = \"player\";\n    turnNumber = turnNumber + 1;\n    ap = maxAp;\n    if (flareTurns > 0) {\n      flareTurns = flareTurns - 1;\n      if (flareTurns == 0) {\n        PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n        terrainDirty = true;\n      }\n    }\n    checkAutoEndCombat();\n    updateHud();\n    return;\n  }\n\n  var actor:Object = enemies[aiActorIdx];\n  var dist:Number = PathLos.hexDist(actor.tx, actor.ty, playerTx, playerTy);\n\n  // Adjacent hex (hexDist == 1) -> Melee Bite / Radscorpion Stinger (3 AP)!\n  if (dist == 1) {\n    if (actor.curAp >= 3) {\n      actor.curAp = actor.curAp - 3;\n      aiWaitFrames = 8;\n      var hitChance:Number = 66 + actor.kind * 6 - currentAc() - (actor.blinded ? 28 : 0);\n      if (hitChance < 10) { hitChance = 10; }\n      var roll:Number = 1 + Math.floor(Math.random() * 100);\n      if (roll <= hitChance) {\n        var dmg:Number = actor.minDmg + Math.floor(Math.random() * (actor.maxDmg - actor.minDmg + 1));\n        if (hasLeatherArmor) {\n          dmg = Math.max(1, Math.round(dmg * 0.75) - 1);\n        }\n        hp = hp - dmg;\n        playSound(sfx.hurt, 0, 80);\n        if (actor.kind == 4 && Math.random() < 0.35) {\n          poisonTurns = Math.max(poisonTurns, 3);\n          addLog(actor.name + \" stings you for \" + dmg + \" dmg and injects VENOM!\", \"#A3E635\");\n          spawnFloatText(playerTx, playerTy, \"-\" + dmg + \" +VENOM\", 0xA3E635);\n        } else {\n          addLog(actor.name + \" lunges across the hex and strikes for \" + dmg + \" dmg!\", \"#EF4444\");\n          spawnFloatText(playerTx, playerTy, \"-\" + dmg + \" HP\", 0xEF4444);\n        }\n        if (hp <= 0) {\n          hp = 0;\n          gameOver = true;\n          modalMode = \"end\";\n          renderModal();\n          updateHud();\n          return;\n        }\n      } else {\n        playSound(sfx.ratSqueak, 0, 55);\n        addLog(actor.name + \" snaps at your armor and misses!\", \"#94A3B8\");\n        spawnFloatText(playerTx, playerTy, \"DODGED\", 0x86EFAC);\n      }\n      updateHud();\n      return;\n    } else {\n      actor.curAp = 0;\n      aiActorIdx = aiActorIdx + 1;\n      return;\n    }\n  }\n\n  // Step 1 hex toward Vault Dweller along 6-way Hex A*!\n  rebuildBlockedMask(aiActorIdx, true);\n  var path:Array = PathLos.findPath(grid, MAP_W, MAP_H, blockedMask, actor.tx, actor.ty, playerTx, playerTy, true);\n  if (path.length > 0 && actor.curAp >= 1) {\n    var nextStep:Object = path[0];\n    if (!(nextStep.tx == playerTx && nextStep.ty == playerTy) && !blockedMask[nextStep.ty * MAP_W + nextStep.tx]) {\n      actor.tx = nextStep.tx;\n      actor.ty = nextStep.ty;\n      actor.curAp = actor.curAp - 1;\n      radarDirty = true;\n      aiWaitFrames = 3;\n      return;\n    }\n  }\n  actor.curAp = 0;\n  aiActorIdx = aiActorIdx + 1;\n}\n\n// --- Input Routing (Mouse Clicks, Minimap Clicks, and Hotkeys) ---\nfunction findNearestVisibleEnemy():Number {\n  var bestIdx:Number = -1;\n  var bestDist:Number = 999;\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && fogState[e.ty * MAP_W + e.tx] == 2) {\n      var d:Number = PathLos.hexDist(playerTx, playerTy, e.tx, e.ty);\n      if (d < bestDist && PathLos.hasLineOfSight(grid, MAP_W, MAP_H, playerTx, playerTy, e.tx, e.ty)) {\n        bestDist = d;\n        bestIdx = i;\n      }\n    }\n    i = i + 1;\n  }\n  return bestIdx;\n}\n\nfunction openVatsOnEnemy(eIdx:Number):Void {\n  if (eIdx < 0 || eIdx >= enemies.length || !enemies[eIdx].alive) {\n    addLog(\"No visible hostile target in sight for V.A.T.S.!\", \"#F87171\");\n    return;\n  }\n  grenadeMode = false;\n  vatsTargetIdx = eIdx;\n  modalMode = \"vats\";\n  playSound(sfx.pipboy, 0, 75);\n  renderModal();\n}\n\nfunction panCameraToHex(tx:Number, ty:Number):Void {\n  var targetWx:Number = PathLos.hexWorldX(tx, ty);\n  var targetWy:Number = PathLos.hexWorldY(ty);\n  camPanX = Math.round(drawWx - targetWx);\n  camPanY = Math.round(drawWy - targetWy);\n  camX = Math.round(VIEW_W * 0.46 - targetWx);\n  camY = Math.round(VIEW_H * 0.50 - targetWy);\n  terrainDirty = true;\n}\n\nfunction handleStageMouseDown():Void {\n  var mx:Number = _root._xmouse;\n  var my:Number = _root._ymouse;\n\n  // 1. Active Modal clicks\n  if (modalMode != \"\") {\n    if (modalMode == \"end\") {\n      if (mx >= 120 && mx <= 680 && my >= 30 && my <= 370) {\n        resetGame();\n      }\n      return;\n    }\n    if (mx < 120 || mx > 680 || my < 30 || my > 370) {\n      modalMode = \"\";\n      renderModal();\n      return;\n    }\n    if (modalMode == \"vats\") {\n      var vi:Number = 0;\n      while (vi < vatsParts.length) {\n        var by:Number = 84 + vi * 44;\n        if (mx >= 142 && mx <= 416 && my >= by && my <= by + 36) {\n          var chosenPart:Object = vatsParts[vi];\n          var targetId:Number = vatsTargetIdx;\n          modalMode = \"\";\n          renderModal();\n          executeAttack(targetId, chosenPart);\n          return;\n        }\n        vi = vi + 1;\n      }\n      return;\n    }\n    if (modalMode == \"inv\") {\n      if (my >= 94 && my < 112) { activeSlot = 1; fireMode = 0; grenadeMode = false; }\n      else if (my >= 112 && my < 130) { activeSlot = 2; fireMode = 0; grenadeMode = false; }\n      else if (my >= 130 && my < 148 && unlockedShotgun) { activeSlot = 3; fireMode = 0; grenadeMode = false; }\n      else if (my >= 148 && my < 168 && unlockedLeatherArmor) { hasLeatherArmor = !hasLeatherArmor; }\n      else if (my >= 198 && my < 216) { useStimpak(); }\n      else if (my >= 216 && my < 234) { useRadAway(); }\n      else if (my >= 234 && my < 254 && flares > 0) {\n        flares = flares - 1;\n        flareTurns = 12;\n        PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n        terrainDirty = true;\n        addLog(\"Ignited Cavern Flare! +3 Hex Sight radius.\", \"#FACC15\");\n      } else if (my > 315) {\n        modalMode = \"\";\n      }\n      updateHud();\n      renderModal();\n      return;\n    }\n    if (modalMode == \"pip\") {\n      // Click inside Pip-Boy Hex Automap pans camera directly to that sector!\n      if (pipTab == 1 && mx >= 186 && mx <= 590 && my >= 104 && my <= 328) {\n        var mRow:Number = Math.max(0, Math.min(MAP_H - 1, Math.floor((my - 104) / 8)));\n        var mCol:Number = Math.max(0, Math.min(MAP_W - 1, Math.floor((mx - 186 - (mRow % 2) * 5) / 11)));\n        panCameraToHex(mCol, mRow);\n        modalMode = \"\";\n        renderModal();\n        addLog(\"Pip-Boy 2000: Camera panned to sector (\" + mCol + \",\" + mRow + \"). Press [C] to center.\", \"#86EFAC\");\n        return;\n      }\n      if (my >= 328) {\n        if (mx < 245) { pipTab = 0; }\n        else if (mx < 365) { pipTab = 1; }\n        else if (mx < 465) { saveProgressToSol(); }\n        else if (mx < 565) { loadProgressFromSol(); return; }\n        else { modalMode = \"\"; }\n        renderModal();\n      }\n      return;\n    }\n    modalMode = \"\";\n    renderModal();\n    return;\n  }\n\n  if (gameOver || escapedCavern) { return; }\n\n  // 2. Click on Live Corner Hex Radar Minimap (x=648..792, y=34..126) -> Pan camera!\n  if (showRadar && mx >= 648 && mx <= 792 && my >= 34 && my <= 126) {\n    var rgy:Number = Math.max(0, Math.min(MAP_H - 1, Math.floor((my - 38) / 3.0)));\n    var rgx:Number = Math.max(0, Math.min(MAP_W - 1, Math.floor((mx - 653 - (rgy % 2) * 1.8) / 3.7)));\n    panCameraToHex(rgx, rgy);\n    return;\n  }\n\n  // 3. Bottom HUD Console clicks (y >= 392)\n  if (my >= 392) {\n    if (mx >= 274 && mx <= 290 && my >= 404 && my <= 454) { scrollLog(-2); return; }\n    if (mx >= 274 && mx <= 290 && my >= 458 && my <= 508) { scrollLog(2); return; }\n    if (mx >= 302 && mx <= 362) {\n      if (my >= 400 && my <= 425) { modalMode = \"inv\"; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n      if (my >= 429 && my <= 454) { modalMode = \"cha\"; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n      if (my >= 458 && my <= 483) { modalMode = \"pip\"; pipTab = 0; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n      if (my >= 487 && my <= 512) { useStimpak(); return; }\n    }\n    if (mx >= 370 && mx <= 566 && my >= 428 && my <= 484) {\n      grenadeMode = false;\n      fireMode = (fireMode + 1) % (activeSlot == 2 ? 2 : 3);\n      playSound(sfx.pipboy, 0, 65);\n      updateHud();\n      return;\n    }\n    if (my >= 488 && my <= 512) {\n      if (mx >= 370 && mx <= 417) {\n        cycleWeaponSlot();\n        playSound(sfx.pipboy, 0, 70);\n        updateHud();\n        return;\n      }\n      if (mx >= 420 && mx <= 467) {\n        grenadeMode = false;\n        fireMode = (fireMode + 1) % (activeSlot == 2 ? 2 : 3);\n        playSound(sfx.pipboy, 0, 65);\n        updateHud();\n        return;\n      }\n      if (mx >= 470 && mx <= 517) {\n        openVatsOnEnemy(findNearestVisibleEnemy());\n        return;\n      }\n      if (mx >= 520 && mx <= 566) {\n        if (grenades > 0) {\n          grenadeMode = !grenadeMode;\n          playSound(sfx.pipboy, 0, 70);\n          addLog(grenadeMode ? \"Frag Grenade armed — click target hex (<= 8 hexes) to throw!\" : \"Grenade stowed.\", \"#FACC15\");\n          updateHud();\n        } else {\n          addLog(\"No Frag Grenades left!\", \"#F87171\");\n        }\n        return;\n      }\n    }\n    if (mx >= 694 && mx <= 790) {\n      if (my >= 428 && my <= 468) { endPlayerTurn(); return; }\n      if (my >= 472 && my <= 512) { tryEndCombat(); return; }\n    }\n    return;\n  }\n\n  // 4. Tactical Hexagonal Viewport clicks (y < 392)\n  if (inCombat && combatTurn != \"player\") { return; }\n\n  var hexHit:Object = screenToHex(mx, my);\n  var tx:Number = hexHit.tx;\n  var ty:Number = hexHit.ty;\n  if (tx < 0 || ty < 0 || tx >= MAP_W || ty >= MAP_H) { return; }\n\n  if (grenadeMode) {\n    throwGrenadeAt(tx, ty);\n    return;\n  }\n\n  // Clicked visible living enemy?\n  var clickedEnemy:Number = enemyAtHex(tx, ty);\n  if (clickedEnemy >= 0 && fogState[ty * MAP_W + tx] == 2) {\n    if (fireMode == 2) {\n      reloadActiveWeapon();\n    } else if (fireMode == 1) {\n      openVatsOnEnemy(clickedEnemy);\n    } else {\n      executeAttack(clickedEnemy, null);\n    }\n    return;\n  }\n\n  // Clicked volatile Rad-Drum?\n  var clickedBarrel:Number = barrelAtHex(tx, ty);\n  if (clickedBarrel >= 0 && fogState[ty * MAP_W + tx] == 2) {\n    shootBarrel(clickedBarrel);\n    return;\n  }\n\n  // Clicked unlooted container / Terminal / locker? (Already-looted floor corpses let you walk normally!)\n  var clickedCont:Number = containerAtHex(tx, ty);\n  if (clickedCont >= 0 && fogState[ty * MAP_W + tx] > 0 && (!containers[clickedCont].looted || !PathLos.isWalkableTile(grid[ty * MAP_W + tx]))) {\n    if (PathLos.hexDist(playerTx, playerTy, tx, ty) <= 1) {\n      lootContainer(clickedCont);\n      return;\n    }\n    if (!inCombat) {\n      rebuildBlockedMask(-1, false);\n      var cPath:Array = PathLos.findPath(grid, MAP_W, MAP_H, blockedMask, playerTx, playerTy, tx, ty, true);\n      if (cPath.length > 0) {\n        camPanX = 0;\n        camPanY = 0;\n        walkQueue = cPath;\n        pendingContainerIdx = clickedCont;\n      }\n      return;\n    }\n  }\n\n  // Clicked walkable hex -> compute 6-way Hex A* path and walk!\n  rebuildBlockedMask(-1, false);\n  var path:Array = PathLos.findPath(grid, MAP_W, MAP_H, blockedMask, playerTx, playerTy, tx, ty, false);\n  if (path.length == 0) { return; }\n\n  camPanX = 0;\n  camPanY = 0;\n  if (inCombat) {\n    if (ap <= 0) {\n      addLog(\"0 AP left — click END TURN or press [SPACE].\", \"#FACC15\");\n      return;\n    }\n    if (path.length > ap) {\n      path = path.slice(0, ap);\n    }\n    ap = ap - path.length;\n    walkQueue = path;\n    pendingContainerIdx = -1;\n    updateHud();\n  } else {\n    walkQueue = path;\n    pendingContainerIdx = -1;\n  }\n}\n\nvar mouseListener:Object = {};\nmouseListener.onMouseDown = function():Void {\n  handleStageMouseDown();\n};\nmouseListener.onMouseWheel = function(delta:Number):Void {\n  scrollLog(delta > 0 ? -1 : 1);\n};\nMouse.addListener(mouseListener);\n\nvar keyListener:Object = {};\nkeyListener.onKeyDown = function():Void {\n  var k:Number = Key.getCode();\n  if (k == 27) {\n    if (grenadeMode) { grenadeMode = false; updateHud(); return; }\n    if (modalMode != \"\") { modalMode = \"\"; renderModal(); return; }\n  }\n\n  if (gameOver || escapedCavern) {\n    if (k == 82) { resetGame(); }\n    else if (k == 120) { loadProgressFromSol(); }\n    return;\n  }\n\n  if (modalMode == \"vats\") {\n    if (k >= 49 && k <= 53) {\n      var pIdx:Number = k - 49;\n      if (pIdx < vatsParts.length) {\n        var partChoice:Object = vatsParts[pIdx];\n        var tId:Number = vatsTargetIdx;\n        modalMode = \"\";\n        renderModal();\n        executeAttack(tId, partChoice);\n      }\n    }\n    return;\n  }\n\n  if (modalMode == \"inv\") {\n    if (k == 49) { activeSlot = 1; fireMode = 0; grenadeMode = false; updateHud(); renderModal(); }\n    else if (k == 50) { activeSlot = 2; fireMode = 0; grenadeMode = false; updateHud(); renderModal(); }\n    else if (k == 51 && unlockedShotgun) { activeSlot = 3; fireMode = 0; grenadeMode = false; updateHud(); renderModal(); }\n    else if (k == 52 && unlockedLeatherArmor) { hasLeatherArmor = !hasLeatherArmor; updateHud(); renderModal(); }\n    else if (k == 53) { useStimpak(); renderModal(); }\n    else if (k == 54) { useRadAway(); renderModal(); }\n    else if (k == 55 && flares > 0) {\n      flares = flares - 1;\n      flareTurns = 12;\n      PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n      terrainDirty = true;\n      renderModal();\n    } else if (k == 73) {\n      modalMode = \"\";\n      renderModal();\n    }\n    return;\n  }\n\n  if (modalMode == \"pip\") {\n    if (k == 49) { pipTab = 0; renderModal(); }\n    else if (k == 50) { pipTab = 1; renderModal(); }\n    else if (k == 53 || k == 116) { saveProgressToSol(); }\n    else if (k == 57 || k == 120) { loadProgressFromSol(); }\n    else if (k == 80) { modalMode = \"\"; renderModal(); }\n    return;\n  }\n\n  if (modalMode == \"cha\") {\n    if (k == 79 || k == 67) { modalMode = \"\"; renderModal(); }\n    return;\n  }\n\n  // Gameplay Hotkeys\n  if (k == 73) { modalMode = \"inv\"; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n  if (k == 79) { modalMode = \"cha\"; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n  if (k == 80) { modalMode = \"pip\"; pipTab = 0; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n  if (k == 9)  { showRadar = !showRadar; renderCornerRadar(); return; } // Tab toggles live Hex Radar\n  if (k == 66) { cycleWeaponSlot(); playSound(sfx.pipboy, 0, 70); updateHud(); return; }\n  if (k == 49) { activeSlot = 1; fireMode = 0; grenadeMode = false; updateHud(); return; }\n  if (k == 50) { activeSlot = 2; fireMode = 0; grenadeMode = false; updateHud(); return; }\n  if (k == 51 && unlockedShotgun) { activeSlot = 3; fireMode = 0; grenadeMode = false; updateHud(); return; }\n  if (k == 77) { grenadeMode = false; fireMode = (fireMode + 1) % (activeSlot == 2 ? 2 : 3); updateHud(); return; }\n  if (k == 71) { // G = Frag Grenade aim / quick-throw\n    if (grenades <= 0) {\n      addLog(\"Out of Frag Grenades!\", \"#F87171\");\n      return;\n    }\n    if (grenadeMode) {\n      var gTarget:Number = findNearestVisibleEnemy();\n      if (gTarget >= 0) {\n        throwGrenadeAt(enemies[gTarget].tx, enemies[gTarget].ty);\n      } else {\n        grenadeMode = false;\n        updateHud();\n      }\n    } else {\n      grenadeMode = true;\n      playSound(sfx.pipboy, 0, 70);\n      addLog(\"Frag Grenade armed — click hex (or press [G] again for nearest hostile)!\", \"#FACC15\");\n      updateHud();\n    }\n    return;\n  }\n  if (k == 72) { useStimpak(); return; }\n  if (k == 82) { reloadActiveWeapon(); return; }\n  if (k == 84) { tryEndCombat(); return; }\n  if (k == 32 || k == 13) { if (inCombat) { endPlayerTurn(); } return; }\n  if (k == 116 || k == 75) { saveProgressToSol(); return; }\n  if (k == 120 || k == 76) { loadProgressFromSol(); return; }\n  if (k == 36 || k == 67) { camPanX = 0; camPanY = 0; terrainDirty = true; return; } // Home / C = Center camera\n\n  if (k == 86) { openVatsOnEnemy(findNearestVisibleEnemy()); return; }\n  if (k == 70) {\n    var fIdx:Number = findNearestVisibleEnemy();\n    if (fIdx >= 0) {\n      executeAttack(fIdx, null);\n    } else {\n      addLog(\"No visible hostile target in hex line of sight.\", \"#94A3B8\");\n    }\n    return;\n  }\n  if (k == 69) { // E = Interact / Hack / Loot adjacent hex!\n    var ci:Number = 0;\n    while (ci < containers.length) {\n      if (!containers[ci].looted && PathLos.hexDist(playerTx, playerTy, containers[ci].tx, containers[ci].ty) <= 1) {\n        lootContainer(ci);\n        return;\n      }\n      ci = ci + 1;\n    }\n    addLog(\"Nothing interactive on adjacent hexes.\", \"#94A3B8\");\n    return;\n  }\n\n  // 6-Hex Keyboard Navigation (with graceful adjacent hex sidestep around props/corners):\n  // A = West (4), D = East (1), W = North-Up (alternating 0/5 by parity), S = South-Down (2/3), Q = NW (5)\n  var oddRow:Number = playerTy % 2;\n  if (k == 65) { tryHexStepDirs(4, oddRow == 1 ? 3 : 5); }\n  else if (k == 68) { tryHexStepDirs(1, oddRow == 1 ? 2 : 0); }\n  else if (k == 87) { tryHexStepDirs(oddRow == 1 ? 5 : 0, oddRow == 1 ? 0 : 5); }\n  else if (k == 83) { tryHexStepDirs(oddRow == 1 ? 3 : 2, oddRow == 1 ? 2 : 3); }\n  else if (k == 81) { tryHexStepDirs(5, 0); }\n};\nKey.addListener(keyListener);\n\n// --- Main 30 FPS Frame Loop ---\ndrawHudButtonsChrome();\nresetGame();\n\nthis.onEnterFrame = function():Void {\n  tickCounter = tickCounter + 1;\n\n  if (modalMode == \"\") {\n    var panSpeed:Number = 10;\n    if (Key.isDown(Key.LEFT))  { camPanX = camPanX + panSpeed; terrainDirty = true; }\n    if (Key.isDown(Key.RIGHT)) { camPanX = camPanX - panSpeed; terrainDirty = true; }\n    if (Key.isDown(Key.UP))    { camPanY = camPanY + panSpeed; terrainDirty = true; }\n    if (Key.isDown(Key.DOWN))  { camPanY = camPanY - panSpeed; terrainDirty = true; }\n  }\n\n  // Advance smooth hex-to-hex walking interpolation\n  if (stepProgress < 1.0) {\n    stepProgress = Math.min(1.0, stepProgress + 0.28);\n    walkBobPhase = walkBobPhase + 0.95;\n    var destWx:Number = PathLos.hexWorldX(playerTx, playerTy);\n    var destWy:Number = PathLos.hexWorldY(playerTy);\n    drawWx = stepFromWx + (destWx - stepFromWx) * stepProgress;\n    drawWy = stepFromWy + (destWy - stepFromWy) * stepProgress;\n    if (stepProgress >= 1.0) {\n      drawWx = destWx;\n      drawWy = destWy;\n      onPlayerEnteredHex();\n    }\n  } else if (walkQueue.length > 0 && !gameOver && !escapedCavern) {\n    var nextNode:Object = walkQueue.shift();\n    rebuildBlockedMask(-1, false);\n    if (!blockedMask[nextNode.ty * MAP_W + nextNode.tx] && PathLos.isWalkableTile(grid[nextNode.ty * MAP_W + nextNode.tx])) {\n      stepFromWx = drawWx;\n      stepFromWy = drawWy;\n      playerTx = nextNode.tx;\n      playerTy = nextNode.ty;\n      var sdx:Number = PathLos.hexWorldX(playerTx, playerTy) - stepFromWx;\n      var sdy:Number = PathLos.hexWorldY(playerTy) - stepFromWy;\n      var sl:Number = Math.sqrt(sdx * sdx + sdy * sdy);\n      if (sl > 0.01) {\n        facingDx = sdx / sl;\n        facingDy = sdy / sl;\n      }\n      stepProgress = 0.0;\n      playSound(sfx.step, 0, 42);\n    } else {\n      walkQueue = [];\n    }\n  }\n\n  // Smooth camera tracking + blast shake\n  var shakeX:Number = 0;\n  var shakeY:Number = 0;\n  if (shakeTimer > 0) {\n    shakeTimer = shakeTimer - 1;\n    shakeX = Math.round((Math.random() - 0.5) * shakeTimer * 1.4);\n    shakeY = Math.round((Math.random() - 0.5) * shakeTimer * 1.4);\n    terrainDirty = true;\n  }\n  var targetCamX:Number = Math.round(VIEW_W * 0.46 - drawWx + camPanX) + shakeX;\n  var targetCamY:Number = Math.round(VIEW_H * 0.50 - drawWy + camPanY) + shakeY;\n  if (Math.abs(targetCamX - camX) >= 1 || Math.abs(targetCamY - camY) >= 1) {\n    camX = camX + Math.round((targetCamX - camX) * 0.28);\n    camY = camY + Math.round((targetCamY - camY) * 0.28);\n    if (Math.abs(targetCamX - camX) <= 1) { camX = targetCamX; }\n    if (Math.abs(targetCamY - camY) <= 1) { camY = targetCamY; }\n    terrainDirty = true;\n  }\n\n  if (inCombat && combatTurn == \"enemy\" && !gameOver && !escapedCavern) {\n    stepEnemyAi();\n  }\n\n  // Mouse Hex Picking & Tactical Preview\n  var mx:Number = _root._xmouse;\n  var my:Number = _root._ymouse;\n  var overRadar:Boolean = showRadar && mx >= 648 && mx <= 792 && my >= 34 && my <= 126;\n  if (modalMode == \"\" && !overRadar && my >= 0 && my < VIEW_H && mx >= 0 && mx < VIEW_W) {\n    var hHex:Object = screenToHex(mx, my);\n    var ntx:Number = hHex.tx;\n    var nty:Number = hHex.ty;\n    if (ntx != hoverTx || nty != hoverTy) {\n      hoverTx = ntx;\n      hoverTy = nty;\n      hoverPath = [];\n      hoverEnemyIdx = -1;\n      hoverContainerIdx = -1;\n      hoverBarrelIdx = -1;\n      if (ntx >= 0 && nty >= 0 && ntx < MAP_W && nty < MAP_H && fogState[nty * MAP_W + ntx] > 0) {\n        var he:Number = enemyAtHex(ntx, nty);\n        var hb:Number = barrelAtHex(ntx, nty);\n        var hc:Number = containerAtHex(ntx, nty);\n        if (grenadeMode) {\n          var gDist:Number = PathLos.hexDist(playerTx, playerTy, ntx, nty);\n          if (this.topHintText != undefined) {\n            this.topHintText.text = (gDist <= 8)\n              ? (\"THROW FRAG GRENADE AT HEX (\" + ntx + \",\" + nty + \") · 2-HEX BLAST (4 AP)\")\n              : (\"OUT OF THROW RANGE (\" + gDist + \" / 8 HEXES)\");\n          }\n        } else if (he >= 0 && fogState[nty * MAP_W + ntx] == 2) {\n          hoverEnemyIdx = he;\n          var eRef:Object = enemies[he];\n          var wRef:Object = activeWeaponDef();\n          var dRef:Number = PathLos.hexDist(playerTx, playerTy, eRef.tx, eRef.ty);\n          var skRef:Number = (activeSlot == 2) ? specStats.melee : specStats.smallGuns;\n          var covRef:Number = PathLos.calcCoverBonus(grid, MAP_W, MAP_H, playerTx, playerTy, eRef.tx, eRef.ty);\n          var hPct:Number = PathLos.calcHitChance(\n            skRef, specStats.pe, dRef, wRef.range, eRef.ac, covRef, 0, flareTurns > 0, activeSlot == 3 && unlockedShotgun\n          );\n          if (this.topHintText != undefined) {\n            var covTxt:String = (covRef > 0) ? \" [COVER]\" : \"\";\n            this.topHintText.text = eRef.name.toUpperCase() + \" (\" + eRef.hp + \"/\" + eRef.maxHp + \" HP · \" + dRef + \" HEX)\" + covTxt + \" · \" +\n              (fireMode == 1 ? \"V.A.T.S. (\" + wRef.apAimed + \" AP)\" : (hPct + \"% HIT (\" + wRef.apSingle + \" AP)\"));\n          }\n        } else if (hb >= 0 && fogState[nty * MAP_W + ntx] == 2) {\n          hoverBarrelIdx = hb;\n          if (this.topHintText != undefined) {\n            this.topHintText.text = \"VOLATILE RAD-DRUM (\" + ntx + \",\" + nty + \") · CLICK TO DETONATE (2-HEX BLAST!)\";\n          }\n        } else if (hc >= 0) {\n          hoverContainerIdx = hc;\n          var cRef:Object = containers[hc];\n          if (this.topHintText != undefined) {\n            var actVerb:String = (cRef.kind == \"terminal\") ? \"HACK [SCIENCE]\" : \"LOOT\";\n            this.topHintText.text = cRef.name.toUpperCase() + (cRef.looted ? \" [DONE]\" : (\" · CLICK OR [E] TO \" + actVerb));\n          }\n        } else if (PathLos.isWalkableTile(grid[nty * MAP_W + ntx])) {\n          rebuildBlockedMask(-1, false);\n          hoverPath = PathLos.findPath(grid, MAP_W, MAP_H, blockedMask, playerTx, playerTy, ntx, nty, false);\n          if (this.topHintText != undefined) {\n            var tCode:Number = grid[nty * MAP_W + ntx];\n            var tName:String = (tCode == 7) ? \"SUNLIT WASTELAND EXIT HEX!\"\n              : ((tCode == 10) ? \"STEEL CATWALK BRIDGE\" : ((tCode == 2) ? \"VAULT 13 AIRLOCK HEX\" : \"CAVERN HEX\"));\n            var apNote:String = (hoverPath.length > 0) ? (\" · \" + hoverPath.length + (inCombat ? \" AP\" : \" HEX\")) : \"\";\n            this.topHintText.text = tName + \" (\" + ntx + \",\" + nty + \")\" + apNote;\n          }\n        } else if (this.topHintText != undefined) {\n          var wt:Number = grid[nty * MAP_W + ntx];\n          this.topHintText.text = (wt == 5) ? \"VAULT 13 BLAST DOOR — SEALED\"\n            : ((wt == 8) ? \"TACTICAL BARRICADE (+15 AC COVER)\" : ((wt == 4) ? \"IRRADIATED SLUDGE\" : \"HEX BASALT WALL\"));\n        }\n        updateHud();\n      }\n    }\n  } else {\n    hoverTx = -1;\n    hoverTy = -1;\n    hoverPath = [];\n    hoverEnemyIdx = -1;\n    hoverContainerIdx = -1;\n    hoverBarrelIdx = -1;\n  }\n\n  renderTerrainIfDirty();\n  if (radarDirty || (tickCounter % 12 == 0)) {\n    radarDirty = false;\n    renderCornerRadar();\n  }\n  renderHoverAndEntities();\n\n  fpsFrames = fpsFrames + 1;\n  var nowMs:Number = getTimer();\n  if (nowMs - fpsLastMs >= 500) {\n    fpsValue = Math.min(60, Math.round((fpsFrames * 1000) / Math.max(1, nowMs - fpsLastMs)));\n    fpsFrames = 0;\n    fpsLastMs = nowMs;\n    if (this.fpsText != undefined) {\n      this.fpsText.text = fpsValue + \" FPS · 36x28 HEX\";\n    }\n  }\n};\n"
            }
          }
        ]
      }
    },
    {
