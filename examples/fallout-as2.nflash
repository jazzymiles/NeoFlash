            "script": {
              "language": "action_script2",
              "source": "import flash.display.BitmapData;\nimport flash.filters.GlowFilter;\nimport fallout.VaultData;\nimport fallout.PathLos;\nimport fallout.ArtGen;\n\nstop();\n\n// --- Stage & Viewport Geometry (800x520 @ 30 fps) ---\nvar STAGE_W:Number = 800;\nvar STAGE_H:Number = 520;\nvar VIEW_W:Number = 800;\nvar VIEW_H:Number = 392;\nvar MAP_W:Number = VaultData.MAP_W;\nvar MAP_H:Number = VaultData.MAP_H;\n\n// --- Load XML Catalog (Weapons, V.A.T.S. Parts, Overseer Holodisk) ---\nvar catalog:Object = VaultData.loadCatalogXml();\nvar weaponDefs:Object = catalog.weapons;\nvar vatsParts:Array = catalog.vatsParts;\n\n// --- Stage Symbol Containers (authored via --headless batch) ---\nvar worldHolder:MovieClip = this.worldViewport;\nif (worldHolder == undefined) {\n  worldHolder = this.createEmptyMovieClip(\"worldFallback\", 5);\n}\nvar terrainClip:MovieClip = worldHolder.createEmptyMovieClip(\"terrainClip\", 10);\nvar cursorClip:MovieClip = worldHolder.createEmptyMovieClip(\"cursorClip\", 20);\nvar entitiesClip:MovieClip = worldHolder.createEmptyMovieClip(\"entitiesClip\", 30);\nvar fxClip:MovieClip = worldHolder.createEmptyMovieClip(\"fxClip\", 40);\nvar radGlowClip:MovieClip = worldHolder.createEmptyMovieClip(\"radGlowClip\", 15);\nradGlowClip.filters = [new GlowFilter(0x4ADE80, 0.85, 10, 10, 2, 1, false, false)];\n\nvar weaponBayHolder:MovieClip = this.weaponBayClip;\nif (weaponBayHolder == undefined) {\n  weaponBayHolder = this.createEmptyMovieClip(\"weaponBayFallback\", 510);\n  weaponBayHolder._x = 374;\n  weaponBayHolder._y = 444;\n}\nvar weaponIconClip:MovieClip = weaponBayHolder.createEmptyMovieClip(\"iconBmpHolder\", 10);\nvar pistolBmp:BitmapData = ArtGen.makeWeaponIcon(true);\nvar knifeBmp:BitmapData = ArtGen.makeWeaponIcon(false);\n\nvar apRackHolder:MovieClip = this.apRackClip;\nif (apRackHolder == undefined) {\n  apRackHolder = this.createEmptyMovieClip(\"apRackFallback\", 520);\n  apRackHolder._x = 400;\n  apRackHolder._y = 412;\n}\nvar apCanvas:MovieClip = apRackHolder.createEmptyMovieClip(\"apLeds\", 10);\n\nvar hudButtonsDecor:MovieClip = this.createEmptyMovieClip(\"hudButtonsDecor\", 530);\n\nvar overlayHolder:MovieClip = this.modalOverlay;\nif (overlayHolder == undefined) {\n  overlayHolder = this.createEmptyMovieClip(\"modalFallback\", 900);\n}\nvar modalBgClip:MovieClip = overlayHolder.createEmptyMovieClip(\"modalBg\", 10);\noverlayHolder.createTextField(\"modalTitleTf\", 20, 160, 48, 480, 26);\noverlayHolder.createTextField(\"modalBodyTf\", 30, 164, 82, 472, 272);\nvar modalTitleTf:TextField = overlayHolder.modalTitleTf;\nvar modalBodyTf:TextField = overlayHolder.modalBodyTf;\nmodalTitleTf.selectable = false;\nmodalBodyTf.selectable = false;\nmodalBodyTf.multiline = true;\nmodalBodyTf.wordWrap = true;\nmodalBodyTf.html = true;\n\nvar titleFmt:TextFormat = new TextFormat();\ntitleFmt.font = \"Courier New\";\ntitleFmt.size = 15;\ntitleFmt.bold = true;\ntitleFmt.color = 0x4ADE80;\n\nvar bodyFmt:TextFormat = new TextFormat();\nbodyFmt.font = \"Courier New\";\nbodyFmt.size = 12;\nbodyFmt.color = 0xBBF7D0;\nmodalBodyTf.setNewTextFormat(bodyFmt);\n\nvar vatsRowFmt:TextFormat = new TextFormat();\nvatsRowFmt.font = \"Courier New\";\nvatsRowFmt.size = 12;\nvatsRowFmt.bold = true;\nvatsRowFmt.color = 0x86EFAC;\n\nvar vatsRowTfs:Array = [];\nvar vri:Number = 0;\nwhile (vri < 5) {\n  var vrName:String = \"vatsRowTf_\" + vri;\n  overlayHolder.createTextField(vrName, 40 + vri, 172, 96 + vri * 44, 238, 22);\n  var vrtf:TextField = overlayHolder[vrName];\n  vrtf.selectable = false;\n  vrtf.html = true;\n  vrtf.setNewTextFormat(vatsRowFmt);\n  vatsRowTfs.push(vrtf);\n  vri = vri + 1;\n}\n\n// Floating damage / bark TextField pool inside fxClip\nvar floatTexts:Array = [];\nvar floatPoolIdx:Number = 0;\n\n// --- Sound Bank (10 PCM WAV assets imported via --headless import) ---\nvar sfx:Object = {};\nfunction bindSfx(id:String):Sound {\n  var s:Sound = new Sound();\n  s.attachSound(id);\n  s.setVolume(75);\n  return s;\n}\nsfx.pistol = bindSfx(\"pistol10mm\");\nsfx.knife = bindSfx(\"knife\");\nsfx.ratSqueak = bindSfx(\"rat_squeak\");\nsfx.ratDeath = bindSfx(\"rat_death\");\nsfx.klaxon = bindSfx(\"klaxon\");\nsfx.pipboy = bindSfx(\"pipboy\");\nsfx.stimpak = bindSfx(\"stimpak\");\nsfx.step = bindSfx(\"step\");\nsfx.hurt = bindSfx(\"hurt\");\nsfx.escape = bindSfx(\"escape\");\n\nfunction playSound(snd:Sound, pan:Number, vol:Number):Void {\n  if (snd == undefined) { return; }\n  snd.setPan(Math.max(-100, Math.min(100, Math.round(pan))));\n  snd.setVolume(Math.max(0, Math.min(100, Math.round(vol))));\n  snd.start(0, 1);\n}\n\n// --- S.P.E.C.I.A.L. Character & Game State ---\nvar specStats:Object = {\n  st: 6, pe: 7, en: 6, ch: 5, intel: 7, ag: 8, lk: 7,\n  smallGuns: 78, melee: 65, firstAid: 55\n};\n\nvar grid:Array = [];\nvar fogState:Array = [];\nvar lightMap:Array = [];\nvar blockedMask:Array = [];\nvar enemies:Array = [];\nvar containers:Array = [];\nvar propsList:Array = [];\n\nvar playerTx:Number = 2;\nvar playerTy:Number = 3;\nvar drawPx:Number = 2.0;\nvar drawPy:Number = 3.0;\nvar facingDx:Number = 1.0;\nvar facingDy:Number = 0.3;\nvar walkQueue:Array = [];\nvar stepFromX:Number = 2;\nvar stepFromY:Number = 3;\nvar stepProgress:Number = 1.0;\nvar walkBobPhase:Number = 0.0;\nvar pendingContainerIdx:Number = -1;\n\nvar level:Number = 1;\nvar xp:Number = 0;\nvar maxHp:Number = 36;\nvar hp:Number = 36;\nvar rads:Number = 0;\nvar maxAp:Number = 9;\nvar ap:Number = 9;\nvar baseAc:Number = 8;\nvar hasLeatherArmor:Boolean = false;\nvar unlockedLeatherArmor:Boolean = false;\nvar hasHolodisk:Boolean = false;\n\nvar activeSlot:Number = 1; // 1 = 10mm Pistol, 2 = Vault Combat Knife\nvar fireMode:Number = 0;   // 0 = SINGLE, 1 = AIMED (V.A.T.S.), 2 = RELOAD\nvar magAmmo:Number = 12;\nvar reserveAmmo:Number = 12;\nvar stimpaks:Number = 1;\nvar flares:Number = 0;\nvar flareTurns:Number = 0;\n\nvar inCombat:Boolean = false;\nvar combatTurn:String = \"player\"; // \"player\" | \"enemy\"\nvar turnNumber:Number = 1;\nvar aiActorIdx:Number = 0;\nvar aiWaitFrames:Number = 0;\n\nvar modalMode:String = \"\"; // \"\" | \"vats\" | \"inv\" | \"cha\" | \"pip\" | \"end\"\nvar pipTab:Number = 0;     // 0 = Objectives/Holodisk, 1 = Cavern Automap\nvar vatsTargetIdx:Number = -1;\n\nvar shotsFired:Number = 0;\nvar shotsHit:Number = 0;\nvar killsCount:Number = 0;\nvar gameOver:Boolean = false;\nvar escapedCavern:Boolean = false;\n\nvar camX:Number = 400;\nvar camY:Number = 116;\nvar camPanX:Number = 0;\nvar camPanY:Number = 0;\nvar terrainDirty:Boolean = true;\nvar muzzleTimer:Number = 0;\nvar tracerTimer:Number = 0;\nvar tracerX0:Number = 0;\nvar tracerY0:Number = 0;\nvar tracerX1:Number = 0;\nvar tracerY1:Number = 0;\nvar tracerCol:Number = 0xFEF08A;\n\nvar hoverTx:Number = -1;\nvar hoverTy:Number = -1;\nvar hoverPath:Array = [];\nvar hoverEnemyIdx:Number = -1;\nvar hoverContainerIdx:Number = -1;\n\nvar logLines:Array = [];\nvar tickCounter:Number = 0;\nvar fpsValue:Number = 30;\nvar fpsFrames:Number = 0;\nvar fpsLastMs:Number = getTimer();\n\n// --- Coordinate Transforms ---\nfunction isoScreenX(tx:Number, ty:Number):Number {\n  return (tx - ty) * 32 + camX;\n}\nfunction isoScreenY(tx:Number, ty:Number):Number {\n  return (tx + ty) * 16 + camY;\n}\nfunction screenToTileX(sx:Number, sy:Number):Number {\n  var u:Number = (sx - camX) / 32;\n  var v:Number = (sy - camY) / 16;\n  return Math.round((u + v) * 0.5);\n}\nfunction screenToTileY(sx:Number, sy:Number):Number {\n  var u:Number = (sx - camX) / 32;\n  var v:Number = (sy - camY) / 16;\n  return Math.round((v - u) * 0.5);\n}\n\n// --- CRT Log & Floating Combat Popups ---\nfunction escHtml(raw:String):String {\n  var s:String = String(raw);\n  s = s.split(\"&\").join(\"&amp;\");\n  s = s.split(\"<\").join(\"&lt;\");\n  s = s.split(\">\").join(\"&gt;\");\n  return s;\n}\n\nfunction addLog(msg:String, hexColor:String):Void {\n  var col:String = (hexColor != undefined && hexColor != \"\") ? hexColor : \"#4ADE80\";\n  logLines.push(\"<font color='\" + col + \"'>• \" + escHtml(msg) + \"</font>\");\n  if (logLines.length > 36) {\n    logLines.shift();\n  }\n  refreshLogField();\n  trace(\"[FALLOUT-AS2] \" + msg);\n}\n\nfunction refreshLogField():Void {\n  if (this.logText == undefined) { return; }\n  this.logText.html = true;\n  this.logText.htmlText = logLines.join(\"<br>\");\n  if (this.logText.maxscroll != undefined && this.logText.maxscroll > 1) {\n    this.logText.scroll = this.logText.maxscroll;\n  }\n}\n\nfunction scrollLog(delta:Number):Void {\n  if (this.logText == undefined) { return; }\n  var nextScroll:Number = this.logText.scroll + delta;\n  if (nextScroll < 1) { nextScroll = 1; }\n  if (this.logText.maxscroll != undefined && nextScroll > this.logText.maxscroll) {\n    nextScroll = this.logText.maxscroll;\n  }\n  this.logText.scroll = nextScroll;\n}\n\nfunction spawnFloatText(tx:Number, ty:Number, label:String, colorNum:Number):Void {\n  floatPoolIdx = (floatPoolIdx + 1) % 24;\n  var name:String = \"flt_\" + floatPoolIdx;\n  var holder:MovieClip = fxClip.createEmptyMovieClip(name, 200 + floatPoolIdx);\n  holder.createTextField(\"tf\", 1, -60, -34, 120, 22);\n  var tf:TextField = holder.tf;\n  tf.selectable = false;\n  var fmt:TextFormat = new TextFormat();\n  fmt.font = \"Arial\";\n  fmt.size = 12;\n  fmt.bold = true;\n  fmt.align = \"center\";\n  fmt.color = colorNum;\n  tf.text = label;\n  tf.setTextFormat(fmt);\n  floatTexts.push({\n    mc: holder,\n    wx: tx,\n    wy: ty,\n    rise: 0,\n    ttl: 34\n  });\n}\n\n// --- Blocking & Entity Queries ---\nfunction rebuildBlockedMask(excludeEnemyIdx:Number, includePlayer:Boolean):Void {\n  var total:Number = MAP_W * MAP_H;\n  var i:Number = 0;\n  while (i < total) {\n    blockedMask[i] = false;\n    i = i + 1;\n  }\n  i = 0;\n  while (i < containers.length) {\n    var c:Object = containers[i];\n    if (c.kind == \"locker\" || c.kind == \"footlocker\") {\n      blockedMask[c.ty * MAP_W + c.tx] = true;\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < propsList.length) {\n    var p:Object = propsList[i];\n    blockedMask[p.ty * MAP_W + p.tx] = true;\n    i = i + 1;\n  }\n  i = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && i != excludeEnemyIdx) {\n      blockedMask[e.ty * MAP_W + e.tx] = true;\n    }\n    i = i + 1;\n  }\n  if (includePlayer) {\n    blockedMask[playerTy * MAP_W + playerTx] = true;\n  }\n}\n\nfunction enemyAtTile(tx:Number, ty:Number):Number {\n  var i:Number = 0;\n  while (i < enemies.length) {\n    if (enemies[i].alive && enemies[i].tx == tx && enemies[i].ty == ty) {\n      return i;\n    }\n    i = i + 1;\n  }\n  return -1;\n}\n\nfunction containerAtTile(tx:Number, ty:Number):Number {\n  var i:Number = 0;\n  while (i < containers.length) {\n    if (containers[i].tx == tx && containers[i].ty == ty) {\n      return i;\n    }\n    i = i + 1;\n  }\n  return -1;\n}\n\nfunction currentAc():Number {\n  return baseAc + (hasLeatherArmor ? 6 : 0);\n}\n\nfunction currentSightRadius():Number {\n  return (flareTurns > 0) ? 10.5 : 7.5;\n}\n\nfunction activeWeaponDef():Object {\n  return (activeSlot == 1) ? weaponDefs.pistol10mm : weaponDefs.knife;\n}\n\nfunction currentAttackAp():Number {\n  var w:Object = activeWeaponDef();\n  if (fireMode == 2) { return 2; }\n  return (fireMode == 1) ? w.apAimed : w.apSingle;\n}\n\nfunction checkXpLevelUp():Void {\n  var nextThreshold:Number = level * 250;\n  if (xp >= nextThreshold) {\n    level = level + 1;\n    maxHp = maxHp + 6;\n    hp = Math.min(maxHp, hp + 6);\n    specStats.smallGuns = Math.min(95, specStats.smallGuns + 8);\n    specStats.melee = Math.min(95, specStats.melee + 6);\n    playSound(sfx.pipboy, 0, 85);\n    addLog(\"LEVEL UP! Reached Level \" + level + \" (+6 Max HP, +8% Small Guns)!\", \"#FACC15\");\n    spawnFloatText(playerTx, playerTy, \"LEVEL \" + level + \"!\", 0xFACC15);\n  }\n}\n\n// --- HUD Static Button Chrome & Refresh ---\nfunction drawHudButtonsChrome():Void {\n  hudButtonsDecor.clear();\n  var btns:Array = [\n    { x: 274, y: 404, w: 16, h: 50, label: \"^\", fill: 0x1E2923 },\n    { x: 274, y: 458, w: 16, h: 50, label: \"v\", fill: 0x1E2923 },\n    { x: 302, y: 400, w: 60, h: 25, label: \"INV [I]\", fill: 0x3B332B },\n    { x: 302, y: 429, w: 60, h: 25, label: \"CHA [O]\", fill: 0x3B332B },\n    { x: 302, y: 458, w: 60, h: 25, label: \"PIP [P]\", fill: 0x3B332B },\n    { x: 302, y: 487, w: 60, h: 25, label: \"STIM[H]\", fill: 0x422826 },\n    { x: 370, y: 488, w: 62, h: 24, label: \"SWAP[B]\", fill: 0x333833 },\n    { x: 436, y: 488, w: 64, h: 24, label: \"MODE[M]\", fill: 0x333833 },\n    { x: 504, y: 488, w: 62, h: 24, label: \"VATS[V]\", fill: 0x263B2D },\n    { x: 694, y: 428, w: 96, h: 40, label: \"END TURN\", fill: 0x4A3520 },\n    { x: 694, y: 472, w: 96, h: 40, label: \"COMBAT\",   fill: 0x263A29 }\n  ];\n  var i:Number = 0;\n  while (i < btns.length) {\n    var b:Object = btns[i];\n    hudButtonsDecor.lineStyle(1.5, 0x6B6054, 95);\n    hudButtonsDecor.beginFill(b.fill, 100);\n    hudButtonsDecor.moveTo(b.x, b.y);\n    hudButtonsDecor.lineTo(b.x + b.w, b.y);\n    hudButtonsDecor.lineTo(b.x + b.w, b.y + b.h);\n    hudButtonsDecor.lineTo(b.x, b.y + b.h);\n    hudButtonsDecor.endFill();\n\n    var tfName:String = \"btnLbl_\" + i;\n    if (hudButtonsDecor[tfName] == undefined) {\n      hudButtonsDecor.createTextField(tfName, 50 + i, b.x, b.y + Math.floor((b.h - 16) * 0.5), b.w, 18);\n    }\n    var tf:TextField = hudButtonsDecor[tfName];\n    tf.selectable = false;\n    var fmt:TextFormat = new TextFormat();\n    fmt.font = \"Arial\";\n    fmt.size = 10;\n    fmt.bold = true;\n    fmt.align = \"center\";\n    fmt.color = 0xE7E5E4;\n    tf.text = b.label;\n    tf.setTextFormat(fmt);\n    i = i + 1;\n  }\n}\n\nfunction pad3(n:Number):String {\n  var v:Number = Math.max(0, Math.floor(n));\n  if (v < 10) { return \"00\" + v; }\n  if (v < 100) { return \"0\" + v; }\n  return String(v);\n}\n\nfunction updateHud():Void {\n  // Weapon icon bitmap in HUD slot\n  weaponIconClip.attachBitmap((activeSlot == 1) ? pistolBmp : knifeBmp, 1, \"auto\", false);\n\n  var w:Object = activeWeaponDef();\n  if (this.weaponNameText != undefined) {\n    this.weaponNameText.text = w.name.toUpperCase();\n  }\n  if (this.weaponModeText != undefined) {\n    var modeStr:String = (fireMode == 0) ? (\"SINGLE (\" + w.apSingle + \" AP)\")\n      : ((fireMode == 1) ? (\"AIMED (\" + w.apAimed + \" AP)\") : \"RELOAD (2 AP)\");\n    var ammoStr:String = (activeSlot == 1) ? (\"10mm: \" + magAmmo + \"/\" + reserveAmmo) : \"MELEE (INF)\";\n    this.weaponModeText.text = modeStr + \"\\n\" + ammoStr;\n  }\n  if (this.hpText != undefined) {\n    this.hpText.text = pad3(hp) + \" / \" + pad3(maxHp);\n  }\n  if (this.acText != undefined) {\n    this.acText.text = \"AC \" + pad3(currentAc()) + (hasLeatherArmor ? \" [LTH]\" : \"\");\n  }\n  if (this.xpText != undefined) {\n    this.xpText.text = \"LV \" + level + \" · XP \" + xp + \"\\nSTIM:\" + stimpaks + \" RAD:\" + rads;\n  }\n  if (this.stateText != undefined) {\n    if (!inCombat) {\n      this.stateText.text = \"EXPLORE\";\n    } else if (combatTurn == \"player\") {\n      this.stateText.text = \"YOUR TURN\";\n    } else {\n      this.stateText.text = \"ENEMY AI\";\n    }\n  }\n\n  // Draw 10 AP LED pips on apCanvas\n  var previewCost:Number = 0;\n  if (inCombat && combatTurn == \"player\") {\n    if (hoverEnemyIdx >= 0) {\n      previewCost = currentAttackAp();\n    } else if (hoverPath.length > 0) {\n      previewCost = hoverPath.length;\n    }\n  }\n  apCanvas.clear();\n  var p:Number = 0;\n  while (p < 10) {\n    var lx:Number = p * 15;\n    var col:Number = 0x1F2922;\n    if (!inCombat) {\n      col = (p < maxAp) ? 0x4ADE80 : 0x1F2922;\n    } else if (p < ap) {\n      if (p >= ap - previewCost) {\n        col = 0xFACC15; // Amber AP preview cost\n      } else {\n        col = 0x4ADE80; // Available green AP LED\n      }\n    }\n    apCanvas.lineStyle(1, 0x0A0F0B, 90);\n    apCanvas.beginFill(col, 100);\n    apCanvas.moveTo(lx - 4, -4);\n    apCanvas.lineTo(lx + 4, -4);\n    apCanvas.lineTo(lx + 4, 4);\n    apCanvas.lineTo(lx - 4, 4);\n    apCanvas.endFill();\n    p = p + 1;\n  }\n}\n\n// --- Combat Lifecycle ---\nfunction enterCombat(reason:String):Void {\n  if (inCombat) { return; }\n  inCombat = true;\n  combatTurn = \"player\";\n  turnNumber = 1;\n  ap = maxAp;\n  walkQueue = [];\n  pendingContainerIdx = -1;\n  playSound(sfx.klaxon, 0, 80);\n  addLog(reason, \"#FACC15\");\n  updateHud();\n}\n\nfunction tryEndCombat():Void {\n  if (!inCombat) {\n    enterCombat(\"Turn-based tactical combat engaged manually.\");\n    return;\n  }\n  if (combatTurn != \"player\") { return; }\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && e.alerted && PathLos.tileDist(playerTx, playerTy, e.tx, e.ty) <= 8.0) {\n      addLog(\"Cannot end combat — hostile \" + e.name + \" is nearby!\", \"#F87171\");\n      playSound(sfx.hurt, 0, 45);\n      return;\n    }\n    i = i + 1;\n  }\n  inCombat = false;\n  ap = maxAp;\n  playSound(sfx.pipboy, 0, 65);\n  addLog(\"Combat ended. Returning to real-time cavern exploration.\", \"#86EFAC\");\n  updateHud();\n}\n\nfunction checkAutoEndCombat():Void {\n  if (!inCombat) { return; }\n  var anyThreat:Boolean = false;\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && (e.alerted || fogState[e.ty * MAP_W + e.tx] == 2)) {\n      anyThreat = true;\n      break;\n    }\n    i = i + 1;\n  }\n  if (!anyThreat) {\n    inCombat = false;\n    ap = maxAp;\n    addLog(\"Area clear — combat ended.\", \"#86EFAC\");\n    updateHud();\n  }\n}\n\nfunction endPlayerTurn():Void {\n  if (!inCombat || combatTurn != \"player\" || gameOver || escapedCavern) { return; }\n  walkQueue = [];\n  modalMode = \"\";\n  renderModal();\n  combatTurn = \"enemy\";\n  aiActorIdx = 0;\n  aiWaitFrames = 6;\n  // Wake nearby visible enemies\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && !e.alerted) {\n      if (PathLos.tileDist(playerTx, playerTy, e.tx, e.ty) <= 7.5 &&\n          PathLos.hasLineOfSight(grid, MAP_W, MAP_H, playerTx, playerTy, e.tx, e.ty)) {\n        e.alerted = true;\n      }\n    }\n    if (e.alive) {\n      e.curAp = e.crippled ? Math.max(2, Math.floor(e.ap * 0.5)) : e.ap;\n      if (e.stunned) {\n        e.curAp = Math.max(0, e.curAp - 3);\n        e.stunned = false;\n      }\n    }\n    i = i + 1;\n  }\n  updateHud();\n}\n\n// --- Looting, Healing, Reloading & Attacks ---\nfunction lootContainer(idx:Number):Void {\n  if (idx < 0 || idx >= containers.length) { return; }\n  var c:Object = containers[idx];\n  if (PathLos.chebyshevDist(playerTx, playerTy, c.tx, c.ty) > 1) {\n    addLog(c.examine, \"#A7F3D0\");\n    return;\n  }\n  if (c.looted) {\n    addLog(c.name + \" is empty.\", \"#94A3B8\");\n    return;\n  }\n  if (inCombat && ap < 2) {\n    addLog(\"Need 2 AP to search \" + c.name + \"!\", \"#F87171\");\n    return;\n  }\n  if (inCombat) { ap = ap - 2; }\n  c.looted = true;\n  addLog(c.examine, \"#BBF7D0\");\n\n  var foundParts:Array = [];\n  if (c.ammo10mm > 0) {\n    reserveAmmo = reserveAmmo + c.ammo10mm;\n    foundParts.push(\"+\" + c.ammo10mm + \"x 10mm JHP\");\n  }\n  if (c.stimpaks > 0) {\n    stimpaks = stimpaks + c.stimpaks;\n    foundParts.push(\"+\" + c.stimpaks + \" Stimpak\");\n  }\n  if (c.flares > 0) {\n    flares = flares + c.flares;\n    foundParts.push(\"+\" + c.flares + \" Flare\");\n  }\n  if (c.armor) {\n    unlockedLeatherArmor = true;\n    hasLeatherArmor = true;\n    foundParts.push(\"Leather Jacket (AC +6, DR 20%)\");\n  }\n  if (c.holodisk) {\n    hasHolodisk = true;\n    foundParts.push(\"Overseer Holodisk\");\n  }\n  xp = xp + 25;\n  playSound(sfx.pipboy, 0, 80);\n  addLog(\"Looted \" + c.name + \": \" + foundParts.join(\", \") + \" (+25 XP).\", \"#FACC15\");\n  spawnFloatText(c.tx, c.ty, \"LOOTED!\", 0xFACC15);\n  checkXpLevelUp();\n  updateHud();\n}\n\nfunction useStimpak():Void {\n  if (gameOver || escapedCavern) { return; }\n  if (stimpaks <= 0) {\n    addLog(\"Out of Stimpaks!\", \"#F87171\");\n    playSound(sfx.hurt, 0, 45);\n    return;\n  }\n  if (hp >= maxHp) {\n    addLog(\"Already at full health (\" + hp + \"/\" + maxHp + \").\", \"#86EFAC\");\n    return;\n  }\n  if (inCombat && combatTurn == \"player\") {\n    if (ap < 2) {\n      addLog(\"Not enough Action Points for Stimpak (needs 2 AP).\", \"#F87171\");\n      return;\n    }\n    ap = ap - 2;\n  }\n  stimpaks = stimpaks - 1;\n  var heal:Number = 14 + Math.floor(specStats.firstAid * 0.1);\n  var before:Number = hp;\n  hp = Math.min(maxHp, hp + heal);\n  playSound(sfx.stimpak, 0, 85);\n  addLog(\"Injected Stimpak: healed +\" + (hp - before) + \" HP (\" + hp + \"/\" + maxHp + \").\", \"#4ADE80\");\n  spawnFloatText(playerTx, playerTy, \"+\" + (hp - before) + \" HP\", 0x4ADE80);\n  updateHud();\n}\n\nfunction reloadActiveWeapon():Void {\n  if (activeSlot != 1) {\n    addLog(\"Combat Knife does not use ammunition.\", \"#94A3B8\");\n    return;\n  }\n  var w:Object = weaponDefs.pistol10mm;\n  if (magAmmo >= w.magSize) {\n    addLog(\"10mm Pistol magazine is already full (12/12).\", \"#86EFAC\");\n    return;\n  }\n  if (reserveAmmo <= 0) {\n    addLog(\"No 10mm reserve ammunition remaining!\", \"#F87171\");\n    return;\n  }\n  if (inCombat && combatTurn == \"player\") {\n    if (ap < 2) {\n      addLog(\"Need 2 AP to reload!\", \"#F87171\");\n      return;\n    }\n    ap = ap - 2;\n  }\n  var needed:Number = w.magSize - magAmmo;\n  var take:Number = Math.min(needed, reserveAmmo);\n  magAmmo = magAmmo + take;\n  reserveAmmo = reserveAmmo - take;\n  fireMode = 0;\n  playSound(sfx.pipboy, 0, 75);\n  addLog(\"Reloaded 10mm Colt 6520 (\" + magAmmo + \"/12, reserve \" + reserveAmmo + \").\", \"#86EFAC\");\n  spawnFloatText(playerTx, playerTy, \"RELOADED\", 0x86EFAC);\n  updateHud();\n}\n\nfunction executeAttack(enemyIdx:Number, partObj:Object):Void {\n  if (enemyIdx < 0 || enemyIdx >= enemies.length) { return; }\n  var target:Object = enemies[enemyIdx];\n  if (!target.alive) { return; }\n\n  if (!inCombat) {\n    enterCombat(\"You initiate combat with \" + target.name + \"!\");\n  }\n  if (combatTurn != \"player\") { return; }\n\n  var w:Object = activeWeaponDef();\n  var isAimed:Boolean = (partObj != null);\n  var apCost:Number = isAimed ? w.apAimed : w.apSingle;\n  var dist:Number = PathLos.tileDist(playerTx, playerTy, target.tx, target.ty);\n\n  if (activeSlot == 2 && PathLos.chebyshevDist(playerTx, playerTy, target.tx, target.ty) > 1) {\n    addLog(target.name + \" is out of melee reach — move closer or swap to 10mm Pistol [B]!\", \"#F87171\");\n    return;\n  }\n  if (dist > w.range + 0.35) {\n    addLog(target.name + \" is out of range (\" + Math.round(dist) + \" > \" + w.range + \")!\", \"#F87171\");\n    return;\n  }\n  if (!PathLos.hasLineOfSight(grid, MAP_W, MAP_H, playerTx, playerTy, target.tx, target.ty)) {\n    addLog(\"Line of sight to \" + target.name + \" is blocked by cavern rock!\", \"#F87171\");\n    return;\n  }\n  if (ap < apCost) {\n    addLog(\"Not enough Action Points (\" + ap + \"/\" + apCost + \" AP)!\", \"#F87171\");\n    playSound(sfx.hurt, 0, 40);\n    return;\n  }\n  if (activeSlot == 1 && magAmmo <= 0) {\n    addLog(\"Click! 10mm Pistol is empty — press [R] or click RELOAD (2 AP)!\", \"#FACC15\");\n    fireMode = 2;\n    updateHud();\n    return;\n  }\n\n  ap = ap - apCost;\n  if (activeSlot == 1) {\n    magAmmo = magAmmo - 1;\n    muzzleTimer = 5;\n    playSound(sfx.pistol, 0, 90);\n  } else {\n    playSound(sfx.knife, 0, 85);\n  }\n\n  // Orient Vault Dweller toward target\n  var dtx:Number = target.tx - playerTx;\n  var dty:Number = target.ty - playerTy;\n  var sdx:Number = (dtx - dty);\n  var sdy:Number = (dtx + dty) * 0.5;\n  var slen:Number = Math.sqrt(sdx * sdx + sdy * sdy);\n  if (slen > 0.01) {\n    facingDx = sdx / slen;\n    facingDy = sdy / slen;\n  }\n\n  target.alerted = true;\n  shotsFired = shotsFired + 1;\n\n  var skillVal:Number = (activeSlot == 1) ? specStats.smallGuns : specStats.melee;\n  var penalty:Number = isAimed ? partObj.penalty : 0;\n  var hitPct:Number = PathLos.calcHitChance(skillVal, specStats.pe, dist, w.range, target.ac, penalty, flareTurns > 0);\n  var roll:Number = 1 + Math.floor(Math.random() * 100);\n\n  tracerTimer = 5;\n  tracerX0 = playerTx;\n  tracerY0 = playerTy;\n  tracerX1 = target.tx;\n  tracerY1 = target.ty;\n\n  if (roll > hitPct) {\n    tracerCol = 0x94A3B8;\n    addLog(\"You missed \" + target.name + \" (\" + hitPct + \"% chance).\", \"#94A3B8\");\n    spawnFloatText(target.tx, target.ty, \"MISS\", 0xCBD5E1);\n    updateHud();\n    return;\n  }\n\n  shotsHit = shotsHit + 1;\n  tracerCol = 0xFEF08A;\n\n  var rawDmg:Number = w.minDmg + Math.floor(Math.random() * (w.maxDmg - w.minDmg + 1));\n  if (activeSlot == 2) {\n    rawDmg = rawDmg + Math.max(0, specStats.st - 5);\n  }\n  var critChance:Number = specStats.lk * 2 + (isAimed ? partObj.critBonus : 0);\n  var isCrit:Boolean = (1 + Math.floor(Math.random() * 100)) <= critChance;\n  var partLabel:String = isAimed ? (\" in the \" + partObj.label) : \"\";\n\n  if (isCrit) {\n    var mult:Number = isAimed ? (partObj.dmgMult / 100.0) : 1.75;\n    rawDmg = Math.max(rawDmg + 4, Math.round(rawDmg * mult));\n    if (isAimed && partObj.effect == \"blind\") {\n      target.blinded = true;\n    } else if (isAimed && partObj.effect == \"cripple\") {\n      target.crippled = true;\n    } else if (isAimed && partObj.effect == \"stun\") {\n      target.stunned = true;\n    }\n  }\n\n  target.hp = target.hp - rawDmg;\n  if (target.hp <= 0) {\n    target.hp = 0;\n    target.alive = false;\n    killsCount = killsCount + 1;\n    xp = xp + target.xp;\n    playSound(sfx.ratDeath, 0, 85);\n    if (isCrit) {\n      addLog(\"CRITICAL! \" + target.name + \" hit\" + partLabel + \" for \" + rawDmg + \" dmg and blasted apart! (+\" + target.xp + \" XP)\", \"#FACC15\");\n      spawnFloatText(target.tx, target.ty, \"CRIT -\" + rawDmg + \"!\", 0xFACC15);\n    } else {\n      addLog(target.name + \" was hit\" + partLabel + \" for \" + rawDmg + \" dmg and killed. (+\" + target.xp + \" XP)\", \"#4ADE80\");\n      spawnFloatText(target.tx, target.ty, \"-\" + rawDmg + \" KILL\", 0x4ADE80);\n    }\n    checkXpLevelUp();\n    checkAutoEndCombat();\n  } else {\n    playSound(sfx.ratSqueak, 0, 75);\n    if (isCrit) {\n      addLog(\"Critical Hit! \" + target.name + \" hit\" + partLabel + \" for \" + rawDmg + \" dmg (\" + target.hp + \"/\" + target.maxHp + \" HP)!\", \"#FACC15\");\n      spawnFloatText(target.tx, target.ty, \"CRIT -\" + rawDmg, 0xFACC15);\n    } else {\n      addLog(\"Hit \" + target.name + partLabel + \" for \" + rawDmg + \" dmg (\" + target.hp + \"/\" + target.maxHp + \" HP).\", \"#86EFAC\");\n      spawnFloatText(target.tx, target.ty, \"-\" + rawDmg, 0xEF4444);\n    }\n  }\n  updateHud();\n}\n\n// --- SharedObject Quick-Save / Quick-Load ---\nfunction saveProgressToSol():Void {\n  var so:SharedObject = SharedObject.getLocal(\"neoflash_fallout_v13\");\n  var enemySnap:Array = [];\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    enemySnap.push({ tx: e.tx, ty: e.ty, hp: e.hp, alive: e.alive, alerted: e.alerted, crippled: e.crippled, blinded: e.blinded });\n    i = i + 1;\n  }\n  var contSnap:Array = [];\n  i = 0;\n  while (i < containers.length) {\n    contSnap.push(containers[i].looted);\n    i = i + 1;\n  }\n  so.data.saved = true;\n  so.data.playerTx = playerTx;\n  so.data.playerTy = playerTy;\n  so.data.hp = hp;\n  so.data.maxHp = maxHp;\n  so.data.xp = xp;\n  so.data.level = level;\n  so.data.rads = rads;\n  so.data.ap = ap;\n  so.data.magAmmo = magAmmo;\n  so.data.reserveAmmo = reserveAmmo;\n  so.data.stimpaks = stimpaks;\n  so.data.flares = flares;\n  so.data.hasLeatherArmor = hasLeatherArmor;\n  so.data.unlockedLeatherArmor = unlockedLeatherArmor;\n  so.data.hasHolodisk = hasHolodisk;\n  so.data.inCombat = inCombat;\n  so.data.killsCount = killsCount;\n  so.data.enemies = enemySnap;\n  so.data.containers = contSnap;\n  so.flush();\n  playSound(sfx.pipboy, 0, 80);\n  addLog(\"Pip-Boy 2000: Cavern state saved to SharedObject.\", \"#FACC15\");\n}\n\nfunction loadProgressFromSol():Boolean {\n  var so:SharedObject = SharedObject.getLocal(\"neoflash_fallout_v13\");\n  if (so.data == undefined || so.data.saved != true) {\n    addLog(\"Pip-Boy 2000: No saved state found in SharedObject.\", \"#F87171\");\n    return false;\n  }\n  playerTx = so.data.playerTx;\n  playerTy = so.data.playerTy;\n  drawPx = playerTx;\n  drawPy = playerTy;\n  hp = so.data.hp;\n  maxHp = so.data.maxHp;\n  xp = so.data.xp;\n  level = so.data.level;\n  rads = so.data.rads;\n  ap = so.data.ap;\n  magAmmo = so.data.magAmmo;\n  reserveAmmo = so.data.reserveAmmo;\n  stimpaks = so.data.stimpaks;\n  flares = so.data.flares;\n  hasLeatherArmor = so.data.hasLeatherArmor;\n  unlockedLeatherArmor = so.data.unlockedLeatherArmor;\n  hasHolodisk = so.data.hasHolodisk;\n  inCombat = so.data.inCombat;\n  combatTurn = \"player\";\n  killsCount = so.data.killsCount;\n  walkQueue = [];\n  gameOver = false;\n  escapedCavern = false;\n\n  var es:Array = so.data.enemies;\n  var i:Number = 0;\n  while (es != undefined && i < enemies.length && i < es.length) {\n    enemies[i].tx = es[i].tx;\n    enemies[i].ty = es[i].ty;\n    enemies[i].hp = es[i].hp;\n    enemies[i].alive = es[i].alive;\n    enemies[i].alerted = es[i].alerted;\n    enemies[i].crippled = es[i].crippled;\n    enemies[i].blinded = es[i].blinded;\n    i = i + 1;\n  }\n  var cs:Array = so.data.containers;\n  i = 0;\n  while (cs != undefined && i < containers.length && i < cs.length) {\n    containers[i].looted = cs[i];\n    i = i + 1;\n  }\n  PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n  terrainDirty = true;\n  modalMode = \"\";\n  renderModal();\n  updateHud();\n  playSound(sfx.pipboy, 0, 85);\n  addLog(\"Pip-Boy 2000: Loaded saved cavern checkpoint (\" + playerTx + \",\" + playerTy + \").\", \"#4ADE80\");\n  return true;\n}\n\n// --- Modal Overlays (V.A.T.S., Inventory, S.P.E.C.I.A.L., Pip-Boy 2000, Victory/Death) ---\nfunction renderModal():Void {\n  modalBgClip.clear();\n  var rClr:Number = 0;\n  while (rClr < vatsRowTfs.length) {\n    vatsRowTfs[rClr].htmlText = \"\";\n    rClr = rClr + 1;\n  }\n  if (modalMode == \"\") {\n    modalTitleTf.text = \"\";\n    modalBodyTf.htmlText = \"\";\n    return;\n  }\n\n  // Translucent dark CRT shroud & Fallout green phosphor frame\n  modalBgClip.lineStyle(undefined);\n  modalBgClip.beginFill(0x050806, 82);\n  modalBgClip.moveTo(0, 0);\n  modalBgClip.lineTo(VIEW_W, 0);\n  modalBgClip.lineTo(VIEW_W, VIEW_H);\n  modalBgClip.lineTo(0, VIEW_H);\n  modalBgClip.endFill();\n\n  modalBgClip.lineStyle(2, 0x4ADE80, 95);\n  modalBgClip.beginFill(0x0B160E, 96);\n  modalBgClip.moveTo(144, 34);\n  modalBgClip.lineTo(656, 34);\n  modalBgClip.lineTo(656, 366);\n  modalBgClip.lineTo(144, 366);\n  modalBgClip.endFill();\n\n  if (modalMode == \"vats\" && vatsTargetIdx >= 0 && vatsTargetIdx < enemies.length) {\n    var tgt:Object = enemies[vatsTargetIdx];\n    var w:Object = activeWeaponDef();\n    var dist:Number = PathLos.tileDist(playerTx, playerTy, tgt.tx, tgt.ty);\n    var skillVal:Number = (activeSlot == 1) ? specStats.smallGuns : specStats.melee;\n\n    modalTitleTf.text = \"V.A.T.S. TARGETING — \" + tgt.name.toUpperCase() + \" (\" + tgt.hp + \"/\" + tgt.maxHp + \" HP)\";\n    modalTitleTf.setTextFormat(titleFmt);\n\n    // Draw green wireframe rodent silhouette on right side of V.A.T.S. screen!\n    var wx:Number = 520;\n    var wy:Number = 200;\n    modalBgClip.lineStyle(1.5, 0x22C55E, 90);\n    modalBgClip.beginFill(0x14532D, 35);\n    modalBgClip.moveTo(wx - 58, wy + 18);\n    modalBgClip.lineTo(wx - 28, wy - 36);\n    modalBgClip.lineTo(wx + 24, wy - 32);\n    modalBgClip.lineTo(wx + 66, wy - 8);\n    modalBgClip.lineTo(wx + 40, wy + 26);\n    modalBgClip.lineTo(wx - 44, wy + 26);\n    modalBgClip.endFill();\n    // Wireframe eye & head crosshairs\n    modalBgClip.lineStyle(1, 0x86EFAC, 80);\n    modalBgClip.moveTo(wx + 42, wy - 20);\n    modalBgClip.lineTo(wx + 54, wy - 20);\n    modalBgClip.moveTo(wx + 48, wy - 26);\n    modalBgClip.lineTo(wx + 48, wy - 14);\n    // Scanlines\n    var sy:Number = 90;\n    modalBgClip.lineStyle(1, 0x14532D, 45);\n    while (sy < 340) {\n      modalBgClip.moveTo(430, sy);\n      modalBgClip.lineTo(634, sy);\n      sy = sy + 8;\n    }\n\n    // Draw clickable V.A.T.S. hit-zone buttons on left (x = 162..416, y = 88 + i * 44)\n    var i:Number = 0;\n    while (i < vatsParts.length) {\n      var pt:Object = vatsParts[i];\n      var pct:Number = PathLos.calcHitChance(skillVal, specStats.pe, dist, w.range, tgt.ac, pt.penalty, flareTurns > 0);\n      var by:Number = 88 + i * 44;\n      modalBgClip.lineStyle(1.5, 0x4ADE80, 90);\n      modalBgClip.beginFill(0x132A1B, 90);\n      modalBgClip.moveTo(162, by);\n      modalBgClip.lineTo(416, by);\n      modalBgClip.lineTo(416, by + 36);\n      modalBgClip.lineTo(162, by + 36);\n      modalBgClip.endFill();\n      if (i < vatsRowTfs.length) {\n        vatsRowTfs[i].htmlText =\n          \"<font face='Courier New' size='12' color='#86EFAC'><b>[\" + (i + 1) + \"] \" + pt.label + \"</b> · </font>\" +\n          \"<font face='Courier New' size='12' color='#FACC15'><b>\" + pct + \"%</b></font>\" +\n          \"<font face='Courier New' size='11' color='#4ADE80'> (+\" + pt.critBonus + \"%CRIT)</font>\";\n      }\n      i = i + 1;\n    }\n    modalBodyTf.htmlText =\n      \"<br><br><br><br><br><br><br><br><br><br><br><br><br><br>\" +\n      \"<font face='Courier New' size='12' color='#86EFAC'>Cost: <b>\" + w.apAimed + \" AP</b> · Click body zone or press <b>[1-5]</b> · <b>[ESC]</b> Cancel</font>\";\n    return;\n  }\n\n  if (modalMode == \"inv\") {\n    modalTitleTf.text = \"VAULT-TEC INVENTORY & EQUIPMENT\";\n    modalTitleTf.setTextFormat(titleFmt);\n    var armorStatus:String = unlockedLeatherArmor\n      ? (hasLeatherArmor ? \"<font color='#4ADE80'>EQUIPPED (+6 AC, 20% DR)</font>\" : \"<font color='#FACC15'>IN PACK (Press [3] to wear)</font>\")\n      : \"Not found yet (Search cavern alcoves)\";\n    modalBodyTf.htmlText =\n      \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n      \"<font color='#FACC15'><b>ACTIVE GEAR &amp; SUPPLIES:</b></font><br><br>\" +\n      \"<b>[1] 10mm Colt 6520 Pistol</b> — Dmg 5-12, Rng 9 \" + (activeSlot == 1 ? \"<font color='#4ADE80'>[ACTIVE]</font>\" : \"\") + \"<br>\" +\n      \"<b>[2] Vault Combat Knife</b> — Dmg 3-8+ST, Melee \" + (activeSlot == 2 ? \"<font color='#4ADE80'>[ACTIVE]</font>\" : \"\") + \"<br>\" +\n      \"<b>[3] Wasteland Leather Jacket</b> — \" + armorStatus + \"<br>\" +\n      \"<b>[4] Use Stimpak (\" + stimpaks + \" left)</b> — Restores +\" + (14 + Math.floor(specStats.firstAid * 0.1)) + \" HP<br>\" +\n      \"<b>[5] Ignite Cavern Flare (\" + flares + \" left)</b> — +3 Sight &amp; +8% Aim (\" + flareTurns + \" turns)<br><br>\" +\n      \"10mm JHP Magazine: <font color='#FACC15'><b>\" + magAmmo + \"/12</b></font> · Reserve Rounds: <font color='#FACC15'><b>\" + reserveAmmo + \"</b></font><br>\" +\n      \"Holodisks: <b>\" + (hasHolodisk ? \"Vault 13 Overseer Directive\" : \"None\") + \"</b><br><br>\" +\n      \"<font color='#86EFAC'>Press [1-5] or click row to use · [I] or [ESC] Return to Cavern</font>\" +\n      \"</font>\";\n    return;\n  }\n\n  if (modalMode == \"cha\") {\n    modalTitleTf.text = \"VAULT DWELLER — S.P.E.C.I.A.L. RECORD (LEVEL \" + level + \")\";\n    modalTitleTf.setTextFormat(titleFmt);\n    var accPct:Number = (shotsFired > 0) ? Math.round((shotsHit * 100) / shotsFired) : 100;\n    modalBodyTf.htmlText =\n      \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n      \"<font color='#FACC15'><b>PRIMARY STATISTICS:</b></font><br>\" +\n      \"STRENGTH: <b>0\" + specStats.st + \"</b> · PERCEPTION: <b>0\" + specStats.pe + \"</b> · ENDURANCE: <b>0\" + specStats.en + \"</b><br>\" +\n      \"CHARISMA: <b>0\" + specStats.ch + \"</b> · INTELLIGENCE: <b>0\" + specStats.intel + \"</b> · AGILITY: <b>0\" + specStats.ag + \"</b> · LUCK: <b>0\" + specStats.lk + \"</b><br><br>\" +\n      \"<font color='#FACC15'><b>TAGGED SKILLS:</b></font><br>\" +\n      \"• Small Guns: <b>\" + specStats.smallGuns + \"%</b><br>\" +\n      \"• Melee Weapons: <b>\" + specStats.melee + \"%</b><br>\" +\n      \"• First Aid: <b>\" + specStats.firstAid + \"%</b><br><br>\" +\n      \"<font color='#FACC15'><b>COMBAT RECORD:</b></font><br>\" +\n      \"HP: <b>\" + hp + \"/\" + maxHp + \"</b> · Armor Class: <b>\" + currentAc() + \"</b> · Action Points: <b>\" + maxAp + \"</b><br>\" +\n      \"XP: <b>\" + xp + \" / \" + (level * 250) + \"</b> · Hostiles Killed: <b>\" + killsCount + \"/\" + enemies.length + \"</b> · Accuracy: <b>\" + accPct + \"%</b><br><br>\" +\n      \"<font color='#86EFAC'>Press [O] or [ESC] or click anywhere to close</font>\" +\n      \"</font>\";\n    return;\n  }\n\n  if (modalMode == \"pip\") {\n    modalTitleTf.text = \"PIP-BOY 2000 · \" + (pipTab == 0 ? \"STATUS & HOLODISKS\" : \"CAVERN AUTOMAP SCANNER\");\n    modalTitleTf.setTextFormat(titleFmt);\n    if (pipTab == 0) {\n      var edDone:String = containers[0].looted ? \"<font color='#4ADE80'>[DONE]</font>\" : \"<font color='#FACC15'>[ACTIVE]</font>\";\n      var ratsDone:String = (killsCount >= enemies.length) ? \"<font color='#4ADE80'>[ALL CLEARED]</font>\" : (\"(\" + killsCount + \"/\" + enemies.length + \" neutralized)\");\n      var holoTxt:String = hasHolodisk ? (\"<br><font color='#FACC15'><b>\" + escHtml(catalog.holoTitle) + \":</b></font><br>\" + escHtml(catalog.holoBody)) : \"<br><i>Search Airlock Wall Locker (2,1) for Overseer Holodisk.</i>\";\n      modalBodyTf.htmlText =\n        \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n        \"<font color='#FACC15'><b>OBJECTIVES — VAULT 13 CAVERNS:</b></font><br>\" +\n        \"1. Inspect Ed's Remains near Airlock (4,3) \" + edDone + \"<br>\" +\n        \"2. Clear Cave Rats &amp; Brood Alpha guarding East Tunnel \" + ratsDone + \"<br>\" +\n        \"3. Reach the Sunlit Wasteland Exit Grid at (17,15)<br>\" +\n        holoTxt + \"<br><br>\" +\n        \"<font color='#86EFAC'><b>[1]</b> Status · <b>[2]</b> Automap · <b>[5/F5]</b> Quick Save · <b>[9/F9]</b> Quick Load · <b>[P/ESC]</b> Close</font>\" +\n        \"</font>\";\n    } else {\n      modalBodyTf.htmlText =\n        \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n        \"Green = Vault Dweller · Red = Hostiles · Cyan = Supplies · Gold = Exit<br>\" +\n        \"<font color='#86EFAC'><b>[1]</b> Status · <b>[2]</b> Automap · <b>[5/F5]</b> Quick Save · <b>[9/F9]</b> Quick Load · <b>[P/ESC]</b> Close</font>\" +\n        \"</font>\";\n      // Draw crisp 20x20 grid scanner inside modalBgClip\n      var ox:Number = 290;\n      var oy:Number = 128;\n      var cell:Number = 11;\n      var my:Number = 0;\n      while (my < MAP_H) {\n        var mx:Number = 0;\n        while (mx < MAP_W) {\n          var idx:Number = my * MAP_W + mx;\n          var fs:Number = fogState[idx];\n          if (fs > 0) {\n            var t:Number = grid[idx];\n            var cCol:Number = 0x14331D;\n            if (t == 0 || t == 3) { cCol = 0x09140C; }\n            else if (t == 5) { cCol = 0x3B82F6; }\n            else if (t == 4) { cCol = 0x84CC16; }\n            else if (t == 7) { cCol = 0xFACC15; }\n            else if (fs == 2) { cCol = 0x22543D; }\n            modalBgClip.lineStyle(undefined);\n            modalBgClip.beginFill(cCol, 100);\n            modalBgClip.moveTo(ox + mx * cell, oy + my * cell);\n            modalBgClip.lineTo(ox + mx * cell + cell - 1, oy + my * cell);\n            modalBgClip.lineTo(ox + mx * cell + cell - 1, oy + my * cell + cell - 1);\n            modalBgClip.lineTo(ox + mx * cell, oy + my * cell + cell - 1);\n            modalBgClip.endFill();\n          }\n          mx = mx + 1;\n        }\n        my = my + 1;\n      }\n      // Unlooted containers in cyan\n      var ci:Number = 0;\n      while (ci < containers.length) {\n        var co:Object = containers[ci];\n        if (!co.looted && fogState[co.ty * MAP_W + co.tx] > 0) {\n          modalBgClip.beginFill(0x38BDF8, 100);\n          modalBgClip.moveTo(ox + co.tx * cell + 2, oy + co.ty * cell + 2);\n          modalBgClip.lineTo(ox + co.tx * cell + cell - 2, oy + co.ty * cell + 2);\n          modalBgClip.lineTo(ox + co.tx * cell + cell - 2, oy + co.ty * cell + cell - 2);\n          modalBgClip.lineTo(ox + co.tx * cell + 2, oy + co.ty * cell + cell - 2);\n          modalBgClip.endFill();\n        }\n        ci = ci + 1;\n      }\n      // Visible living enemies in bright red\n      var ei:Number = 0;\n      while (ei < enemies.length) {\n        var en:Object = enemies[ei];\n        if (en.alive && fogState[en.ty * MAP_W + en.tx] == 2) {\n          modalBgClip.beginFill(0xEF4444, 100);\n          modalBgClip.moveTo(ox + en.tx * cell + 2, oy + en.ty * cell + 2);\n          modalBgClip.lineTo(ox + en.tx * cell + cell - 2, oy + en.ty * cell + 2);\n          modalBgClip.lineTo(ox + en.tx * cell + cell - 2, oy + en.ty * cell + cell - 2);\n          modalBgClip.lineTo(ox + en.tx * cell + 2, oy + en.ty * cell + cell - 2);\n          modalBgClip.endFill();\n        }\n        ei = ei + 1;\n      }\n      // Player pip in bright phosphor green\n      modalBgClip.beginFill(0x4ADE80, 100);\n      modalBgClip.moveTo(ox + playerTx * cell + 1, oy + playerTy * cell + 1);\n      modalBgClip.lineTo(ox + playerTx * cell + cell - 1, oy + playerTy * cell + 1);\n      modalBgClip.lineTo(ox + playerTx * cell + cell - 1, oy + playerTy * cell + cell - 1);\n      modalBgClip.lineTo(ox + playerTx * cell + 1, oy + playerTy * cell + cell - 1);\n      modalBgClip.endFill();\n    }\n    return;\n  }\n\n  if (modalMode == \"end\") {\n    var accEnd:Number = (shotsFired > 0) ? Math.round((shotsHit * 100) / shotsFired) : 100;\n    if (escapedCavern) {\n      modalTitleTf.text = \"VAULT 13 CAVERNS CLEARED — THE WASTELAND AWAITS\";\n      modalTitleTf.setTextFormat(titleFmt);\n      modalBodyTf.htmlText =\n        \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n        \"<font color='#FACC15'><b>YOU STEP OUT INTO THE BLINDING CALIFORNIA DESERT SUN...</b></font><br><br>\" +\n        \"Behind you, the limestone mouth of Mount Whitney seals Vault 13 in darkness. \" +\n        \"Ahead lies Shady Sands, Vault 15, and the search for the Water Chip.<br><br>\" +\n        \"• Final Level: <b>\" + level + \" (\" + xp + \" XP)</b><br>\" +\n        \"• Remaining Health: <b>\" + hp + \"/\" + maxHp + \" HP</b> (Radiation: \" + rads + \" RAD)<br>\" +\n        \"• Cavern Vermin Eliminated: <b>\" + killsCount + \" / \" + enemies.length + \"</b><br>\" +\n        \"• Weapons Accuracy: <b>\" + accPctSafe(shotsHit, shotsFired) + \"%</b> · Spare 10mm Rounds: <b>\" + (magAmmo + reserveAmmo) + \"</b><br><br>\" +\n        \"<font color='#4ADE80'><b>Press [R] or click here to start a new Vault 13 expedition!</b></font>\" +\n        \"</font>\";\n    } else {\n      modalTitleTf.text = \"YOUR BONES JOIN ED'S IN THE DARK...\";\n      modalTitleTf.setTextFormat(titleFmt);\n      modalBodyTf.htmlText =\n        \"<font face='Courier New' size='12' color='#BBF7D0'>\" +\n        \"<font color='#EF4444'><b>YOU HAVE DIED.</b></font><br><br>\" +\n        \"Without the Water Chip, Vault 13's reserves run dry. The cavern rats feast in the silence.<br><br>\" +\n        \"• XP Earned: <b>\" + xp + \"</b> · Kills: <b>\" + killsCount + \" / \" + enemies.length + \"</b><br><br>\" +\n        \"<font color='#FACC15'><b>Press [R] to restart from Airlock 13, or [F9] to load Pip-Boy Save.</b></font>\" +\n        \"</font>\";\n    }\n  }\n}\n\nfunction accPctSafe(h:Number, f:Number):Number {\n  if (f <= 0) { return 100; }\n  return Math.round((h * 100) / f);\n}\n\n// --- Level Initialization & Reset ---\nfunction resetGame():Void {\n  grid = VaultData.createGrid();\n  var total:Number = MAP_W * MAP_H;\n  fogState = [];\n  lightMap = [];\n  var i:Number = 0;\n  while (i < total) {\n    fogState[i] = 0;\n    lightMap[i] = 0.0;\n    i = i + 1;\n  }\n\n  var rawEnemies:Array = VaultData.createEnemies();\n  enemies = [];\n  i = 0;\n  while (i < rawEnemies.length) {\n    var re:Object = rawEnemies[i];\n    enemies.push({\n      id: re.id,\n      kind: re.kind,\n      name: re.name,\n      tx: re.tx,\n      ty: re.ty,\n      hp: re.hp,\n      maxHp: re.maxHp,\n      ap: re.ap,\n      curAp: re.ap,\n      ac: re.ac,\n      minDmg: re.minDmg,\n      maxDmg: re.maxDmg,\n      xp: re.xp,\n      alive: true,\n      alerted: false,\n      crippled: false,\n      blinded: false,\n      stunned: false\n    });\n    i = i + 1;\n  }\n\n  containers = VaultData.createContainers();\n  propsList = VaultData.createProps();\n\n  playerTx = 2;\n  playerTy = 3;\n  drawPx = 2.0;\n  drawPy = 3.0;\n  facingDx = 1.0;\n  facingDy = 0.25;\n  walkQueue = [];\n  stepProgress = 1.0;\n  pendingContainerIdx = -1;\n\n  level = 1;\n  xp = 0;\n  maxHp = 36;\n  hp = 36;\n  rads = 0;\n  maxAp = 9;\n  ap = 9;\n  hasLeatherArmor = false;\n  unlockedLeatherArmor = false;\n  hasHolodisk = false;\n\n  activeSlot = 1;\n  fireMode = 0;\n  magAmmo = 12;\n  reserveAmmo = 12;\n  stimpaks = 1;\n  flares = 0;\n  flareTurns = 0;\n\n  inCombat = false;\n  combatTurn = \"player\";\n  turnNumber = 1;\n  shotsFired = 0;\n  shotsHit = 0;\n  killsCount = 0;\n  gameOver = false;\n  escapedCavern = false;\n  modalMode = \"\";\n  camPanX = 0;\n  camPanY = 0;\n\n  logLines = [];\n  PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n  camX = Math.round(VIEW_W * 0.5 - (playerTx - playerTy) * 32);\n  camY = Math.round(VIEW_H * 0.48 - (playerTx + playerTy) * 16);\n  terrainDirty = true;\n\n  addLog(\"Airlock 13 seals behind you. Cold cavern air fills your lungs.\", \"#86EFAC\");\n  addLog(\"You see Ed's skeletal remains at (4,3). Click to loot supplies.\", \"#FACC15\");\n  renderModal();\n  updateHud();\n}\n\n// --- Rendering Pipeline (Cached Terrain + Dynamic Isometric Y-Sorted Entities) ---\nfunction renderTerrainIfDirty():Void {\n  if (!terrainDirty) { return; }\n  terrainDirty = false;\n  terrainClip.clear();\n  radGlowClip.clear();\n\n  // Isometric back-to-front painter's order (y + x ascending)\n  var sum:Number = 0;\n  var maxSum:Number = (MAP_W - 1) + (MAP_H - 1);\n  while (sum <= maxSum) {\n    var tx:Number = 0;\n    while (tx < MAP_W) {\n      var ty:Number = sum - tx;\n      if (ty >= 0 && ty < MAP_H) {\n        var idx:Number = ty * MAP_W + tx;\n        var fs:Number = fogState[idx];\n        if (fs > 0) {\n          var sx:Number = isoScreenX(tx, ty);\n          var sy:Number = isoScreenY(tx, ty);\n          if (sx >= -80 && sx <= VIEW_W + 80 && sy >= -60 && sy <= VIEW_H + 70) {\n            var tile:Number = grid[idx];\n            var light:Number = (fs == 2) ? lightMap[idx] : 0.24;\n\n            if (tile == 0 || tile == 5 || tile == 3) {\n              // Only draw solid rock blocks that border at least one non-wall explored tile\n              var nearFloor:Boolean = (tile != 0);\n              if (!nearFloor) {\n                if ((tx > 0 && grid[idx - 1] != 0) ||\n                    (tx + 1 < MAP_W && grid[idx + 1] != 0) ||\n                    (ty > 0 && grid[idx - MAP_W] != 0) ||\n                    (ty + 1 < MAP_H && grid[idx + MAP_W] != 0)) {\n                  nearFloor = true;\n                }\n              }\n              if (nearFloor) {\n                ArtGen.drawWallColumn(terrainClip, sx, sy, tile, light, tx, ty);\n              }\n            } else if (tile == 4) {\n              // Radioactive green goo pool!\n              ArtGen.drawDiamond(terrainClip, sx, sy, ArtGen.shadeColor(0x166534, light + 0.25), 100, 0x14532D, 90, 1);\n              ArtGen.drawDiamond(radGlowClip, sx, sy, 0x4ADE80, (fs == 2) ? 55 : 22, 0x86EFAC, 60, 1);\n            } else if (tile == 7) {\n              // Sunlit Wasteland Exit Grid!\n              ArtGen.drawDiamond(terrainClip, sx, sy, ArtGen.shadeColor(0xD97706, Math.max(0.65, light)), 100, 0xFACC15, 95, 1.5);\n              // Golden sunbeam shaft\n              if (fs == 2) {\n                terrainClip.lineStyle(undefined);\n                terrainClip.beginFill(0xFEF08A, 18);\n                terrainClip.moveTo(sx - 24, sy - 90);\n                terrainClip.lineTo(sx + 24, sy - 90);\n                terrainClip.lineTo(sx + 30, sy);\n                terrainClip.lineTo(sx - 30, sy);\n                terrainClip.endFill();\n              }\n            } else {\n              // Walkable floor: 2 = Vault steel grating, 6 = bone/gravel, 1 = damp cavern stone\n              var grit:Number = (ArtGen.hash2d(tx, ty, 31) - 0.5) * 0.12;\n              var baseHex:Number = (tile == 2) ? 0x475569 : ((tile == 6) ? 0x615242 : 0x524538);\n              var floorCol:Number = ArtGen.shadeColor(baseHex, Math.max(0.16, light + grit));\n              var edgeCol:Number = ArtGen.shadeColor(0x26201A, Math.max(0.15, light));\n              ArtGen.drawDiamond(terrainClip, sx, sy, floorCol, 100, edgeCol, 65, 1);\n\n              if (tile == 2) {\n                // Vault-Tec yellow hazard stripe along airlock threshold\n                if (tx == 5) {\n                  terrainClip.lineStyle(2, ArtGen.shadeColor(0xEAB308, light), 85);\n                  terrainClip.moveTo(sx + 10, sy - 8);\n                  terrainClip.lineTo(sx - 10, sy + 8);\n                }\n              }\n            }\n          }\n        }\n      }\n      tx = tx + 1;\n    }\n    sum = sum + 1;\n  }\n}\n\nfunction renderHoverAndEntities():Void {\n  cursorClip.clear();\n  entitiesClip.clear();\n\n  // 1. Hover path & tactical tile cursor\n  if (modalMode == \"\" && !gameOver && !escapedCavern && hoverTx >= 0 && hoverTy >= 0) {\n    if (hoverPath.length > 0 && (!inCombat || combatTurn == \"player\")) {\n      var pi:Number = 0;\n      while (pi < hoverPath.length) {\n        var stepNode:Object = hoverPath[pi];\n        var psx:Number = isoScreenX(stepNode.tx, stepNode.ty);\n        var psy:Number = isoScreenY(stepNode.tx, stepNode.ty);\n        var affordable:Boolean = (!inCombat) || ((pi + 1) <= ap);\n        var stepCol:Number = affordable ? 0x4ADE80 : 0xEF4444;\n        cursorClip.lineStyle(1, stepCol, 85);\n        cursorClip.beginFill(stepCol, (pi == hoverPath.length - 1) ? 34 : 18);\n        cursorClip.moveTo(psx, psy - 6);\n        cursorClip.lineTo(psx + 12, psy);\n        cursorClip.lineTo(psx, psy + 6);\n        cursorClip.lineTo(psx - 12, psy);\n        cursorClip.endFill();\n        pi = pi + 1;\n      }\n    } else if (hoverTx < MAP_W && hoverTy < MAP_H && fogState[hoverTy * MAP_W + hoverTx] > 0) {\n      var hsx:Number = isoScreenX(hoverTx, hoverTy);\n      var hsy:Number = isoScreenY(hoverTx, hoverTy);\n      var hCol:Number = (hoverEnemyIdx >= 0) ? 0xEF4444 : ((hoverContainerIdx >= 0) ? 0xFACC15 : 0x86EFAC);\n      ArtGen.drawDiamond(cursorClip, hsx, hsy, hCol, 14, hCol, 85, 1.5);\n    }\n  }\n\n  // 2. Collect visible entities & sort back-to-front by isometric depth (tx + ty)\n  var drawList:Array = [];\n  var i:Number = 0;\n  while (i < containers.length) {\n    var co:Object = containers[i];\n    if (fogState[co.ty * MAP_W + co.tx] > 0) {\n      drawList.push({ kind: \"container\", idx: i, sortKey: (co.tx + co.ty) * 100 + co.tx - 20 });\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < propsList.length) {\n    var pr:Object = propsList[i];\n    if (fogState[pr.ty * MAP_W + pr.tx] > 0) {\n      drawList.push({ kind: \"prop\", idx: i, sortKey: (pr.tx + pr.ty) * 100 + pr.tx });\n    }\n    i = i + 1;\n  }\n  i = 0;\n  while (i < enemies.length) {\n    var en:Object = enemies[i];\n    var eFog:Number = fogState[en.ty * MAP_W + en.tx];\n    if ((!en.alive && eFog > 0) || (en.alive && eFog == 2)) {\n      drawList.push({\n        kind: \"enemy\",\n        idx: i,\n        sortKey: (en.tx + en.ty) * 100 + en.tx + (en.alive ? 10 : -35)\n      });\n    }\n    i = i + 1;\n  }\n  drawList.push({ kind: \"player\", idx: 0, sortKey: (drawPx + drawPy) * 100 + drawPx + 12 });\n\n  // Insertion sort (small list <= 20 items, fast & deterministic in AS2)\n  var a:Number = 1;\n  while (a < drawList.length) {\n    var curItem:Object = drawList[a];\n    var b:Number = a - 1;\n    while (b >= 0 && drawList[b].sortKey > curItem.sortKey) {\n      drawList[b + 1] = drawList[b];\n      b = b - 1;\n    }\n    drawList[b + 1] = curItem;\n    a = a + 1;\n  }\n\n  // Render sorted entities\n  i = 0;\n  while (i < drawList.length) {\n    var item:Object = drawList[i];\n    if (item.kind == \"container\") {\n      var cObj:Object = containers[item.idx];\n      ArtGen.drawContainerOrProp(\n        entitiesClip,\n        isoScreenX(cObj.tx, cObj.ty),\n        isoScreenY(cObj.tx, cObj.ty),\n        cObj.kind,\n        cObj.looted,\n        hoverContainerIdx == item.idx\n      );\n    } else if (item.kind == \"prop\") {\n      var pObj:Object = propsList[item.idx];\n      ArtGen.drawContainerOrProp(\n        entitiesClip,\n        isoScreenX(pObj.tx, pObj.ty),\n        isoScreenY(pObj.tx, pObj.ty),\n        pObj.kind,\n        false,\n        false\n      );\n    } else if (item.kind == \"enemy\") {\n      var eObj:Object = enemies[item.idx];\n      ArtGen.drawRat(\n        entitiesClip,\n        isoScreenX(eObj.tx, eObj.ty),\n        isoScreenY(eObj.tx, eObj.ty),\n        eObj.kind,\n        eObj.alive,\n        eObj.hp / eObj.maxHp,\n        tickCounter,\n        hoverEnemyIdx == item.idx\n      );\n    } else if (item.kind == \"player\") {\n      if (!gameOver) {\n        ArtGen.drawVaultDweller(\n          entitiesClip,\n          isoScreenX(drawPx, drawPy),\n          isoScreenY(drawPx, drawPy),\n          facingDx,\n          facingDy,\n          walkBobPhase,\n          hasLeatherArmor,\n          activeSlot == 1,\n          muzzleTimer > 0\n        );\n      } else {\n        ArtGen.drawContainerOrProp(\n          entitiesClip,\n          isoScreenX(playerTx, playerTy),\n          isoScreenY(playerTx, playerTy),\n          \"corpse\",\n          true,\n          false\n        );\n      }\n    }\n    i = i + 1;\n  }\n\n  // 3. Projectile tracer & floating text updates\n  fxClip.clear();\n  if (tracerTimer > 0) {\n    tracerTimer = tracerTimer - 1;\n    fxClip.lineStyle(2.2, tracerCol, 90);\n    fxClip.moveTo(isoScreenX(tracerX0, tracerY0), isoScreenY(tracerX0, tracerY0) - 22);\n    fxClip.lineTo(isoScreenX(tracerX1, tracerY1), isoScreenY(tracerX1, tracerY1) - 8);\n  }\n  if (muzzleTimer > 0) { muzzleTimer = muzzleTimer - 1; }\n\n  var fi:Number = floatTexts.length - 1;\n  while (fi >= 0) {\n    var ft:Object = floatTexts[fi];\n    ft.ttl = ft.ttl - 1;\n    ft.rise = ft.rise + 0.75;\n    if (ft.ttl <= 0) {\n      if (ft.mc.tf != undefined) {\n        ft.mc.tf.text = \"\";\n        ft.mc.tf.removeTextField();\n      }\n      ft.mc._visible = false;\n      ft.mc.removeMovieClip();\n      floatTexts.splice(fi, 1);\n    } else {\n      ft.mc._x = isoScreenX(ft.wx, ft.wy);\n      ft.mc._y = isoScreenY(ft.wx, ft.wy) - ft.rise;\n      ft.mc._alpha = Math.min(100, ft.ttl * 5);\n    }\n    fi = fi - 1;\n  }\n}\n\n// --- Player Step & Post-Arrival Triggers ---\nfunction onPlayerEnteredTile():Void {\n  PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n  terrainDirty = true;\n\n  // Check Wasteland Exit Grid (tile 7)!\n  if (grid[playerTy * MAP_W + playerTx] == 7) {\n    escapedCavern = true;\n    walkQueue = [];\n    inCombat = false;\n    xp = xp + 250;\n    checkXpLevelUp();\n    playSound(sfx.escape, 0, 95);\n    addLog(\"FREEDOM! You emerge from Vault 13's cavern into the sunlit Wasteland! (+250 XP)\", \"#FACC15\");\n    modalMode = \"end\";\n    renderModal();\n    updateHud();\n    return;\n  }\n\n  // Check adjacent radioactive goo pools (tile 4)\n  var nearRad:Boolean = false;\n  var dy:Number = -1;\n  while (dy <= 1) {\n    var dx:Number = -1;\n    while (dx <= 1) {\n      var rx:Number = playerTx + dx;\n      var ry:Number = playerTy + dy;\n      if (rx >= 0 && ry >= 0 && rx < MAP_W && ry < MAP_H && grid[ry * MAP_W + rx] == 4) {\n        nearRad = true;\n      }\n      dx = dx + 1;\n    }\n    dy = dy + 1;\n  }\n  if (nearRad) {\n    rads = rads + 2;\n    addLog(\"Geiger counter clicks! Irradiated waste (+2 RAD).\", \"#A3E635\");\n  }\n\n  // Check if any visible Cave Rat spots the player -> auto-trigger Turn-Based Combat!\n  if (!inCombat) {\n    var ei:Number = 0;\n    while (ei < enemies.length) {\n      var en:Object = enemies[ei];\n      if (en.alive && fogState[en.ty * MAP_W + en.tx] == 2 &&\n          PathLos.tileDist(playerTx, playerTy, en.tx, en.ty) <= 5.6) {\n        en.alerted = true;\n        enterCombat(\"Hostile \" + en.name + \" hisses from the shadows — COMBAT STARTED!\");\n        return;\n      }\n      ei = ei + 1;\n    }\n  }\n\n  // Auto-loot pending container when reaching adjacent tile\n  if (pendingContainerIdx >= 0 && walkQueue.length == 0) {\n    var targetC:Number = pendingContainerIdx;\n    pendingContainerIdx = -1;\n    lootContainer(targetC);\n  }\n  updateHud();\n}\n\nfunction tryDirectionalStep(dx:Number, dy:Number):Void {\n  if (gameOver || escapedCavern || modalMode != \"\") { return; }\n  if (inCombat && combatTurn != \"player\") { return; }\n  if (stepProgress < 1.0 || walkQueue.length > 0) { return; }\n\n  rebuildBlockedMask(-1, false);\n  var candidates:Array = [{ x: playerTx + dx, y: playerTy + dy }];\n  if (dx != 0 && dy != 0) {\n    candidates.push({ x: playerTx + dx, y: playerTy });\n    candidates.push({ x: playerTx, y: playerTy + dy });\n  }\n\n  var ci:Number = 0;\n  while (ci < candidates.length) {\n    var nx:Number = candidates[ci].x;\n    var ny:Number = candidates[ci].y;\n    if (nx >= 0 && ny >= 0 && nx < MAP_W && ny < MAP_H) {\n      // Check if enemy is on that tile -> melee/shoot!\n      var eIdx:Number = enemyAtTile(nx, ny);\n      if (eIdx >= 0) {\n        executeAttack(eIdx, null);\n        return;\n      }\n      // Check if container is on that tile -> loot!\n      var cIdx:Number = containerAtTile(nx, ny);\n      if (cIdx >= 0 && (containers[cIdx].kind == \"locker\" || containers[cIdx].kind == \"footlocker\")) {\n        lootContainer(cIdx);\n        return;\n      }\n      var nTile:Number = grid[ny * MAP_W + nx];\n      if (PathLos.isWalkableTile(nTile) && !blockedMask[ny * MAP_W + nx]) {\n        if (inCombat) {\n          if (ap < 1) {\n            addLog(\"Out of Action Points — press [SPACE] to End Turn!\", \"#FACC15\");\n            return;\n          }\n          ap = ap - 1;\n        }\n        walkQueue = [{ tx: nx, ty: ny }];\n        if (cIdx >= 0 && !containers[cIdx].looted) {\n          pendingContainerIdx = cIdx;\n        }\n        updateHud();\n        return;\n      }\n    }\n    ci = ci + 1;\n  }\n}\n\n// --- Enemy AI Turn Execution ---\nfunction stepEnemyAi():Void {\n  if (aiWaitFrames > 0) {\n    aiWaitFrames = aiWaitFrames - 1;\n    return;\n  }\n\n  while (aiActorIdx < enemies.length) {\n    var e:Object = enemies[aiActorIdx];\n    if (!e.alive || !e.alerted || e.curAp <= 0) {\n      aiActorIdx = aiActorIdx + 1;\n    } else {\n      break;\n    }\n  }\n\n  if (aiActorIdx >= enemies.length) {\n    // End of enemy turn -> restore player AP!\n    combatTurn = \"player\";\n    turnNumber = turnNumber + 1;\n    ap = maxAp;\n    if (flareTurns > 0) {\n      flareTurns = flareTurns - 1;\n      if (flareTurns == 0) {\n        PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n        terrainDirty = true;\n      }\n    }\n    checkAutoEndCombat();\n    updateHud();\n    return;\n  }\n\n  var actor:Object = enemies[aiActorIdx];\n  var dist:Number = PathLos.chebyshevDist(actor.tx, actor.ty, playerTx, playerTy);\n\n  // Adjacent -> Bite attack (3 AP)!\n  if (dist <= 1) {\n    if (actor.curAp >= 3) {\n      actor.curAp = actor.curAp - 3;\n      aiWaitFrames = 9;\n      var hitChance:Number = 68 + actor.kind * 6 - currentAc() - (actor.blinded ? 28 : 0);\n      if (hitChance < 10) { hitChance = 10; }\n      var roll:Number = 1 + Math.floor(Math.random() * 100);\n      if (roll <= hitChance) {\n        var dmg:Number = actor.minDmg + Math.floor(Math.random() * (actor.maxDmg - actor.minDmg + 1));\n        if (hasLeatherArmor) {\n          dmg = Math.max(1, Math.round(dmg * 0.8) - 1);\n        }\n        hp = hp - dmg;\n        playSound(sfx.hurt, 0, 80);\n        addLog(actor.name + \" lunges and bites you for \" + dmg + \" dmg!\", \"#EF4444\");\n        spawnFloatText(playerTx, playerTy, \"-\" + dmg + \" HP\", 0xEF4444);\n        if (hp <= 0) {\n          hp = 0;\n          gameOver = true;\n          modalMode = \"end\";\n          renderModal();\n          updateHud();\n          return;\n        }\n      } else {\n        playSound(sfx.ratSqueak, 0, 55);\n        addLog(actor.name + \" snaps at your boots and misses!\", \"#94A3B8\");\n        spawnFloatText(playerTx, playerTy, \"DODGED\", 0x86EFAC);\n      }\n      updateHud();\n      return;\n    } else {\n      actor.curAp = 0;\n      aiActorIdx = aiActorIdx + 1;\n      return;\n    }\n  }\n\n  // Otherwise step 1 tile toward Vault Dweller along A* path (1 AP)\n  rebuildBlockedMask(aiActorIdx, true);\n  var path:Array = PathLos.findPath(grid, MAP_W, MAP_H, blockedMask, actor.tx, actor.ty, playerTx, playerTy, true);\n  if (path.length > 0 && actor.curAp >= 1) {\n    var nextStep:Object = path[0];\n    if (!(nextStep.tx == playerTx && nextStep.ty == playerTy) && !blockedMask[nextStep.ty * MAP_W + nextStep.tx]) {\n      actor.tx = nextStep.tx;\n      actor.ty = nextStep.ty;\n      actor.curAp = actor.curAp - 1;\n      aiWaitFrames = 4;\n      return;\n    }\n  }\n  actor.curAp = 0;\n  aiActorIdx = aiActorIdx + 1;\n}\n\n// --- Input Routing (Mouse Clicks, Wheel, and Keyboard Shortcuts) ---\nfunction findNearestVisibleEnemy():Number {\n  var bestIdx:Number = -1;\n  var bestDist:Number = 999;\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive && fogState[e.ty * MAP_W + e.tx] == 2) {\n      var d:Number = PathLos.tileDist(playerTx, playerTy, e.tx, e.ty);\n      if (d < bestDist && PathLos.hasLineOfSight(grid, MAP_W, MAP_H, playerTx, playerTy, e.tx, e.ty)) {\n        bestDist = d;\n        bestIdx = i;\n      }\n    }\n    i = i + 1;\n  }\n  return bestIdx;\n}\n\nfunction openVatsOnEnemy(eIdx:Number):Void {\n  if (eIdx < 0 || eIdx >= enemies.length || !enemies[eIdx].alive) {\n    addLog(\"No visible hostile target in sight for V.A.T.S.!\", \"#F87171\");\n    return;\n  }\n  vatsTargetIdx = eIdx;\n  modalMode = \"vats\";\n  playSound(sfx.pipboy, 0, 75);\n  renderModal();\n}\n\nfunction handleStageMouseDown():Void {\n  var mx:Number = _root._xmouse;\n  var my:Number = _root._ymouse;\n\n  // 1. If a modal is open, handle modal clicks!\n  if (modalMode != \"\") {\n    if (modalMode == \"end\") {\n      if (mx >= 144 && mx <= 656 && my >= 34 && my <= 366) {\n        resetGame();\n      }\n      return;\n    }\n    // Click outside modal frame closes it\n    if (mx < 144 || mx > 656 || my < 34 || my > 366) {\n      modalMode = \"\";\n      renderModal();\n      return;\n    }\n    if (modalMode == \"vats\") {\n      var vi:Number = 0;\n      while (vi < vatsParts.length) {\n        var by:Number = 88 + vi * 44;\n        if (mx >= 162 && mx <= 416 && my >= by && my <= by + 36) {\n          var chosenPart:Object = vatsParts[vi];\n          var targetId:Number = vatsTargetIdx;\n          modalMode = \"\";\n          renderModal();\n          executeAttack(targetId, chosenPart);\n          return;\n        }\n        vi = vi + 1;\n      }\n      return;\n    }\n    if (modalMode == \"inv\") {\n      if (my >= 112 && my < 130) { activeSlot = 1; fireMode = 0; }\n      else if (my >= 130 && my < 148) { activeSlot = 2; fireMode = 0; }\n      else if (my >= 148 && my < 166 && unlockedLeatherArmor) { hasLeatherArmor = !hasLeatherArmor; }\n      else if (my >= 166 && my < 186) { useStimpak(); }\n      else if (my >= 186 && my < 208 && flares > 0) {\n        flares = flares - 1;\n        flareTurns = 10;\n        PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n        terrainDirty = true;\n        addLog(\"Lit Cavern Flare! Sight radius and cavern accuracy increased.\", \"#FACC15\");\n      } else if (my > 310) {\n        modalMode = \"\";\n      }\n      updateHud();\n      renderModal();\n      return;\n    }\n    if (modalMode == \"pip\") {\n      if (my >= 315) {\n        if (mx < 245) { pipTab = 0; }\n        else if (mx < 345) { pipTab = 1; }\n        else if (mx < 455) { saveProgressToSol(); }\n        else if (mx < 560) { loadProgressFromSol(); return; }\n        else { modalMode = \"\"; }\n        renderModal();\n      }\n      return;\n    }\n    modalMode = \"\";\n    renderModal();\n    return;\n  }\n\n  if (gameOver || escapedCavern) { return; }\n\n  // 2. Bottom HUD Console clicks (y >= 392)\n  if (my >= 392) {\n    if (mx >= 274 && mx <= 290 && my >= 404 && my <= 454) { scrollLog(-2); return; }\n    if (mx >= 274 && mx <= 290 && my >= 458 && my <= 508) { scrollLog(2); return; }\n    if (mx >= 302 && mx <= 362) {\n      if (my >= 400 && my <= 425) { modalMode = \"inv\"; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n      if (my >= 429 && my <= 454) { modalMode = \"cha\"; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n      if (my >= 458 && my <= 483) { modalMode = \"pip\"; pipTab = 0; playSound(sfx.pipboy, 0, 70); renderModal(); return; }\n      if (my >= 487 && my <= 512) { useStimpak(); return; }\n    }\n    // Clicking active weapon slot cycles Single -> Aimed -> Reload\n    if (mx >= 370 && mx <= 566 && my >= 428 && my <= 484) {\n      fireMode = (fireMode + 1) % (activeSlot == 1 ? 3 : 2);\n      playSound(sfx.pipboy, 0, 65);\n      updateHud();\n      return;\n    }\n    if (my >= 488 && my <= 512) {\n      if (mx >= 370 && mx <= 432) {\n        activeSlot = (activeSlot == 1) ? 2 : 1;\n        fireMode = 0;\n        playSound(sfx.pipboy, 0, 70);\n        updateHud();\n        return;\n      }\n      if (mx >= 436 && mx <= 500) {\n        fireMode = (fireMode + 1) % (activeSlot == 1 ? 3 : 2);\n        playSound(sfx.pipboy, 0, 65);\n        updateHud();\n        return;\n      }\n      if (mx >= 504 && mx <= 566) {\n        var nearV:Number = findNearestVisibleEnemy();\n        openVatsOnEnemy(nearV);\n        return;\n      }\n    }\n    if (mx >= 694 && mx <= 790) {\n      if (my >= 428 && my <= 468) { endPlayerTurn(); return; }\n      if (my >= 472 && my <= 512) { tryEndCombat(); return; }\n    }\n    return;\n  }\n\n  // 3. Tactical Isometric Viewport clicks (y < 392)\n  if (inCombat && combatTurn != \"player\") { return; }\n\n  var tx:Number = screenToTileX(mx, my);\n  var ty:Number = screenToTileY(mx, my);\n  if (tx < 0 || ty < 0 || tx >= MAP_W || ty >= MAP_H) { return; }\n\n  // Clicked visible living enemy?\n  var clickedEnemy:Number = enemyAtTile(tx, ty);\n  if (clickedEnemy >= 0 && fogState[ty * MAP_W + tx] == 2) {\n    if (fireMode == 2) {\n      reloadActiveWeapon();\n    } else if (fireMode == 1) {\n      openVatsOnEnemy(clickedEnemy);\n    } else {\n      executeAttack(clickedEnemy, null);\n    }\n    return;\n  }\n\n  // Clicked container / Ed's corpse?\n  var clickedCont:Number = containerAtTile(tx, ty);\n  if (clickedCont >= 0 && fogState[ty * MAP_W + tx] > 0) {\n    if (PathLos.chebyshevDist(playerTx, playerTy, tx, ty) <= 1) {\n      lootContainer(clickedCont);\n      return;\n    }\n    if (!inCombat) {\n      rebuildBlockedMask(-1, false);\n      var cPath:Array = PathLos.findPath(grid, MAP_W, MAP_H, blockedMask, playerTx, playerTy, tx, ty, true);\n      if (cPath.length > 0) {\n        walkQueue = cPath;\n        pendingContainerIdx = clickedCont;\n      }\n      return;\n    }\n  }\n\n  // Clicked walkable floor tile -> compute A* path and move!\n  rebuildBlockedMask(-1, false);\n  var path:Array = PathLos.findPath(grid, MAP_W, MAP_H, blockedMask, playerTx, playerTy, tx, ty, false);\n  if (path.length == 0) { return; }\n\n  if (inCombat) {\n    if (ap <= 0) {\n      addLog(\"0 AP left — click END TURN or press [SPACE].\", \"#FACC15\");\n      return;\n    }\n    if (path.length > ap) {\n      path = path.slice(0, ap);\n    }\n    ap = ap - path.length;\n    walkQueue = path;\n    pendingContainerIdx = -1;\n    updateHud();\n  } else {\n    walkQueue = path;\n    pendingContainerIdx = -1;\n  }\n}\n\nvar mouseListener:Object = {};\nmouseListener.onMouseDown = function():Void {\n  handleStageMouseDown();\n};\nmouseListener.onMouseWheel = function(delta:Number):Void {\n  scrollLog(delta > 0 ? -1 : 1);\n};\nMouse.addListener(mouseListener);\n\nvar keyListener:Object = {};\nkeyListener.onKeyDown = function():Void {\n  var k:Number = Key.getCode();\n  // ESC closes any active modal\n  if (k == 27 && modalMode != \"\") {\n    modalMode = \"\";\n    renderModal();\n    return;\n  }\n\n  if (gameOver || escapedCavern) {\n    if (k == 82) { resetGame(); }       // R\n    else if (k == 120) { loadProgressFromSol(); } // F9\n    return;\n  }\n\n  // V.A.T.S. modal number keys 1..5\n  if (modalMode == \"vats\") {\n    if (k >= 49 && k <= 53) {\n      var pIdx:Number = k - 49;\n      if (pIdx < vatsParts.length) {\n        var partChoice:Object = vatsParts[pIdx];\n        var tId:Number = vatsTargetIdx;\n        modalMode = \"\";\n        renderModal();\n        executeAttack(tId, partChoice);\n      }\n    }\n    return;\n  }\n\n  // Inventory modal number keys 1..5\n  if (modalMode == \"inv\") {\n    if (k == 49) { activeSlot = 1; fireMode = 0; updateHud(); renderModal(); }\n    else if (k == 50) { activeSlot = 2; fireMode = 0; updateHud(); renderModal(); }\n    else if (k == 51 && unlockedLeatherArmor) { hasLeatherArmor = !hasLeatherArmor; updateHud(); renderModal(); }\n    else if (k == 52) { useStimpak(); renderModal(); }\n    else if (k == 53 && flares > 0) {\n      flares = flares - 1;\n      flareTurns = 10;\n      PathLos.updateVisibility(grid, MAP_W, MAP_H, playerTx, playerTy, currentSightRadius(), fogState, lightMap);\n      terrainDirty = true;\n      renderModal();\n    } else if (k == 73) {\n      modalMode = \"\";\n      renderModal();\n    }\n    return;\n  }\n\n  // Pip-Boy modal keys\n  if (modalMode == \"pip\") {\n    if (k == 49) { pipTab = 0; renderModal(); }\n    else if (k == 50) { pipTab = 1; renderModal(); }\n    else if (k == 53 || k == 116) { saveProgressToSol(); }\n    else if (k == 57 || k == 120) { loadProgressFromSol(); }\n    else if (k == 80 || k == 9) { modalMode = \"\"; renderModal(); }\n    return;\n  }\n\n  if (modalMode == \"cha\") {\n    if (k == 79 || k == 67) { modalMode = \"\"; renderModal(); }\n    return;\n  }\n\n  // Standard Cavern & Combat hotkeys\n  if (k == 73) { modalMode = \"inv\"; playSound(sfx.pipboy, 0, 70); renderModal(); return; } // I = Inventory\n  if (k == 79) { modalMode = \"cha\"; playSound(sfx.pipboy, 0, 70); renderModal(); return; } // O = Character Sheet\n  if (k == 80 || k == 9) { modalMode = \"pip\"; pipTab = (k == 9) ? 1 : 0; playSound(sfx.pipboy, 0, 70); renderModal(); return; } // P / Tab = Pip-Boy\n  if (k == 66) { activeSlot = (activeSlot == 1) ? 2 : 1; fireMode = 0; playSound(sfx.pipboy, 0, 70); updateHud(); return; } // B = Swap weapon\n  if (k == 49) { activeSlot = 1; fireMode = 0; updateHud(); return; } // 1 = 10mm Pistol\n  if (k == 50) { activeSlot = 2; fireMode = 0; updateHud(); return; } // 2 = Combat Knife\n  if (k == 77) { fireMode = (fireMode + 1) % (activeSlot == 1 ? 3 : 2); updateHud(); return; } // M = Cycle Mode\n  if (k == 72) { useStimpak(); return; } // H = Stimpak\n  if (k == 82) { reloadActiveWeapon(); return; } // R = Reload\n  if (k == 84) { tryEndCombat(); return; } // T = Toggle Combat\n  if (k == 32 || k == 13) { if (inCombat) { endPlayerTurn(); } return; } // Space / Enter = End Turn\n  if (k == 116 || k == 75) { saveProgressToSol(); return; } // F5 / K = Quick Save\n  if (k == 120 || k == 76) { loadProgressFromSol(); return; } // F9 / L = Quick Load\n  if (k == 36) { camPanX = 0; camPanY = 0; terrainDirty = true; return; } // Home = Re-center camera\n\n  // V = Open V.A.T.S. on nearest visible hostile\n  if (k == 86) {\n    openVatsOnEnemy(findNearestVisibleEnemy());\n    return;\n  }\n  // F = Fire / Attack nearest visible hostile immediately\n  if (k == 70) {\n    var fIdx:Number = findNearestVisibleEnemy();\n    if (fIdx >= 0) {\n      executeAttack(fIdx, null);\n    } else {\n      addLog(\"No visible hostile target in line of sight.\", \"#94A3B8\");\n    }\n    return;\n  }\n  // E = Loot / Interact with adjacent container\n  if (k == 69) {\n    var ci:Number = 0;\n    while (ci < containers.length) {\n      if (!containers[ci].looted && PathLos.chebyshevDist(playerTx, playerTy, containers[ci].tx, containers[ci].ty) <= 1) {\n        lootContainer(ci);\n        return;\n      }\n      ci = ci + 1;\n    }\n    addLog(\"Nothing lootable within arm's reach.\", \"#94A3B8\");\n    return;\n  }\n\n  // Screen-aligned WASD step movement:\n  // W = Screen Up (-1,-1), S = Screen Down (+1,+1), A = Screen Left (-1,+1), D = Screen Right (+1,-1)\n  if (k == 87) { tryDirectionalStep(-1, -1); }\n  else if (k == 83) { tryDirectionalStep(1, 1); }\n  else if (k == 65) { tryDirectionalStep(-1, 1); }\n  else if (k == 68) { tryDirectionalStep(1, -1); }\n};\nKey.addListener(keyListener);\n\n// --- Main 30 FPS Frame Loop ---\ndrawHudButtonsChrome();\nresetGame();\n\nthis.onEnterFrame = function():Void {\n  tickCounter = tickCounter + 1;\n\n  // Arrow keys smoothly pan camera inspection offset\n  if (modalMode == \"\") {\n    var panSpeed:Number = 8;\n    if (Key.isDown(Key.LEFT))  { camPanX = camPanX + panSpeed; terrainDirty = true; }\n    if (Key.isDown(Key.RIGHT)) { camPanX = camPanX - panSpeed; terrainDirty = true; }\n    if (Key.isDown(Key.UP))    { camPanY = camPanY + panSpeed; terrainDirty = true; }\n    if (Key.isDown(Key.DOWN))  { camPanY = camPanY - panSpeed; terrainDirty = true; }\n  }\n\n  // Advance smooth tile-to-tile walking animation\n  if (stepProgress < 1.0) {\n    stepProgress = Math.min(1.0, stepProgress + 0.25);\n    walkBobPhase = walkBobPhase + 0.9;\n    drawPx = stepFromX + (playerTx - stepFromX) * stepProgress;\n    drawPy = stepFromY + (playerTy - stepFromY) * stepProgress;\n    if (stepProgress >= 1.0) {\n      drawPx = playerTx;\n      drawPy = playerTy;\n      onPlayerEnteredTile();\n    }\n  } else if (walkQueue.length > 0 && !gameOver && !escapedCavern) {\n    var nextNode:Object = walkQueue.shift();\n    rebuildBlockedMask(-1, false);\n    if (!blockedMask[nextNode.ty * MAP_W + nextNode.tx] && PathLos.isWalkableTile(grid[nextNode.ty * MAP_W + nextNode.tx])) {\n      stepFromX = playerTx;\n      stepFromY = playerTy;\n      playerTx = nextNode.tx;\n      playerTy = nextNode.ty;\n      var sdx:Number = (playerTx - stepFromX) - (playerTy - stepFromY);\n      var sdy:Number = ((playerTx - stepFromX) + (playerTy - stepFromY)) * 0.5;\n      var sl:Number = Math.sqrt(sdx * sdx + sdy * sdy);\n      if (sl > 0.01) {\n        facingDx = sdx / sl;\n        facingDy = sdy / sl;\n      }\n      stepProgress = 0.0;\n      playSound(sfx.step, 0, 42);\n    } else {\n      walkQueue = [];\n    }\n  }\n\n  // Smooth camera tracking around Vault Dweller + pan offset\n  var targetCamX:Number = Math.round(VIEW_W * 0.5 - (drawPx - drawPy) * 32 + camPanX);\n  var targetCamY:Number = Math.round(VIEW_H * 0.48 - (drawPx + drawPy) * 16 + camPanY);\n  if (Math.abs(targetCamX - camX) >= 1 || Math.abs(targetCamY - camY) >= 1) {\n    camX = camX + Math.round((targetCamX - camX) * 0.28);\n    camY = camY + Math.round((targetCamY - camY) * 0.28);\n    if (Math.abs(targetCamX - camX) <= 1) { camX = targetCamX; }\n    if (Math.abs(targetCamY - camY) <= 1) { camY = targetCamY; }\n    terrainDirty = true;\n  }\n\n  // Enemy AI turn execution\n  if (inCombat && combatTurn == \"enemy\" && !gameOver && !escapedCavern) {\n    stepEnemyAi();\n  }\n\n  // Update mouse hover inspection & A* preview path\n  var mx:Number = _root._xmouse;\n  var my:Number = _root._ymouse;\n  if (modalMode == \"\" && my >= 0 && my < VIEW_H && mx >= 0 && mx < VIEW_W) {\n    var ntx:Number = screenToTileX(mx, my);\n    var nty:Number = screenToTileY(mx, my);\n    if (ntx != hoverTx || nty != hoverTy) {\n      hoverTx = ntx;\n      hoverTy = nty;\n      hoverPath = [];\n      hoverEnemyIdx = -1;\n      hoverContainerIdx = -1;\n      if (ntx >= 0 && nty >= 0 && ntx < MAP_W && nty < MAP_H && fogState[nty * MAP_W + ntx] > 0) {\n        var he:Number = enemyAtTile(ntx, nty);\n        var hc:Number = containerAtTile(ntx, nty);\n        if (he >= 0 && fogState[nty * MAP_W + ntx] == 2) {\n          hoverEnemyIdx = he;\n          var eRef:Object = enemies[he];\n          var wRef:Object = activeWeaponDef();\n          var dRef:Number = PathLos.tileDist(playerTx, playerTy, eRef.tx, eRef.ty);\n          var skRef:Number = (activeSlot == 1) ? specStats.smallGuns : specStats.melee;\n          var hPct:Number = PathLos.calcHitChance(skRef, specStats.pe, dRef, wRef.range, eRef.ac, 0, flareTurns > 0);\n          if (this.topHintText != undefined) {\n            this.topHintText.text = eRef.name.toUpperCase() + \" (\" + eRef.hp + \"/\" + eRef.maxHp + \" HP) · \" +\n              (fireMode == 1 ? \"OPEN V.A.T.S. (\" + wRef.apAimed + \" AP)\" : (hPct + \"% HIT (\" + wRef.apSingle + \" AP)\"));\n          }\n        } else if (hc >= 0) {\n          hoverContainerIdx = hc;\n          var cRef:Object = containers[hc];\n          if (this.topHintText != undefined) {\n            this.topHintText.text = cRef.name.toUpperCase() + (cRef.looted ? \" [EMPTY]\" : \" · CLICK OR [E] TO LOOT\");\n          }\n        } else if (PathLos.isWalkableTile(grid[nty * MAP_W + ntx])) {\n          rebuildBlockedMask(-1, false);\n          hoverPath = PathLos.findPath(grid, MAP_W, MAP_H, blockedMask, playerTx, playerTy, ntx, nty, false);\n          if (this.topHintText != undefined) {\n            var tCode:Number = grid[nty * MAP_W + ntx];\n            var tName:String = (tCode == 7) ? \"SUNLIT WASTELAND EXIT GRID!\" : ((tCode == 2) ? \"VAULT 13 AIRLOCK\" : \"CAVERN FLOOR\");\n            var apNote:String = (inCombat && hoverPath.length > 0) ? (\" · MOVE \" + hoverPath.length + \" AP\") : \"\";\n            this.topHintText.text = tName + \" (\" + ntx + \",\" + nty + \")\" + apNote;\n          }\n        } else if (this.topHintText != undefined) {\n          var wt:Number = grid[nty * MAP_W + ntx];\n          this.topHintText.text = (wt == 5) ? \"VAULT 13 BLAST DOOR — SEALED\" : ((wt == 4) ? \"IRRADIATED SLUDGE POOL\" : \"LIMESTONE CAVERN WALL\");\n        }\n        updateHud();\n      }\n    }\n  } else {\n    hoverTx = -1;\n    hoverTy = -1;\n    hoverPath = [];\n    hoverEnemyIdx = -1;\n    hoverContainerIdx = -1;\n  }\n\n  // Render cached terrain & live Y-sorted tactical sprites\n  renderTerrainIfDirty();\n  renderHoverAndEntities();\n\n  // FPS telemetry readout\n  fpsFrames = fpsFrames + 1;\n  var nowMs:Number = getTimer();\n  if (nowMs - fpsLastMs >= 500) {\n    fpsValue = Math.min(60, Math.round((fpsFrames * 1000) / Math.max(1, nowMs - fpsLastMs)));\n    fpsFrames = 0;\n    fpsLastMs = nowMs;\n    if (this.fpsText != undefined) {\n      this.fpsText.text = fpsValue + \" FPS · V13 CAVERN\";\n    }\n  }\n};\n"
            }
          }
        ]
      }
    },
    {
