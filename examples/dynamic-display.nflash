        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.geom.Matrix;\nvar legacyClip = this.createEmptyMovieClip(\"legacy\", this.getNextHighestDepth());\nlegacyClip._x = 462;\nlegacyClip._y = 235;\nlegacyClip.lineStyle(2, 0xD4BEFF, 100);\nvar legacyBox:Matrix=new Matrix(); legacyBox.createGradientBox(36,60,0);\nlegacyClip.lineGradientStyle(\"linear\",[0xF1E3FF,0xAE8BDF],[100,100],[0,255],legacyBox);\nlegacyClip.beginGradientFill(\"linear\",[0xBE8DE7,0x61449A],[100,100],[0,255],legacyBox);\nlegacyClip.moveTo(0, 0);\nlegacyClip.lineTo(36, 30);\nlegacyClip.lineTo(0, 60);\nlegacyClip.lineTo(0, 0);\nlegacyClip.endFill();\nlegacyClip.onPress = function() { trace(\"dynamic AS2 press\", this._name); };\ntrace(\"dynamic AS2 ready\", legacyClip._name, legacyClip._parent == this);\n"
            }
          }
        ]
      }
    }
  ],
  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n  import flash.display.MovieClip;\n  import flash.display.Sprite;\n  import flash.display.Shape;\n  import flash.events.KeyboardEvent;\n  import flash.events.TimerEvent;\n  import flash.utils.Timer;\n  import flash.utils.ByteArray;\n  import flash.geom.Rectangle;\n  import flash.geom.Matrix;\n  import flash.display.GradientType;\n  import flash.display.SpreadMethod;\n  import flash.display.InterpolationMethod;\n  import flash.display.GraphicsPathCommand;\n  import flash.display.GraphicsPathWinding;\n  public class Main extends MovieClip {\n    public var leftPanel:Sprite;\n    public var rightPanel:Sprite;\n    public var card:Card;\n    public var underlay:Sprite;\n    public var timer:Timer;\n    public var copiedPaint:Shape;\n    public var invalidGradientRejected:Boolean=false;\n    public function Main() {\n      super(); stop();\n      leftPanel = new Sprite(); leftPanel.name = \"leftPanel\";\n      leftPanel.x = 60; leftPanel.y = 190;\n      leftPanel.graphics.beginFill(0x253449); leftPanel.graphics.drawRect(0, 0, 380, 190); leftPanel.graphics.endFill();\n      rightPanel = new Sprite(); rightPanel.name = \"rightPanel\";\n      rightPanel.x = 520; rightPanel.y = 190;\n      rightPanel.graphics.beginFill(0x253449); rightPanel.graphics.drawRect(0, 0, 380, 190); rightPanel.graphics.endFill();\n      addChild(leftPanel); addChild(rightPanel);\n      underlay = new Sprite(); underlay.name = \"underlay\"; underlay.x = 55; underlay.y = 60;\n      var warm:Matrix=new Matrix(); warm.createGradientBox(240,95,0.35);\n      underlay.graphics.beginGradientFill(GradientType.LINEAR,[0xF4C970,0xBD632E],[1,1],[0,255],warm);\n      underlay.graphics.drawRoundRectComplex(0,0,240,95,4,28,28,4); underlay.graphics.endFill();\n      var wave:Matrix=new Matrix(); wave.createGradientBox(380,120,0,0,70);\n      rightPanel.graphics.beginGradientFill(GradientType.LINEAR,[0x4161AC,0x37BCA7],[1,1],[0,255],wave,SpreadMethod.PAD,InterpolationMethod.RGB);\n      var commands:Vector.<int>=Vector.<int>([GraphicsPathCommand.MOVE_TO,GraphicsPathCommand.LINE_TO,GraphicsPathCommand.CUBIC_CURVE_TO,GraphicsPathCommand.LINE_TO,GraphicsPathCommand.LINE_TO]);\n      var points:Vector.<Number>=Vector.<Number>([0,190,0,130,110,65,220,230,380,115,380,190,0,190]);\n      rightPanel.graphics.drawPath(commands,points,GraphicsPathWinding.NON_ZERO); rightPanel.graphics.endFill();\n      rightPanel.graphics.lineStyle(3,0xB6EADF); rightPanel.graphics.moveTo(12,155);\n      rightPanel.graphics.cubicCurveTo(100,75,245,220,366,135);\n      try {rightPanel.graphics.beginGradientFill(GradientType.LINEAR,[0,0xffffff],[1,1],[0,255],wave,SpreadMethod.REFLECT);} catch(error:*) {invalidGradientRejected=true;}\n      leftPanel.addChild(underlay);\n      var packet:ByteArray = new ByteArray(); packet.writeUnsignedInt(0x53C1D4); packet.position = 0;\n      card = new Card(packet.readUnsignedInt()); card.name = \"card\"; card.x = 25; card.y = 25;\n      leftPanel.addChild(card);\n      copiedPaint=new Shape(); copiedPaint.name=\"copiedPaint\";\n      copiedPaint.graphics.copyFrom(card.graphics); copiedPaint.x=92; copiedPaint.y=42;\n      copiedPaint.scaleX=0.65; copiedPaint.scaleY=0.65; rightPanel.addChild(copiedPaint);\n      stage.addEventListener(KeyboardEvent.KEY_DOWN, onKey);\n      timer = new Timer(200, 4); timer.addEventListener(TimerEvent.TIMER, onTick); timer.start();\n      report(\"Ready\");\n      trace(\"dynamic ready\", leftPanel.numChildren, rightPanel.numChildren, card.numChildren, card.parent === leftPanel);\n    }\n    public function onTick(event:TimerEvent):void { card.y += 3; }\n    public function onKey(event:KeyboardEvent):void {\n      if (event.keyCode == 39) moveCard();\n      if (event.keyCode == 32) toggleCard();\n      if (event.keyCode == 38) runCycle();\n    }\n    public function moveCard():void {\n      if (card.parent === leftPanel) rightPanel.addChild(card); else leftPanel.addChild(card);\n      report(\"Reparented\"); trace(\"dynamic move\", card.parent.name, card.count);\n    }\n    public function toggleCard():void {\n      if (card.parent != null) card.parent.removeChild(card); else leftPanel.addChild(card);\n      report(\"Attachment changed\"); trace(\"dynamic attachment\", card.parent != null, card.count);\n    }\n    public function runCycle():void {\n      var saved:Card = card;\n      rightPanel.addChild(card);\n      rightPanel.removeChild(card);\n      var detached:Boolean = card.parent == null;\n      leftPanel.addChild(card);\n      leftPanel.swapChildren(card, underlay);\n      var index:int = leftPanel.getChildIndex(card);\n      leftPanel.setChildIndex(card, leftPanel.numChildren - 1);\n      var bounds:Rectangle = card.getBounds(this);\n      report(\"Cycle kept the instance\");\n      trace(\"dynamic cycle\", saved === card, detached, index, card.parent === leftPanel, bounds.width, bounds.height, card.count);\n    }\n    public function report(message:String):void {\n      status.text = message + \" | left \" + leftPanel.numChildren + \" / right \" + rightPanel.numChildren + \" | card clicks \" + card.count;\n      measurements.text = \"Gradients + cubic paths + round corners | unsupported spread refused: \" + invalidGradientRejected;\n    }\n  }\n}\n"
    },
    {
      "id": "card-source",
      "path": "app/Card.as",
      "language": "action_script3",
      "source": "package app {\n  import flash.display.Sprite;\n  import flash.display.Shape;\n  import flash.display.Graphics;\n  import flash.display.GradientType;\n  import flash.display.SpreadMethod;\n  import flash.display.InterpolationMethod;\n  import flash.geom.Matrix;\n  import flash.events.MouseEvent;\n  public class Card extends Sprite {\n    public var count:int = 0;\n    public var base:uint;\n    public function Card(color:uint) {\n      super(); base=color; paintCard();\n      var badge:Shape = new Shape(); badge.name = \"badge\"; badge.x = 195; badge.y = 50;\n      var lens:Matrix=new Matrix(); lens.createGradientBox(38,38,0,-19,-19);\n      badge.graphics.beginGradientFill(GradientType.RADIAL,[0xFFF0B2,0xDB9A49,0x172638],[1,1,1],[0,130,255],lens,SpreadMethod.PAD,InterpolationMethod.RGB,-0.35);\n      badge.graphics.drawCircle(0, 0, 19); badge.graphics.endFill();\n      addChild(badge); addEventListener(MouseEvent.CLICK, onClick);\n    }\n    public function paintCard():void {\n      var paint:Graphics=graphics; paint.clear();\n      var box:Matrix=new Matrix(); box.createGradientBox(240,100,0);\n      paint.lineStyle(2,0xD2F5FA);\n      paint.lineGradientStyle(GradientType.LINEAR,[0xEDFAFF,0xA998F4],[1,1],[0,255],box);\n      paint.beginGradientFill(GradientType.LINEAR,[base,count%2==0?0x3653A0:0x8D4C9C],[1,1],[0,255],box);\n      paint.drawRoundRect(0,0,240,100,28,28); paint.endFill();\n      box.tx=900; // The drawing owns a copy of its gradient matrix.\n    }\n    public function onClick(event:MouseEvent):void {\n      count++; paintCard(); root.status.text = \"Card clicks \" + count + \" | same instance in \" + parent.name;\n      trace(\"dynamic click\", count, parent.name, numChildren);\n    }\n  }\n}\n"
    }
  ]
}
