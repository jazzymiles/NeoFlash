        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "stop();\nvar sample:Sound = new Sound();\nvar ready:Boolean = false;\nvar metadataEvents:Number = 0;\nvar loads:Number = 0;\nvar completed:Number = 0;\nvar plays:Number = 0;\nvar mode:Number = 0;\nsample.setVolume(0);\nfunction updateSoundBatch():Void {\n  var matrix:Object = sample.getTransform();\n  _root.matrixStatus.text = \"Matrix ll=\" + matrix.ll + \" lr=\" + matrix.lr + \" rl=\" + matrix.rl + \" rr=\" + matrix.rr + \"; volume=\" + sample.getVolume() + \"%\";\n  _root.status.text = \"Ready=\" + ready + \"; ID3 events=\" + metadataEvents + \"; loads=\" + loads + \"; plays=\" + plays + \"; completed=\" + completed;\n}\nsample.onID3 = function():Void {\n  metadataEvents++;\n  _root.metadata.text = \"Title: \" + sample.id3.songname + \"\\nArtist: \" + sample.id3.artist + \"\\nComment: \" + sample.id3.comment;\n};\nsample.onLoad = function(success:Boolean):Void {\n  ready = success;\n  if (success) {\n    loads++;\n    if (metadataEvents != 2 || sample.id3.songname != \"NeoFlash AS2 pulse\" || sample.getVolume() != 0 || sample.duration <= 0) { throw new Error(\"AS2 Sound batch metadata/load check failed\"); }\n    trace(\"AS2 Sound ready: 2 ID3 callbacks, title/artist/comment, decoded MP3, silent volume\");\n  }\n  updateSoundBatch();\n};\nsample.onSoundComplete = function():Void {\n  completed++;\n  updateSoundBatch();\n  trace(\"AS2 Sound matrix playback complete \" + completed);\n};\nfunction playSoundBatch():Void {\n  if (!ready) { return; }\n  sample.stop();\n  sample.setPan(0);\n  sample.start(0, 1);\n  mode = (mode + 1) % 2;\n  if (mode == 1) { sample.setTransform({ll:50, lr:50, rl:50, rr:50}); }\n  else { sample.setTransform({ll:100, lr:0, rl:0, rr:100}); }\n  var detached:Object = sample.getTransform();\n  detached.ll = 0;\n  if (sample.getTransform().ll == 0 || sample.getVolume() != 0) { throw new Error(\"Sound transform copy/volume check failed\"); }\n  plays++;\n  updateSoundBatch();\n}\nfunction reattachSoundBatch():Void {\n  ready = false;\n  metadataEvents = 0;\n  sample.attachSound(\"as2-tagged-pulse\");\n  updateSoundBatch();\n}\nreattachSoundBatch();\n"
            }
          }
        ]
      }
