                    "id": "stop-button",
                    "name": "stopButton",
                    "transform": {
                      "x": 500,
                      "y": 230,
                      "scale_x": 1,
                      "scale_y": 1,
                      "rotation": 0,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "rectangle",
                      "width": 110,
                      "height": 32,
