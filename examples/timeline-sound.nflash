                      "y": 28,
                      "scale_x": 1,
                      "scale_y": 1,
                      "rotation": 0,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "text",
                      "text": "Stream melody (frames 1–36) · Event beeps (1, 25)",
