                      "scale_x": 1,
                      "scale_y": 1,
                      "rotation": 0,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "text",
                      "text": "Enable audio: the melody follows the playhead; the box runs SoundMixer.stopAll().",
                      "font_family": "Helvetica",
                      "font_size": 14,
                      "color": [
                        230,
                        236,
                        245,
                        255
                      ]
                    },
                    "scripts": []
                  }
                ],
                "tween": null,
                "label": ""
              }
            ]
          },
          {
            "id": "beeps",
            "name": "Beeps",
            "visible": true,
            "locked": false,
            "keyframes": [
              {
                "frame": 0,
                "elements": [],
                "tween": null,
                "label": "",
                "sound": {
                  "resource": "beep"
                }
              },
              {
                "frame": 24,
                "elements": [],
                "tween": null,
                "label": "",
                "sound": {
                  "resource": "beep"
