        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "this.legacyChanges=0;this.legacyFocus=0;this.legacyBlur=0;\nthis.reportLegacy=function(){this.legacyReport.text=\"AS2 changes \"+this.legacyChanges+\" / focus \"+this.legacyFocus+\" / blur \"+this.legacyBlur;};\nthis.noteField.onChanged=function(field){_root.legacyChanges++;_root.reportLegacy();};\nthis.noteField.onSetFocus=function(oldFocus){_root.legacyFocus++;_root.reportLegacy();};\nthis.noteField.onKillFocus=function(newFocus){_root.legacyBlur++;_root.reportLegacy();};\nthis.selectMessage=function(){var ok:Boolean=Selection.setFocus(this.noteField);Selection.setSelection(0,5);this.status.text=\"AS2 focus \"+ok+\" / range \"+Selection.getBeginIndex()+\"..\"+Selection.getEndIndex()+\" / \"+Selection.getFocus();trace(\"form AS2 selection\",ok,Selection.getBeginIndex(),Selection.getEndIndex());};\nthis.reportLegacy();"
            }
          }
        ]
