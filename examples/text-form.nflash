  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;import flash.text.TextField;import flash.text.TextFieldType;import flash.text.TextFormat;\n import flash.events.Event;import flash.events.TextEvent;import flash.events.FocusEvent;import flash.net.SharedObject;\n public dynamic class Main extends MovieClip {\n  public var nickField:TextField;public var noteField:TextField;public var save:SharedObject;\n  public var changes:int=0;public var inputs:int=0;public var focused:int=0;public var blurred:int=0;public var rejected:int=0;\n  public function Main(){super();stop();save=SharedObject.getLocal(\"neoflash-text-form\");\n   nickField=makeField(\"nickField\",68,239,414,28,false);nickField.maxChars=24;nickField.restrict=\"A-Za-zА-Яа-яЁё \";nickField.text=save.data.name===undefined?\"Pilot\":save.data.name;\n   noteField=makeField(\"noteField\",558,239,414,100,true);noteField.maxChars=128;noteField.text=save.data.message===undefined?\"Hello from NeoFlash\":save.data.message;\n   report();reportSaved();trace(\"form ready\",nickField.text,noteField.text);\n  }\n  public function makeField(id:String,xpos:Number,ypos:Number,w:Number,h:Number,multi:Boolean):TextField{\n   var field:TextField=new TextField();field.name=id;field.x=xpos;field.y=ypos;field.width=w;field.height=h;\n   field.defaultTextFormat=new TextFormat(\"Arial\",20,0x162c3a);field.type=TextFieldType.INPUT;field.multiline=multi;field.wordWrap=multi;addChild(field);\n   field.addEventListener(Event.CHANGE,changed);field.addEventListener(TextEvent.TEXT_INPUT,typed);field.addEventListener(FocusEvent.FOCUS_IN,focusIn);field.addEventListener(FocusEvent.FOCUS_OUT,focusOut);return field;\n  }\n  public function changed(event:Event):void{changes++;report();trace(\"form change\",event.target.name,event.target.text,changes);}\n  public function typed(event:TextEvent):void{inputs++;if(event.text.indexOf(\"#\")>=0){event.preventDefault();rejected++;status.text=\"The # insertion was cancelled before changing the field.\";}report();}\n  public function focusIn(event:FocusEvent):void{focused++;report();}\n  public function focusOut(event:FocusEvent):void{blurred++;report();}\n  public function report():void{modernReport.text=\"AS3 changes \"+changes+\" / textInput \"+inputs+\" / focus \"+focused+\" / blur \"+blurred;}\n  public function replaceName():void{stage.focus=nickField;nickField.setSelection(0,Math.min(5,nickField.length));nickField.replaceSelectedText(\"Studio\");status.text=\"Replaced selected name: \"+nickField.selectionBeginIndex+\" / \"+nickField.selectionEndIndex+\" / caret \"+nickField.caretIndex;trace(\"form replace\",nickField.text,nickField.caretIndex);}\n  public function saveProfile():void{save.data.name=nickField.text;save.data.message=noteField.text;save.flush();reportSaved();status.text=\"Profile saved. Reload or Restart restores both fields.\";trace(\"form saved\",nickField.text,noteField.text);}\n  public function clearProfile():void{save.clear();reportSaved();status.text=\"Saved profile cleared. Reload returns to the example defaults.\";trace(\"form cleared\");}\n  public function reportSaved():void{savedReport.text=save.data.name===undefined?\"No saved profile\":\"Saved profile: \"+save.data.name+\" / \"+save.data.message.length+\" message characters\";}\n }\n}"
    }
  ]
}
