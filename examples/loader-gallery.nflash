  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip; import flash.display.Loader; import flash.display.LoaderInfo;\n import flash.net.URLLoader; import flash.net.URLRequest; import flash.net.URLLoaderDataFormat;\n import flash.events.Event; import flash.events.MouseEvent; import flash.events.ProgressEvent; import flash.events.IOErrorEvent;\n import flash.utils.ByteArray;\n public class Main extends MovieClip {\n  public var picture:Loader; public var bytesPicture:Loader; public var source:URLLoader;\n  public var errorProbe:Loader; public var cancelledProbe:Loader;\n  public var phase:int=0; public var loads:int=0; public var byteLoads:int=0; public var inits:int=0; public var errors:int=0; public var cancelled:int=0; public var progress:int=0; public var hits:int=0;\n  public var order:String=\"\"; public var cancelledInfo:LoaderInfo;\n  public function Main(){\n   super();stop();picture=new Loader();picture.name=\"urlPicture\";picture.x=75;picture.y=220;picture.scaleX=2.5;picture.scaleY=2.5;addChild(picture);\n   bytesPicture=new Loader();bytesPicture.name=\"bytesPicture\";bytesPicture.x=405;bytesPicture.y=220;bytesPicture.scaleX=2.5;bytesPicture.scaleY=2.5;addChild(bytesPicture);\n   picture.contentLoaderInfo.addEventListener(Event.INIT,onInit);picture.contentLoaderInfo.addEventListener(Event.COMPLETE,onComplete);picture.contentLoaderInfo.addEventListener(ProgressEvent.PROGRESS,onProgress);\n   bytesPicture.contentLoaderInfo.addEventListener(Event.COMPLETE,onBytesComplete);\n   picture.addEventListener(MouseEvent.CLICK,onImageClick);bytesPicture.addEventListener(MouseEvent.CLICK,onImageClick);\n   source=new URLLoader();source.dataFormat=URLLoaderDataFormat.BINARY;source.addEventListener(Event.COMPLETE,onSource);\n   cancelledProbe=new Loader();cancelledInfo=cancelledProbe.contentLoaderInfo;cancelledInfo.addEventListener(Event.COMPLETE,onCancelled);cancelledProbe.load(new URLRequest(\"images/first.png\"));cancelledProbe.close();\n   errorProbe=new Loader();errorProbe.contentLoaderInfo.addEventListener(IOErrorEvent.IO_ERROR,onError);var invalid:ByteArray=new ByteArray();invalid.writeUTFBytes(\"not an image\");errorProbe.loadBytes(invalid);\n   loadImages();report();\n  }\n  public function loadImages():void{picture.load(new URLRequest(phase==1?\"images/second.png\":\"images/first.png\"));source.load(new URLRequest(phase==1?\"images/first.png\":\"images/second.png\"));}\n  public function onSource(event:Event):void{bytesPicture.loadBytes(ByteArray(source.data));}\n  public function onInit(event:Event):void{inits++;order+=\"I\";}\n  public function onComplete(event:Event):void{loads++;order+=\"C\";urlStatus.text=\"Loaded \"+picture.contentLoaderInfo.width+\" × \"+picture.contentLoaderInfo.height+\" / \"+picture.contentLoaderInfo.bytesLoaded+\" bytes\";report();trace(\"gallery URL\",loads,inits,order);}\n  public function onBytesComplete(event:Event):void{byteLoads++;bytesStatus.text=\"Decoded \"+bytesPicture.contentLoaderInfo.width+\" × \"+bytesPicture.contentLoaderInfo.height+\" / \"+bytesPicture.contentLoaderInfo.contentType;report();trace(\"gallery bytes\",byteLoads);}\n  public function onProgress(event:ProgressEvent):void{progress++;}\n  public function onError(event:IOErrorEvent):void{errors++;report();trace(\"gallery refusal\",errors);}\n  public function onCancelled(event:Event):void{cancelled++;report();}\n  public function onImageClick(event:MouseEvent):void{hits++;inputStatus.text=\"AS3 image clicks \"+hits;trace(\"gallery click\",hits);}\n  public function cycle():void{phase=(phase+1)%3;if(phase==2){picture.unload();bytesPicture.unload();urlStatus.text=\"Unloaded / children \"+picture.numChildren;bytesStatus.text=\"Unloaded / content \"+(bytesPicture.content==null);}else{loadImages();}report();trace(\"gallery phase\",phase,loads,byteLoads);}\n  public function report():void{status.text=\"Phase \"+phase+\" / URL loads \"+loads+\" / byte loads \"+byteLoads+\" / clicks \"+hits;details.text=\"INIT before COMPLETE: \"+order+\" / decode errors \"+errors+\" / cancelled callbacks \"+cancelled;}\n }\n}"
    }
  ],
  "resources": [
    {
      "id": "gallery-0",
      "path": "images/first.png",
