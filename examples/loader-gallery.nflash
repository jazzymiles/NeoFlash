        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "this.legacyPhase=0;this.legacyLoads=0;this.legacyClicks=0;this.legacyOrder=\"\";\nthis.imageLoader=new MovieClipLoader();this.imageListener={};\nimageListener.onLoadComplete=function(target:MovieClip,status:Number){_root.legacyOrder+=\"C\";};\nimageListener.onLoadInit=function(target:MovieClip){\n _root.legacyOrder+=\"I\";_root.legacyLoads++;\n var progress:Object=_root.imageLoader.getProgress(target);\n _root.legacyStatus.text=\"AS2 loaded \"+progress.bytesLoaded+\" bytes\\nOrder \"+_root.legacyOrder;\n target.onPress=function(){this._root.legacyClicks++;this._root.inputStatus.text=\"AS2 image clicks \"+this._root.legacyClicks;trace(\"gallery AS2 click\",this._root.legacyClicks);};\n trace(\"gallery AS2\",_root.legacyLoads,_root.legacyOrder,progress.bytesLoaded);\n};\nimageLoader.addListener(imageListener);imageLoader.loadClip(\"images/first.png\",legacyTarget);\nthis.cycleLegacy=function(){this.legacyPhase=(this.legacyPhase+1)%3;if(this.legacyPhase==2){this.imageLoader.unloadClip(this.legacyTarget);this.legacyStatus.text=\"AS2 unloaded / placeholder stays removed\";}else{this.imageLoader.loadClip(this.legacyPhase==1?\"images/second.png\":\"images/first.png\",this.legacyTarget);}};\n"
            }
          }
        ]
      }
