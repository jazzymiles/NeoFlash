              "language": "action_script2",
              "source": "import legacy.*;\nstop();\nvar counter:Counter=new Counter();\nfunction advanceLegacy():Void {counter.advance(); refreshLegacy();}\nfunction refreshLegacy():Void {this[\"legacy-values\"].text=\"AS2 private in subclass: \"+counter.read();}\nrefreshLegacy();"
