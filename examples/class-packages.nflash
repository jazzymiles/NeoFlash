  "sources": [
    {
      "id": "model-BaseCounter",
      "path": "model/BaseCounter.as",
      "language": "action_script3",
      "source": "package model {\n    public class BaseCounter {\n        private var value:int=10;\n        protected var factor:int=1;\n        internal var revision:int=0;\n        public function BaseCounter() {}\n        public final function advance(amount:int=1):int {\n            value+=delta(amount); revision++; return value;\n        }\n        protected function delta(amount:int):int { return amount*factor; }\n        private function readValue():int { return value; }\n        public function get total():int { return readValue(); }\n    }\n}\n"
    },
    {
      "id": "model-BoostCounter",
      "path": "model/BoostCounter.as",
      "language": "action_script3",
      "source": "package model {\n    public final class BoostCounter extends BaseCounter {\n        private var value:int=100;\n        public function BoostCounter() { super(); }\n        protected override function delta(amount:int):int { return super.delta(amount)*2; }\n        public function run(amount:int):int { value+=amount; return advance(amount); }\n        public function get local():int { return value; }\n    }\n}\n"
    },
    {
      "id": "model-PackageLedger",
      "path": "model/PackageLedger.as",
      "language": "action_script3",
      "source": "package model {\n    class PackageLedger {\n        public static function describe(counter:BaseCounter):String { return counter.revision+\" revisions\"; }\n    }\n}\n"
    },
    {
      "id": "model-Board",
      "path": "model/Board.as",
      "language": "action_script3",
      "source": "package model {\n    public class Board {\n        public var counter:BoostCounter;\n        public function Board() { counter=new BoostCounter(); }\n        public function step():int { return counter.run(2); }\n        public function get caption():String { return PackageLedger.describe(counter); }\n    }\n}\n"
    },
    {
      "id": "data-Record",
      "path": "data/Record.as",
      "language": "action_script3",
      "source": "package data {\n    public dynamic class Record {\n        public var label:String=\"session\";\n        private var secret:String=\"hidden\";\n        public function Record() {}\n        public function get safe():String { return label; }\n    }\n}\n"
    },
    {
      "id": "data-FixedRecord",
      "path": "data/FixedRecord.as",
      "language": "action_script3",
      "source": "package data {\n    public class FixedRecord extends Record {\n        public function FixedRecord() { super(); }\n    }\n}\n"
    },
    {
      "id": "app-Main",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n    import flash.display.*;\n    import model.*;\n    import data.*;\n    public class Main extends MovieClip {\n        private var board:Board;\n        public var state:Record;\n        public var fixed:FixedRecord;\n        public var steps:int=0;\n        public var modelTotal:int=0;\n        public var modelLocal:int=0;\n        public var summary:String;\n        public var serialized:String;\n        public var metadataKeys:String;\n        public var sealedBlocked:Boolean=false;\n        public var privateBlocked:Boolean=false;\n        public var tagged:Boolean=false;\n        public function Main() {\n            super(); stop();\n            this[\"advance\"][\"advance-label\"].selectable=false;\n            this[\"tag\"][\"tag-label\"].selectable=false;\n            board=new Board(); state=new Record(); fixed=new FixedRecord();\n            state[\"note\"]=\"ready\";\n            try { fixed[\"note\"]=\"refused\"; } catch(error:Error) { sealedBlocked=true; }\n            try { var hidden:* =board.counter[\"value\"]; } catch(error:Error) { privateBlocked=true; }\n            refresh(); trace(\"packages ready\",modelTotal,modelLocal,sealedBlocked,privateBlocked);\n        }\n        public function advanceModels():void {\n            board.step(); steps++; state[\"note\"]=\"step \"+steps;\n            refresh(); trace(\"packages advance\",steps,modelTotal,modelLocal);\n        }\n        public function toggleTag():void {\n            tagged=!tagged;\n            if(tagged) state[\"theme\"]=\"mint\"; else delete state[\"theme\"];\n            refresh(); trace(\"packages tag\",tagged,metadataKeys);\n        }\n        private function refresh():void {\n            modelTotal=board.counter.total; modelLocal=board.counter.local;\n            summary=board.caption; serialized=JSON.stringify(board.counter);\n            var keys:Array=[];\n            for(var key:String in state) keys.push(key);\n            keys.sort(); metadataKeys=keys.join(\", \");\n            this[\"model-values\"].text=modelTotal+\" base / \"+modelLocal+\" derived\";\n            this[\"model-detail\"].text=\"Protected dispatch \u00d72 / \"+summary;\n            this[\"model-json\"].text=serialized;\n            this[\"model-guard\"].text=\"Private hidden: \"+privateBlocked+\" / sealed child: \"+sealedBlocked;\n            this[\"state-values\"].text=state[\"note\"];\n            this[\"state-detail\"].text=\"Dynamic keys: \"+metadataKeys;\n            this[\"state-json\"].text=JSON.stringify(state);\n            this[\"footer\"].text=\"Commands \"+steps+\" / tag \"+tagged+\" / Restart creates fresh models\";\n        }\n    }\n}\n"
    },
    {
      "id": "legacy-BaseCounter",
      "path": "legacy/BaseCounter.as",
      "language": "action_script2",
      "source": "class legacy.BaseCounter {\n    private var value:Number=20;\n    public function BaseCounter() {}\n    public function read():Number { return value; }\n}\n"
    },
    {
      "id": "legacy-Counter",
      "path": "legacy/Counter.as",
      "language": "action_script2",
      "source": "import legacy.*;\nclass legacy.Counter extends BaseCounter {\n    public function Counter() { super(); }\n    public function advance():Number { value+=3; return value; }\n}\n"
    }
  ]
}
