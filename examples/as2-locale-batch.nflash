  "document_class": "app.LocaleMain",
  "sources": [
    {
      "id": "as2-locale-main",
      "path": "app/LocaleMain.as",
      "language": "action_script2",
      "source": "import mx.lang.Locale;\nclass app.LocaleMain extends MovieClip {\n  public var runs:Number = 0;\n  public var checks:Number = 0;\n  public var passed:Number = 0;\n  public var callbackCount:Number = 0;\n  public function LocaleMain() { super(); stop(); runLocale(); }\n  public function check(name:String,ok:Boolean):Void { checks++;if(ok)passed++;trace(\"AS2_LOCALE_CHECK \"+name+\" \"+ok); }\n  public function runLocale():Void {\n    runs++;checks=0;passed=0;callbackCount=0;\n    Locale.setDefaultLang(\"en\");\n    Locale.setString(\"GREETING\",\"en\",\"Hello\");Locale.setString(\"GREETING\",\"fr\",\"Salut\");\n    Locale.setString(\"EMPTY\",\"en\",\"\");Locale.setString(\"EMPTY\",\"fr\",\"\");\n    var table:Boolean=Locale.loadString(\"GREETING\")==\"Hello\"&&Locale.loadStringEx(\"GREETING\",\"fr\")==\"Salut\"&&Locale.loadStringEx(\"EMPTY\",\"fr\")==\"\"&&Locale.loadStringEx(\"ABSENT\",\"en\")==undefined;\n    Locale.setDefaultLang(\"fr\");\n    check(\"translation tables and defaults\",table&&Locale.getDefaultLang()==\"fr\");\n    Locale.setDefaultLang(\"en\");\n    Locale.addXMLPath(\"en\",\"locale/en.xml\");Locale.addXMLPath(\"fr\",\"locale/fr.xml\");Locale.addXMLPath(\"broken\",\"locale/broken.xml\");\n    var codes:Array=Locale.languageCodeArray;var ids:Array=Locale.stringIDArray;var before:Number=codes.length;codes.push(\"not-a-real-language\");ids.push(\"not-a-real-id\");\n    check(\"language and ID lists are snapshots\",Locale.languageCodeArray.length==before&&Locale.stringIDArray.length==2&&before==3);\n    Locale.setLoadCallback(function(success:Boolean):Void {_root.callbackCount++;});\n    Locale.loadLanguageXML(\"fr\",function(success:Boolean):Void {_root.frenchLoaded(success);});\n    result.text=\"Loading embedded language resources...\";\n  }\n  public function frenchLoaded(success:Boolean):Void {\n    check(\"asynchronous XLIFF and custom callback\",success&&Locale.checkXMLStatus()&&Locale.loadString(\"GREETING\")==\"Bonjour & bienvenue!\"&&Locale.loadStringEx(\"RUSSIAN\",\"fr\")==\"Привет\"&&Locale.loadString(\"EMPTY\")==\"\"&&Locale.loadString(\"MARKUP\")==\"<b>literal</b>\"&&callbackCount==0);\n    Locale.setLoadCallback(function(ok:Boolean):Void {_root.brokenLoaded(ok);});\n    Locale.loadLanguageXML(\"broken\");\n  }\n  public function brokenLoaded(success:Boolean):Void {\n    check(\"malformed language preserves existing table\",!success&&!Locale.checkXMLStatus()&&Locale.loadString(\"GREETING\")==\"Bonjour & bienvenue!\"&&Locale.loadStringEx(\"GREETING\",\"en\")==\"Hello\");\n    Locale.setLoadCallback(function(ok:Boolean):Void {_root.initialized(ok);});\n    Locale.initialize();\n  }\n  public function initialized(success:Boolean):Void {\n    var greeting:String=Locale.loadString(\"GREETING\");\n    check(\"environment language with default fallback\",success&&Locale.checkXMLStatus()&&(greeting==\"Hello from XLIFF\"||greeting==\"Bonjour & bienvenue!\"));\n    Locale.loadLanguageXML(\"unconfigured\",function(ok:Boolean):Void {_root.missingLoaded(ok);});\n  }\n  public function missingLoaded(success:Boolean):Void {\n    check(\"unconfigured language callback\",!success&&!Locale.checkXMLStatus()&&Locale.loadStringEx(\"RUSSIAN\",\"fr\")==\"Привет\");\n    result.text=passed==checks?\"PASS: AS2 Locale package\":\"FAIL: inspect trace output\";\n    pipeline.text=\"French: \"+Locale.loadStringEx(\"GREETING\",\"fr\");\n    casing.text=\"Unicode: \"+Locale.loadStringEx(\"RUSSIAN\",\"fr\");\n    codec.text=\"XML parsing and translation state execute in Rust\";\n    counts.text=passed+\" / \"+checks+\" grouped checks; run \"+runs;\n    trace(\"AS2_LOCALE_RESULT \"+passed+\"/\"+checks);\n  }\n}\n"
    }
  ],
