            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "stop(); runs = 0;\nfunction runReuse() {\n runs += 1; var passed=0; var checks=0; var failures=\"\";\n function check(name:String, ok:Boolean) { checks++; if(ok)passed++;else failures+=name+\"; \"; }\n check(\"add\", (2 add 3)==\"23\");\n check(\"eq\", (2 eq \"2\")); check(\"ne\", (\"02\" ne 2));\n check(\"lt\", (10 lt 2)); check(\"le\", (\"a\" le \"a\"));\n check(\"gt\", (2 gt 10)); check(\"ge\", (\"b\" ge \"a\"));\n check(\"not\", (not 0)===true); check(\"and\", (1 and 2)===true); check(\"or\", (0 or \"yes\")===true);\n check(\"inequality\", 2 <> 3);\n var calls=0; function touch(){calls++;return true;}\n var eager=false and touch();check(\"eager\", calls==1 && eager===false);\n check(\"precedence\", (1 add 2 eq \"12\") && (\"a\" lt \"b\" and true));\n check(\"utf16\", (\"\\ud800\" lt \"\\ud801\"));\n check(\"parseInt\", parseInt(\"010\")==8 && parseInt(\"0x100\",10)==100 && parseInt(\"0x  -10\")==-16);\n check(\"parseInt-NaN\", isNaN(parseInt(\"-0x10\")) && isNaN(parseInt(\"12\",0)));\n var parse=parseInt;check(\"parseInt-alias\", parse(\"101\",2)==5);\n var saved=_root.pipeline._x;setProperty(_root.pipeline,0,saved+5);\n check(\"setProperty\", getProperty(_root.pipeline,0)==saved+5);setProperty(_root.pipeline,0,saved);\n check(\"getProperty-path\", getProperty(\"_root.pipeline\",0)==saved);\n check(\"targetPath\", targetPath(_root.pipeline)==\"_level0.pipeline\");\n var temporary=_root.createEmptyMovieClip(\"legacyTemporary\",300);\n temporary.beginFill(16746496);temporary.moveTo(0,0);temporary.lineTo(10,0);temporary.lineTo(10,10);temporary.endFill();\n duplicateMovieClip(temporary,\"legacyCopy\",301);\n check(\"global-duplicate\",_root.legacyCopy.getDepth()==301);\n startDrag(_root.legacyCopy,true,10,10,20,20);stopDrag();\n check(\"global-drag\",_root.legacyCopy._x>=10&&_root.legacyCopy._x<=20);\n removeMovieClip(\"_root.legacyCopy\");removeMovieClip(temporary);\n check(\"global-remove\",_root.getInstanceAtDepth(301)==undefined);\n var pair=(1,2);var old={x:1};var removed=delete old.x;\n check(\"existing-language\",pair==2 && (void 5)==undefined && removed && !old.hasOwnProperty(\"x\") && int(3.8)==3);\n _root.result.text=passed+\" / \"+checks+\" checks passed · run \"+runs;\n _root.pipeline.text=\"2 add 3 = \"+(2 add 3)+\" / 10 lt 2 = \"+(10 lt 2);\n _root.codec.text=targetPath(_root.pipeline)+\" · x=\"+getProperty(_root.pipeline,0);\n _root.report=\"AS2_LEGACY_RESULT \"+passed+\"/\"+checks+\" failures=\"+failures;trace(_root.report);\n}\nrunReuse();"
            }
          }
        ]
