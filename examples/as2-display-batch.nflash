              "language": "action_script2",
              "source": "stop();\nvar passed = 0;\nvar checks = 0;\nvar failures = \"\";\nfunction check(label, condition) {\n  checks++;\n  if (condition) passed++; else failures += label + \"; \";\n}\nvar holder = _root.createEmptyMovieClip(\"holder\", 500);\nholder._x = 80;\nholder._y = 185;\nvar first = holder.createEmptyMovieClip(\"first\", 100);\nfirst.beginFill(0x55D9A7, 100);\nfirst.moveTo(0, 0); first.lineTo(130, 0); first.lineTo(130, 100); first.lineTo(0, 100); first.lineTo(0, 0); first.endFill();\nvar second = holder.createEmptyMovieClip(\"second\", 4);\ncheck(\"sparse depths\", first.getDepth() == 100 && second.getDepth() == 4 && holder.getNextHighestDepth() == 101);\ncheck(\"lookup\", holder.getInstanceAtDepth(100) === first && holder.getInstanceAtDepth(7) === undefined);\nfirst.swapDepths(second);\ncheck(\"swap object\", first.getDepth() == 4 && second.getDepth() == 100);\nfirst.swapDepths(999);\ncheck(\"swap empty depth\", first.getDepth() == 999 && holder.getInstanceAtDepth(4) === undefined);\nvar copy = first.duplicateMovieClip(\"copy\", 100, {caption:\"independent duplicate\"});\ncopy._x = 190;\ncheck(\"replacement\", holder.getInstanceAtDepth(100) === copy && second._parent === null);\ncheck(\"duplicate metadata\", copy.caption == \"independent duplicate\" && copy._width == 130 && copy._height == 100);\ncheck(\"target paths\", copy._target == \"/holder/copy\" && targetPath(copy) == \"_level0.holder.copy\");\ncheck(\"loaded frames\", copy._framesloaded == 1);\ncheck(\"publication url\", _root._url.indexOf(\"http\") == 0);\nvar point = {x:0, y:0};\ncopy.localToGlobal(point);\ncheck(\"AS2 point mutation\", point.x == 270 && point.y == 185);\ncopy.globalToLocal(point);\ncheck(\"AS2 inverse point\", point.x == 0 && point.y == 0);\nvar box = copy.getBounds(\"_root\");\nvar rect = copy.getRect(\"/holder\");\ncheck(\"AS2 bounds\", box.xMin == 270 && box.xMax == 400 && rect.xMin == 190 && rect.yMax == 100);\nfirst.clear();\nfirst.beginFill(0x728FE8);first.moveTo(0,0);first.lineTo(90,0);first.curveTo(140,50,90,100);first.lineTo(0,100);first.lineTo(0,0);first.endFill();\ncheck(\"independent graphics\", copy._width == 130 && first._width != copy._width);\nvar label = holder.createTextField(\"caption\", 2000, 0, 135, 600, 50);\nlabel.text = \"Rust depth graph | independent drawings | AS2 paths\";\nlabel.textColor = 0xD5E7FA;\ncheck(\"text depth\", label.getDepth() == 2000 && holder.getInstanceAtDepth(2000) === label);\nvar removed = holder.createEmptyMovieClip(\"removed\", 4000);\nremoved.removeMovieClip();\ncheck(\"remove\", holder.getInstanceAtDepth(4000) === undefined && holder.getNextHighestDepth() == 2001);\nvar format = new TextFormat();\nformat.font = \"Arial\";format.size = 18;format.bold = true;format.italic = true;\nlabel.setTextFormat(format);\nvar copiedFormat = label.getTextFormat();\nlabel.setNewTextFormat(copiedFormat);\ncheck(\"TextFormat shared properties\", copiedFormat.font == \"Arial\" && copiedFormat.size == 18 && copiedFormat.bold && copiedFormat.italic);\nlabel.type = \"dynamic\";label.selectable = true;label.password = false;label.maxChars = 90;label.restrict = \"A-Z a-z|\";\ncheck(\"TextField input state\", label.type == \"dynamic\" && label.selectable && !label.password && label.maxChars == 90 && label.restrict == \"A-Z a-z|\");\nlabel.setSelection(0,4);label.replaceSel(\"Core\");\nlabel.replaceText(0,4,\"Rust\");\ncheck(\"TextField replacements\", label.text.indexOf(\"Rust depth\") == 0);\ncheck(\"TextField metrics and identity\", label.textWidth > 0 && label.textHeight > 0 && label._name == \"caption\" && label._visible);\nvar temporary = holder.createTextField(\"temporary\", 5000, 0, 0, 100, 30);\ntemporary.removeTextField();\ncheck(\"removeTextField\", holder.getInstanceAtDepth(5000) === undefined);\nvar sheet = new TextField.StyleSheet();\ncheck(\"CSS parse and selectors\", sheet.parseCSS(\"p, .story { font-family:Arial; font-size:20px; color:#55D9A7; font-weight:bold; text-decoration:underline; margin-left:8; margin-right:6; text-indent:12; }\") && sheet.getStyleNames().length == 2);\nvar styleCopy = sheet.getStyle(\".story\");styleCopy.color = \"#FFFFFF\";\ncheck(\"CSS defensive copy\", sheet.getStyle(\".story\").color == \"#55D9A7\");\nvar styleFormat = sheet.transform(sheet.getStyle(\"p\"));\ncheck(\"CSS format transform\", styleFormat.font == \"Arial\" && styleFormat.size == 20 && styleFormat.bold && styleFormat.underline && styleFormat.leftMargin == 8 && styleFormat.rightMargin == 6 && styleFormat.indent == 12);\nvar styled = _root.createTextField(\"styled\", 6000, 560, 180, 340, 210);\nstyled.multiline = true;styled.wordWrap = true;styled.html = true;styled.condenseWhite = true;styled.styleSheet = sheet;\nstyled.htmlText = '<p class=\"story\">Rust CSS and HTML<br>Uniform styles, real paragraph layout.</p>';\ncheck(\"HTML renders text\", styled.text.indexOf(\"Rust CSS and HTML\") == 0 && styled.text.indexOf(\"<p\") < 0 && styled.textHeight > 20);\ncheck(\"HTML metadata\", styled.html && styled.condenseWhite && styled.styleSheet === sheet && styled.htmlText.indexOf(\"<p\") == 0);\nsheet.setStyle(\".story\", {fontFamily:\"Arial\",fontSize:\"20px\",color:\"#728FE8\",fontWeight:\"bold\",textDecoration:\"underline\",marginLeft:\"8\",marginRight:\"6\",textIndent:\"12\"});\ncheck(\"CSS updates field\", styled.getTextFormat().color == 0x728FE8);\nvar scratch = new TextField.StyleSheet();scratch.setStyle(\"p\", {fontSize:\"16px\"});scratch.clear();\ncheck(\"CSS clear and remove\", scratch.getStyleNames().length == 0 && scratch.getStyle(\"p\") === null);\nvar invalidCss = scratch.parseCSS(\"p { font-size 20; }\");\ncheck(\"CSS parse atomic failure\", !invalidCss && scratch.getStyleNames().length == 0);\nvar reject = _root.createTextField(\"rejectedHtml\", 6001, 0, 0, 100, 30);reject.html = true;\nreject.htmlText = \"<b>uniform bold</b>\";\ncheck(\"uniform HTML tag formatting\", reject.text == \"uniform bold\" && reject.getTextFormat().bold);\nreject.removeTextField();\nstyleFormat.blockIndent = 5;\nvar extent = styleFormat.getTextExtent(\"Rust layout measured in the browser\", 150);\ncheck(\"AS2 text extent\", extent.width > 0 && extent.height > 20 && extent.textFieldWidth == extent.width + 4 && extent.ascent > 0 && styleFormat.blockIndent == 5);\nvar snapshot = _root.getTextSnapshot();\ncheck(\"TextSnapshot actual static text\", snapshot.getCount() > 40 && snapshot.getText(0,3) == \"AS2\" && snapshot.findText(0,\"Rust CSS\",true) == -1);\ncheck(\"TextSnapshot search\", snapshot.findText(0,\"as2\",false) == 0 && snapshot.findText(0,\"as2\",true) == -1);\nsnapshot.setSelected(0,3,true);snapshot.setSelectColor(0x55D9A7);\ncheck(\"TextSnapshot selection\", snapshot.getSelected(0,10) && snapshot.getSelectedText() == \"AS2\");\nvar runInfo = snapshot.getTextRunInfo(0,3);\ncheck(\"TextSnapshot geometry\", runInfo.length == 3 && runInfo[0].font == \"Arial\" && runInfo[0].selected && snapshot.hitTestTextNearPos(runInfo[0].matrix_tx + 1,runInfo[0].matrix_ty + 1) == 0);\nvar inputCounts = {press:0,mouseDown:0,mouseMove:0,mouseUp:0,keyDown:0,keyUp:0,focus:0,blur:0,dragOut:0,dragOver:0,unload:0};\nfunction showInput(traceResult) {\n  _root.inputStatus.text = \"Click blue shape; press A; Tab to green. Press: \" + inputCounts.press + \" | Keys: \" + inputCounts.keyDown + \"/\" + inputCounts.keyUp + \" | Focus: \" + inputCounts.focus + \"/\" + inputCounts.blur;\n  if (traceResult) trace(\"AS2 INPUT press=\" + inputCounts.press + \" key=\" + inputCounts.keyDown + \"/\" + inputCounts.keyUp + \" focus=\" + inputCounts.focus + \"/\" + inputCounts.blur + \" mouse=\" + inputCounts.mouseDown + \"/\" + inputCounts.mouseUp + \" drag=\" + inputCounts.dragOut + \"/\" + inputCounts.dragOver);\n}\nfirst.focusEnabled = true;first.tabEnabled = true;first.tabIndex = 1;\ncopy.focusEnabled = true;copy.tabEnabled = true;copy.tabIndex = 2;\nholder.tabChildren = true;first.enabled = false;\ncheck(\"AS2 enabled and tab preferences\", !first.enabled && first.tabIndex == 1 && copy.tabIndex == 2 && holder.tabChildren);\nfirst.enabled = true;\nfirst.onMouseDown = function() { inputCounts.mouseDown++; };\nfirst.onMouseMove = function() { inputCounts.mouseMove++; };\nfirst.onMouseUp = function() { inputCounts.mouseUp++; };\nfirst.onPress = function() { inputCounts.press++;Selection.setFocus(this);showInput(true); };\nfirst.onKeyDown = function() { inputCounts.keyDown++;showInput(true); };\nfirst.onKeyUp = function() { inputCounts.keyUp++;showInput(true); };\nfirst.onDragOut = function() { inputCounts.dragOut++;showInput(true); };\nfirst.onDragOver = function() { inputCounts.dragOver++;showInput(true); };\nfirst.onSetFocus = function(oldFocus) { inputCounts.focus++;showInput(false); };\nfirst.onKillFocus = function(newFocus) { inputCounts.blur++;showInput(false); };\ncopy.onSetFocus = function(oldFocus) { inputCounts.focus++;showInput(true); };\ncopy.onKillFocus = function(newFocus) { inputCounts.blur++;showInput(true); };\nSelection.setFocus(first);\ncheck(\"AS2 focus callback\", inputCounts.focus == 1);\nvar unloaded = holder.createEmptyMovieClip(\"unloadProbe\", 7000);\nunloaded.onUnload = function() { inputCounts.unload++; };\nunloaded.removeMovieClip();\ncheck(\"AS2 unload callback\", inputCounts.unload == 1);\nshowInput(false);\nvar viewport = _root.createTextField(\"viewport\", 8000, 560, 400, 340, 54);\nviewport.multiline = true;viewport.wordWrap = false;\nvar viewportFormat = new TextFormat(\"Arial\",16,0xD5E7FA);\nviewport.setNewTextFormat(viewportFormat);\nviewport.text = \"A deliberately long first line for horizontal scrolling in Rust.\\nSecond line\\nThird line\\nFourth line\\nFifth line\";\nviewport.background = true;viewport.backgroundColor = 0x202E45;viewport.border = true;viewport.borderColor = 0x55D9A7;\ncheck(\"AS2 TextField background border\", viewport.background && viewport.backgroundColor == 0x202E45 && viewport.border && viewport.borderColor == 0x55D9A7);\nvar scrollEvents = 0;\nviewport.onScroller = function() { scrollEvents++; };\nvar listenerEvents = 0;\nvar textListener = {onScroller:function(scrolledField) { if(scrolledField === viewport) listenerEvents++; }};\nviewport.addListener(textListener);\nviewport.scroll = 2;viewport.hscroll = 10;\ncheck(\"AS2 TextField scrolling\", viewport.scroll == 2 && viewport.hscroll == 10 && viewport.maxscroll > 1 && viewport.maxhscroll > 0 && viewport.bottomScroll > viewport.scroll && scrollEvents == 2);\nvar removedListener = viewport.removeListener(textListener);\nviewport.scroll = 3;\ncheck(\"TextField listener ordering and removal\", removedListener && listenerEvents == 2 && scrollEvents == 3);\nfunction publishDisplayReport() {\n_root.result.text = passed + \" / \" + checks + \" checks passed\";\n_root.report = '{\"suite\":\"as2-display-batch\",\"passed\":' + passed + ',\"checks\":' + checks + ',\"failures\":\"' + failures + '\"}';\ntrace(_root.report);\n\n}\npublishDisplayReport();\nvar loadedSheet = new TextField.StyleSheet();\nloadedSheet.onLoad = function(success) {\n  check(\"CSS resource load callback\", success && this.getStyle(\".loaded\").color == \"#55D9A7\");\n  publishDisplayReport();\n};\nloadedSheet.load(\"data/as2-display.css\");\n"
            }
          }
