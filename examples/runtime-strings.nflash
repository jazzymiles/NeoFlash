  "document_class": "app.StringsExample",
  "sources": [
    {
      "id": "string-example",
      "path": "app/StringsExample.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.utils.escapeMultiByte;\n import flash.utils.unescapeMultiByte;\n public dynamic class StringsExample extends MovieClip {\n  public var runs:int=0;\n  public var checks:Array;\n  public var failures:Array;\n  public var members:Array;\n  public function StringsExample(){super();stop();runReuse();}\n  public function check(id:String,actual:*,expected:*,member:Boolean=true):void {\n   var ok:Boolean=actual===expected;\n   checks.push({id:id,pass:ok,actual:actual,expected:expected});\n   if(!ok)failures.push(id);\n   if(member&&members.indexOf(id)<0)members.push(id);\n  }\n  public function runReuse():void {\n   runs++;checks=[];failures=[];members=[];\n   var raw:String=\"title:neo|level:3|tag:flash\";\n   var rows:Array=raw.split(\"|\");var output:String=\"\";\n   for(var i:int=0;i<rows.length;i++){\n    var at:int=rows[i].indexOf(\":\");\n    output=output.concat(output==\"\"?\"\":\";\",rows[i].substring(0,at).toUpperCase(),\"=\",rows[i].slice(at+1));\n   }\n   check(\"String.charAt\",raw.charAt(0),\"t\");\n   check(\"String.charCodeAt\",raw.charCodeAt(0),116);\n   check(\"String.concat\",\"Neo\".concat(\"Flash\"),\"NeoFlash\");\n   check(\"String.fromCharCode\",String.fromCharCode(65,0,66).length,3);\n   check(\"String.indexOf\",raw.indexOf(\"|\"),9);\n   check(\"String.lastIndexOf\",raw.lastIndexOf(\"|\"),17);\n   check(\"String.slice\",raw.slice(-5),\"flash\");\n   check(\"String.split\",rows.length,3);\n   check(\"String.substr\",\"abcdef\".substr(1,-2),\"bcde\");\n   check(\"String.substring\",\"abcdef\".substring(4,1),\"bcd\");\n   check(\"String.toLowerCase\",\"İ\".toLowerCase(),\"i\");\n   check(\"String.toUpperCase\",\"straße\".toUpperCase(),\"STRAßE\");\n   check(\"String.toString\",\"value\".toString(),\"value\");\n   check(\"String.valueOf\",\"value\".valueOf(),\"value\");\n   check(\"String.replace\",\"red red\".replace(\"red\",\"$&\"),\"$& red\");\n   check(\"String.localeCompare\",\"abc\".localeCompare(\"abd\"),-1);\n   check(\"String.toLocaleLowerCase\",\"İ\".toLocaleLowerCase(),\"i\");\n   check(\"String.toLocaleUpperCase\",\"straße\".toLocaleUpperCase(),\"STRAßE\");\n   var uri:String=\"https://neo.test/a b?x=α&v=1\";\n   check(\"encodeURI\",encodeURI(uri),\"https://neo.test/a%20b?x=%CE%B1&v=1\");\n   check(\"decodeURI\",decodeURI(\"%2f%23\"),\"%2f%23\");\n   check(\"encodeURIComponent\",encodeURIComponent(\"a/b α\"),\"a%2Fb%20%CE%B1\");\n   check(\"decodeURIComponent\",decodeURIComponent(\"a%2Fb%20%CE%B1\"),\"a/b α\");\n   check(\"escape\",escape(\"é €😀\"),\"%E9%20%u20AC%uD83D%uDE00\");\n   check(\"unescape\",unescape(\"%E9%20%u20AC%uD83D%uDE00\"),\"é €😀\");\n   check(\"escapeMultiByte\",escapeMultiByte(\"é +/\"),\"%C3%A9%20%2B%2F\");\n   check(\"unescapeMultiByte\",unescapeMultiByte(\"%C3%A9%20%2B%2F\"),\"é +/\");\n   check(\"isXMLName\",isXMLName(\"élève_2\")&&!isXMLName(\"a:b\")&&!isXMLName(null),true);\n   check(\"UTF16 preservation\",unescape(\"%uD800\").slice(0,1).charCodeAt(0),55296,false);\n   check(\"combined text pipeline\",output,\"TITLE=neo;LEVEL=3;TAG=flash\",false);\n   check(\"replacement callback\",\"red\".replace(\"red\",function(match:String,index:int,subject:String):String{return match.toUpperCase()+\":\"+index+\":\"+subject.length;}),\"RED:0:3\",false);\n   var refused:Boolean=false;try{decodeURIComponent(\"%E0%A4\");}catch(error:URIError){refused=true;}\n   check(\"malformed UTF8 diagnostic\",refused,true,false);\n   result.text=(checks.length-failures.length)+\" / \"+checks.length+\" checks passed · run \"+runs;\n   pipeline.text=output;\n   casing.text=\"Historical casing: straße → \"+\"straße\".toLocaleUpperCase()+\" / İ → \"+\"İ\".toLocaleLowerCase();\n   codec.text=\"AS3 escape: \"+escape(\"é €😀\");\n   counts.text=members.length+\" APIs · 19 Rust migrations + 8 new methods/globals\";\n   trace(\"AS3_STRINGS_RESULT \"+JSON.stringify({run:runs,checks:checks.length,passed:checks.length-failures.length,failed:failures.length,members:members,newMembers:8,converted:19,failures:failures}));\n  }\n }\n}\n"
    }
  ]
}
