  "sources": [
    {
      "id": "source-main",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.net.URLLoader;\n import flash.net.URLRequest;\n import flash.events.Event;\n import flash.events.IOErrorEvent;\n public class Main extends MovieClip {\n  public var loader:URLLoader;\n  public var original:XML;\n  public var catalog:XML;\n  public var roundtrip:XML;\n  public var rows:XMLList;\n  public var ready:Boolean=false;\n  public var revision:int=0;\n  public var total:int=0;\n  public var serialized:String;\n  public var malformedRejected:Boolean=false;\n  public var declarationRejected:Boolean=false;\n  public var operatorRejected:Boolean=false;\n  public var handlerTypes:Boolean=false;\n  public var handlerNullable:Boolean=false;\n  public var sharedSettings:Boolean=false;\n  public function Main() {\n   super(); stop(); XML.prettyPrinting=true; XML.prettyIndent=2;\n   loader=new URLLoader();\n   loader.addEventListener(Event.COMPLETE,loaded);\n   loader.addEventListener(IOErrorEvent.IO_ERROR,failed);\n   loader.load(new URLRequest(\"data/catalog.xml\"));\n  }\n  public function loaded(event:Event):void {\n   original=new XML(loader.data);catalog=original;\n   try {var bad:XML=new XML(\"<catalog><item></catalog>\");} catch(error:*) {malformedRejected=true;}\n   try {var blocked:XML=new XML(\"<!DOCTYPE catalog><catalog/>\");} catch(error:*) {declarationRejected=true;}\n   try {var implicit:* = original + original;} catch(error:*) {operatorRejected=true;}\n   ready=true;refresh();\n  }\n  public function failed(event:IOErrorEvent):void {modernStatus.text=\"XML load failed: \"+event.text;}\n  public function acceptXML(value:XML):XML {return value;}\n  public function acceptList(value:XMLList):XMLList {return value;}\n  public function advance():void {\n   if(!ready)return;\n   revision++;catalog=original.copy();\n   var copied:XML=original.elements(\"item\")[0].copy();\n   copied.child(\"name\").setChildren(\"Copied item / revision \"+revision);\n   catalog.appendChild(copied);refresh();\n  }\n  public function refresh():void {\n   rows=catalog.elements(\"item\");total=0;var lines:String=\"\";\n   for each(var row:XML in rows) {\n    var stock:int=int(String(row.attribute(\"stock\")));total+=stock;\n    lines+=String(row.attribute(\"id\"))+\" / \"+String(row.child(\"name\"))+\" / \"+stock+\"\\n\";\n   }\n   serialized=catalog.toXMLString();roundtrip=new XML(serialized);\n   modernRows.text=lines;modernXML.text=serialized;\n   modernStatus.text=\"AS3 revision \"+revision+\" / \"+rows.length()+\" items / stock \"+total+\"\\nOriginal remains \"+original.elements(\"item\").length()+\" items / roundtrip \"+roundtrip.elements(\"item\").length();\n   guardStatus.text=\"Malformed XML rejected: \"+malformedRejected+\" / DOCTYPE rejected: \"+declarationRejected+\" / E4X addition refused: \"+operatorRejected;\n   trace(\"xml catalog\",revision,rows.length(),total,original.elements(\"item\").length());\n  }\n }\n}"
    }
  ],
  "resources": [
    {
      "id": "catalog-data",
      "path": "data/catalog.xml",
      "media_type": "application/xml",
      "data_base64": ""
    }
  ]
