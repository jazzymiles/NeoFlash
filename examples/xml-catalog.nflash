                  {
                    "id": "advance-button",
                    "name": "advance-button",
                    "transform": {
                      "x": 40,
                      "y": 783,
                      "scale_x": 1,
                      "scale_y": 1,
                      "rotation": 0,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "advance-control",
                      "playback": "independent"
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "var missing:XML;this.root.handlerNullable=(missing==null);var value:XML=this.root.acceptXML(this.root.catalog);var list:XMLList=this.root.acceptList(value.elements(\"item\"));this.root.handlerTypes=(value is XML)&&(list is XMLList)&&((list as XMLList).length()>0);this.root.sharedSettings=(XML.prettyIndent==2);this.root.advance();"
                        }
                      },
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "_root.advanceLegacy();"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Update both catalogs",
                      "description": "Copy and append with AS3, then clone, move and remove with AS2.",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  }
                ],
                "tween": null,
                "label": ""
              }
            ]
          }
        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "var legacyDoc:XML=new XML();legacyDoc.ignoreWhite=true;\nvar legacyReady:Boolean=false;var legacyRevision:Number=0;var legacyTotal:Number=0;var legacyCount:Number=0;\nvar legacyReceiverOK:Boolean=false;var legacySerialized:String=\"\";var legacyMoved:Boolean=false;\nfunction refreshLegacy():Void {\n var root=legacyDoc.firstChild;var children=root.childNodes;var lines:String=\"\";legacyTotal=0;legacyCount=0;\n for(var i:Number=0;i<children.length;i++) {\n  var node=children[i];\n  if(node.nodeType==1&&node.nodeName==\"item\") {\n   legacyCount++;legacyTotal+=Number(node.attributes.stock);\n   lines+=node.attributes.id+\" / \"+node.firstChild.firstChild.nodeValue+\" / \"+node.attributes.stock+\"\\n\";\n  }\n }\n legacySerialized=legacyDoc.toString();legacyRows.text=lines;legacyXML.text=legacySerialized;\n legacyStatus.text=\"AS2 revision \"+legacyRevision+\" / \"+legacyCount+\" items / stock \"+legacyTotal+\"\\nLoad callback owns XML: \"+legacyReceiverOK+\" / moved clone: \"+legacyMoved;\n}\nfunction advanceLegacy():Void {\n if(!legacyReady)return;\n legacyRevision++;var root=legacyDoc.firstChild;var first=root.firstChild;var cloned=first.cloneNode(true);\n cloned.attributes.id=\"COPY-\"+legacyRevision;cloned.attributes.stock=\"5\";\n cloned.firstChild.firstChild.nodeValue=\"DOM copy / revision \"+legacyRevision;\n root.appendChild(cloned);legacyMoved=(root.lastChild==cloned&&cloned.parentNode==root);first.removeNode();refreshLegacy();\n}\nlegacyDoc.onLoad=function(success:Boolean):Void {\n legacyReady=success;legacyReceiverOK=(this==legacyDoc);\n if(success)refreshLegacy();else legacyStatus.text=\"AS2 XML load failed / status \"+legacyDoc.status;\n};\nlegacyDoc.load(\"data/catalog.xml\");"
            }
          }
        ]
      }
