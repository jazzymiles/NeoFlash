        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "this.legacySave=SharedObject.getLocal(\"neoflash-saved-game-as2\");this.legacyFlush=false;\nthis.reportLegacy=function(){var value:Number=this.legacySave.data.score===undefined?0:this.legacySave.data.score;this.legacyScore.text=\"Score \"+value;this.legacyBar._width=value==0?1:Math.min(value*2,390);this.legacyDetail.text=value==0?\"No saved progress\":\"AMF0 refs \"+(this.legacySave.data.primary===this.legacySave.data.alias)+\" / self \"+(this.legacySave.data.self===this.legacySave.data);};\nthis.collectLegacy=function(){var next:Number=this.legacySave.data.score===undefined?25:this.legacySave.data.score+25;var hero:Object={name:\"Legacy\",rank:next/25};this.legacySave.data.score=next;this.legacySave.data.primary=hero;this.legacySave.data.alias=hero;this.legacySave.data.self=this.legacySave.data;this.legacySave.data.savedAt=new Date(Date.UTC(2026,9,27));this.legacySave.data.inventory=[\"pen\",\"film\",next];this.legacySave.data.unset=undefined;this.legacyFlush=this.legacySave.flush();this.reportLegacy();trace(\"save AS2\",next,this.legacyFlush,this.legacySave.getSize());};\nthis.clearLegacy=function(){this.legacySave.clear();this.reportLegacy();trace(\"save AS2 clear\",this.legacySave.data.score===undefined);};\nthis.reportLegacy();\n"
            }
          }
        ]
      }
