  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip; import flash.net.SharedObject; import flash.net.SharedObjectFlushStatus; import flash.net.ObjectEncoding; import flash.utils.ByteArray;\n public class Main extends MovieClip {\n  public var save:SharedObject; public var packet:ByteArray;public var oldPacket:ByteArray;public var round:Object;public var oldRound:Object;\n  public var lastFlush:String=\"none\";public var restores:Boolean=false;public var malformedPacketRecovered:Boolean=false;public var malformedError:Object;\n  public function Main(){super();stop();save=SharedObject.getLocal(\"neoflash-saved-game-as3\");verifyPackets();report();trace(\"save ready\",score(),save.objectEncoding,restores);}\n  public function score():int{return save.data.score===undefined?0:save.data.score;}\n  public function collect():void{\n   var next:int=score()+25;var hero:Object={name:\"Pilot\",rank:next/25};\n   save.data.score=next;save.data.primary=hero;save.data.alias=hero;save.data.self=save.data;save.data.savedAt=new Date(Date.UTC(2026,9,27,0,0,next/25));\n   save.data.inventory=[\"ink\",\"paper\",next];save.data.unset=undefined;save.data.nan=0/0;save.data.infinity=1/0;save.data.negativeZero=-0;\n   var badge:ByteArray=new ByteArray();badge.writeUTF(\"LEVEL-\"+(next/25));save.data.badge=badge;\n   lastFlush=save.flush();report();status.text=\"AS3 flush \"+lastFlush+\" / reload or Restart preserves both scores\";trace(\"save AS3\",next,lastFlush,save.size);\n  }\n  public function clearSave():void{save.clear();lastFlush=\"cleared\";report();status.text=\"Named saves cleared. Reload starts from zero.\";trace(\"save AS3 clear\",score());}\n  public function verifyPackets():void{\n   var malformed:ByteArray=new ByteArray();malformed.writeByte(10);malformed.position=0;\n   try{malformed.readObject();}catch(error:Error){malformedError=error;malformedPacketRecovered=error.message.indexOf(\"truncated AMF value\")>=0&&malformed.position==0&&malformed.length==1&&malformed[0]==10;}\n   var shared:Object={label:\"linked\"};var data:Object={left:shared,right:shared,unset:undefined,nan:0/0,infinity:1/0,negativeZero:-0,when:new Date(Date.UTC(2026,9,27))};data.self=data;\n   var values:Array=[];values[2]=\"third\";values.tag=\"bag\";data.values=values;\n   packet=new ByteArray();packet.objectEncoding=ObjectEncoding.AMF3;packet.writeObject(data);packet.writeUTF(\"tail3\");packet.position=0;round=packet.readObject();var tail3:String=packet.readUTF();\n   oldPacket=new ByteArray();oldPacket.objectEncoding=ObjectEncoding.AMF0;oldPacket.writeObject(data);oldPacket.writeUTF(\"tail0\");oldPacket.position=0;oldRound=oldPacket.readObject();var tail0:String=oldPacket.readUTF();\n   restores=round.left===round.right&&round.self===round&&oldRound.left===oldRound.right&&oldRound.self===oldRound&&tail3==\"tail3\"&&tail0==\"tail0\";\n   binaryReport.text=\"ByteArray AMF3: \"+packet.length+\" bytes / AMF0: \"+oldPacket.length+\" bytes / trailing records intact\";\n   identityReport.text=\"Shared identity + cycles: \"+restores+\" / Date: \"+round.when.getUTCFullYear()+\" / named array: \"+round.values.tag;\n  }\n  public function report():void{var value:int=score();scoreText.text=\"Score \"+value;progressBar.width=value==0?1:Math.min(value*2,390);savedDetail.text=value==0?\"No saved progress\":\"Rank \"+save.data.primary.rank+\" / refs \"+(save.data.primary===save.data.alias)+\" / self \"+(save.data.self===save.data);}\n }\n}"
    }
  ]
}
