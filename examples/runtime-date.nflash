          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "var legacy:Date=new Date(99,0,1,12,0,0,0);var yearOk:Boolean=legacy.getYear()==99;legacy.setYear(5);var changed:Boolean=legacy.getFullYear()==1905;var epoch:Date=new Date(Date.UTC(2000,1,29));epoch.setUTCDate(30);var carry:Boolean=epoch.getUTCMonth()==2&&epoch.getUTCDate()==1;trace(\"DATE_AS2_RESULT \"+(yearOk&&changed&&carry));"
            }
          }
        ]
      }
