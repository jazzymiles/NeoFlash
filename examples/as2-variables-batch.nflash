          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "stop(); passed=0; checks=0; failures=\"\"; posted=false;\nvar summary=_root.createTextField(\"summary\",70,42,165,870,55);var details=_root.createTextField(\"details\",71,42,235,870,180);\nvar format=new TextFormat(\"Arial\",26,16777215);summary.setNewTextFormat(format);summary.setTextFormat(format);\nvar body=new TextFormat(\"Arial\",18,13489378);details.setNewTextFormat(body);details.setTextFormat(body);details.multiline=true;\nfunction result(name,ok){checks++;if(ok)passed++;else failures+=name+\"; \";summary.text=\"Timeline variables: \"+passed+\" / \"+checks;summary.textColor=passed==checks?7520933:16734032;details.text=\"Bundled GET / target method / root level / real HTTP POST\\n\"+(failures==\"\"?\"Completed groups passed. Use the button for the local echo POST.\":failures);trace(\"AS2_VARIABLES_RESULT \"+passed+\"/\"+checks+\"; \"+failures);}\nvar destination=_root.createEmptyMovieClip(\"variables\",20);\ndestination.onData=function(){_root.result(\"global\",this.title==\"Loaded from Rust\"&&this.tag.length==2&&this.unicode==\"мир\");this.onData=function(){_root.result(\"method\",this.title==\"Second batch\"&&this.tag[1]==\"as2\");_root.onData=function(){_root.result(\"level\",_root.rootReply==\"level-zero\");};loadVariablesNum(\"data/root.txt\",0);};this.loadVariables(\"data/next.txt\");};\nloadVariables(\"data/variables.txt\",destination);\nfunction runReuse(){if(posted)return;posted=true;var sender=_root.createEmptyMovieClip(\"sender\",21);sender.title=\"A useful batch\";sender.tag=[\"rust\",\"as2\"];sender.onData=function(){_root.result(\"POST\",this.requestMethod==\"POST\"&&this.title==\"A useful batch\"&&this.tag[0]==\"rust\"&&this.tag[1]==\"as2\");};sender.loadVariables(\"/__as2_vars_echo\",\"POST\");}\n"
            }
          }
        ]
      }
