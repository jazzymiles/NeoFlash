        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "java_script",
              "source": "// Ordinary authored JavaScript: the exported player needs no manual host patch.\nif (typeof document !== \"undefined\") {\n  const movie=document.getElementById(\"stage\");\n  const old=document.getElementById(\"web-host-panel\");if(old)old.remove();\n  const panel=document.createElement(\"section\");panel.id=\"web-host-panel\";\n  panel.style.cssText=\"flex:1 0 100%;display:flex;flex-wrap:wrap;gap:8px;align-items:center;border-top:1px solid #4b6078;padding-top:10px\";\n  const title=document.createElement(\"strong\");title.textContent=\"HTML host controls\";panel.append(title);\n  const output=document.createElement(\"output\");output.id=\"web-host-output\";output.setAttribute(\"aria-live\",\"polite\");output.style.cssText=\"min-width:260px;color:#b8eedb\";\n  window.NeoFlashExampleHost={calls:0,quote(dialect,score){this.calls++;output.textContent=\"From \"+dialect+\": \"+score+\" \u2192 HTML reply #\"+this.calls;return {caption:\"HTML reply #\"+this.calls,score:score*10};}};\n  function control(id,label,method,amount){const button=document.createElement(\"button\");button.id=id;button.type=\"button\";button.textContent=label;button.addEventListener(\"click\",()=>{try{const reply=movie[method](amount);output.textContent=\"Returned \"+reply.dialect+\": score \"+reply.total+\", calls \"+reply.calls;}catch(error){output.textContent=\"Bridge error: \"+error.message;}});panel.append(button);}\n  control(\"html-to-as3\",\"HTML \u2192 AS3 +3\",\"addPoints\",3);control(\"html-to-as2\",\"HTML \u2192 AS2 +2\",\"addLegacy\",2);\n  output.textContent=\"Callbacks are methods on the stage canvas. No network is needed.\";panel.append(output);\n  const receipt=document.createElement(\"iframe\");receipt.id=\"web-receipt\";receipt.name=\"neoflashReceipt\";receipt.title=\"Optional HTTP receipt\";\n  receipt.style.cssText=\"width:100%;height:64px;border:1px solid #415975;border-radius:5px;background:#142131\";\n  receipt.srcdoc=\"<!doctype html><html><body style='background:#142131;color:#b6c8df;font:13px system-ui'>Optional receipt: run the local HTTP example server, then use GET or POST above.</body></html>\";\n  panel.append(receipt);document.querySelector(\"footer\").append(panel);\n}"
            }
          }
        ]
      }
    },
    {
      "id": "legacy-panel",
      "name": "legacy-panel",
      "kind": "movie_clip",
      "timeline": {
        "frame_count": 1,
        "layers": [
          {
            "id": "legacy-panel-layer",
            "name": "Content",
            "visible": true,
            "locked": false,
            "keyframes": [
              {
                "frame": 0,
                "elements": [],
                "tween": null,
                "label": ""
