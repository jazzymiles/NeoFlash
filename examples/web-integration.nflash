        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.external.ExternalInterface;\nstop();\nvar value:Number=0;\nfunction addLegacy(amount:Number):Object{this.value+=amount;_root.legacyTotal=this.value;_root.legacyCalls++;_root.refresh();return {dialect:\"AS2\",total:this.value,calls:_root.legacyCalls};}\nfunction askHost():Void{var reply:Object=ExternalInterface.call(\"NeoFlashExampleHost.quote\",\"AS2\",this.value);_root.legacyReply=reply==null?\"HTML bridge unavailable\":reply.caption+\" / score \"+reply.score;_root.refresh();}\nfunction submitReceipt():Void{var form:LoadVars=new LoadVars();form.source=\"AS2-LoadVars\";form.score=this.value;form.send(\"/__neoflash_web_receipt__\",\"neoflashReceipt\");_root.webState=\"AS2 form POST requested in the HTML receipt frame\";_root.refresh();}\nfunction openLegacy():Void{getURL(\"/__neoflash_web_receipt__?source=AS2-getURL\",\"neoflashReceipt\");_root.webState=\"AS2 getURL requested the named HTML frame\";_root.refresh();}\n_root.legacyReady=ExternalInterface.addCallback(\"addLegacy\",this,addLegacy);\n_root.legacyReply=\"Explicit receiver: legacyPanel.value\";\n_root.refresh();"
            }
          }
        ]
      }
    },
