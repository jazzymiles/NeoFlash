  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\nimport flash.display.MovieClip;\nimport flash.external.ExternalInterface;\nimport flash.net.URLRequest;\nimport flash.net.URLVariables;\nimport flash.net.navigateToURL;\nimport flash.net.sendToURL;\npublic dynamic class Main extends MovieClip {\n    public var total:int=0;\n    public var calls:int=0;\n    public var quoteScore:int=0;\n    public var hostReply:String=\"Press Ask HTML after startup\";\n    public var legacyTotal:int=0;\n    public var legacyCalls:int=0;\n    public var legacyReply:String=\"Waiting for AS2 callback registration\";\n    public var legacyReady:Boolean=false;\n    public var webState:String=\"HTTP controls are optional: serve with the receipt endpoint.\";\n    public function Main(){\n        stop();\n        title.selectable=false;eyebrow.selectable=false;intro.selectable=false;status3.selectable=false;status2.selectable=false;\n        heading3.selectable=false;heading2.selectable=false;httpTitle.selectable=false;httpNote.selectable=false;footer.selectable=false;\n        ask3.caption.selectable=false;ask3.caption.text=\"Ask HTML / AS3\";\n        ask2.caption.selectable=false;ask2.caption.text=\"Ask HTML / AS2\";\n        getButton.caption.selectable=false;getButton.caption.text=\"GET receipt\";\n        postButton.caption.selectable=false;postButton.caption.text=\"POST / LoadVars\";\n        sendButton.caption.selectable=false;sendButton.caption.text=\"Send, ignore reply\";\n        legacyButton.caption.selectable=false;legacyButton.caption.text=\"Legacy getURL\";\n        if(ExternalInterface.available){ExternalInterface.addCallback(\"addPoints\",addPoints);ExternalInterface.marshallExceptions=true;}\n        refresh();\n    }\n    public function addPoints(amount:int):Object{\n        total+=amount;calls++;refresh();\n        return {dialect:\"AS3\",total:total,calls:calls,objectID:ExternalInterface.objectID};\n    }\n    public function askHost():void{\n        var reply:Object=ExternalInterface.call(\"NeoFlashExampleHost.quote\",\"AS3\",total);\n        if(reply==null){hostReply=\"HTML bridge unavailable\";}else{quoteScore=reply.score;hostReply=reply.caption+\" / score \"+quoteScore;}\n        refresh();\n    }\n    public function getReceipt():void{\n        var data:URLVariables=new URLVariables();data.source=\"AS3-navigation\";data.score=total;\n        var request:URLRequest=new URLRequest(\"/__neoflash_web_receipt__\");request.data=data;\n        navigateToURL(request,\"neoflashReceipt\");webState=\"GET requested in the HTML receipt frame\";refresh();\n    }\n    public function sendReceipt():void{\n        var data:URLVariables=new URLVariables();data.source=\"AS3-sendToURL\";data.score=total;\n        var request:URLRequest=new URLRequest(\"/__neoflash_web_receipt__\");request.method=\"POST\";request.data=data;\n        sendToURL(request);webState=\"POST sent; sendToURL deliberately ignores the response\";refresh();\n    }\n    public function refresh():void{\n        status3.text=\"HTML calls \"+calls+\" / score \"+total+\"\\n\"+hostReply;\n        status2.text=\"Registered \"+legacyReady+\" / HTML calls \"+legacyCalls+\" / score \"+legacyTotal+\"\\n\"+legacyReply;\n        httpNote.text=webState+\"\\nLocal endpoint: /__neoflash_web_receipt__ (GET + URL-encoded POST).\";\n    }\n}\n}"
    }
  ]
}
