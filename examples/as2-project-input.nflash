  "sources": [
    {
      "id": "as2-source-base",
      "path": "app/Base.as",
      "language": "action_script2",
      "source": "class app.Base extends MovieClip {\n  public static var instances:Number = 0;\n  public static var total:Number = 0;\n  public var count:Number = 0;\n  public var homeX:Number = 0;\n  public function Base() {\n    super();\n    homeX = _x;\n    app.Base.instances++;\n  }\n  public function activate():Void {\n    count++;\n    app.Base.total++;\n    _x = homeX + count * 8;\n    caption.text = _name.toUpperCase() + \" / \" + count;\n    trace(\"AS2 component\", _name, count, app.Base.total);\n  }\n  public function resetCount():Void {\n    count = 0;\n    _x = homeX;\n    caption.text = _name.toUpperCase() + \" / \" + count;\n  }\n}"
    },
    {
      "id": "as2-source-widget",
      "path": "app/Widget.as",
      "language": "action_script2",
      "source": "import app.Base;\nclass app.Widget extends Base {\n  public function Widget() {\n    super();\n    stop();\n    caption.text = _name.toUpperCase() + \" / \" + count;\n  }\n  public function onPress():Void {\n    activate();\n  }\n}"
    },
    {
      "id": "as2-source-main",
      "path": "app/Main.as",
      "language": "action_script2",
      "source": "import app.Base;\nclass app.Main extends MovieClip {\n  public var keyEvents:Number = 0;\n  public var keyUps:Number = 0;\n  public var mouseEvents:Number = 0;\n  public var resizeEvents:Number = 0;\n  public function Main() {\n    super();\n    stop();\n    Key.addListener(this);\n    Mouse.addListener(this);\n    Stage.addListener(this);\n    statusMessage.text = \"Ready: two AS2 instances, shared total 0\";\n    trace(\"AS2 ready\", Base.instances, Base.total, Stage.width, Stage.height);\n  }\n  public function onKeyDown():Void {\n    keyEvents++;\n    if (Key.isDown(Key.LEFT)) _root.left.activate();\n    if (Key.isDown(Key.RIGHT)) _root.right.activate();\n    if (Key.getCode() == Key.SPACE) {\n      Base.total = 0;\n      _root.left.resetCount();\n      _root.right.resetCount();\n      trace(\"AS2 reset\", _root.left.count, _root.right.count, Base.total);\n    }\n    if (Key.getCode() == 72) Mouse.hide();\n    if (Key.getCode() == 83) Mouse.show();\n    statusMessage.text = \"Key \" + Key.getCode() + \" / ASCII \" + Key.getAscii() + \" / shared total \" + Base.total;\n  }\n  public function onKeyUp():Void {\n    keyUps++;\n    trace(\"AS2 key up\", Key.getCode(), Key.isDown(Key.getCode()));\n  }\n  public function onMouseDown():Void {\n    mouseEvents++;\n    statusMessage.text = \"Mouse events \" + mouseEvents + \" / shared total \" + Base.total;\n    trace(\"AS2 mouse\", mouseEvents);\n  }\n  public function onResize():Void {\n    resizeEvents++;\n    statusMessage.text = \"Logical Stage \" + Stage.width + \" x \" + Stage.height;\n    trace(\"AS2 stage\", Stage.width, Stage.height);\n  }\n}"
    }
  ]
}
