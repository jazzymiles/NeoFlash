                "label": ""
              }
            ]
          }
        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.filters.BlurFilter;import flash.filters.GlowFilter;import flash.filters.DropShadowFilter;import flash.filters.ColorMatrixFilter;\nthis.legacyCard=createEmptyMovieClip(\"legacyCard\",getNextHighestDepth());this.legacyCard._x=60;this.legacyCard._y=518;this.legacyCard.beginFill(0x54b7a5,100);this.legacyCard.moveTo(0,0);this.legacyCard.lineTo(918,0);this.legacyCard.lineTo(918,42);this.legacyCard.lineTo(0,42);this.legacyCard.lineTo(0,0);this.legacyCard.endFill();\nthis.legacyClicks=0;this.legacyCard.onPress=function(){_root.legacyClicks++;_root.legacyReport.text=\"AS2 clicks \"+_root.legacyClicks+\" / filter values are copies\";trace(\"filter AS2 click\",_root.legacyClicks);};\nthis.applyLegacy=function(value:Number){if(value==2){this.legacyCard.filters=[];}else{this.legacyCard.filters=[new DropShadowFilter(value==0?6:12,90,0x05100d,0.8,6,6,1,1,false,false,false),new GlowFilter(0x86f7d5,0.6,value==0?4:9,4,1,1,value==1,false)];}this.legacyReport.text=\"AS2 phase \"+value+\" / filters \"+this.legacyCard.filters.length+\" / clicks \"+this.legacyClicks;};this.applyLegacy(0);"
            }
          }
        ]
      }
    },
    {
      "id": "cycle-control",
      "name": "Cycle filter styles",
      "kind": "button",
      "timeline": {
        "frame_count": 1,
        "layers": [
