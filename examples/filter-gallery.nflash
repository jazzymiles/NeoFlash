                      "rotation": 0,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "text",
                      "text": "Cycle: original → alternate → clear → original. Restart restores fresh objects and callbacks.",
                      "font_family": "Arial",
                      "font_size": 14,
                      "color": [
                        159,
                        182,
                        197,
