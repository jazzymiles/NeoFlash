  "document_class": "app.PlatformMain",
  "sources": [
    {
      "id": "as2-platform-main",
      "path": "app/PlatformMain.as",
      "language": "action_script2",
      "source": "import mx.utils.Delegate;\nimport mx.events.EventDispatcher;\nclass app.PlatformMain extends MovieClip {\n  public var runs:Number = 0;\n  public var passed:Number = 0;\n  public var checks:Number = 0;\n  public var delegated:Number = 0;\n  public var imeText:String = \"\";\n  public var keyCaps:Boolean = false;\n  public function PlatformMain() {\n    super(); stop();\n    Key.addListener(this); System.IME.addListener(this);\n    runPackage();\n  }\n  public function check(name:String, value:Boolean):Void {\n    checks++; if(value) passed++;\n    trace(\"AS2_PLATFORM_CHECK \" + name + \" \" + value);\n  }\n  public function onDelegated(a:Number, b:Number):Number { delegated = a + b; return delegated; }\n  public function runPackage():Void {\n    runs++; passed = 0; checks = 0;\n    var c:Object = System.capabilities;\n    var booleanNames:Array = [\"avHardwareDisable\", \"hasAccessibility\", \"hasAudio\", \"hasAudioEncoder\", \"hasEmbeddedVideo\", \"hasIME\", \"hasMP3\", \"hasPrinting\", \"hasScreenBroadcast\", \"hasScreenPlayback\", \"hasStreamingAudio\", \"hasStreamingVideo\", \"hasVideoEncoder\", \"isDebugger\", \"localFileReadDisable\"];\n    var booleans:Boolean = true;\n    for(var i:Number = 0; i < booleanNames.length; i++) booleans = booleans && typeof c[booleanNames[i]] == \"boolean\";\n    check(\"capability flags\", booleans && !c.hasAudioEncoder && !c.hasVideoEncoder && c.localFileReadDisable);\n    check(\"capability metadata\", c.manufacturer == \"NeoFlash\" && c.playerType == \"NeoFlashHTML5\" && c.version.indexOf(\"NEO \") == 0 && c.language.length >= 2 && c.os.length > 0 && c.screenColor.length > 0 && c.screenDPI == 96 && c.pixelAspectRatio == 1 && c.screenResolutionX >= 0 && c.screenResolutionY >= 0 && c.serverString.indexOf(\"M=NeoFlash\") >= 0 && c.serverString.indexOf(\"PT=NeoFlashHTML5\") >= 0);\n    System.exactSettings = true; System.useCodepage = false;\n    var primitiveNumber:Number = -12.5; var primitiveBoolean:Boolean = true;\n    check(\"browser settings and global utilities\", System.exactSettings && !System.useCodepage && (System.security.sandboxType == \"remote\" || System.security.sandboxType == \"localWithNetwork\") && getVersion() == c.version && getTimer() >= 0 && primitiveNumber.valueOf() == -12.5 && primitiveBoolean.valueOf() == true);\n    var silentA:Sound = new Sound(); var silentB:Sound = new Sound();\n    silentA.setVolume(0); silentB.setVolume(0); silentA.stop(); stopAllSounds();\n    var callback:Function = Delegate.create(this, this.onDelegated);\n    check(\"delegate receiver and arguments\", callback(7, 9) == 16 && delegated == 16 && silentA.position == 0 && silentB.position == 0);\n    var source:Object = {};\n    EventDispatcher.initialize(source);\n    var receiver:Object = {hits:0, ping:function(event) { this.hits += event.amount; }};\n    source.addEventListener(\"ping\", receiver); source.addEventListener(\"ping\", receiver);\n    var event:Object = {type:\"ping\", amount:3}; source.dispatchEvent(event);\n    var first:Boolean = receiver.hits == 3 && event.target == source;\n    receiver.ping = function(event) { this.hits += event.amount * 2; };\n    source.dispatchEvent({type:\"ping\", amount:4}); source.removeEventListener(\"ping\", receiver);\n    source.dispatchEvent({type:\"ping\", amount:10});\n    check(\"component event lifecycle\", first && receiver.hits == 11);\n    source.addEventListener(\"ping\", callback); source.dispatchEvent({type:\"none\"});\n    source.removeEventListener(\"ping\", callback); EventDispatcher.initialize(source);\n    source.dispatchEvent({type:\"ping\", amount:10});\n    check(\"dispatcher reinitialization\", receiver.hits == 11);\n    var imeListener:Object = {onIMEComposition:function(text) { this.text = text; }};\n    System.IME.addListener(imeListener); System.IME.addListener(imeListener);\n    check(\"IME listener lifecycle\", System.IME.removeListener(imeListener) && !System.IME.removeListener(imeListener) && System.IME.UNKNOWN == \"UNKNOWN\" && System.IME.KOREAN == \"KOREAN\");\n    var listener:Object = {};\n    var before:Number = Key._listeners.length;\n    Key.addListener(listener); Key.addListener(listener);\n    var single:Boolean = Key._listeners.length == before + 1;\n    var removed:Boolean = Key.removeListener(listener);\n    Mouse.addListener(listener); var mouseRemoved:Boolean = Mouse.removeListener(listener);\n    Stage.addListener(listener); var stageRemoved:Boolean = Stage.removeListener(listener);\n    check(\"input singleton lifecycle\", single && removed && mouseRemoved && stageRemoved && Key._listeners.length == before && Key.isAccessible() && typeof Key.isToggled(Key.CAPSLOCK) == \"boolean\" && Key.BACKSPACE == 8 && Key.UP == 38 && Key.DELETEKEY == 46);\n    result.text = passed == checks ? \"PASS: AS2 platform package\" : \"FAIL: inspect the trace output\";\n    pipeline.text = c.manufacturer + \" / \" + c.os + \" / \" + c.language + \" / \" + c.screenResolutionX + \" x \" + c.screenResolutionY;\n    counts.text = passed + \" / \" + checks + \" grouped checks; run \" + runs;\n    updateAfterEvent();\n    trace(\"AS2_PLATFORM_RESULT \" + passed + \"/\" + checks);\n  }\n  public function onKeyDown():Void {\n    keyCaps = Key.isToggled(Key.CAPSLOCK);\n    casing.text = \"Key \" + Key.getCode() + \" / CapsLock \" + keyCaps;\n    trace(\"AS2_PLATFORM_KEY \" + Key.getCode() + \" \" + keyCaps);\n  }\n  public function onIMEComposition(text:String):Void {\n    imeText = text; codec.text = \"IME: \" + text;\n    trace(\"AS2_PLATFORM_IME \" + text);\n  }\n}\n"
    }
  ]
}
