        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.net.FileReference;\nimport flash.net.FileReferenceList;\nstop();\nvar selectedFile:FileReference = new FileReference();\nvar pickerList:FileReferenceList = new FileReferenceList();\nvar transferLog:String = \"\";\nvar selects:Number = 0;\nvar completions:Number = 0;\nvar uploadReply:String = \"\";\nvar fileListener:Object = new Object();\nfunction logFileBatch(message:String):Void {\n  transferLog = message + \"\\n\" + transferLog;\n  _root.fileStatus.text = transferLog.substr(0, 700);\n}\nfunction describeFileBatch(file:FileReference):Void {\n  selectedFile = file;\n  _root.fileDetails.text = \"Name: \" + file.name + \"\\nSize: \" + file.size + \" bytes; type: \" + file.type + \"\\nModified milliseconds: \" + (file.modificationDate == undefined ? \"not yet available\" : file.modificationDate.getTime());\n}\nfileListener.onSelect = function(file:FileReference):Void { selects++; describeFileBatch(file); logFileBatch(\"Selected \" + file.name + \"; selects=\" + selects); };\nfileListener.onCancel = function(file:FileReference):Void { logFileBatch(\"File dialog cancelled\"); };\nfileListener.onOpen = function(file:FileReference):Void { logFileBatch(\"Transfer opened: \" + file.name); };\nfileListener.onProgress = function(file:FileReference, loaded:Number, total:Number):Void { logFileBatch(\"Progress \" + loaded + \"/\" + total); };\nfileListener.onComplete = function(file:FileReference):Void { completions++; logFileBatch(\"Transfer complete \" + completions); };\nfileListener.onUploadCompleteData = function(file:FileReference, data:String):Void { uploadReply=data;logFileBatch(\"Server reply: \" + data);trace(\"AS2 file upload complete: \" + data); };\nfileListener.onHTTPError = function(file:FileReference, code:Number):Void { logFileBatch(\"HTTP error \" + code); };\nfileListener.onIOError = function(file:FileReference):Void { logFileBatch(\"File I/O error; inspect runtime diagnostic\"); };\nselectedFile.addListener(fileListener);\nvar listListener:Object = new Object();\nlistListener.onSelect = function(list:FileReferenceList):Void {\n  var files:Array = list.fileList;\n  if (files.length > 0) {\n    files[0].addListener(fileListener);\n    describeFileBatch(files[0]);\n    selects++;\n  }\n  logFileBatch(\"List selected \" + files.length + \" files; first file is ready for upload\");\n};\nlistListener.onCancel = function(list:FileReferenceList):Void { logFileBatch(\"Multiple-file dialog cancelled\"); };\npickerList.addListener(listListener);\nfunction chooseFileBatch():Void { selectedFile.browse([{description:\"Text files\", extension:\"*.txt;*.json\"}]); }\nfunction chooseListBatch():Void { pickerList.browse([{description:\"Text files\", extension:\"*.txt;*.json\"}]); }\nfunction uploadFileBatch():Void { selectedFile.postData=\"label=AS2+fixture&source=NeoFlash\";selectedFile.upload(\"/__as2_file_echo\"); }\nfunction downloadFileBatch():Void { var downloadFile:FileReference=new FileReference();downloadFile.addListener(fileListener);downloadFile.download(\"/__as2_file_fixture\", \"as2-downloaded-fixture.txt\"); }\nfunction cancelFileBatch():Void { selectedFile.cancel();logFileBatch(\"Active transfer cancelled\"); }"
            }
          }
        ]
      }
