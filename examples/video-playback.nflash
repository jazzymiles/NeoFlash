        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "var legacyConnection:NetConnection=new NetConnection();\nvar legacyStream:NetStream;\nvar legacyReady:Boolean=false;\nvar legacyPlays:Number=0;\nvar legacyCompleted:Number=0;\nvar legacyMetadata:Number=0;\nvar legacyDuration:Number=0;\nvar legacySource:String=\"media/motion.mp4\";\nvar legacyCode:String=\"Not connected\";\nvar legacyCommand:String=\"Ready for Play\";\nfunction legacyRefresh():Void {legacyStatus.text=legacyCommand+\"\\n\"+legacyCode+\"\\nMetadata \"+legacyMetadata+\" | duration \"+legacyDuration+\"s | ended \"+legacyCompleted;}\nfunction legacyPlay():Void {if(!legacyReady)return;legacyPlays++;legacySource=\"media/motion.mp4\";legacyCommand=\"Playing embedded MP4\";legacyStream.play(legacySource);legacyRefresh();}\nfunction legacyPause():Void {if(!legacyReady||legacyPlays==0)return;legacyStream.pause(true);legacyCommand=\"Paused\";legacyRefresh();}\nfunction legacySeek():Void {if(!legacyReady||legacyDuration==0)return;legacyStream.seek(2);legacyCommand=\"Seek to 2 seconds\";legacyRefresh();}\nfunction legacyResume():Void {if(!legacyReady||legacyPlays==0)return;legacyStream.pause(false);legacyCommand=\"Resumed\";legacyRefresh();}\nfunction legacyClose():Void {if(!legacyReady)return;legacyStream.close();legacyCommand=\"Closed / last frame retained\";legacyRefresh();}\nfunction legacyHTTP():Void {if(!legacyReady)return;legacyPlays++;legacySource=\"/video-fixture.mp4\";legacyCommand=\"HTTP source / local server required\";legacyStream.play(legacySource);legacyRefresh();}\nlegacyConnection.onStatus=function(info:Object):Void {\n if(info.code==\"NetConnection.Connect.Success\") {\n  legacyStream=new NetStream(legacyConnection);\n  legacyStream.onMetaData=function(info:Object):Void {legacyMetadata++;legacyDuration=info.duration;legacyRefresh();};\n  legacyStream.onStatus=function(info:Object):Void {legacyCode=info.code;if(info.code==\"NetStream.Play.Stop\")legacyCompleted++;if(info.level==\"error\")legacyCommand=\"HTTP unavailable? Use Play for embedded MP4.\";legacyRefresh();};\n  legacyVideo.attachVideo(legacyStream);legacyReady=true;legacyRefresh();\n }\n};\nlegacyConnection.connect(null);\n"
            }
          }
        ]
      }
