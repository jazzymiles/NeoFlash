  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.media.Video;\n import flash.media.SoundTransform;\n import flash.net.NetConnection;\n import flash.net.NetStream;\n import flash.events.NetStatusEvent;\n public dynamic class Main extends MovieClip {\n  public var connection:NetConnection;\n  public var stream:NetStream;\n  public var video:Video;\n  public var ready:Boolean=false;\n  public var plays:int=0;\n  public var completed:int=0;\n  public var metadataCount:int=0;\n  public var duration:Number=0;\n  public var lastCode:String=\"Not connected\";\n  public var command:String=\"Ready for Play\";\n  public function Main() {\n   stop();\n   this.eyebrow.selectable=false;this.title.selectable=false;this.instructions.selectable=false;\n   this.as3Heading.selectable=false;this.as2Heading.selectable=false;\n   this.as3Status.selectable=false;this.legacyStatus.selectable=false;this.note.selectable=false;\n   this.playButton.caption.selectable=false;this.pauseButton.caption.selectable=false;this.seekButton.caption.selectable=false;\n   this.resumeButton.caption.selectable=false;this.closeButton.caption.selectable=false;this.httpButton.caption.selectable=false;\n   video=new Video(320,180);video.name=\"createdVideo\";video.x=72;video.y=202;video.smoothing=true;addChild(video);\n   connection=new NetConnection();connection.addEventListener(NetStatusEvent.NET_STATUS,onConnection);connection.connect(null);\n  }\n  public function onConnection(event:NetStatusEvent):void {\n   if(event.info.code==\"NetConnection.Connect.Success\") {\n    stream=new NetStream(connection);stream.client=this;stream.soundTransform=new SoundTransform(0);\n    stream.addEventListener(NetStatusEvent.NET_STATUS,onStatus);video.attachNetStream(stream);ready=true;refresh();\n   }\n  }\n  public function onMetaData(info:Object):void {metadataCount++;duration=info.duration;refresh();}\n  public function onStatus(event:NetStatusEvent):void {\n   lastCode=event.info.code;if(lastCode==\"NetStream.Play.Stop\")completed++;refresh();\n  }\n  public function startVideo():void {if(!ready)return;plays++;command=\"Playing embedded MP4\";stream.play(\"media/motion.mp4\");refresh();}\n  public function pauseVideo():void {if(!ready||plays==0)return;stream.pause();command=\"Paused\";refresh();}\n  public function seekVideo():void {if(!ready||duration==0)return;stream.seek(2);command=\"Seek to 2 seconds\";refresh();}\n  public function resumeVideo():void {if(!ready||plays==0)return;stream.resume();command=\"Resumed\";refresh();}\n  public function closeVideo():void {if(!ready)return;stream.close();command=\"Closed / last frame retained\";refresh();}\n  public function refresh():void {\n   this.as3Status.text=command+\"\\n\"+lastCode+\"\\nMetadata \"+metadataCount+\" | duration \"+duration+\"s | ended \"+completed;\n  }\n }\n}"
    }
  ],
