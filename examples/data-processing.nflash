        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "var legacyDate:Date = new Date(Date.UTC(2026,9,27,9,30,0,0));\nfunction legacyAdvance(offset:Number):Void {\n    legacyDate.setTime(Date.UTC(2026,9,27,9,30,0,0));\n    legacyDate.setUTCDate(legacyDate.getUTCDate()+offset);\n    legacyStatus.text = \"UTC \" + legacyDate.getUTCFullYear() + \"-\" + (legacyDate.getUTCMonth()+1) + \"-\" + legacyDate.getUTCDate() + \"\\n09:30 / offset \" + offset + \" day(s)\\nTimestamp \" + legacyDate.getTime();\n}\nlegacyAdvance(0);\n"
            }
          }
        ]
      }
