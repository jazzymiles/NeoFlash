    {
      "id": "scene",
      "name": "Main",
      "kind": "movie_clip",
      "timeline": {
        "frame_count": 1,
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script3",
              "source": "import flash.events.Event;\nimport flash.events.KeyboardEvent;\nimport flash.ui.Keyboard;\n\nstop();\n\nvar playLeft:Number = 60;\nvar playTop:Number = 80;\nvar playRight:Number = 580;\nvar playBottom:Number = 440;\n\nvar paddleX:Number = 320;\nvar paddleY:Number = 416;\nvar paddleW:Number = 84;\nvar paddleH:Number = 14;\nvar paddleSpeed:Number = 12;\n\nvar ballX:Number = 320;\nvar ballY:Number = 398;\nvar ballVX:Number = 4;\nvar ballVY:Number = -6;\nvar ballRadius:Number = 7;\n\nvar brickCols:int = 6;\nvar brickRows:int = 4;\nvar brickW:Number = 76;\nvar brickH:Number = 20;\nvar brickStartX:Number = 110;\nvar brickStartY:Number = 120;\nvar brickStepX:Number = 84;\nvar brickStepY:Number = 28;\n\nvar bricksAlive:Array = [];\nvar bricksRemaining:int = 24;\nvar score:int = 0;\nvar lives:int = 3;\nvar level:int = 1;\nvar gameOver:Boolean = false;\nvar levelCleared:Boolean = false;\n\nfunction brickCenterX(index:int):Number {\n  var col:int = index % brickCols;\n  return brickStartX + col * brickStepX;\n}\n\nfunction brickCenterY(index:int):Number {\n  var row:int = int(Math.floor(index / brickCols));\n  return brickStartY + row * brickStepY;\n}\n\nfunction updateHud():void {\n  if (this.scoreText != null) {\n    this.scoreText.text = \"SCORE: \" + score;\n  }\n  if (this.livesText != null) {\n    this.livesText.text = \"LIVES: \" + lives;\n  }\n  if (this.levelText != null) {\n    this.levelText.text = \"LEVEL: \" + level;\n  }\n  if (this.statusText != null) {\n    if (gameOver) {\n      this.statusText.text = \"GAME OVER\";\n    } else if (levelCleared) {\n      this.statusText.text = \"LEVEL CLEARED!\";\n    } else {\n      this.statusText.text = \"IN PLAY\";\n    }\n  }\n}\n\nfunction syncPositions():void {\n  if (this.paddle != null) {\n    this.paddle.x = paddleX;\n    this.paddle.y = paddleY;\n  }\n  if (this.ball != null) {\n    this.ball.x = ballX;\n    this.ball.y = ballY;\n  }\n}\n\nfunction resetBallAndPaddle():void {\n  paddleX = 320;\n  paddleY = 416;\n  ballX = 320;\n  ballY = 398;\n  ballVX = 4;\n  ballVY = -6;\n  syncPositions();\n}\n\nfunction resetGame():void {\n  score = 0;\n  lives = 3;\n  level = 1;\n  gameOver = false;\n  levelCleared = false;\n  bricksRemaining = brickCols * brickRows;\n  bricksAlive = [];\n  var i:int = 0;\n  while (i < brickCols * brickRows) {\n    bricksAlive[i] = true;\n    var bClip:Object = this[\"brick\" + i];\n    if (bClip != null) {\n      bClip.visible = true;\n      bClip.x = brickCenterX(i);\n      bClip.y = brickCenterY(i);\n    }\n    i = i + 1;\n  }\n  resetBallAndPaddle();\n  updateHud();\n}\n\nfunction movePaddle(dx:Number):void {\n  if (gameOver || levelCleared) {\n    return;\n  }\n  var minX:Number = playLeft + paddleW / 2;\n  var maxX:Number = playRight - paddleW / 2;\n  paddleX = paddleX + dx;\n  if (paddleX < minX) {\n    paddleX = minX;\n  }\n  if (paddleX > maxX) {\n    paddleX = maxX;\n  }\n  syncPositions();\n}\n\nfunction stepGame():Boolean {\n  if (gameOver || levelCleared) {\n    return false;\n  }\n  ballX = ballX + ballVX;\n  ballY = ballY + ballVY;\n\n  if (ballX - ballRadius <= playLeft) {\n    ballX = playLeft + ballRadius;\n    ballVX = Math.abs(ballVX);\n  } else if (ballX + ballRadius >= playRight) {\n    ballX = playRight - ballRadius;\n    ballVX = -Math.abs(ballVX);\n  }\n\n  if (ballY - ballRadius <= playTop) {\n    ballY = playTop + ballRadius;\n    ballVY = Math.abs(ballVY);\n  }\n\n  if (ballVY > 0 && ballY + ballRadius >= paddleY - paddleH / 2 && ballY - ballRadius <= paddleY + paddleH / 2) {\n    if (ballX + ballRadius >= paddleX - paddleW / 2 && ballX - ballRadius <= paddleX + paddleW / 2) {\n      ballY = paddleY - paddleH / 2 - ballRadius;\n      ballVY = -Math.abs(ballVY);\n      var hitOffset:Number = (ballX - paddleX) / (paddleW / 2);\n      ballVX = hitOffset * 6;\n      if (Math.abs(ballVX) < 2) {\n        ballVX = (ballVX < 0) ? -2 : 2;\n      }\n    }\n  }\n\n  var i:int = 0;\n  while (i < brickCols * brickRows) {\n    if (bricksAlive[i]) {\n      var bx:Number = brickCenterX(i);\n      var by:Number = brickCenterY(i);\n      if (Math.abs(ballX - bx) <= (brickW / 2 + ballRadius) && Math.abs(ballY - by) <= (brickH / 2 + ballRadius)) {\n        bricksAlive[i] = false;\n        bricksRemaining = bricksRemaining - 1;\n        var bClip:Object = this[\"brick\" + i];\n        if (bClip != null) {\n          bClip.visible = false;\n        }\n        var row:int = int(Math.floor(i / brickCols));\n        score = score + (brickRows - row) * 10;\n        ballVY = -ballVY;\n        if (bricksRemaining <= 0) {\n          levelCleared = true;\n        }\n        break;\n      }\n    }\n    i = i + 1;\n  }\n\n  if (ballY - ballRadius > playBottom) {\n    lives = lives - 1;\n    if (lives <= 0) {\n      lives = 0;\n      gameOver = true;\n    } else {\n      resetBallAndPaddle();\n    }\n  }\n\n  syncPositions();\n  updateHud();\n  return true;\n}\n\nfunction onKeyDown(event:KeyboardEvent):void {\n  var code:uint = event.keyCode;\n  if (code == Keyboard.LEFT || code == 65) {\n    movePaddle(-paddleSpeed);\n  } else if (code == Keyboard.RIGHT || code == 68) {\n    movePaddle(paddleSpeed);\n  } else if (code == 82) {\n    resetGame();\n  }\n}\n\nfunction onTick(event:Event):void {\n  stepGame();\n}\n\nif (stage != null) {\n  stage.focus = this;\n  stage.addEventListener(KeyboardEvent.KEY_DOWN, onKeyDown);\n}\naddEventListener(Event.ENTER_FRAME, onTick);\n\nresetGame();\n"
            }
          }
        ],
