  "sources": [
    {
      "id": "source-main",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.utils.Dictionary;\n import flash.utils.getQualifiedClassName;\n import flash.utils.getQualifiedSuperclassName;\n import flash.utils.getDefinitionByName;\n import flash.utils.describeType;\n public dynamic class Main extends MovieClip {\n  public var items:Vector.<Item>;\n  public var cards:Vector.<InventoryCard>;\n  public var byCard:Dictionary;\n  public var batch:int=0;\n  public var total:int=0;\n  public var keyCount:int=0;\n  public var released:Boolean=false;\n  public var report:String;\n  public var history:Array;\n  public var removedHistory:String=\"\";\n  public var metadata:Object;\n  public var publicKeys:Array;\n  public var rootText:String;\n  public var converted:int;\n  public var wrapped:uint;\n  public var numericOK:Boolean;\n  public var enumerationOK:Boolean;\n  public var reflectionOK:Boolean;\n  public var describeGetterStable:Boolean;\n  public var modelType:String;\n  public var modelBase:String;\n  public var typeDescription:String;\n  public var foundationSummary:String;\n  public var identityOK:Boolean;\n  public var identityLabels:String;\n  public var classProbe:Item;\n  public var derivedProbe:DerivedRecord;\n  public var customToStringCalls:int;\n  public var arrayClass:Class;\n  public var arraySource:Array;\n  public var cachedPush:Function;\n  public var cachedPop:Function;\n  public var cachedSplice:Function;\n  public var cachedSlice:Function;\n  public var cachedSort:Function;\n  public var cachedMap:Function;\n  public var arrayBoundOK:Boolean;\n  public var arrayCrossClassOK:Boolean;\n  public var arrayHandlerOK:Boolean=false;\n  public var arrayCustomOK:Boolean;\n  public var arraySnapshot:String;\n  public var arrayPipeline:String;\n  public var arraySummary:String;\n  public var arrayOverrideCalls:int;\n  public function Main() {\n   super(); stop();\n   items=new Vector.<Item>(); cards=new Vector.<InventoryCard>(); byCard=new Dictionary();\n   history=[\"Ready\",\"Empty\"];\n   var Values:Class=Array;\n   arrayClass=Values;\n   arraySource=new Values(3,1,2);\n   cachedPush=arraySource.push; cachedPop=arraySource.pop;\n   cachedSplice=arraySource.splice; cachedSlice=arraySource.slice;\n   cachedSort=arraySource.sort; cachedMap=arraySource.map;\n   var records:Array=JSON.parse(\"[{\\\"sku\\\":\\\"INK\\\",\\\"label\\\":\\\"Ink cartridges\\\",\\\"quantity\\\":4},{\\\"sku\\\":\\\"PAPER\\\",\\\"label\\\":\\\"Print paper\\\",\\\"quantity\\\":6},{\\\"sku\\\":\\\"FILM\\\",\\\"label\\\":\\\"Animation film\\\",\\\"quantity\\\":3}]\");\n   for each(var record:Object in records) {\n    var item:Item=new Item(record.sku,record.label,record.quantity);\n    var card:InventoryCard=new InventoryCard();\n    items.push(item); cards.push(card); byCard[card]=item; addChild(card);\n   }\n   refresh();\n  }\n  public function processBatch():void {\n   batch++;\n   history.insertAt(0,\"Batch \"+batch);\n   removedHistory=String(history.removeAt(-1));\n   for each(var item:Item in items) item.quantity++;\n   var recycled:InventoryCard=cards.shift();\n   var shipped:Item=items.shift();\n   delete byCard[recycled]; released=!(recycled in byCard);\n   removeChild(recycled);\n   var incoming:Item=new Item(\"RESTOCK-\"+batch,\"Incoming batch \"+batch,batch+4);\n   items.push(incoming); cards.push(recycled); byCard[recycled]=incoming; addChild(recycled);\n   refresh();\n  }\n  public function inspectArrays():void {\n   var other:Array=[777];\n   var replaced:Array=cachedSplice.call(other,0,arraySource.length,items[0].quantity,items[1].quantity,items[2].quantity);\n   var inserted:uint=cachedPush.call(other,99);\n   var popped:*=cachedPop.apply(other,[]);\n   var sorted:*=cachedSort(Array.NUMERIC);\n   var snapshot:Array=cachedSlice.call(other);\n   var doubled:Array=cachedMap.apply(other,[function(value:*,index:int,owner:Array):* {return int(value)*2;}]);\n   arraySnapshot=snapshot.join(\",\"); arrayPipeline=doubled.join(\",\");\n   arrayCrossClassOK=(getDefinitionByName(\"Array\")===arrayClass);\n   arrayBoundOK=(replaced.length==3 && inserted==4 && popped==99 && sorted===arraySource && other.length==1 && other[0]==777);\n   arrayBoundOK=arrayBoundOK && cachedPush===arraySource.push && cachedPop===arraySource.pop && cachedSplice===arraySource.splice && cachedSlice===arraySource.slice && cachedSort===arraySource.sort && cachedMap===arraySource.map;\n   var overrideCalls:int=0;\n   arraySource.push=function(value:*):int {overrideCalls++;return 77;};\n   var capturedOverride:Function=arraySource.push;\n   arraySource.push=function(value:*):int {return 88;};\n   var overrideResult:int=capturedOverride(1);\n   cachedPush(99);\n   var retainedTail:*=cachedPop();\n   delete arraySource.push;\n   arrayOverrideCalls=overrideCalls;\n   arrayCustomOK=(overrideResult==77 && overrideCalls==1 && retainedTail==99 && cachedPush===arraySource.push);\n  }\n  public function refreshArrayReadout():void {\n   arraySummary=\"Arrays \"+(arrayBoundOK && arrayCrossClassOK && arrayHandlerOK && arrayCustomOK)+\" / sorted \"+arraySnapshot+\" / doubled \"+arrayPipeline;\n   detail.text=foundationSummary+\"\\n\"+modelType+\" / public keys: \"+publicKeys.join(\", \")+\" / recent: \"+history.join(\", \")+\"\\n\"+arraySummary;\n  }\n  public function inspectIdentity():void {\n   var ModelClass:Class=getDefinitionByName(\"app.Item\");\n   classProbe=new ModelClass(\"PROBE\",\"Constructor alias\",1);\n   derivedProbe=new DerivedRecord();\n   identityOK=(classProbe.constructor===Item && Item.prototype.isPrototypeOf(classProbe) && classProbe.valueOf()===classProbe);\n   identityOK=identityOK && DerivedRecord.prototype.isPrototypeOf(derivedProbe) && BaseRecord.prototype.isPrototypeOf(derivedProbe);\n   identityOK=identityOK && DerivedRecord.prototype.constructor===DerivedRecord && !BaseRecord.prototype.isPrototypeOf(classProbe) && !Item.prototype.isPrototypeOf(derivedProbe);\n   identityOK=identityOK && DerivedRecord.prototype.hasOwnProperty(\"constructor\") && !DerivedRecord.prototype.propertyIsEnumerable(\"constructor\");\n   var calls:int=0;\n   var custom:Object={toString:function():String {calls++;return \"custom\";}};\n   var localized:Object={toLocaleString:function():String {return \"local\";}};\n   identityLabels=classProbe.toString()+\" / \"+classProbe.toLocaleString()+\" / \"+custom.toString()+\" / \"+custom.toLocaleString()+\" / \"+localized.toLocaleString();\n   customToStringCalls=calls;\n   identityOK=identityOK && identityLabels==\"[object Item] / [object Item] / custom / [object Object] / local\" && customToStringCalls==1;\n   identityOK=identityOK && derivedProbe.toString()==\"[object DerivedRecord]\" && Item.toString()==\"[class Item]\";\n  }\n  public function inspectInventory():void {\n   var signedType:Class=int;\n   var unsignedType:Class=uint;\n   converted=new signedType(\"42.9\");\n   wrapped=new unsignedType(-1);\n   var squareRoot:Function=Math.sqrt;\n   var rootValue:Number=squareRoot(total);\n   var formatRoot:Function=rootValue.toFixed;\n   rootText=formatRoot(2);\n   numericOK=(converted==42 && wrapped==uint.MAX_VALUE && uint.MIN_VALUE==0 && int.MIN_VALUE==-2147483648 && int.MAX_VALUE==2147483647);\n   numericOK=numericOK && formatRoot.call(999,2)==rootText && formatRoot.apply(null,[2])==rootText;\n   metadata={count:items.length,quantity:total,batchNote:\"batch-\"+batch};\n   metadata.setPropertyIsEnumerable(\"batchNote\",false);\n   publicKeys=[];\n   for(var key:String in metadata) publicKeys.push(key);\n   publicKeys.sort();\n   enumerationOK=metadata.hasOwnProperty(\"batchNote\") && !metadata.propertyIsEnumerable(\"batchNote\") && (\"batchNote\" in metadata);\n   enumerationOK=enumerationOK && items[0].hasOwnProperty(\"quantity\") && !items[0].propertyIsEnumerable(\"quantity\");\n   modelType=getQualifiedClassName(items[0]);\n   modelBase=getQualifiedSuperclassName(items[0]);\n   var definition:Class=getDefinitionByName(\"app::Item\");\n   var getterReadsBefore:int=Item.getterReads;\n   typeDescription=describeType(items[0]).toXMLString();\n   describeGetterStable=(Item.getterReads==getterReadsBefore);\n   reflectionOK=(describeGetterStable && definition==Item && getDefinitionByName(\"app.Item\")==Item && modelType==\"app::Item\" && modelBase==\"Object\");\n   inspectIdentity();\n   inspectArrays();\n   foundationSummary=\"Math \"+numericOK+\" / sqrt \"+rootText+\" / objects \"+enumerationOK+\" / reflection \"+reflectionOK+\" / identity \"+identityOK;\n   trace(\"inventory foundation\",batch,rootText,numericOK,enumerationOK,reflectionOK,identityOK,history.join(\",\"));\n  }\n  public function refresh():void {\n   total=0; keyCount=0;\n   for each(var item:Item in items) total+=item.quantity;\n   for(var key:Object in byCard) {\n    var card:InventoryCard=InventoryCard(key);\n    card.bind(Item(byCard[key])); keyCount++;\n   }\n   for(var i:int=0;i<cards.length;i++) {cards[i].x=52;cards[i].y=190+i*110;}\n   inspectInventory();\n   report=JSON.stringify(items,null,2);\n   reportText.text=report;\n   summary.text=\"Batch \"+batch+\" / \"+items.length+\" typed models / \"+keyCount+\" identity keys / quantity \"+total;\n   refreshArrayReadout();\n   trace(\"typed inventory\",batch,items.length,keyCount,total,released,InventoryCard.created);\n  }\n }\n}"
    },
    {
      "id": "source-item",
      "path": "app/Item.as",
      "language": "action_script3",
      "source": "package app {\n public class Item {\n  public static var getterReads:int=0;\n  public var sku:String;\n  public var label:String;\n  public var quantity:int;\n  public function Item(sku:String,label:String,quantity:int) {this.sku=sku;this.label=label;this.quantity=quantity;}\n  public function get stockLabel():String {getterReads++;return sku+\": \"+quantity;}\n }\n}"
    },
    {
      "id": "source-card",
      "path": "app/InventoryCard.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n public class InventoryCard extends MovieClip {\n  public static var created:int=0;\n  public var item:Item;\n  public function InventoryCard() {super();stop();created++;}\n  public function bind(value:Item):void {\n   item=value;title.text=value.label;quantity.text=value.stockLabel;\n   bar.scaleX=Math.min(value.quantity,20)/20;\n  }\n }\n}"
    },
    {
      "id": "source-base-record",
      "path": "app/BaseRecord.as",
      "language": "action_script3",
      "source": "package app {\n public class BaseRecord {\n  public var marker:int=7;\n  public function BaseRecord() {}\n }\n}\n"
    },
    {
      "id": "source-derived-record",
      "path": "app/DerivedRecord.as",
      "language": "action_script3",
      "source": "package app {\n public class DerivedRecord extends BaseRecord {\n  public function DerivedRecord() {super();}\n }\n}\n"
    }
  ]
