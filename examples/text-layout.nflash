  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n    import flash.display.MovieClip;\n    import flash.text.TextField;\n    import flash.text.TextFormat;\n    import flash.text.TextFormatAlign;\n\n    public dynamic class Main extends MovieClip {\n        public var primaryCard:TextField;\n        public var fixedCard:TextField;\n        public var phase:int = 0;\n\n        public function Main() {\n            stop();\n            var format:TextFormat = new TextFormat(\"Arial\", 20, 0xeef7ff);\n            format.leading = 6;\n            format.align = TextFormatAlign.LEFT;\n            primaryCard = new TextField();\n            primaryCard.name = \"primaryCard\";\n            primaryCard.x = 64;\n            primaryCard.y = 234;\n            primaryCard.width = 340;\n            primaryCard.height = 160;\n            primaryCard.multiline = true;\n            primaryCard.wordWrap = true;\n            primaryCard.defaultTextFormat = format;\n            primaryCard.text = \"Draft: text flows inside a logical box.\";\n            primaryCard.replaceText(0, 6, \"Ready:\");\n            primaryCard.appendText(\"\\nThe transform scale stays at one.\");\n            addChild(primaryCard);\n\n            fixedCard = new TextField();\n            fixedCard.name = \"fixedCard\";\n            fixedCard.x = 504;\n            fixedCard.y = 234;\n            fixedCard.width = 340;\n            fixedCard.height = 160;\n            fixedCard.multiline = true;\n            fixedCard.wordWrap = true;\n            fixedCard.defaultTextFormat = format;\n            fixedCard.text = \"This card keeps its width and content while its neighbor changes.\\nCurrent color, bold and italic differ from the insertion default.\";\n            var current:TextFormat = new TextFormat();\n            current.color = 0xa4d4f5;\n            current.italic = true;\n            current.bold = true;\n            fixedCard.setTextFormat(current);\n            addChild(fixedCard);\n            updateStatus();\n            trace(\"text layout ready\", primaryCard.width, fixedCard.width, phase);\n        }\n\n        public function cycleLayout():void {\n            phase = (phase + 1) % 3;\n            var width:Number = 340;\n            var alignment:String = TextFormatAlign.LEFT;\n            if (phase == 1) {\n                width = 220;\n                alignment = TextFormatAlign.CENTER;\n            } else if (phase == 2) {\n                width = 300;\n                alignment = TextFormatAlign.RIGHT;\n            }\n            primaryCard.width = width;\n            var current:TextFormat = primaryCard.getTextFormat();\n            current.align = alignment;\n            primaryCard.setTextFormat(current);\n            updateStatus();\n            trace(\"text layout\", phase, width, alignment, primaryCard.numLines);\n        }\n\n        public function updateStatus():void {\n            var current:TextFormat = primaryCard.getTextFormat();\n            status.text = \"Width \" + primaryCard.width + \" | \" + current.align + \" | \" + primaryCard.numLines + \" lines | scale \" + primaryCard.scaleX;\n        }\n    }\n}\n"
    }
  ]
}
