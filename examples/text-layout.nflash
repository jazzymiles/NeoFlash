        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "var legacyFormat:TextFormat = new TextFormat(\"Arial\", 18, 0x2ad4a5);\nlegacyFormat.leading = 4;\nlegacyFormat.align = \"left\";\nvar legacyCard:TextField = this.createTextField(\"legacyCard\", this.getNextHighestDepth(), 64, 474, 788, 64);\nlegacyCard.multiline = true;\nlegacyCard.wordWrap = true;\nlegacyCard.setNewTextFormat(legacyFormat);\nlegacyCard.text = \"AS2 creates this card at the next available depth. Its current and default formats are independent of the AS3 cards.\";\nlegacyCard.setTextFormat(legacyFormat);\n"
            }
          }
        ]
      }
