        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.geom.Rectangle;\nthis.legacyPhase=0; this.legacyHits=0;\nthis.legacyPanel=this.createEmptyMovieClip(\"legacyPanel\",this.getNextHighestDepth());\nlegacyPanel._x=60; legacyPanel._y=580;\nlegacyPanel.beginFill(0xAC7AC4,100);legacyPanel.moveTo(0,0);legacyPanel.lineTo(520,0);legacyPanel.lineTo(520,64);legacyPanel.lineTo(0,64);legacyPanel.lineTo(0,0);legacyPanel.endFill();\nlegacyPanel.beginFill(0xE1B06B,100);legacyPanel.moveTo(150,0);legacyPanel.lineTo(220,0);legacyPanel.lineTo(220,64);legacyPanel.lineTo(150,64);legacyPanel.lineTo(150,0);legacyPanel.endFill();\nthis.legacyMask=this.createEmptyMovieClip(\"legacyMask\",this.getNextHighestDepth());\nlegacyMask._x=60;legacyMask._y=580;\nlegacyMask.beginFill(0,0);legacyMask.moveTo(0,0);legacyMask.lineTo(400,0);legacyMask.lineTo(360,64);legacyMask.lineTo(40,64);legacyMask.lineTo(0,0);legacyMask.endFill();\nthis.legacyAbsent=(legacyPanel.scrollRect===undefined);\nlegacyPanel.scrollRect=new Rectangle(0,0,450,64);\nthis.legacyMaskAccepted=legacyPanel.setMask(legacyMask);\nlegacyPanel.onPress=function(){this._root.legacyHits++;this._root.legacyStatus.text=\"AS2 clicks \"+this._root.legacyHits+\" / phase \"+this._root.legacyPhase;trace(\"clipping legacy click\",this._root.legacyHits);};\nthis.advanceLegacy=function(){\n this.legacyPhase=(this.legacyPhase+1)%3;\n if(this.legacyPhase==2){this.legacyPanel.setMask(null);this.legacyPanel.scrollRect=null;this.legacyAbsent=(this.legacyPanel.scrollRect===undefined);}\n else {this.legacyPanel.setMask(this.legacyMask);this.legacyPanel.scrollRect=new Rectangle(this.legacyPhase*55,0,450,64);}\n this.legacyStatus.text=\"AS2 phase \"+this.legacyPhase+\" / mask accepted \"+this.legacyMaskAccepted+\"\\nAbsent scrollRect is undefined: \"+this.legacyAbsent;\n trace(\"clipping legacy\",this.legacyPhase,this.legacyAbsent,this.legacyHits);\n};\nlegacyStatus.text=\"AS2 phase 0 / mask accepted \"+legacyMaskAccepted+\"\\nAbsent scrollRect is undefined: \"+legacyAbsent;\n"
            }
          }
        ]
      }
