  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip; import flash.display.Sprite; import flash.display.Shape;\n import flash.geom.Rectangle; import flash.geom.Point; import flash.display.GraphicsPathWinding;\n public class Main extends MovieClip {\n  public var viewport:Sprite; public var rightViewport:Sprite; public var aperture:Sprite;\n  public var panel:MaskedPanel; public var cards:Vector.<ScrollCard>; public var phase:int=0;\n  public var selected:int=0; public var panelHits:int=0; public var rectangleCopied:Boolean=false;\n  public var badMaskRejected:Boolean=false; public var badScrollRejected:Boolean=false;\n  public function Main(){\n   super();stop();viewport=new Sprite();viewport.name=\"viewport\";viewport.x=60;viewport.y=220;addChild(viewport);\n   cards=new Vector.<ScrollCard>();\n   for(var i:int=0;i<5;i++){var card:ScrollCard=new ScrollCard();card.name=\"card\"+i;card.index=i+1;card.caption.text=\"Card \"+(i+1);card.x=20+i*155;card.y=28;viewport.addChild(card);cards.push(card);}\n   var view:Rectangle=new Rectangle(0,0,450,230);viewport.scrollRect=view;view.x=900;rectangleCopied=(viewport.scrollRect.x==0);\n   var returned:Rectangle=viewport.scrollRect;returned.x=700;rectangleCopied=rectangleCopied&&viewport.scrollRect.x==0;\n   rightViewport=new Sprite();rightViewport.name=\"rightViewport\";rightViewport.x=590;rightViewport.y=220;rightViewport.scrollRect=new Rectangle(0,0,390,230);addChild(rightViewport);\n   panel=new MaskedPanel();panel.name=\"maskedPanel\";rightViewport.addChild(panel);\n   aperture=new Sprite();aperture.name=\"aperture\";aperture.x=590;aperture.y=220;addChild(aperture);\n   var hole:Shape=new Shape();hole.graphics.beginFill(0,0);\n   hole.graphics.drawPath([1,2,2,2,2,1,2,2,2,2],[20,20,200,20,200,210,20,210,20,20,70,70,145,70,145,145,70,145,70,70],GraphicsPathWinding.EVEN_ODD);hole.graphics.endFill();aperture.addChild(hole);\n   var circle:Shape=new Shape();circle.graphics.beginFill(0,0);circle.graphics.drawCircle(290,115,95);circle.graphics.endFill();aperture.addChild(circle);\n   panel.mask=aperture;\n   try{panel.mask=panel;}catch(error:*){badMaskRejected=true;}\n   try{viewport.scrollRect=new Rectangle(0.5,0,450,230);}catch(error:*){badScrollRejected=true;}\n   report();trace(\"clipping ready\",ScrollCard.created,cards.length,rectangleCopied,badMaskRejected,badScrollRejected);\n  }\n  public function advance():void{\n   phase=(phase+1)%3;viewport.scrollRect=new Rectangle(phase*155,0,450,230);\n   if(phase==2){panel.mask=null;rightViewport.scrollRect=null;}\n   else{panel.mask=aperture;aperture.x=590+phase*20;rightViewport.scrollRect=new Rectangle(phase*35,0,390,230);}\n   report();trace(\"clipping phase\",phase,ScrollCard.created,viewport.scrollRect.x,panel.mask==aperture);\n  }\n  public function report():void{\n   status.text=\"Phase \"+phase+\" / scroll \"+viewport.scrollRect.x+\" / masks \"+(panel.mask!=null)+\" / linked instances \"+ScrollCard.created;\n   selection.text=\"Selected card \"+selected+\" / panel clicks \"+panelHits+\" / rectangle copied \"+rectangleCopied+\" / invalid changes refused \"+(badMaskRejected&&badScrollRejected);\n  }\n }\n}"
    },
    {
      "id": "card-source",
      "path": "app/ScrollCard.as",
      "language": "action_script3",
      "source": "package app { import flash.display.MovieClip;import flash.events.MouseEvent;\n public class ScrollCard extends MovieClip { public static var created:int=0;public var index:int=0;public var hits:int=0;\n public function ScrollCard(){super();stop();created++;addEventListener(MouseEvent.CLICK,onClick);}\n public function onClick(event:MouseEvent):void{hits++;root.selected=index;root.report();trace(\"clipping card\",index,hits);}\n }}"
    },
    {
      "id": "panel-source",
      "path": "app/MaskedPanel.as",
      "language": "action_script3",
      "source": "package app { import flash.display.MovieClip;import flash.events.MouseEvent;\n public class MaskedPanel extends MovieClip {public function MaskedPanel(){super();stop();addEventListener(MouseEvent.CLICK,onClick);}\n public function onClick(event:MouseEvent):void{root.panelHits++;root.report();trace(\"clipping panel\",root.panelHits);}\n }}"
    }
  ]
}
