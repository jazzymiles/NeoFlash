  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n  import flash.display.MovieClip;\n  import flash.geom.Matrix;\n  import flash.geom.Point;\n  import flash.geom.Rectangle;\n  import flash.utils.Timer;\n  import flash.events.TimerEvent;\n  import flash.utils.getTimer;\n  public class Main extends MovieClip {\n    public var timer:Timer;\n    public var mapping:Matrix;\n    public var marker:MovieClip;\n    public var ticks:int = 0;\n    public function Main() {\n      super();\n      stop();\n      marker = getChildByName(\"marker\");\n      mapping = new Matrix(140, 36, 0, 1, 180, 220);\n      timer = new Timer(400, 4);\n      timer.addEventListener(TimerEvent.TIMER, onTick);\n      timer.addEventListener(TimerEvent.TIMER_COMPLETE, onComplete);\n      status.text = \"Running: 0 / 4 ticks\";\n      trace(\"geometry timer ready\", ticks, timer.currentCount);\n      timer.start();\n    }\n    public function onTick(event:TimerEvent):void {\n      ticks = timer.currentCount;\n      var next:Point = mapping.transformPoint(new Point(ticks, 0));\n      marker.x = next.x;\n      marker.y = next.y;\n      var bounds:Rectangle = marker.getBounds(this);\n      var world:Point = marker.localToGlobal(new Point(0, 0));\n      status.text = \"Running: \" + ticks + \" / 4 ticks\";\n      measurements.text = \"Global (\" + world.x + \", \" + world.y + \") | bounds \" + bounds.width + \" x \" + bounds.height + \" | elapsed \" + getTimer() + \" ms\";\n      trace(\"geometry tick\", ticks, next.x, next.y, bounds.width, bounds.height, world.x, world.y);\n    }\n    public function onComplete(event:TimerEvent):void {\n      status.text = \"Complete: \" + ticks + \" / 4 ticks. Restart to run again.\";\n      trace(\"geometry complete\", ticks, timer.currentCount, timer.running);\n    }\n  }\n}\n"
    }
  ]
}
