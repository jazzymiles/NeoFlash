      "source": "import mx.video.FLVPlayback;\nimport mx.video.VideoPlayer;\nimport mx.video.VideoError;\nclass app.MediaMain extends MovieClip {\n public var component:FLVPlayback;\n public var player:VideoPlayer;\n public var rawStream:NetStream;\n public var rawConnection:NetConnection;\n public var rawReady:Boolean=false;\n public var rawProbe:Number=0;\n public var rawTimer:Number=0;\n public var rawFps:Number=0;\n public var rawComplete:Number=0;\n public var checks:Number=0;\n public var passed:Number=0;\n public var readyCount:Number=0;\n public var playerReady:Boolean=false;\n public var componentReady:Boolean=false;\n public var initialSeek:Number=0;\n public var cueCount:Number=0;\n public var completeCount:Number=0;\n public var progressCount:Number=0;\n public var playheadCount:Number=0;\n public var finalReady:Boolean=false;\n public var closed:Boolean=false;\n public var controlChecks:Boolean=false;\n public function MediaMain(){\n  super();stop();\n  component=FLVPlayback.attach(componentVideo);player=VideoPlayer.attach(legacyVideo);\n  check(\"controller identity and errors\",component instanceof FLVPlayback&&component.getVideoPlayer(0) instanceof VideoPlayer&&VideoPlayer.attach(componentVideo)==component.getVideoPlayer(0)&&player instanceof VideoPlayer&&new VideoError(VideoError.INVALID_SEEK,\"bad seek\").code==1003&&FLVPlayback.PLAYING==\"playing\");\n  component.maintainAspectRatio=false;component.setSize(320,180);component.setScale(75,75);var scaled:Boolean=component.width==240&&component.height==135;component.setScale(100,100);component.x=72;component.y=202;component.visible=false;var hidden:Boolean=!component.visible;component.visible=true;\n  check(\"actual viewport size scale and visibility\",scaled&&hidden&&component.width==320&&component.height==180&&component.x==72&&component.y==202);\n  component.autoPlay=false;component.autoRewind=true;component.autoSize=false;component.maintainAspectRatio=true;component.playheadUpdateInterval=100;component.volume=0;player.volume=0;\n  check(\"functional playback settings\",!component.autoPlay&&component.autoRewind&&!component.autoSize&&component.maintainAspectRatio&&component.volume==0&&player.volume==0&&component.playheadUpdateInterval==100);\n  var events:Object={\n   ready:function(e:Object):Void{_root.componentLoaded();},\n   seek:function(e:Object):Void{_root.seekFinished(e);},\n   cuePoint:function(e:Object):Void{_root.cueCount++;trace(\"AS2_MEDIA_CUE \"+e.info.name+\" \"+e.info.time+\" \"+e.info.parameters.label);_root.refresh();},\n   complete:function(e:Object):Void{_root.completeCount++;trace(\"AS2_MEDIA_COMPLETE \"+_root.completeCount+\" cues=\"+_root.cueCount);_root.refresh();},\n   progress:function(e:Object):Void{_root.progressCount++;},\n   playheadUpdate:function(e:Object):Void{_root.playheadCount++;_root.refresh();},\n   stateChange:function(e:Object):Void{_root.refresh();}\n  };\n  component.addEventListener(\"ready\",events);component.addEventListener(\"seek\",events);component.addEventListener(\"cuePoint\",events);component.addEventListener(\"complete\",events);component.addEventListener(\"progress\",events);component.addEventListener(\"playheadUpdate\",events);component.addEventListener(\"stateChange\",events);\n  player.addEventListener(\"ready\",function(e:Object):Void{_root.playerLoaded();});\n  component.contentPath=\"media/motion.mp4\";player.load(\"media/motion.mp4\");\n  var parameters:Object={label:\"identity retained\"};var first:Object=component.addASCuePoint(0.5,\"mark\",parameters);component.addASCuePoint({time:1.5,name:\"mark\",parameters:parameters});component.addASCuePoint(1.5,\"alpha\");\n  var found:Object=component.findCuePoint(\"mark\");var next:Object=component.findNextCuePointWithName(found);\n  check(\"cue identity lookup and stable order\",first.parameters==parameters&&found.time==0.5&&next.time==1.5&&next.parameters==parameters&&component.findNearestCuePoint(2).name==\"alpha\");\n  var removed:Object=component.removeASCuePoint({time:1.5,name:\"alpha\"});\n  check(\"cue editing and snapshot continuation\",removed.name==\"alpha\"&&component.findCuePoint(\"alpha\")==null&&component.findNextCuePointWithName(next)==null);\n  check(\"cue milliseconds and explicit type filter\",component.findCuePoint(0.5004).time==0.5&&component.findCuePoint(\"mark\",FLVPlayback.NAVIGATION)==null&&component.findNearestCuePoint(0.1)==null);\n  rawConnection=new NetConnection();rawConnection.connect(null);rawStream=new NetStream(rawConnection);\n  rawStream.onMetaData=function(info:Object):Void{_root.rawLoaded(info);};\n  rawStream.onPlayStatus=function(info:Object):Void{_root.rawComplete++;_root.check(\"raw stream real completion\",info.code==\"NetStream.Play.Complete\"&&info.level==\"status\");trace(\"AS2_STREAM_COMPLETE \"+_root.rawComplete);};rawStream.setBufferTime(0.75);\n  rawVideo.smoothing=true;rawVideo.attachVideo(rawStream);rawStream.receiveAudio(false);rawStream.receiveVideo(false);rawStream.play(\"media/motion.mp4\");rawStream.pause(true);\n  check(\"raw receive controls and real buffering facts\",rawStream.bufferTime==0.75&&rawStream.currentFps==0&&rawStream.bufferLength>=0&&rawStream.bytesLoaded==rawStream.bytesTotal&&rawStream.bytesTotal>0&&rawVideo.smoothing);\n  refresh();\n }\n public function rawLoaded(info:Object):Void{\n  if(rawReady)return;rawReady=true;check(\"raw stream metadata and authored Video aliases\",info.width==320&&info.height==180&&rawVideo.videoWidth==320&&rawVideo.videoHeight==180&&rawStream.time>=0);rawVideo.clear();rawStream.receiveVideo(true);finishReady();\n }\n public function check(name:String,ok:Boolean):Void{checks++;if(ok)passed++;trace(\"AS2_MEDIA_CHECK \"+name+\" \"+ok);}\n public function componentLoaded():Void{\n  if(!componentReady){componentReady=true;check(\"metadata ready and byte progress\",component.metadataLoaded&&component.paused&&component.stateResponsive&&component.metadata.width==320&&component.metadata.height==180&&component.totalTime>3&&component.bytesLoaded==component.bytesTotal&&component.bytesTotal>0&&progressCount>0&&!component.isRTMP);initialSeek=1;component.seekPercent(50);}\n  refresh();\n }\n public function playerLoaded():Void{\n  if(!playerReady){playerReady=true;check(\"standalone VideoPlayer uses real metadata\",player.connected&&player.state==VideoPlayer.PAUSED&&player.videoWidth==320&&player.videoHeight==180&&player.metadata.duration==player.totalTime&&player.bytesTotal>0);}\n  finishReady();refresh();\n }\n public function seekFinished(event:Object):Void{\n  if(initialSeek==1){initialSeek=2;check(\"asynchronous percentage seek\",Math.abs(component.playheadPercentage-50)<1&&component.paused);component.seekSeconds(0);}\n  else if(initialSeek==2){initialSeek=3;check(\"backward seek and retained cues\",component.playheadTime<0.1&&component.findCuePoint(\"mark\").time==0.5&&component.getVideoPlayer(0).playheadTime==component.playheadTime);finishReady();}\n  else trace(\"AS2_MEDIA_SEEK \"+event.playheadTime+\" state=\"+component.state);\n  refresh();\n }\n public function finishReady():Void{if(!finalReady&&playerReady&&rawReady&&initialSeek==3){finalReady=true;trace(\"AS2_MEDIA_READY \"+passed+\"/\"+checks);}}\n public function playVideo():Void{if(!finalReady||closed)return;component.play();player.play();rawStream.pause(false);if(rawTimer==0){rawProbe=0;rawTimer=setInterval(this,\"streamSample\",250);}refresh();}\n public function pauseVideo():Void{if(closed)return;component.pause();player.pause();rawStream.pause(true);trace(\"AS2_MEDIA_PAUSED \"+component.state+\" \"+player.state);refresh();}\n public function seekVideo():Void{if(closed)return;component.seekSeconds(2);player.seek(2);rawStream.seek(2);}\n public function resumeVideo():Void{playVideo();}\n public function stopVideo():Void{if(closed)return;component.stop();player.stop();rawStream.pause(true);rawStream.seek(0);refresh();}\n public function closeOrLoad():Void{\n  if(!closed){component.getVideoPlayer(0).close();player.close();rawStream.close();if(rawTimer!=0){clearInterval(rawTimer);rawTimer=0;}closed=true;trace(\"AS2_MEDIA_CLOSED \"+component.state+\" \"+player.state);}\n  else{closed=false;component.contentPath=\"media/motion.mp4\";component.addASCuePoint(0.5,\"reloaded\",{label:\"fresh resource\"});player.load(\"media/motion.mp4\");rawStream.play(\"media/motion.mp4\");rawStream.pause(true);trace(\"AS2_MEDIA_RELOAD\");}\n  refresh();\n }\n public function streamSample():Void{\n  if(rawProbe==0&&rawStream.currentFps>0){rawFps=rawStream.currentFps;rawStream.receiveVideo(false);rawProbe=1;trace(\"AS2_STREAM_FROZEN fps=\"+rawStream.currentFps+\" time=\"+rawStream.time);}\n  else if(rawProbe==1){rawStream.receiveAudio(true);rawStream.receiveAudio(false);rawStream.receiveVideo(true);rawProbe=2;trace(\"AS2_STREAM_RESUMED\");}\n  else if(rawProbe==2&&rawStream.currentFps>0){check(\"raw stream actual FPS and freeze resume\",rawFps>0&&rawStream.bufferLength>=0&&rawStream.currentFps>0);clearInterval(rawTimer);rawTimer=0;trace(\"AS2_MEDIA_PLAYBACK \"+passed+\"/\"+checks+\" fps=\"+rawStream.currentFps);}\n }\n public function refresh():Void{\n  if(component==null||player==null)return;\n  as3Status.text=\"Checks \"+passed+\" / \"+checks+\" | \"+component.state+\"\\nTime \"+component.playheadTime+\" / \"+component.totalTime+\"s\\nCues \"+cueCount+\" | complete \"+completeCount+\" | updates \"+playheadCount;\n  legacyStatus.text=player.state+\"\\nTime \"+player.playheadTime+\" / \"+player.totalTime+\"s\\nViewport \"+player.width+\" × \"+player.height;\n }\n}\n"
    }
  ],
