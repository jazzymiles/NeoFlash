                        "single_frame": 0
                      }
                    },
                    "scripts": [],
                    "accessibility": {
                      "name": "AS2 card",
                      "description": "",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "object",
                    "name": "object",
                    "transform": {
                      "x": 150,
                      "y": 318,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "object-art",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "try { _root.card._visible = {}; } catch (error) { trace(\"unexpected AS2 catch\"); } finally { trace(\"AS2 finally\", _root.card._visible); } trace(\"unexpected continuation\");"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Unsupported object",
                      "description": "",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  },
                  {
                    "id": "numeric-text",
                    "name": "numeric-text",
                    "transform": {
                      "x": 420,
                      "y": 318,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "numeric-text-art",
                      "playback": {
                        "single_frame": 0
                      }
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "try { _root.card._visible = \"00\"; } catch (error) { trace(\"unexpected AS2 catch\"); } finally { trace(\"AS2 finally\", _root.card._visible); } trace(\"unexpected continuation\");"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Unsupported string",
                      "description": "",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  }
                ],
                "tween": null,
                "label": ""
              }
            ]
          }
        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "stop(); _root.card._visible = false; trace(\"ready; card hidden\");"
