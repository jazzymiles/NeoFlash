                    "transform": {
                      "x": 112,
                      "y": 164,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "card-art",
