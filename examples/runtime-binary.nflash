  "document_class": "app.BinaryExample",
  "sources": [
    {
      "id": "binary-example",
      "path": "app/BinaryExample.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.utils.ByteArray;\n public dynamic class BinaryExample extends MovieClip {\n  public var runs:int=0;\n  public var checks:Array;\n  public var failures:Array;\n  public var members:Array;\n  public function BinaryExample(){super();stop();runReuse();}\n  public function check(id:String,ok:Boolean,member:Boolean=true):void {\n   checks.push({id:id,pass:ok});if(!ok)failures.push(id);\n   if(member&&members.indexOf(id)<0)members.push(id);\n  }\n  public function runReuse():void {\n   runs++;checks=[];failures=[];members=[];\n   var payload:String=\"\";for(var i:int=0;i<40;i++)payload+=\"NeoFlash binary packet / Rust to HTML5. \";\n   var packed:ByteArray=new ByteArray();packed.writeUTFBytes(payload);var original:int=packed.length;\n   packed.position=7;packed.compress();var compressed:int=packed.length;\n   check(\"ByteArray.compress\",packed.position==packed.length&&compressed<original);\n   packed.uncompress();check(\"ByteArray.uncompress\",packed.position==0&&packed.toString()==payload);\n   packed.deflate();check(\"ByteArray.deflate\",packed.position==packed.length&&packed.length<original);\n   packed.inflate();check(\"ByteArray.inflate\",packed.position==0&&packed.toString()==payload);\n   var text:ByteArray=new ByteArray();text.writeMultiByte(\"café €\",\"iso-8859-1\");\n   check(\"ByteArray.writeMultiByte\",text.length==6&&text[3]==233&&text[5]==128);\n   text.position=0;check(\"ByteArray.readMultiByte\",text.readMultiByte(6,\"windows-1252\")==\"café €\"&&text.position==6);\n   var hex:ByteArray=new ByteArray();check(\"ByteArray.writeHexString\",hex.writeHexString(\"00017f80feff\")==6&&hex.position==6);\n   check(\"ByteArray.toHexString\",hex.toHexString()==\"00017F80FEFF\"&&hex.position==6);\n   check(\"ByteArray.toBase64\",hex.toBase64()==\"AAF/gP7/\"&&hex.position==6);\n   var decoded:ByteArray=new ByteArray();check(\"ByteArray.writeBase64\",decoded.writeBase64(hex.toBase64())==6&&decoded.toHexString()==hex.toHexString());\n   var fromBase:ByteArray=ByteArray.createFromBase64(\"TmVvRmxhc2g=\");\n   check(\"ByteArray.createFromBase64\",fromBase.toString()==\"NeoFlash\"&&fromBase.position==8);\n   var fromHex:ByteArray=ByteArray.createFromHexString(\"4E656F466C617368\");\n   check(\"ByteArray.createFromHexString\",fromHex.toString()==\"NeoFlash\"&&fromHex.position==8);\n   text.clear();text.writeMultiByte(\"🦀\\u0000tail\",\"utf-16be\");var length:int=text.length;text.position=0;\n   check(\"UTF16 and NUL consumption\",text.readMultiByte(length,\"utf-16be\")==\"🦀\"&&text.position==length,false);\n   var charsets:Array=[\"utf-8\",\"windows-1251\",\"shift_jis\",\"gbk\",\"big5\",\"euc-kr\",\"iso-2022-jp\"];\n   var samples:Array=[\"Привет\",\"Привет\",\"日本\",\"中文\",\"中文\",\"한국\",\"日本\"];\n   var pagesOK:Boolean=true;\n   for(var page:int=0;page<charsets.length;page++){\n    text.clear();text.writeMultiByte(samples[page],charsets[page]);text.position=0;\n    pagesOK=pagesOK&&text.readMultiByte(text.length,charsets[page])==samples[page]&&text.position==text.length;\n   }\n   check(\"Unicode and legacy codepage roundtrips\",pagesOK,false);\n   var before:String=hex.toHexString();var pos:int=hex.position;var refused:Boolean=false;\n   try{hex.uncompress();}catch(error:Error){refused=true;}\n   check(\"failed decompression preserves buffer\",refused&&hex.position==pos&&hex.toHexString()==before,false);\n   hex.position=0;refused=false;try{hex.writeHexString(\"123\");}catch(error:Error){refused=true;}\n   check(\"failed text codec preserves buffer\",refused&&hex.position==0&&hex.toHexString()==before,false);\n   result.text=(checks.length-failures.length)+\" / \"+checks.length+\" checks passed · run \"+runs;\n   pipeline.text=\"zlib: \"+original+\" → \"+compressed+\" bytes → original payload\";\n   casing.text=\"UTF8 · UTF16 · CP1251 · Shift_JIS · GBK · Big5 · EUC-KR\";\n   codec.text=\"Binary bytes: \"+hex.toHexString()+\" ⇄ \"+hex.toBase64();\n   counts.text=members.length+\" APIs · 6 legacy methods + 6 AIR 51 codecs\";\n   trace(\"AS3_BINARY_RESULT \"+JSON.stringify({run:runs,checks:checks.length,passed:checks.length-failures.length,failed:failures.length,members:members,newMembers:12,catalogEntries:4,uncatalogued:8,converted:5,codecFamilies:38,newCodecFamilies:34,failures:failures}));\n  }\n }\n}\n"
    }
  ]
}
