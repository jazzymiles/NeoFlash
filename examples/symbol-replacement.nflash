            "script": {
              "language": "java_script",
              "source": "let stale = false;\ntry { this.savedCard.x; } catch (error) { stale = true; }\nconst card = this.card, nested = card.nested, leaf = nested.leaf;\ntrace(\"swap\", \"V=\" + [card.visible, nested.visible, leaf.visible].join(\"/\"), \"X=\" + [card.x, nested.x, leaf.x].join(\"/\"), \"customClear=\" + (card.score === undefined && nested.score === undefined && leaf.score === undefined), \"F=\" + [card.currentFrame, nested.currentFrame].join(\"/\"), \"newRefs=\" + (card !== this.savedCard && nested !== this.savedNested && leaf !== this.savedLeaf), \"stale=\" + stale, \"loads=\" + [this.cardLoads, this.nestedLoads, this.leafLoads].join(\"/\"), \"sibling=\" + [this.sibling.nested.visible, this.sibling.nested.x, this.sibling.score].join(\"/\"));"
            }
