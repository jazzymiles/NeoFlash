                          "language": "java_script",
                          "source": "const root = this.root;\nroot.savedCard = root.card;\nroot.savedNested = root.card.nested;\nroot.savedLeaf = root.card.nested.leaf;\nroot.card.gotoAndStop(7);\nroot.card.nested.gotoAndStop(9);\nroot.card.visible = false; root.card.x = 330; root.card.score = 99;\nroot.card.nested.visible = false; root.card.nested.x = 77; root.card.nested.score = 98;\nroot.card.nested.leaf.visible = false; root.card.nested.leaf.x = 55; root.card.nested.leaf.score = 97;\nroot.sibling.score = 8; root.sibling.nested.visible = false; root.sibling.nested.x = 31;\ntrace(\"armed\", \"V=\" + [root.card.visible, root.card.nested.visible, root.card.nested.leaf.visible].join(\"/\"), \"X=\" + [root.card.x, root.card.nested.x, root.card.nested.leaf.x].join(\"/\"), \"F=\" + [root.card.currentFrame, root.card.nested.currentFrame].join(\"/\"), \"sibling=false/31/8\");"
                        }
