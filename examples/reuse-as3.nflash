  "sources": [
    {
      "id": "source-main",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.geom.Vector3D;\n import flash.geom.Matrix3D;\n import flash.geom.Utils3D;\n public dynamic class Main extends MovieClip {\n  public var checks:Array;\n  public var api:Array;\n  public var failures:Array;\n  public var step:int=0;\n  public var pose:Matrix3D;\n  public function Main(){super();stop();run();}\n  public function near(a:Number,b:Number):Boolean{return Math.abs(a-b)<0.0001;}\n  public function xyz(v:Vector3D,x:Number,y:Number,z:Number):Boolean{return near(v.x,x)&&near(v.y,y)&&near(v.z,z);}\n  public function check(id:String,ok:Boolean,members:String):void {\n   checks.push({id:id,pass:ok});\n   if(!ok)failures.push(id);\n   var names:Array=members.split(\",\");\n   for each(var name:String in names){if(name.length>0&&api.indexOf(name)<0)api.push(name);}\n  }\n  public function run():void {\n   checks=[];api=[];failures=[];step=0;\n   var a:Vector3D=new Vector3D(3,4,0,8);\n   var b:Vector3D=new Vector3D(1,2,3,9);\n   check(\"vector length\",near(a.length,5)&&near(a.lengthSquared,25),\"Vector3D.length,Vector3D.lengthSquared\");\n   var c:Vector3D=a.add(b);check(\"add ignores w\",xyz(c,4,6,3)&&c.w==0,\"Vector3D.add,Vector3D.x,Vector3D.y,Vector3D.z,Vector3D.w\");\n   c=a.subtract(b);check(\"subtract\",xyz(c,2,2,-3),\"Vector3D.subtract\");\n   check(\"dot product\",a.dotProduct(b)==11,\"Vector3D.dotProduct\");\n   c=a.crossProduct(b);check(\"cross product\",xyz(c,12,-9,2)&&c.w==1,\"Vector3D.crossProduct\");\n   check(\"static distance\",Vector3D.distance(new Vector3D(),a)==5,\"Vector3D.distance\");\n   check(\"axis angle\",near(Vector3D.angleBetween(Vector3D.X_AXIS,Vector3D.Y_AXIS),Math.PI/2)&&Vector3D.Z_AXIS.z==1,\"Vector3D.angleBetween\");\n   c=a.clone();check(\"clone and equals\",c.equals(a,true)&&c!=a,\"Vector3D.clone,Vector3D.equals\");\n   check(\"near equals\",c.nearEquals(new Vector3D(3.00001,4,0),0.001),\"Vector3D.nearEquals\");\n   check(\"normalize returns length\",near(c.normalize(),5)&&xyz(c,0.6,0.8,0)&&c.w==8,\"Vector3D.normalize\");\n   c=new Vector3D(1,2,3,7);c.incrementBy(b);check(\"increment retains w\",xyz(c,2,4,6)&&c.w==7,\"Vector3D.incrementBy\");\n   c.decrementBy(b);check(\"decrement\",xyz(c,1,2,3),\"Vector3D.decrementBy\");\n   c.copyFrom(a);check(\"copyFrom retains w\",xyz(c,3,4,0)&&c.w==7,\"Vector3D.copyFrom\");\n   c.setTo(6,8,10);c.w=2;c.project();check(\"project\",xyz(c,3,4,5)&&c.w==2,\"Vector3D.setTo,Vector3D.project\");\n   c.scaleBy(2);c.negate();check(\"scale and negate\",xyz(c,-6,-8,-10)&&c.w==2,\"Vector3D.scaleBy,Vector3D.negate\");\n   c.x=1;c.y=2;c.z=3;c.w=4;check(\"component setters and string\",c.toString()==\"Vector3D(1, 2, 3)\"&&c.w==4,\"Vector3D.toString\");\n   var m:Matrix3D=new Matrix3D();\n   var raw:Vector.<Number> =m.rawData;check(\"typed rawData\",raw.length==16&&raw[0]==1&&raw[15]==1,\"Matrix3D.rawData\");\n   m.appendScale(2,3,4);m.appendTranslation(10,20,30);\n   c=m.transformVector(new Vector3D(1,2,3,99));check(\"scaled translated point\",xyz(c,12,26,42)&&c.w==1,\"Matrix3D.appendScale,Matrix3D.appendTranslation,Matrix3D.transformVector\");\n   c=m.deltaTransformVector(new Vector3D(1,2,3));check(\"delta ignores translation\",xyz(c,2,6,12)&&c.w==0,\"Matrix3D.deltaTransformVector\");\n   check(\"determinant\",m.determinant==24,\"Matrix3D.determinant\");\n   var inverse:Matrix3D=m.clone();var inverted:Boolean=inverse.invert();c=inverse.transformVector(new Vector3D(12,26,42));check(\"inverse round trip\",inverted&&xyz(c,1,2,3),\"Matrix3D.clone,Matrix3D.invert\");\n   var p:Vector3D=m.position;check(\"position copy\",xyz(p,10,20,30)&&p.w==0,\"Matrix3D.position\");\n   inverse.identity();inverse.position=new Vector3D(7,8,9);check(\"identity and position setter\",inverse.determinant==1&&xyz(inverse.position,7,8,9),\"Matrix3D.identity\");\n   inverse.copyFrom(m);check(\"copyFrom\",inverse.determinant==24,\"Matrix3D.copyFrom\");\n   var copied:Matrix3D=new Matrix3D();m.copyToMatrix3D(copied);check(\"copyToMatrix3D\",xyz(copied.position,10,20,30),\"Matrix3D.copyToMatrix3D\");\n   var scale:Matrix3D=new Matrix3D();scale.appendScale(2,2,2);var translation:Matrix3D=new Matrix3D();translation.appendTranslation(3,4,5);\n   copied=scale.clone();copied.append(translation);c=copied.transformVector(new Vector3D(1,1,1));check(\"append order\",xyz(c,5,6,7),\"Matrix3D.append\");\n   copied=scale.clone();copied.prepend(translation);c=copied.transformVector(new Vector3D(1,1,1));check(\"prepend order\",xyz(c,8,10,12),\"Matrix3D.prepend\");\n   copied.identity();copied.prependScale(2,3,4);copied.prependTranslation(1,2,3);check(\"prepend scale translation\",xyz(copied.position,2,6,12),\"Matrix3D.prependScale,Matrix3D.prependTranslation\");\n   copied.identity();copied.appendRotation(90,Vector3D.Z_AXIS);check(\"rotation\",xyz(copied.transformVector(Vector3D.X_AXIS),0,1,0),\"Matrix3D.appendRotation\");\n   copied.identity();copied.prependRotation(90,Vector3D.Z_AXIS,new Vector3D(1,0,0));check(\"pivot rotation\",xyz(copied.transformVector(new Vector3D(2,0,0)),1,1,0),\"Matrix3D.prependRotation\");\n   copied.identity();copied.copyColumnFrom(3,new Vector3D(4,5,6,1));c=new Vector3D();copied.copyColumnTo(3,c);check(\"column copy\",xyz(c,4,5,6)&&c.w==1,\"Matrix3D.copyColumnFrom,Matrix3D.copyColumnTo\");\n   copied.copyRowFrom(0,new Vector3D(2,3,4,5));copied.copyRowTo(0,c);check(\"row copy\",xyz(c,2,3,4)&&c.w==5,\"Matrix3D.copyRowFrom,Matrix3D.copyRowTo\");\n   copied.transpose();raw=copied.rawData;check(\"transpose\",raw[0]==2&&raw[1]==3&&raw[2]==4&&raw[3]==5,\"Matrix3D.transpose\");\n   var buffer:Vector.<Number> =new Vector.<Number>();buffer.push(99);m.copyRawDataTo(buffer,1,true);copied.copyRawDataFrom(buffer,1,true);check(\"raw copy transpose\",copied.determinant==24&&xyz(copied.position,10,20,30),\"Matrix3D.copyRawDataTo,Matrix3D.copyRawDataFrom\");\n   raw=m.rawData;copied.rawData=raw;check(\"rawData setter\",copied.determinant==24,\"\");\n   var input:Vector.<Number> =new Vector.<Number>();input.push(1,2,3,0,0,0);var output:Vector.<Number> =new Vector.<Number>();m.transformVectors(input,output);check(\"bulk vectors\",output.length==6&&output[0]==12&&output[1]==26&&output[2]==42&&output[3]==10&&output[4]==20&&output[5]==30,\"Matrix3D.transformVectors\");\n   var projection:Matrix3D=new Matrix3D();raw=projection.rawData;raw[11]=0.25;projection.rawData=raw;\n   c=Utils3D.projectVector(projection,new Vector3D(8,4,4));check(\"homogeneous projection\",xyz(c,4,2,2)&&c.w==2,\"Utils3D.projectVector\");\n   var vertices:Vector.<Number> = new Vector.<Number>();vertices.push(8,4,4,6,3,8);\n   var projected:Vector.<Number> = new Vector.<Number>();var uvts:Vector.<Number> = new Vector.<Number>();uvts.push(0.1,0.2,0,0.3,0.4,0);\n   Utils3D.projectVectors(projection,vertices,projected,uvts);check(\"bulk projection and UVT\",projected.length==4&&projected[0]==4&&projected[1]==2&&projected[2]==2&&projected[3]==1&&near(uvts[0],0.1)&&near(uvts[2],0.5)&&near(uvts[5],1/3),\"Utils3D.projectVectors\");\n   var diagnosed:Boolean=false;try{m.decompose();}catch(error:Error){diagnosed=error.message.indexOf(\"unsupported\")>=0;}check(\"unsupported diagnostic\",diagnosed,\"\");\n   pose=new Matrix3D();pose.appendTranslation(130,390,0);refresh();\n  }\n  public function advance():void {step++;pose.prependRotation(20,Vector3D.Z_AXIS);refresh();}\n  public function refresh():void {\n   var point:Vector3D=Utils3D.projectVector(pose,new Vector3D(90,0,0));marker.x=point.x;marker.y=point.y;marker.rotation=step*20;\n   heading.text=\"Rust geometry / \"+(checks.length-failures.length)+\" of \"+checks.length+\" checks\";\n   summary.text=api.length+\" unique methods + properties executed \u00b7 2 constructors \u00b7 3 axis constants\\nStep \"+step+\" \u00b7 transformed point (\"+point.x.toFixed(1)+\", \"+point.y.toFixed(1)+\")\";\n   details.text=failures.length==0?\"PASS \u00b7 vectors, typed data, transforms, composition, inverse, pivot rotation, projection\\nAll geometry calculations and values are owned by Rust/WASM.\":\"FAILURES: \"+failures.join(\", \");\n   trace(\"AS3_REUSE_RESULT \"+JSON.stringify({checks:checks.length,passed:checks.length-failures.length,failed:failures.length,apiMembers:api.length,members:api,constructors:2,constants:3,step:step,failures:failures}));\n  }\n }\n}\n"
    }
  ]
}
