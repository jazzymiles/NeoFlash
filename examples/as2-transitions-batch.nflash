        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import mx.transitions.TransitionManager;\nimport mx.transitions.Transition;\nimport mx.transitions.Fade;\nimport mx.transitions.Fly;\nimport mx.transitions.Rotate;\nimport mx.transitions.Zoom;\nimport mx.transitions.Squeeze;\nimport mx.transitions.easing.None;\nimport mx.transitions.easing.Regular;\nimport mx.transitions.easing.Strong;\nimport mx.transitions.easing.Bounce;\nimport mx.transitions.easing.Back;\nimport mx.transitions.easing.Elastic;\nstop();\nvar transitionClips:Array = [];\nvar transitionManagers:Array = [];\nvar transitionTypes:Array = [Fade, Fly, Rotate, Zoom, Squeeze];\nvar transitionCurves:Array = [None.easeNone, Regular.easeInOut, Strong.easeInOut, Bounce.easeOut, Elastic.easeOut];\nvar transitionRunning:Boolean = false;\nvar transitionInCount:Number = 0;\nvar transitionOutCount:Number = 0;\nvar transitionChecks:Number = 0;\nvar transitionFailures:Number = 0;\nfunction transitionCheck(label:String, ok:Boolean):Void {\n if (ok) { transitionChecks++; } else { transitionFailures++; }\n transitionDetails.text += (ok ? \"PASS  \" : \"FAIL  \") + label + \"\\n\";\n transitionStatus.text = \"AS2_TRANSITIONS_RESULT \" + transitionChecks + \" passed / \" + transitionFailures + \" failed\";\n trace(\"AS2_TRANSITIONS \" + label + \" \" + ok);\n}\nfor (var transitionIndex:Number = 0; transitionIndex < 5; transitionIndex++) {\n var transitionClip:MovieClip = createEmptyMovieClip(\"transitionCard\" + transitionIndex, getNextHighestDepth());\n transitionClip._x = 130 + transitionIndex * 200;\n transitionClip._y = 300;\n transitionClip.beginFill(0x40bba4 + transitionIndex * 0x190500);\n transitionClip.moveTo(-55,-45);transitionClip.lineTo(55,-45);transitionClip.lineTo(55,45);transitionClip.lineTo(-55,45);transitionClip.lineTo(-55,-45);transitionClip.endFill();\n transitionClip.beginFill(0xffffff);transitionClip.moveTo(-16,-18);transitionClip.lineTo(25,0);transitionClip.lineTo(-16,18);transitionClip.lineTo(-16,-18);transitionClip.endFill();\n transitionClips.push(transitionClip);\n var transitionManager:TransitionManager = new TransitionManager(transitionClip);\n transitionManager.addEventListener(\"allTransitionsInDone\", function(event:Object):Void {\n  transitionInCount++;\n  if (transitionInCount == 5) {\n   var restored:Boolean = true;\n   for(var k:Number=0;k<5;k++) { restored = restored && transitionClips[k]._visible && transitionClips[k]._xscale == 100 && transitionClips[k]._yscale == 100 && transitionClips[k]._alpha == 100 && transitionClips[k]._rotation == 0 && transitionClips[k]._x == 130+k*200; }\n   transitionCheck(\"five IN effects finish at saved appearance\", restored);\n   startTransitionOut();\n  }\n });\n transitionManager.addEventListener(\"allTransitionsOutDone\", function(event:Object):Void {\n  transitionOutCount++;\n  if (transitionOutCount == 5) {\n   var hidden:Boolean = true;\n   for(var k:Number=0;k<5;k++) { hidden = hidden && !transitionClips[k]._visible && transitionClips[k]._xscale == 100 && transitionClips[k]._alpha == 100; }\n   transitionCheck(\"five OUT effects hide and restore for replay\", hidden);\n   transitionRunning=false;\n  }\n });\n transitionManagers.push(transitionManager);\n}\ntransitionCheck(\"manager snapshot + existing easing classes\", transitionManagers[0].content == transitionClips[0] && transitionManagers[0].contentAppearance._x == 130 && transitionManagers[0].contentAppearance._innerBounds.xMin == -55 && transitionManagers[0].toString() == \"[TransitionManager]\" && Back.easeOut(1,0,1,1) == 1);\nfunction transitionParams(i:Number,direction:Number):Object { return {type:transitionTypes[i], direction:direction, duration:2.4, easing:transitionCurves[i], startPoint:1, degrees:720, dimension:1}; }\nfunction runTransitionsBatch():Void {\n if(transitionRunning) { return; }\n transitionRunning=true;transitionInCount=0;transitionOutCount=0;\n for(var i:Number=0;i<5;i++) { var effect:Transition = TransitionManager.start(transitionClips[i],transitionParams(i,Transition.IN)); }\n transitionStatus.text=\"Five live transitions IN, then OUT...\";\n}\nfunction startTransitionOut():Void {\n for(var i:Number=0;i<5;i++) { transitionManagers[i].startTransition(transitionParams(i,Transition.OUT)); }\n}\n"
            }
          }
        ]
      }
    },
