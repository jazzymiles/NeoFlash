                  },
                  {
                    "id": "as2",
                    "name": "as2",
                    "transform": {
                      "x": 32,
                      "y": 192,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "as2-art",
                      "playback": "independent"
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "var lines = new Array(\"Ada,30\", \"zoe,15\", \"Bob,20\");\nvar records = Array();\nfor (var i = 0; i < lines.length; i++) {\n    var parts = lines[i].split(\",\");\n    records.push({name:parts[0], score:Number(parts[1])});\n}\nvar original = records;\nvar removed = records.splice(1, 1, {name:\"Zoe\", score:45});\nrecords.unshift({name:\"Ann\", score:25});\nvar first = records.shift();\nrecords.push({name:\"Cy\", score:10});\nvar last = records.pop();\nvar preview = records.slice(0, 2);\nvar order = records.sortOn([\"score\", \"name\"], [Array.NUMERIC | Array.DESCENDING | Array.RETURNINDEXEDARRAY, Array.CASEINSENSITIVE]);\nvar unchanged = records[0].name;\nvar sorted = records.sortOn(\"score\", Array.NUMERIC | Array.DESCENDING);\nvar labels = new Array();\nfor (var j = 0; j < records.length; j++) labels.push(records[j].name + \":\" + records[j].score);\nvar numeric = new Array(30, 2, 11);\nnumeric.sort(Array.NUMERIC);\nvar duplicate = new Array(\"echo\", \"echo\");\nvar unique = duplicate.sort(Array.UNIQUESORT);\nvar copy = labels.concat([\"end\"]);\nvar reversed = copy.reverse();\nrecords.sort = function(flags) { return \"custom:\" + flags; };\nvar custom = records.sort(Array.NUMERIC);\nresult = labels.join(\"|\");\ntrace(\"AS2\", result, \"order\", order.join(\",\"), \"numbers\", numeric.join(\",\"));\n_root.as2Result.text = labels.join(\"\\n\");\n_root.as2Result.textColor = 7396858;"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Run AS2 leaderboard",
                      "description": "Run the leaderboard data-processing scenario and show its transcript.",
                      "role": "button",
                      "tab_order": 32,
                      "disabled": false
                    }
                  },
                  {
                    "id": "as3",
                    "name": "as3",
                    "transform": {
                      "x": 416,
                      "y": 192,
                      "rotation": 0,
                      "scale_x": 1,
                      "scale_y": 1,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "as3-art",
                      "playback": "independent"
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script3",
                          "source": "var lines:Array = new Array(3);\nlines[0] = \"Ada,30\"; lines[1] = \"zoe,15\"; lines[2] = \"Bob,20\";\nvar records:Array = lines.map(function(line:*, index:int, source:Array):Object {\n    var parts:Array = line.split(\",\");\n    return {name:parts[0], score:Number(parts[1])};\n});\nrecords.splice(1, 1, {name:\"Zoe\", score:45});\nrecords.push({name:\"Cy\", score:10});\nvar selected:Array = records.filter(function(item:Object, index:int, source:Array):Boolean { return item.score >= 20; });\nvar order:Array = selected.sortOn([\"score\", \"name\"], [Array.NUMERIC | Array.DESCENDING | Array.RETURNINDEXEDARRAY, Array.CASEINSENSITIVE]);\nvar unchanged:String = selected[0].name;\nselected.sortOn(\"score\", Array.NUMERIC | Array.DESCENDING);\nvar labels:Array = selected.map(function(item:Object, index:int, source:Array):String { return item.name + \":\" + item.score; });\nvar total:int = 0;\nvar eachResult:* = selected.forEach(function(item:Object, index:int, source:Array):void { total += item.score; });\nvar all:Boolean = selected.every(function(item:Object, index:int, source:Array):Boolean { return item.score >= 20; });\nvar any:Boolean = selected.some(function(item:Object, index:int, source:Array):Boolean { return item.name == \"Zoe\"; });\nvar first:int = labels.indexOf(\"Ada:30\");\nvar last:int = labels.lastIndexOf(\"Bob:20\");\nvar numeric:Array = new Array(30, 2, 11);\nnumeric.sort(function(a:Number, b:Number):Number { return a - b; });\nvar duplicate:Array = new Array(\"echo\", \"echo\");\nvar unique:* = duplicate.sort(Array.UNIQUESORT);\nresult = labels.join(\"|\");\ntrace(\"AS3\", result, \"total\", total, \"checks\", all && any, \"find\", first, last);\nthis.root.as3Result.text = \"...\\n\" + labels.join(\"\\n\");\nthis.root.as3Result.replaceText(0, 4, \"\");\nthis.root.as3Result.appendText(\"\\nTotal: \" + total);\nthis.root.as3Result.textColor = 4774064;"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Run AS3 leaderboard",
                      "description": "Run the leaderboard data-processing scenario and show its transcript.",
                      "role": "button",
                      "tab_order": 416,
                      "disabled": false
                    }
                  },
