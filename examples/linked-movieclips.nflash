              "source": "var classic = this.attachMovie(\"legacy-card\", \"classic\", this.getNextHighestDepth(), {_x:660, _y:210, tag:\"init-before-constructor\"});\ntrace(\"legacy attached\", classic.tag, classic._parent == this, classic._currentframe);\n"
