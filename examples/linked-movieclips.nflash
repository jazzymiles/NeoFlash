  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.events.KeyboardEvent;\n public class Main extends MovieClip {\n  public var a:LinkedClip;\n  public var b:LinkedClip;\n  public function Main() {\n   super(); stop();\n   a = new LinkedClip(); a.name = \"left\"; a.x = 60; a.y = 210; addChild(a); a.gotoAndStop(1);\n   b = new LinkedClip(); b.name = \"right\"; b.x = 360; b.y = 210; addChild(b); b.gotoAndPlay(7);\n   stage.addEventListener(KeyboardEvent.KEY_DOWN, onKey);\n   report(\"Ready\");\n   trace(\"linked ready\", a !== b, a.badge !== b.badge, a.totalFrames, b.totalFrames, a.caption.text);\n  }\n  public function onKey(event:KeyboardEvent):void {\n   if (event.keyCode == 39) { a.nextFrame(); b.prevFrame(); report(\"Stepped separately\"); }\n   if (event.keyCode == 32) {\n    if (b.parent != null) removeChild(b); else addChild(b);\n    report(\"Attachment changed\"); trace(\"linked attachment\", b.parent != null, b.clicks, b.currentFrame);\n   }\n   if (event.keyCode == 38) { a.gotoAndPlay(\"first\"); b.gotoAndStop(\"second\"); report(\"Playing left / parked right\"); }\n  }\n  public function report(message:String):void {\n   status.text = message + \" | left frame \" + a.currentFrame + \" / right \" + b.currentFrame + \" | right attached \" + (b.parent != null);\n  }\n }\n}\n"
    },
    {
      "id": "linked-source",
      "path": "app/LinkedClip.as",
      "language": "action_script3",
      "source": "package app {\n import flash.display.MovieClip;\n import flash.events.MouseEvent;\n public class LinkedClip extends MovieClip {\n  public var clicks:int = 0;\n  public var paused:Boolean = false;\n  public function LinkedClip() {\n   super(); caption.text = \"AS3 linked\"; addEventListener(MouseEvent.CLICK, onClick);\n   trace(\"linked constructor\", caption.text, badge != null, totalFrames);\n  }\n  public function onClick(event:MouseEvent):void {\n   clicks++; paused = !paused;\n   if (paused) stop(); else play();\n   caption.text = name + \" / clicks \" + clicks;\n   root.status.text = name + \" | clicks \" + clicks + \" | frame \" + currentFrame + \" | paused \" + paused;\n   trace(\"linked click\", name, clicks, currentFrame, paused);\n  }\n }\n}\n"
    },
    {
      "id": "legacy-source",
      "path": "legacy/Classic.as",
      "language": "action_script2",
      "source": "class legacy.Classic extends MovieClip {\n public var clicks:Number = 0;\n public var tag:String;\n public function Classic() {\n  super(); stop(); caption.text = \"AS2 attached\";\n  trace(\"legacy constructor\", tag, caption.text, _totalframes);\n }\n public function onPress():Void {\n  clicks++; caption.text = \"AS2 / clicks \" + clicks;\n  gotoAndPlay(\"second\");\n  _root.status.text = \"AS2 attached | clicks \" + clicks + \" | \" + tag;\n  trace(\"legacy linked click\", _name, clicks, _currentframe, tag);\n }\n}\n"
    }
  ]
}
