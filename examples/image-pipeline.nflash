        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.display.BitmapData;\nimport flash.geom.Rectangle;\nimport flash.geom.Point;\nimport flash.geom.Matrix;\nimport flash.geom.ColorTransform;\nimport flash.filters.BlurFilter;\nvar legacyPhase:Number=-1;\nvar legacySource:BitmapData=_root.source.clone();\nvar legacyFiltered:BitmapData=new BitmapData(112,80,true,0);\nvar legacyCanvas:BitmapData=new BitmapData(128,96,true,0);\nvar legacyClip:MovieClip=createEmptyMovieClip(\"legacyClip\",getNextHighestDepth());\nlegacyClip._x=776;legacyClip._y=480;legacyClip.attachBitmap(legacyCanvas,legacyClip.getNextHighestDepth());\nvar legacyResult:Number=0;\nfunction processLegacy():Void {\n    legacyPhase=(legacyPhase+1)%3;\n    legacySource.copyPixels(_root.source,_root.source.rectangle,new Point());\n    legacySource.colorTransform(legacySource.rectangle,new ColorTransform(1,legacyPhase==1?.6:1,.8,1,0,0,20,0));\n    legacyFiltered.fillRect(legacyFiltered.rectangle,0);\n    legacyResult=legacyFiltered.applyFilter(legacySource,legacySource.rectangle,new Point(8,8),new BlurFilter(3,3,1));\n    legacyCanvas.fillRect(legacyCanvas.rectangle,0);\n    legacyCanvas.draw(legacyFiltered,new Matrix(1,0,0,1,8,8),null,\"normal\");\n    legacyStatus.text=\"Palette \"+legacyPhase+\" / filter result \"+legacyResult;\n}\nprocessLegacy();"
            }
          }
        ]
      }
