  "sources": [
    {
      "id": "source-main",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n    import flash.display.MovieClip;\n    import flash.display.Sprite;\n    import flash.display.Bitmap;\n    import flash.display.BitmapData;\n    import flash.display.PNGEncoderOptions;\n    import flash.display.Loader;\n    import flash.geom.Rectangle;\n    import flash.geom.Point;\n    import flash.geom.Matrix;\n    import flash.geom.ColorTransform;\n    import flash.filters.GlowFilter;\n    import flash.utils.ByteArray;\n    import flash.events.Event;\n    import flash.events.IOErrorEvent;\n    public class Main extends MovieClip {\n        public var source:BitmapData;\n        public var tinted:BitmapData;\n        public var processed:BitmapData;\n        public var captured:BitmapData;\n        public var roundTrip:BitmapData;\n        public var composition:Sprite;\n        public var nested:Sprite;\n        public var picture:Loader;\n        public var raw:ByteArray;\n        public var png:ByteArray;\n        public var prefixed:ByteArray;\n        public var affected:Rectangle;\n        public var options:PNGEncoderOptions;\n        public var phase:int=0;\n        public var loads:int=0;\n        public var sourceStable:Boolean=true;\n        public var rejectionCaught:Boolean=false;\n        public var reloadedMatches:Boolean=false;\n        public var rawEnd:uint=0;\n        public var copiedEnd:uint=0;\n        public function Main() {\n            super();stop();\n            this[\"process-button\"][\"process-label\"].selectable=false;\n            source=new BitmapData(96,64,true,0);\n            source.fillRect(new Rectangle(4,4,88,56),0xff1d3557);\n            source.fillRect(new Rectangle(12,12,72,40),0xff48cfae);\n            source.fillRect(new Rectangle(20,20,56,24),0xfff4e8b8);\n            source.fillRect(new Rectangle(26,26,12,12),0xffea7b55);\n            source.fillRect(new Rectangle(44,26,26,6),0xff3462a2);\n            tinted=source.clone();processed=new BitmapData(112,80,true,0);\n            captured=new BitmapData(192,112,true,0);roundTrip=new BitmapData(192,112,true,0);\n            view(source,80,216,2);view(processed,408,204,2);\n            composition=new Sprite();composition.name=\"composition\";composition.x=80;composition.y=476;composition.alpha=.7;addChild(composition);\n            var first:Bitmap=new Bitmap(source);first.x=8;first.y=16;first.scaleX=.75;first.scaleY=.75;composition.addChild(first);\n            nested=new Sprite();nested.x=72;nested.y=8;composition.addChild(nested);\n            var second:Bitmap=new Bitmap(processed);second.scaleX=.9;second.scaleY=.9;nested.addChild(second);\n            view(roundTrip,408,478,1.15);\n            picture=new Loader();picture.x=720;picture.y=216;picture.scaleX=1.3;picture.scaleY=1.3;\n            picture.contentLoaderInfo.addEventListener(Event.COMPLETE,loaded);\n            picture.contentLoaderInfo.addEventListener(IOErrorEvent.IO_ERROR,failed);addChild(picture);\n            options=new PNGEncoderOptions(true);prefixed=new ByteArray();\n            process();\n        }\n        public function view(data:BitmapData,x:Number,y:Number,scale:Number):void {\n            var image:Bitmap=new Bitmap(data);image.x=x;image.y=y;image.scaleX=scale;image.scaleY=scale;addChild(image);\n        }\n        public function advance():void {phase=(phase+1)%3;process();}\n        public function process():void {\n            var before:uint=source.getPixel32(24,24);\n            try { source.colorTransform(source.rect,new ColorTransform(1,1,1,1,256,0,0,0)); }\n            catch(error:Error) { rejectionCaught=source.getPixel32(24,24)==before; }\n            tinted.copyPixels(source,source.rect,new Point());\n            var tint:ColorTransform=phase==0?new ColorTransform(.85,1,1,1,12,0,0,0):phase==1?new ColorTransform(1,.65,.7,1,16,12,0,0):new ColorTransform(.8,.7,1,1,20,0,20,0);\n            tinted.colorTransform(tinted.rect,tint);\n            var glow:GlowFilter=new GlowFilter(phase==0?0x48cfae:phase==1?0xea7b55:0xa78bfa,.8,6,6,1,1);\n            affected=tinted.generateFilterRect(tinted.rect,glow);\n            processed.fillRect(processed.rect,0);processed.applyFilter(tinted,tinted.rect,new Point(8,8),glow);\n            captured.fillRect(captured.rect,0);captured.draw(composition,new Matrix(),null,\"normal\",null,false);\n            if(raw!=null)raw.clear();raw=captured.getPixels(captured.rect);raw.position=0;\n            roundTrip.setPixels(roundTrip.rect,raw);rawEnd=raw.position;\n            prefixed.clear();prefixed.writeUnsignedInt(0x4e465049);captured.copyPixelsToByteArray(captured.rect,prefixed);copiedEnd=prefixed.position;\n            if(png!=null)png.clear();png=roundTrip.encode(roundTrip.rect,options);png.position=0;\n            if(picture.content!=null){var old:Bitmap=picture.content as Bitmap;picture.unload();old.bitmapData.dispose();}\n            reloadedMatches=false;sourceStable=source.getPixel32(24,24)==0xfff4e8b8;\n            pipelineStatus.text=\"Palette \"+phase+\" / waiting for PNG decode\";\n            byteStatus.text=\"ARGB \"+raw.length+\" bytes / cursor \"+rawEnd+\" / PNG \"+png.length+\" bytes\";\n            picture.loadBytes(png);\n        }\n        public function loaded(event:Event):void {\n            loads++;var image:Bitmap=picture.content as Bitmap;\n            reloadedMatches=image.bitmapData.getPixel32(32,32)==roundTrip.getPixel32(32,32);\n            pipelineStatus.text=\"Palette \"+phase+\" / PNG round-trip \"+reloadedMatches+\" / source unchanged \"+sourceStable;\n            trace(\"image pipeline\",phase,loads,sourceStable,reloadedMatches);\n        }\n        public function failed(event:IOErrorEvent):void {pipelineStatus.text=\"Image pipeline failed: \"+event.text;}\n    }\n}\n"
    }
  ]
}
