        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.display.BitmapData;\nimport flash.geom.Rectangle;\nvar legacyPixels:BitmapData = new BitmapData(16,16,true,0xff2ad4a5);\nlegacyPixels.fillRect(new Rectangle(4,4,8,8),0xffff965c);\nlegacyPixels.setPixel32(0,0,0xff122233);\nvar legacyClip:MovieClip = createEmptyMovieClip(\"legacyBitmap\",getNextHighestDepth());\nlegacyClip._x = 64; legacyClip._y = 384;\nlegacyClip._xscale = 600; legacyClip._yscale = 600;\nlegacyClip.attachBitmap(legacyPixels,legacyClip.getNextHighestDepth(),\"auto\",false);\nlegacyStatus.text = \"16 × 16 pixels | rectangle: \" + legacyPixels.rectangle.width + \" | depth: append-only\";\n"
            }
          }
        ]
      }
