  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n  import flash.display.MovieClip;\n  import flash.display.Bitmap;\n  import flash.display.BitmapData;\n  import flash.display.PixelSnapping;\n  import flash.geom.Point;\n  import flash.geom.Rectangle;\n  public class Main extends MovieClip {\n    public var original:BitmapData;\n    public var shared:BitmapData;\n    public var independent:BitmapData;\n    public var leftView:Bitmap;\n    public var rightView:Bitmap;\n    public var cloneView:Bitmap;\n    public var phase:int = 0;\n    public function Main() {\n      super(); stop();\n      original = sourceImage.bitmapData;\n      shared = original.clone();\n      shared.fillRect(new Rectangle(0,0,4,4),0xffffc857);\n      shared.setPixel32(15,15,0xfff08080);\n      independent = shared.clone();\n      independent.scroll(2,0);\n      independent.copyPixels(original,new Rectangle(4,3,8,8),new Point(0,8));\n      leftView = new Bitmap(shared,PixelSnapping.AUTO,false);\n      leftView.name = \"sharedLeft\";\n      leftView.x = 280; leftView.y = 192;\n      leftView.scaleX = 8; leftView.scaleY = 8;\n      addChild(leftView);\n      rightView = new Bitmap(shared);\n      rightView.name = \"sharedRight\";\n      rightView.x = 496; rightView.y = 192;\n      rightView.scaleX = 8; rightView.scaleY = 8;\n      addChild(rightView);\n      cloneView = new Bitmap(independent);\n      cloneView.name = \"independentClone\";\n      cloneView.x = 712; cloneView.y = 192;\n      cloneView.scaleX = 8; cloneView.scaleY = 8;\n      addChild(cloneView);\n      status.text = \"Ready: \" + shared.width + \" × \" + shared.height + \" pixels | two shared views + one independent clone\";\n      trace(\"bitmaps ready\",shared.width,shared.height,phase);\n    }\n    public function paintShared():void {\n      phase++;\n      var color:uint = phase % 2 == 1 ? 0xffff965c : 0xff8b9dff;\n      shared.fillRect(new Rectangle(4,4,8,6),color);\n      shared.setPixel(0,0,0x1f3045);\n      status.text = \"Paint \" + phase + \": both shared views changed | PNG source and clone unchanged\";\n      trace(\"bitmaps paint\",phase,shared.getPixel32(4,4));\n    }\n  }\n}\n"
    }
  ],
