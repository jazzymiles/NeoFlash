              "language": "action_script2",
              "source": "import mx.transitions.Tween;\nstop();\nfunction runLegacyEasing() {\n var checks=0;var passed=0;var methods=0;\n function check(ok:Boolean){checks++;if(ok)passed++;}\n function curve(name:String,f:Function){methods++;var x=f(0.37,10,90,1);check(Math.abs(f(0,10,90,1)-10)<0.00001&&Math.abs(f(1,10,90,1)-100)<0.00001&&isFinite(x));}\ncurve(\"mx.transitions.easing.Back.easeIn\",mx.transitions.easing.Back.easeIn);\ncurve(\"mx.transitions.easing.Back.easeOut\",mx.transitions.easing.Back.easeOut);\ncurve(\"mx.transitions.easing.Back.easeInOut\",mx.transitions.easing.Back.easeInOut);\ncurve(\"mx.transitions.easing.Bounce.easeIn\",mx.transitions.easing.Bounce.easeIn);\ncurve(\"mx.transitions.easing.Bounce.easeOut\",mx.transitions.easing.Bounce.easeOut);\ncurve(\"mx.transitions.easing.Bounce.easeInOut\",mx.transitions.easing.Bounce.easeInOut);\ncurve(\"mx.transitions.easing.Elastic.easeIn\",mx.transitions.easing.Elastic.easeIn);\ncurve(\"mx.transitions.easing.Elastic.easeOut\",mx.transitions.easing.Elastic.easeOut);\ncurve(\"mx.transitions.easing.Elastic.easeInOut\",mx.transitions.easing.Elastic.easeInOut);\ncurve(\"mx.transitions.easing.None.easeNone\",mx.transitions.easing.None.easeNone);\ncurve(\"mx.transitions.easing.None.easeIn\",mx.transitions.easing.None.easeIn);\ncurve(\"mx.transitions.easing.None.easeOut\",mx.transitions.easing.None.easeOut);\ncurve(\"mx.transitions.easing.None.easeInOut\",mx.transitions.easing.None.easeInOut);\ncurve(\"mx.transitions.easing.Regular.easeIn\",mx.transitions.easing.Regular.easeIn);\ncurve(\"mx.transitions.easing.Regular.easeOut\",mx.transitions.easing.Regular.easeOut);\ncurve(\"mx.transitions.easing.Regular.easeInOut\",mx.transitions.easing.Regular.easeInOut);\ncurve(\"mx.transitions.easing.Strong.easeIn\",mx.transitions.easing.Strong.easeIn);\ncurve(\"mx.transitions.easing.Strong.easeOut\",mx.transitions.easing.Strong.easeOut);\ncurve(\"mx.transitions.easing.Strong.easeInOut\",mx.transitions.easing.Strong.easeInOut);\n var target={value:0};var tween=new Tween(target,\"value\",mx.transitions.easing.Regular.easeIn,10,110,4,false);\n tween.stop();var events={changed:0,finished:0,resumed:0,started:0,stopped:0};\n tween.onMotionChanged=function(){events.changed++;};tween.onMotionFinished=function(){events.finished++;};tween.onMotionResumed=function(){events.resumed++;};tween.onMotionStarted=function(){events.started++;};tween.onMotionStopped=function(){events.stopped++;};\n check(tween.FPS==24&&tween.duration==4&&tween.finish==110&&tween.position==10&&tween.time==0);\n tween.start();check(tween.position==10);tween.stop();tween.nextFrame();check(tween.position==16.25);tween.prevFrame();check(tween.time==0);\n tween.rewind(2);check(tween.position==35);tween.resume();tween.stop();tween.fforward();check(tween.position==110);\n tween.continueTo(210,4);tween.stop();tween.time=2;check(tween.position==135);tween.yoyo();tween.stop();tween.fforward();check(tween.position==110);\n tween.FPS=30;tween.duration=2;tween.finish=310;tween.time=1;tween.position=77;check(tween.FPS==30&&tween.duration==2&&tween.finish==310&&target.value==77);\n check(tween.toString()==\"[Tween]\");check(events.changed>0&&events.finished>0&&events.resumed>0&&events.started>0&&events.stopped>0);\n status2.text=\"AS2: \"+passed+\" / \"+checks+\" checks \u00b7 19 easing methods + 10 Tween methods + 5 properties\";\n trace('EASING_AS2_RESULT {\"checks\":'+checks+',\"passed\":'+passed+',\"easingMethods\":19,\"tweenMethods\":10,\"properties\":5}');\n if(legacyAnimation!=undefined)legacyAnimation.stop();\n legacyAnimation=new Tween(legacyMarker,\"_x\",mx.transitions.easing.Strong.easeInOut,80,730,3,true);\n legacyAnimation.onMotionFinished=function(){_root.legacyStatus.text=\"AS2 completed \u00b7 x=\"+_root.legacyMarker._x;trace(\"EASING_AS2_ANIMATION_FINISHED \"+_root.legacyMarker._x);};\n legacyStatus.text=\"AS2 seconds tween running\";\n runLegacyTimerGlobals();runLegacyBroadcaster();\n}\nfunction runLegacyBroadcaster(){\n var checks=0;var passed=0;var calls=[];\n function check(ok){checks++;if(ok)passed++;}\n var broadcaster={};AsBroadcaster.initialize(broadcaster);\n var first={value:40};var second={value:50};\n first.onValue=function(a,b){calls.push(this.value+a+b);};\n second.onValue=function(a,b){calls.push(this.value+a+b);};\n check(broadcaster.addListener(first)&&broadcaster.addListener(first)&&broadcaster._listeners.length==1);\n check(broadcaster.addListener(second)&&broadcaster._listeners[0]==first&&broadcaster._listeners[1]==second);\n check(broadcaster.broadcastMessage(\"onValue\",1,1)&&calls.length==2&&calls[0]==42&&calls[1]==52);\n check(broadcaster.removeListener(first)&&!broadcaster.removeListener(first)&&broadcaster._listeners.length==1);\n second.onValue=function(a,b){calls.push(this.value+a+b+10);};\n broadcaster.broadcastMessage(\"onValue\",1,1);check(calls[2]==62);\n check(broadcaster.broadcastMessage(\"missingMethod\")&&calls.length==3);\n AsBroadcaster.initialize(broadcaster);check(broadcaster._listeners.length==0);\n var closure=function(value){calls.push(value);};broadcaster.addListener(closure);broadcaster.broadcastMessage(\"\",99);check(calls[3]==99);\n broadcaster.removeListener(closure);check(broadcaster._listeners.length==0);\n _root.broadcasterStatus.text=\"AS2 AsBroadcaster: \"+passed+\" / \"+checks+\" \u00b7 ordered listeners, callbacks and reinitialization\";\n trace('BROADCASTER_AS2_RESULT {\"checks\":'+checks+',\"passed\":'+passed+',\"members\":5}');\n}\nfunction runLegacyTimerGlobals(){\n if(_root.legacyTimerIds!=undefined)for(var oldIndex=0;oldIndex<_root.legacyTimerIds.length;oldIndex++)clearTimeout(_root.legacyTimerIds[oldIndex]);\n _root.legacyTimerIds=[];\n var result={ticks:0,timeout:0,cancelled:0,args:false,method:false};\n clearInterval(0);clearTimeout(0);\n var canceled=setTimeout(function(){result.cancelled++;},1);clearTimeout(canceled);\n var crossCanceled=setTimeout(function(){result.cancelled++;},1);clearInterval(crossCanceled);\n var target={value:41};\n target.tick=function(value){result.cancelled++;};\n var intervalId=setInterval(target,\"tick\",10,1);_root.legacyTimerIds.push(intervalId);\n target.tick=function(value){\n  result.ticks++;result.method=this.value+value==42;\n  if(result.ticks==2){clearInterval(intervalId);_root.legacyTimerIds.push(setTimeout(function(){\n   var ok=result.ticks==2&&result.timeout==1&&result.cancelled==0&&result.args&&result.method;\n   trace('TIMER_GLOBALS_AS2_RESULT {\"passed\":'+ok+',\"apiFunctions\":4,\"ticks\":'+result.ticks+',\"timeouts\":'+result.timeout+',\"cancelled\":'+result.cancelled+',\"arguments\":'+result.args+',\"lateBoundMethod\":'+result.method+'}');\n   _root.timerStatus2.text=\"AS2 callback timers: \"+(ok?\"PASS\":\"FAIL\")+\" \u00b7 function and object/method callbacks\";\n  },20));}\n };\n _root.legacyTimerIds.push(setTimeout(function(a,b){result.timeout++;result.args=a==\"rust\"&&b==42;},0,\"rust\",42));\n}\nrunLegacyEasing();\n"
            }
