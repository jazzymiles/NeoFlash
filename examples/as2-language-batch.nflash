        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import model.Counter;\nstop();\nvar passed:Number=0;\nvar checks:Number=0;\nvar failures:String=\"\";\nfunction check(ok:Boolean,name:String):Void {checks++;if(ok)passed++;else failures+=name+\"; \";}\nfunction runLanguage():Void {\n passed=0;checks=0;failures=\"\";\n var counter:Counter=new Counter();\n var other:Counter=new Counter();\n var previous:Number=Counter.changes;\n check(counter.value==2 && other.value==2,\"getter\");\n counter.value=8;\n check(counter.value==8 && other.value==2 && Counter.changes==previous+1,\"setter and static accessor\");\n check(counter.advance()==11,\"bare compound accessor\");\n counter.extra=\"dynamic\";\n check(counter.extra==\"dynamic\",\"dynamic property\");\n var scopeObject:Object={amount:4,child:{amount:9},method:function(delta:Number):Number {this.amount+=delta;return this.amount;}};\n var amount:Number=100;\n var outside:Number=0;\n with(scopeObject) {\n   check(amount==4,\"object precedes local\");\n   amount+=2;\n   check(method(3)==9,\"with method receiver\");\n   with(child) {amount++;check(amount==10,\"nested scope\");}\n   outside=amount;\n }\n check(amount==100 && scopeObject.amount==9 && outside==9,\"lexical fallback\");\n check(scopeObject.child.amount==10,\"nested write\");\n var area:Number=0;\n with(Math) {area=round(PI*4);}\n check(area==13,\"native Math methods\");\n scopeObject.temporary=7;\n with(scopeObject) {delete temporary;}\n check(scopeObject.temporary==undefined,\"delete scoped property\");\n var sum:Number=0;\n for(var i:Number=0;i<4;i++){with(scopeObject){sum+=amount;if(i==1)break;}}\n check(sum==18,\"with inside control flow\");\n with(scopeObject){newTimelineValue=21;}\n check(_root.newTimelineValue==21 && scopeObject.newTimelineValue==undefined,\"new field falls back to timeline\");\n var array:Array=Array(1,2,3);\n var record:Object=Object(scopeObject);\n check(array.length==3 && array[2]==3 && record===scopeObject,\"existing Array and Object function forms\");\n _root.counts.text=\"AS2 language: \"+passed+\" / \"+checks;\n _root.hint.text=failures==\"\"?\"Get/set accessors, dynamic fields, nested with, method receivers, lexical fallback and control flow.\":failures;\n trace(\"AS2_LANGUAGE_RESULT \"+passed+\"/\"+checks+\" \"+failures);\n}\nrunLanguage();"
            }
          }
        ]
      }
