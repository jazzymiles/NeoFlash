  "sources": [
    {
      "id": "counter-source",
      "path": "model/Counter.as",
      "language": "action_script2",
      "source": "dynamic class model.Counter {\n private var stored:Number=2;\n private static var writes:Number=0;\n public function get value():Number{return stored;}\n public function set value(next:Number):Void{stored=next;writes++;}\n public static function get changes():Number{return writes;}\n public function advance():Number {value+=3;return value;}\n}"
    }
  ]
