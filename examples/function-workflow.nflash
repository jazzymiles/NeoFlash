        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import legacy.Counter;\nvar legacyOne:Counter=new Counter(0);\nvar legacyOther:Counter=new Counter(20);\nvar legacyFn:Function=legacyOne.add;\nvar legacyShared:Boolean=legacyFn===legacyOther.add;\nvar legacyExtra:Number=0;\nvar legacyPipe:Function=function():Number {\n    var sum:Number=0;\n    for(var i:Number=0;i<arguments.length;i++) sum+=arguments[i];\n    this.value+=sum; this.seen=arguments.length; return this.value;\n};\nfunction refreshLegacy():Void {\n    this[\"legacy-values\"].text=legacyOne.value+\" first / \"+legacyOther.value+\" other\";\n    this[\"legacy-args\"].text=\"argc: first \"+legacyOne.seen+\" / other \"+legacyOther.seen;\n    this[\"legacy-identity\"].text=\"Shared method identity: \"+legacyShared;\n    this[\"legacy-binding\"].text=\"Last return: \"+legacyExtra+\" / receiver kept\";\n}\nfunction runLegacyDefault():Void {\n    legacyExtra=legacyFn.call(legacyOther); refreshLegacy();\n}\nfunction runLegacyBatch():Void {\n    legacyExtra=legacyPipe.apply(legacyOne,[2,3]); refreshLegacy();\n}\nfunction runLegacyBorrow():Void {\n    legacyExtra=legacyFn.apply(legacyOne,[4,\"ignored\"]); refreshLegacy();\n}\nrefreshLegacy();"
            }
          }
        ]
      }
    },
