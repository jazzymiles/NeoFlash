  "sources": [
    {
      "id": "source-0",
      "path": "app/ICommand.as",
      "language": "action_script3",
      "source": "package app {\n    public interface ICommand { function execute(amount:int=1, label:String=\"tap\"):int; }\n}\n"
    },
    {
      "id": "source-1",
      "path": "app/Counter.as",
      "language": "action_script3",
      "source": "package app {\n    public class Counter implements ICommand {\n        public var value:int;\n        public var label:String;\n        public var last:String=\"ready\";\n        public function Counter(seed:int=0, name:String=\"Primary\") { value=seed; label=name; }\n        public function execute(amount:int=1, label:String=\"tap\"):int {\n            value+=amount; last=label; return value;\n        }\n    }\n}\n"
    },
    {
      "id": "source-2",
      "path": "app/BonusCounter.as",
      "language": "action_script3",
      "source": "package app {\n    public class BonusCounter extends Counter {\n        public function BonusCounter(seed:int=10, name:String=\"Secondary\") { super(seed,name); }\n        public override function execute(amount:int=2, label:String=\"bonus\"):int {\n            return super.execute(amount,label);\n        }\n    }\n}\n"
    },
    {
      "id": "source-3",
      "path": "app/CommandBus.as",
      "language": "action_script3",
      "source": "package app {\n    public class CommandBus {\n        public var listeners:Array=[];\n        public function add(listener:Function):void { listeners.push(listener); }\n        public function run(...values:Array):int {\n            var total:int=0;\n            for(var i:int=0;i<listeners.length;i++) total+=listeners[i].apply(null,values);\n            return total;\n        }\n    }\n}\n"
    },
    {
      "id": "source-4",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n    import flash.display.MovieClip;\n    public class Main extends MovieClip {\n        public var primary:Counter;\n        public var secondary:Counter;\n        public var bus:CommandBus;\n        public var commands:int=0;\n        public var total:int=0;\n        public var argumentSummary:String;\n        public var argumentTyped:String;\n        public var argumentValueType:String;\n        public var calleeMatches:Boolean=false;\n        public var borrowed:Object;\n        public var boundResult:int=0;\n        public var ordinaryResult:int=0;\n        public function Main() {\n            super(); stop();\n            this[\"default-command\"][\"default-command-symbol-label\"].selectable=false;\n            this[\"batch-command\"][\"batch-command-symbol-label\"].selectable=false;\n            this[\"borrow-command\"][\"borrow-command-symbol-label\"].selectable=false;\n            primary=new Counter(); secondary=new BonusCounter();\n            bus=new CommandBus(); bus.add(primary.execute); bus.add(secondary.execute);\n            argumentSummary=inspect()+\" | \"+inspect(undefined);\n            argumentTyped=inspect(\"7\",\"extra\");\n            borrowed={value:100};\n            render(); trace(\"functions ready\",primary.value,secondary.value);\n        }\n        public function inspect(seed:int=5):String {\n            calleeMatches=arguments.callee===inspect;\n            argumentValueType=typeof arguments[0];\n            return seed+\" / argc \"+arguments.length;\n        }\n        public function sendDefault():void {\n            commands++; total=bus.run(); render(); trace(\"functions default\",primary.value,secondary.value);\n        }\n        public function sendBatch():void {\n            commands++; total=bus.run(3,\"batch\"); render(); trace(\"functions batch\",primary.value,secondary.value);\n        }\n        public function borrowReceiver():void {\n            var command:Function=primary.execute;\n            boundResult=command.call(borrowed,4,\"bound\");\n            var ordinary:Function=function(amount:int=1):int {this.value+=amount;return this.value;};\n            ordinaryResult=ordinary.call(borrowed,3);\n            commands++; render(); trace(\"functions borrow\",primary.value,borrowed.value);\n        }\n        public function render():void {\n            this[\"modern-values\"].text=primary.value+\" primary / \"+secondary.value+\" secondary\";\n            this[\"modern-detail\"].text=\"Commands \"+commands+\" / last \"+primary.last+\" + \"+secondary.last;\n            this[\"modern-args\"].text=argumentSummary;\n            this[\"modern-length\"].text=\"execute.length \"+primary.execute.length+\" / run.length \"+bus.run.length;\n            this[\"modern-binding\"].text=\"Other receiver: \"+borrowed.value+\" / callee \"+calleeMatches;\n        }\n    }\n}\n"
    },
    {
      "id": "source-5",
      "path": "legacy/Counter.as",
      "language": "action_script2",
      "source": "class legacy.Counter {\n    public var value:Number;\n    public var seen:Number;\n    public function Counter(seed:Number) { value=seed; seen=0; }\n    public function add(step:Number):Number {\n        seen=arguments.length;\n        if(step===undefined) step=1;\n        value+=step; return value;\n    }\n}\n"
    }
  ]
}
