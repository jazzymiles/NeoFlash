    {
      "id": "scene",
      "name": "Main",
      "kind": "movie_clip",
      "timeline": {
        "frame_count": 1,
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script3",
              "source": "import flash.display.Sprite;\nimport flash.events.Event;\nimport flash.events.KeyboardEvent;\nimport flash.ui.Keyboard;\n\nstop();\n\nvar gridCols:int = 20;\nvar gridRows:int = 15;\nvar cellSize:int = 20;\nvar boardX:Number = 120;\nvar boardY:Number = 100;\nvar maxVisibleSegments:int = 20;\n\nvar snakeX:Array = [];\nvar snakeY:Array = [];\nvar dirX:int = 1;\nvar dirY:int = 0;\nvar nextDirX:int = 1;\nvar nextDirY:int = 0;\nvar foodX:int = 14;\nvar foodY:int = 7;\nvar score:int = 0;\nvar highScore:int = 0;\nvar gameOver:Boolean = false;\nvar paused:Boolean = false;\nvar tickCount:int = 0;\nvar moveInterval:int = 4;\nvar rngSeed:int = 1337;\nvar boardCanvas:Sprite = new Sprite();\nboardCanvas.x = boardX;\nboardCanvas.y = boardY;\naddChild(boardCanvas);\n\nfunction nextRandom(maxVal:int):int {\n  rngSeed = (rngSeed * 1103515245 + 12345) & 2147483647;\n  return rngSeed % maxVal;\n}\n\nfunction isOccupied(gx:int, gy:int):Boolean {\n  var i:int = 0;\n  while (i < snakeX.length) {\n    if (snakeX[i] == gx && snakeY[i] == gy) {\n      return true;\n    }\n    i = i + 1;\n  }\n  return false;\n}\n\nfunction placeFood():void {\n  var attempts:int = 0;\n  var candidateX:int = nextRandom(gridCols);\n  var candidateY:int = nextRandom(gridRows);\n  while (isOccupied(candidateX, candidateY) && attempts < 300) {\n    candidateX = (candidateX + 1) % gridCols;\n    if (candidateX == 0) {\n      candidateY = (candidateY + 1) % gridRows;\n    }\n    attempts = attempts + 1;\n  }\n  foodX = candidateX;\n  foodY = candidateY;\n  if (this.food != null) {\n    this.food.x = boardX + foodX * cellSize + cellSize / 2;\n    this.food.y = boardY + foodY * cellSize + cellSize / 2;\n  }\n}\n\nfunction updateHud():void {\n  if (this.scoreText != null) {\n    this.scoreText.text = \"SCORE: \" + score;\n  }\n  if (this.highScoreText != null) {\n    this.highScoreText.text = \"HIGH: \" + highScore;\n  }\n  if (this.statusText != null) {\n    if (gameOver) {\n      this.statusText.text = \"GAME OVER - PRESS R\";\n    } else if (paused) {\n      this.statusText.text = \"PAUSED\";\n    } else {\n      this.statusText.text = \"PLAYING\";\n    }\n  }\n}\n\nfunction renderSnake():void {\n  var i:int = 0;\n  while (i < maxVisibleSegments) {\n    var segClip:Object = this[\"seg\" + i];\n    if (segClip != null) {\n      if (i < snakeX.length) {\n        segClip.visible = true;\n        segClip.x = boardX + snakeX[i] * cellSize + cellSize / 2;\n        segClip.y = boardY + snakeY[i] * cellSize + cellSize / 2;\n      } else {\n        segClip.visible = false;\n      }\n    }\n    i = i + 1;\n  }\n  if (boardCanvas != null) {\n    boardCanvas.graphics.clear();\n    var j:int = maxVisibleSegments;\n    while (j < snakeX.length) {\n      var px:Number = snakeX[j] * cellSize + 2;\n      var py:Number = snakeY[j] * cellSize + 2;\n      boardCanvas.graphics.beginFill(0x4ADE80, 1.0);\n      boardCanvas.graphics.drawRect(px, py, cellSize - 4, cellSize - 4);\n      boardCanvas.graphics.endFill();\n      j = j + 1;\n    }\n  }\n}\n\nfunction setDirection(dx:int, dy:int):void {\n  if (dx == 0 && dy == 0) {\n    return;\n  }\n  if (dx == -dirX && dy == -dirY) {\n    return;\n  }\n  nextDirX = dx;\n  nextDirY = dy;\n}\n\nfunction resetGame():void {\n  snakeX = [10, 9, 8];\n  snakeY = [7, 7, 7];\n  dirX = 1;\n  dirY = 0;\n  nextDirX = 1;\n  nextDirY = 0;\n  score = 0;\n  gameOver = false;\n  paused = false;\n  tickCount = 0;\n  placeFood();\n  renderSnake();\n  updateHud();\n}\n\nfunction stepSnake():Boolean {\n  if (gameOver || paused) {\n    return false;\n  }\n  dirX = nextDirX;\n  dirY = nextDirY;\n  var newHeadX:int = int(snakeX[0]) + dirX;\n  var newHeadY:int = int(snakeY[0]) + dirY;\n  if (newHeadX < 0 || newHeadX >= gridCols || newHeadY < 0 || newHeadY >= gridRows) {\n    gameOver = true;\n    updateHud();\n    return false;\n  }\n  var eatFood:Boolean = (newHeadX == foodX && newHeadY == foodY);\n  var checkLimit:int = eatFood ? snakeX.length : (snakeX.length - 1);\n  var k:int = 0;\n  while (k < checkLimit) {\n    if (snakeX[k] == newHeadX && snakeY[k] == newHeadY) {\n      gameOver = true;\n      updateHud();\n      return false;\n    }\n    k = k + 1;\n  }\n  snakeX.unshift(newHeadX);\n  snakeY.unshift(newHeadY);\n  if (eatFood) {\n    score = score + 10;\n    if (score > highScore) {\n      highScore = score;\n    }\n    placeFood();\n  } else {\n    snakeX.pop();\n    snakeY.pop();\n  }\n  renderSnake();\n  updateHud();\n  return true;\n}\n\nfunction onKeyDown(event:KeyboardEvent):void {\n  var code:uint = event.keyCode;\n  if (code == Keyboard.LEFT || code == 65) {\n    setDirection(-1, 0);\n  } else if (code == Keyboard.RIGHT || code == 68) {\n    setDirection(1, 0);\n  } else if (code == Keyboard.UP || code == 87) {\n    setDirection(0, -1);\n  } else if (code == Keyboard.DOWN || code == 83) {\n    setDirection(0, 1);\n  } else if (code == 82) {\n    resetGame();\n  } else if (code == 80) {\n    paused = !paused;\n    updateHud();\n  }\n}\n\nfunction onTick(event:Event):void {\n  if (gameOver || paused) {\n    return;\n  }\n  tickCount = tickCount + 1;\n  if (tickCount >= moveInterval) {\n    tickCount = 0;\n    stepSnake();\n  }\n}\n\nif (stage != null) {\n  stage.focus = this;\n  stage.addEventListener(KeyboardEvent.KEY_DOWN, onKeyDown);\n}\naddEventListener(Event.ENTER_FRAME, onTick);\n\nresetGame();\n"
            }
          }
