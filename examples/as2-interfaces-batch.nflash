  "sources": [
    {
      "id": "interface-source-0",
      "path": "contracts/Named.as",
      "language": "action_script2",
      "source": "interface contracts.Named { public function label():String; }"
    },
    {
      "id": "interface-source-1",
      "path": "contracts/Counter.as",
      "language": "action_script2",
      "source": "interface contracts.Counter extends contracts.Named { function value():Number; function step():Number; }"
    },
    {
      "id": "interface-source-2",
      "path": "contracts/Resettable.as",
      "language": "action_script2",
      "source": "interface contracts.Resettable { function reset():Void; }"
    },
    {
      "id": "interface-source-3",
      "path": "model/Base.as",
      "language": "action_script2",
      "source": "class model.Base { public function label():String { return \"Linked AS2 counter\"; } }"
    },
    {
      "id": "interface-source-4",
      "path": "model/Counter.as",
      "language": "action_script2",
      "source": "class model.Counter extends model.Base implements contracts.Counter, contracts.Resettable { public var total:Number=3; public function value():Number { return total; } public function step():Number { total++; return total; } public function reset():Void { total=0; } }"
    }
  ],
  "resources": []
}
