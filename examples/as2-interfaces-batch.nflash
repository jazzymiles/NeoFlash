                    "id": "advance-interface",
                    "name": "advance-interface",
                    "transform": {
                      "x": 40,
                      "y": 300,
                      "scale_x": 1,
                      "scale_y": 1,
                      "rotation": 0,
                      "alpha": 1
                    },
                    "kind": {
                      "type": "instance",
                      "symbol_id": "advance-control",
                      "playback": "independent"
                    },
                    "scripts": [
                      {
                        "event": "click",
                        "script": {
                          "language": "action_script2",
                          "source": "_root.advanceInterface();"
                        }
                      }
                    ],
                    "accessibility": {
                      "name": "Advance typed counter",
                      "description": "Invoke the step method through an AS2 interface annotation.",
                      "role": "button",
                      "tab_order": 0,
                      "disabled": false
                    }
                  }
                ],
                "tween": null,
                "label": ""
              }
            ]
          }
        ],
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import model.Counter;\nimport contracts.Named;\nimport contracts.Resettable;\nstop();\nvar instance:Counter = new Counter();\nvar typed:contracts.Counter = instance;\nvar named:Named = instance;\nvar resetter:Resettable = instance;\nvar steps:Number = 0;\nfunction describe(value:Named):String { return value.label(); }\nfunction refreshInterfaces():Void {\n summary.text = describe(named) + \" / value: \" + typed.value() + \" / clicks: \" + steps + \"\\nInherited method + interface annotations + multiple contracts.\";\n}\nfunction advanceInterface():Void { steps++; typed.step(); refreshInterfaces(); }\nfunction resetInterface():Void { resetter.reset(); refreshInterfaces(); }\nrefreshInterfaces();\n"
            }
          }
        ]
      }
    },
    {
      "id": "advance-control",
      "name": "Update both catalogs",
      "kind": "button",
