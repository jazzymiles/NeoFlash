        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "var legacySound:Sound = new Sound();\nvar legacyReady:Boolean = false;\nvar legacyCompleted:Number = 0;\nlegacySound.setVolume(0);\nlegacySound.setPan(-25);\nlegacySound.onLoad = function(success:Boolean):Void {\n    legacyReady = success;\n    if (success) {\n        legacyStatus.text = \"Ready | \" + this.getBytesTotal() + \" bytes\\nVolume \" + this.getVolume() + \" | pan \" + this.getPan();\n    } else {\n        legacyStatus.text = \"The MP3 could not be loaded or decoded.\";\n    }\n};\nlegacySound.onSoundComplete = function():Void {\n    legacyCompleted++;\n    legacyStatus.text = \"Completed \" + legacyCompleted + \" time(s)\\nVolume \" + this.getVolume() + \" | pan \" + this.getPan();\n};\nlegacySound.loadSound(\"audio/original-pulse.mp3\", false);\n"
            }
          }
        ]
      }
