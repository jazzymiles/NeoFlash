  "sources": [
    {
      "id": "main-source",
      "path": "app/Main.as",
      "language": "action_script3",
      "source": "package app {\n    import flash.display.MovieClip;\n    import flash.media.Sound;\n    import flash.media.SoundChannel;\n    import flash.media.SoundTransform;\n    import flash.net.URLRequest;\n    import flash.events.Event;\n    import flash.events.IOErrorEvent;\n\n    public class Main extends MovieClip {\n        public var sound:Sound;\n        public var channel:SoundChannel;\n        public var ready:Boolean = false;\n        public var plays:int = 0;\n        public var completed:int = 0;\n        public var stopped:int = 0;\n        // This original publication intentionally starts silent.\n        public var volume:Number = 0;\n\n        public function Main() {\n            stop();\n            sound = new Sound();\n            sound.addEventListener(Event.COMPLETE, loaded);\n            sound.addEventListener(IOErrorEvent.IO_ERROR, failed);\n            sound.load(new URLRequest(\"audio/original-pulse.mp3\"));\n        }\n        public function loaded(event:Event):void {\n            ready = true;\n            soundStatus.text = \"Ready | \" + Math.round(sound.length) + \" ms\\n\" + sound.bytesLoaded + \" / \" + sound.bytesTotal + \" bytes\";\n            status.text = \"Choose Play silently. If your browser asks, choose Enable audio; the example stays muted.\";\n            trace(\"sound ready\", sound.bytesLoaded, Math.round(sound.length));\n        }\n        public function failed(event:IOErrorEvent):void {\n            ready = false;\n            soundStatus.text = \"The MP3 could not be loaded or decoded.\";\n            status.text = \"Audio is unavailable in this browser or the resource could not be decoded.\";\n        }\n        public function playMuted():void {\n            if (!ready || !legacyReady) {\n                status.text = \"Wait until both sound cards are ready.\";\n                return;\n            }\n            if (channel != null) { channel.stop(); }\n            legacySound.stop();\n            channel = sound.play(0, 0, new SoundTransform(volume, 0.25));\n            channel.addEventListener(Event.SOUND_COMPLETE, ended);\n            legacySound.setVolume(volume * 100);\n            legacySound.setPan(-25);\n            legacySound.start(0, 1);\n            plays++;\n            soundStatus.text = \"Playing run \" + plays + \"\\nVolume \" + channel.soundTransform.volume + \" | pan \" + channel.soundTransform.pan;\n            legacyStatus.text = \"Playing run \" + plays + \"\\nVolume \" + legacySound.getVolume() + \" | pan \" + legacySound.getPan();\n            status.text = \"Two independent channels are playing at volume \" + volume + \". Stop cancels completion; Restart restores the source.\";\n            trace(\"sound play\", plays, volume);\n        }\n        public function ended(event:Event):void {\n            completed++;\n            soundStatus.text = \"Completed \" + completed + \" time(s)\\nPosition \" + Math.round(channel.position) + \" ms\";\n            status.text = \"Playback finished. Play again, test Stop, or Restart for fresh channels and counters.\";\n            trace(\"sound complete\", completed);\n        }\n        public function stopPlayback():void {\n            if (channel != null) { channel.stop(); }\n            legacySound.stop();\n            stopped++;\n            soundStatus.text = \"Stopped | \" + stopped + \" command(s)\\nCompletion count \" + completed;\n            legacyStatus.text = \"Stopped | completion count \" + legacyCompleted;\n            status.text = \"Stopped channels do not dispatch a natural completion event.\";\n            trace(\"sound stop\", stopped);\n        }\n    }\n}\n"
    }
  ],
  "resources": [
    {
      "id": "original-pulse",
      "path": "audio/original-pulse.mp3",
      "media_type": "audio/mpeg",
      "data_base64": ""
    }
  ]
