    {
      "id": "scene",
      "name": "Main",
      "kind": "movie_clip",
      "timeline": {
        "frame_count": 1,
        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "stop();\n\nvar gridCols:Number = 20;\nvar gridRows:Number = 15;\nvar cellSize:Number = 20;\nvar boardX:Number = 120;\nvar boardY:Number = 100;\nvar maxVisibleSegments:Number = 20;\n\nvar snakeX:Array = [];\nvar snakeY:Array = [];\nvar dirX:Number = 1;\nvar dirY:Number = 0;\nvar nextDirX:Number = 1;\nvar nextDirY:Number = 0;\nvar foodX:Number = 14;\nvar foodY:Number = 7;\nvar score:Number = 0;\nvar highScore:Number = 0;\nvar gameOver:Boolean = false;\nvar paused:Boolean = false;\nvar tickCount:Number = 0;\nvar moveInterval:Number = 4;\nvar rngSeed:Number = 1337;\nvar boardCanvas:MovieClip = this.createEmptyMovieClip(\"boardCanvas\", 100);\nboardCanvas._x = boardX;\nboardCanvas._y = boardY;\nvar canvasDirty:Boolean = false;\nvar foodClip:Object = this.food;\nvar scoreField:Object = this.scoreText;\nvar highField:Object = this.highScoreText;\nvar statusField:Object = this.statusText;\nvar lastScoreStr:String = \"\";\nvar lastHighStr:String = \"\";\nvar lastStatusStr:String = \"\";\nvar segClips:Array = [];\nvar initIdx:Number = 0;\nwhile (initIdx < maxVisibleSegments) {\n  segClips[initIdx] = this[\"seg\" + initIdx];\n  initIdx = initIdx + 1;\n}\n\nfunction nextRandom(maxVal:Number):Number {\n  rngSeed = (rngSeed * 1103515245 + 12345) & 2147483647;\n  return rngSeed % maxVal;\n}\n\nfunction isOccupied(gx:Number, gy:Number):Boolean {\n  var i:Number = 0;\n  while (i < snakeX.length) {\n    if (snakeX[i] == gx && snakeY[i] == gy) {\n      return true;\n    }\n    i = i + 1;\n  }\n  return false;\n}\n\nfunction placeFood():Void {\n  var attempts:Number = 0;\n  var candidateX:Number = nextRandom(gridCols);\n  var candidateY:Number = nextRandom(gridRows);\n  while (isOccupied(candidateX, candidateY) && attempts < 300) {\n    candidateX = (candidateX + 1) % gridCols;\n    if (candidateX == 0) {\n      candidateY = (candidateY + 1) % gridRows;\n    }\n    attempts = attempts + 1;\n  }\n  foodX = candidateX;\n  foodY = candidateY;\n  if (foodClip != undefined) {\n    foodClip._x = boardX + foodX * cellSize + cellSize / 2;\n    foodClip._y = boardY + foodY * cellSize + cellSize / 2;\n  }\n}\n\nfunction updateHud():Void {\n  if (scoreField != undefined) {\n    var nextScore:String = \"SCORE: \" + score;\n    if (nextScore != lastScoreStr) {\n      lastScoreStr = nextScore;\n      scoreField.text = nextScore;\n    }\n  }\n  if (highField != undefined) {\n    var nextHigh:String = \"HIGH: \" + highScore;\n    if (nextHigh != lastHighStr) {\n      lastHighStr = nextHigh;\n      highField.text = nextHigh;\n    }\n  }\n  if (statusField != undefined) {\n    var nextStatus:String = gameOver ? \"GAME OVER - PRESS R\" : (paused ? \"PAUSED\" : \"PLAYING\");\n    if (nextStatus != lastStatusStr) {\n      lastStatusStr = nextStatus;\n      statusField.text = nextStatus;\n    }\n  }\n}\n\nfunction renderSnake():Void {\n  var i:Number = 0;\n  while (i < maxVisibleSegments) {\n    var segClip = segClips[i];\n    if (segClip != undefined) {\n      if (i < snakeX.length) {\n        segClip._visible = true;\n        segClip._x = boardX + snakeX[i] * cellSize + cellSize / 2;\n        segClip._y = boardY + snakeY[i] * cellSize + cellSize / 2;\n      } else {\n        segClip._visible = false;\n      }\n    }\n    i = i + 1;\n  }\n  if (boardCanvas != undefined && (snakeX.length > maxVisibleSegments || canvasDirty)) {\n    boardCanvas.clear();\n    canvasDirty = snakeX.length > maxVisibleSegments;\n    var j:Number = maxVisibleSegments;\n    while (j < snakeX.length) {\n      var px:Number = snakeX[j] * cellSize + 2;\n      var py:Number = snakeY[j] * cellSize + 2;\n      boardCanvas.beginFill(0x4ADE80, 100);\n      boardCanvas.moveTo(px, py);\n      boardCanvas.lineTo(px + cellSize - 4, py);\n      boardCanvas.lineTo(px + cellSize - 4, py + cellSize - 4);\n      boardCanvas.lineTo(px, py + cellSize - 4);\n      boardCanvas.lineTo(px, py);\n      boardCanvas.endFill();\n      j = j + 1;\n    }\n  }\n}\n\nfunction setDirection(dx:Number, dy:Number):Void {\n  if (dx == 0 && dy == 0) {\n    return;\n  }\n  if (dx == -dirX && dy == -dirY) {\n    return;\n  }\n  nextDirX = dx;\n  nextDirY = dy;\n}\n\nfunction resetGame():Void {\n  snakeX = [10, 9, 8];\n  snakeY = [7, 7, 7];\n  dirX = 1;\n  dirY = 0;\n  nextDirX = 1;\n  nextDirY = 0;\n  score = 0;\n  gameOver = false;\n  paused = false;\n  tickCount = 0;\n  placeFood();\n  renderSnake();\n  updateHud();\n}\n\nfunction stepSnake():Boolean {\n  if (gameOver || paused) {\n    return false;\n  }\n  dirX = nextDirX;\n  dirY = nextDirY;\n  var newHeadX:Number = snakeX[0] + dirX;\n  var newHeadY:Number = snakeY[0] + dirY;\n  if (newHeadX < 0 || newHeadX >= gridCols || newHeadY < 0 || newHeadY >= gridRows) {\n    gameOver = true;\n    updateHud();\n    return false;\n  }\n  var eatFood:Boolean = (newHeadX == foodX && newHeadY == foodY);\n  var checkLimit:Number = eatFood ? snakeX.length : (snakeX.length - 1);\n  var k:Number = 0;\n  while (k < checkLimit) {\n    if (snakeX[k] == newHeadX && snakeY[k] == newHeadY) {\n      gameOver = true;\n      updateHud();\n      return false;\n    }\n    k = k + 1;\n  }\n  snakeX.unshift(newHeadX);\n  snakeY.unshift(newHeadY);\n  if (eatFood) {\n    score = score + 10;\n    if (score > highScore) {\n      highScore = score;\n    }\n    placeFood();\n  } else {\n    snakeX.pop();\n    snakeY.pop();\n  }\n  renderSnake();\n  updateHud();\n  return true;\n}\n\nthis.onKeyDown = function():Void {\n  var code:Number = Key.getCode();\n  if (code == Key.LEFT || code == 65) {\n    setDirection(-1, 0);\n  } else if (code == Key.RIGHT || code == 68) {\n    setDirection(1, 0);\n  } else if (code == Key.UP || code == 87) {\n    setDirection(0, -1);\n  } else if (code == Key.DOWN || code == 83) {\n    setDirection(0, 1);\n  } else if (code == 82) {\n    resetGame();\n  } else if (code == 80) {\n    paused = !paused;\n    updateHud();\n  }\n};\nKey.addListener(this);\n\nthis.onEnterFrame = function():Void {\n  if (gameOver || paused) {\n    return;\n  }\n  tickCount = tickCount + 1;\n  if (tickCount >= moveInterval) {\n    tickCount = 0;\n    stepSnake();\n  }\n};\n\nresetGame();\n"
            }
          }
