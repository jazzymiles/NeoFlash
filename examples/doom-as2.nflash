            "script": {
              "language": "action_script2",
              "source": "import flash.display.BitmapData;\nimport flash.geom.Matrix;\nimport doom.LevelData;\nimport doom.TexGen;\n\nstop();\n\n// --- Viewport & High-Res 320-Column Raycaster Constants ---\nvar STAGE_W:Number = 640;\nvar STAGE_H:Number = 400;\nvar VIEW_W:Number = 640;\nvar VIEW_H:Number = 336;\nvar NUM_COLS:Number = 320; // Upgraded from 160 -> 320 crisp 2px VGA columns!\nvar COL_W:Number = 2;      // 320 * 2 = 640\nvar MAP_W:Number = LevelData.MAP_W;\nvar MAP_H:Number = LevelData.MAP_H;\n\n// --- Assets & Scene Clips ---\nvar skyBmp:BitmapData = TexGen.buildSkybox();\nvar wallBank:Array = TexGen.buildWallBank();\nvar sprites:Object = TexGen.buildSprites();\nvar reusableMat:Matrix = new Matrix();\nvar skyMat:Matrix = new Matrix();\nvar floorMat:Matrix = new Matrix();\nfloorMat.createGradientBox(VIEW_W, VIEW_H * 0.5, Math.PI * 0.5, 0, VIEW_H * 0.5);\n\nvar worldHolder:MovieClip = this.worldContainer;\nif (worldHolder == undefined) {\n  worldHolder = this.createEmptyMovieClip(\"worldDynamic\", 1);\n}\nvar viewClip:MovieClip = worldHolder.createEmptyMovieClip(\"viewClip\", 10);\nvar weaponClip:MovieClip = worldHolder.createEmptyMovieClip(\"weaponClip\", 20);\nvar fxClip:MovieClip = worldHolder.createEmptyMovieClip(\"fxClip\", 30);\nvar automapClip:MovieClip = worldHolder.createEmptyMovieClip(\"automapClip\", 40);\n\nvar faceHolder:MovieClip = this.marineFaceClip;\nvar faceCanvas:MovieClip = (faceHolder != undefined)\n  ? faceHolder.createEmptyMovieClip(\"faceArt\", 10)\n  : this.createEmptyMovieClip(\"faceArtFallback\", 500);\nif (faceHolder == undefined) {\n  faceCanvas._x = 320;\n  faceCanvas._y = 368;\n}\n\n// --- Sound Bank (imported via --headless import) ---\nvar sfx:Object = {};\nfunction loadSfx(name:String):Sound {\n  var snd:Sound = new Sound();\n  snd.attachSound(name);\n  snd.setVolume(75);\n  return snd;\n}\nsfx.pistol = loadSfx(\"pistol\");\nsfx.shotgun = loadSfx(\"shotgun\");\nsfx.door = loadSfx(\"door\");\nsfx.impPain = loadSfx(\"imp_pain\");\nsfx.impDeath = loadSfx(\"imp_death\");\nsfx.pickup = loadSfx(\"pickup\");\nsfx.hurt = loadSfx(\"hurt\");\nsfx.win = loadSfx(\"win\");\n\nfunction playSfx(snd:Sound, pan:Number, vol:Number):Void {\n  if (snd == undefined) { return; }\n  var clampedPan:Number = Math.max(-100, Math.min(100, Math.round(pan)));\n  var clampedVol:Number = Math.max(0, Math.min(100, Math.round(vol)));\n  snd.setVolume(clampedVol);\n  snd.setPan(clampedPan);\n  snd.start(0, 1);\n}\n\n// --- Game State ---\nvar grid:Array = [];\nvar doorOpen:Array = [];\nvar doorOpening:Array = [];\nvar enemies:Array = [];\nvar items:Array = [];\nvar fireballs:Array = [];\nvar zBuf:Array = [];\n\nvar posX:Number = 2.5;\nvar posY:Number = 3.5; // Centered on Hangar corridor facing Blast Door (6, 3) straight ahead!\nvar dirX:Number = 1.0;\nvar dirY:Number = 0.0;\nvar planeX:Number = 0.0;\nvar planeY:Number = 0.66;\n\nvar health:Number = 100;\nvar armor:Number = 0;\nvar shells:Number = 12;\nvar hasShotgun:Boolean = false;\nvar hasYellowKey:Boolean = false;\nvar curWeapon:Number = 1; // 1 = Pistol, 2 = Shotgun\nvar fireCooldown:Number = 0;\nvar muzzleFrames:Number = 0;\nvar walkPhase:Number = 0;\nvar hurtFlash:Number = 0;\nvar pickupFlash:Number = 0;\nvar faceGlance:Number = 0;\nvar faceTimer:Number = 0;\nvar grinTimer:Number = 0;\n\nvar kills:Number = 0;\nvar totalEnemies:Number = 0;\nvar itemsPicked:Number = 0;\nvar totalItems:Number = 0;\nvar exitActivated:Boolean = false;\nvar gameOver:Boolean = false;\nvar levelCleared:Boolean = false;\nvar showAutomap:Boolean = false;\nvar tickCount:Number = 0;\nvar levelStartMs:Number = getTimer();\nvar clearTimeSec:Number = 0;\n\nvar hudMessage:String = \"\";\nvar hudMsgTimer:Number = 0;\nvar fpsDisplay:Number = 30;\nvar lastFpsSampleMs:Number = getTimer();\nvar framesSinceSample:Number = 0;\nvar lastFrameCostMs:Number = 0;\nvar lastAmmoStr:String = \"\";\nvar lastHealthStr:String = \"\";\nvar lastArmorStr:String = \"\";\nvar lastArmsStr:String = \"\";\nvar lastKillsStr:String = \"\";\nvar lastBannerStr:String = \"\";\n\nfunction showMsg(msg:String, frames:Number):Void {\n  hudMessage = msg;\n  hudMsgTimer = frames;\n  if (this.msgText != undefined) {\n    this.msgText.text = msg;\n  }\n}\n\nfunction resetLevel():Void {\n  grid = LevelData.createGrid();\n  doorOpen = [];\n  doorOpening = [];\n  var i:Number = 0;\n  while (i < MAP_W * MAP_H) {\n    doorOpen[i] = 0.0;\n    doorOpening[i] = 0;\n    i = i + 1;\n  }\n\n  var rawEnemies:Array = LevelData.createEnemies();\n  enemies = [];\n  i = 0;\n  while (i < rawEnemies.length) {\n    var e:Object = rawEnemies[i];\n    enemies.push({\n      kind: e.kind,\n      x: e.x,\n      y: e.y,\n      hp: e.hp,\n      maxHp: e.maxHp,\n      alive: true,\n      alerted: false,\n      painTimer: 0,\n      attackTimer: 0,\n      cooldown: 24 + (i * 9) % 25\n    });\n    i = i + 1;\n  }\n  totalEnemies = enemies.length;\n\n  var rawItems:Array = LevelData.createItems();\n  items = [];\n  i = 0;\n  while (i < rawItems.length) {\n    items.push({ kind: rawItems[i].kind, x: rawItems[i].x, y: rawItems[i].y, taken: false });\n    i = i + 1;\n  }\n  totalItems = items.length;\n  fireballs = [];\n\n  posX = 2.5;\n  posY = 3.5;\n  dirX = 1.0;\n  dirY = 0.0;\n  planeX = 0.0;\n  planeY = 0.66;\n\n  health = 100;\n  armor = 0;\n  shells = 12;\n  hasShotgun = false;\n  hasYellowKey = false;\n  curWeapon = 1;\n  fireCooldown = 0;\n  muzzleFrames = 0;\n  walkPhase = 0;\n  hurtFlash = 0;\n  pickupFlash = 0;\n  grinTimer = 0;\n  kills = 0;\n  itemsPicked = 0;\n  exitActivated = false;\n  gameOver = false;\n  levelCleared = false;\n  showAutomap = false;\n  tickCount = 0;\n  levelStartMs = getTimer();\n  lastAmmoStr = \"\";\n  lastHealthStr = \"\";\n  lastArmorStr = \"\";\n  lastArmsStr = \"\";\n  lastKillsStr = \"\";\n  lastBannerStr = \" \";\n\n  showMsg(\"E1M1 HANGAR · WASD:MOVE  ARROWS:TURN  SPACE/E:OPEN DOOR  F/CLICK:FIRE  M:MAP\", 180);\n  updateHudText();\n  drawMarineFace();\n  trace(\"[DOOM-AS2] Level initialized: map=\" + MAP_W + \"x\" + MAP_H + \" enemies=\" + totalEnemies + \" items=\" + totalItems + \" cols=\" + NUM_COLS);\n}\n\nfunction tileAt(mx:Number, my:Number):Number {\n  if (mx < 0 || my < 0 || mx >= MAP_W || my >= MAP_H) { return 1; }\n  return grid[my * MAP_W + mx];\n}\n\nfunction isPassableForActor(x:Number, y:Number, radius:Number):Boolean {\n  var x0:Number = Math.floor(x - radius);\n  var x1:Number = Math.floor(x + radius);\n  var y0:Number = Math.floor(y - radius);\n  var y1:Number = Math.floor(y + radius);\n  var ty:Number = y0;\n  while (ty <= y1) {\n    var tx:Number = x0;\n    while (tx <= x1) {\n      var cell:Number = tileAt(tx, ty);\n      if (cell != 0) {\n        if ((cell == 4 || cell == 5) && doorOpen[ty * MAP_W + tx] >= 0.85) {\n          // Open door allows passage\n        } else {\n          return false;\n        }\n      }\n      tx = tx + 1;\n    }\n    ty = ty + 1;\n  }\n  return true;\n}\n\nfunction rotatePlayer(angle:Number):Void {\n  var c:Number = Math.cos(angle);\n  var s:Number = Math.sin(angle);\n  var oldDirX:Number = dirX;\n  dirX = dirX * c - dirY * s;\n  dirY = oldDirX * s + dirY * c;\n  var oldPlaneX:Number = planeX;\n  planeX = planeX * c - planeY * s;\n  planeY = oldPlaneX * s + planeY * c;\n}\n\nfunction tryMovePlayer(dx:Number, dy:Number):Void {\n  var r:Number = 0.24;\n  if (isPassableForActor(posX + dx, posY, r)) {\n    posX = posX + dx;\n  }\n  if (isPassableForActor(posX, posY + dy, r)) {\n    posY = posY + dy;\n  }\n}\n\nfunction hasLineOfSight(ax:Number, ay:Number, bx:Number, by:Number):Boolean {\n  var dx:Number = bx - ax;\n  var dy:Number = by - ay;\n  var dist:Number = Math.sqrt(dx * dx + dy * dy);\n  var steps:Number = Math.ceil(dist * 6);\n  var s:Number = 1;\n  while (s < steps) {\n    var t:Number = s / steps;\n    var cx:Number = Math.floor(ax + dx * t);\n    var cy:Number = Math.floor(ay + dy * t);\n    var cell:Number = tileAt(cx, cy);\n    if (cell != 0 && !((cell == 4 || cell == 5) && doorOpen[cy * MAP_W + cx] >= 0.80)) {\n      return false;\n    }\n    s = s + 1;\n  }\n  return true;\n}\n\nfunction tryUseAhead():Boolean {\n  var d:Number = 0.40;\n  while (d <= 1.80) {\n    var tx:Number = Math.floor(posX + dirX * d);\n    var ty:Number = Math.floor(posY + dirY * d);\n    var cell:Number = tileAt(tx, ty);\n    var idx:Number = ty * MAP_W + tx;\n    if (cell == 4) {\n      if (doorOpening[idx] == 0 && doorOpen[idx] < 0.95) {\n        doorOpening[idx] = 1;\n        playSfx(sfx.door, 0, 80);\n        showMsg(\"UAC BLAST DOOR OPENING\", 55);\n        trace(\"[DOOM-AS2] DOOR_OPEN (\" + tx + \",\" + ty + \")\");\n      }\n      return true;\n    } else if (cell == 5) {\n      if (!hasYellowKey) {\n        playSfx(sfx.hurt, 0, 45);\n        showMsg(\"LOCKED — YOU NEED THE YELLOW KEYCARD!\", 75);\n        return true;\n      }\n      if (doorOpening[idx] == 0 && doorOpen[idx] < 0.95) {\n        doorOpening[idx] = 1;\n        playSfx(sfx.door, 0, 85);\n        showMsg(\"YELLOW SECURITY DOOR UNLOCKED!\", 70);\n      }\n      return true;\n    } else if (cell == 6) {\n      exitActivated = true;\n      levelCleared = true;\n      clearTimeSec = Math.max(1, Math.round((getTimer() - levelStartMs) / 1000));\n      playSfx(sfx.win, 0, 90);\n      showMsg(\"E1M1 HANGAR COMPLETE! PRESS R TO PLAY AGAIN\", 300);\n      trace(\"[DOOM-AS2] LEVEL CLEARED kills=\" + kills + \"/\" + totalEnemies + \" items=\" + itemsPicked + \"/\" + totalItems + \" time=\" + clearTimeSec + \"s\");\n      return true;\n    }\n    d = d + 0.35;\n  }\n  return false;\n}\n\nfunction damagePlayer(amount:Number, srcX:Number, srcY:Number):Void {\n  if (gameOver || levelCleared) { return; }\n  var absorbed:Number = 0;\n  if (armor > 0) {\n    absorbed = Math.min(armor, Math.floor(amount * 0.4));\n    armor = armor - absorbed;\n  }\n  var hpLoss:Number = Math.max(1, amount - absorbed);\n  health = health - hpLoss;\n  hurtFlash = 8;\n  var relPan:Number = ((srcX - posX) * (-dirY) + (srcY - posY) * dirX) * 25;\n  playSfx(sfx.hurt, relPan, 80);\n  if (health <= 0) {\n    health = 0;\n    gameOver = true;\n    showMsg(\"YOU DIED — PRESS R TO RESTART LEVEL\", 600);\n    trace(\"[DOOM-AS2] PLAYER DIED\");\n  }\n  drawMarineFace();\n}\n\nfunction fireWeapon():Void {\n  if (gameOver || levelCleared || fireCooldown > 0) { return; }\n  var useShotgun:Boolean = (curWeapon == 2 && hasShotgun && shells > 0);\n  if (curWeapon == 2 && (!hasShotgun || shells <= 0)) {\n    curWeapon = 1;\n    useShotgun = false;\n  }\n\n  var pellets:Number = useShotgun ? 7 : 1;\n  var spreadRange:Number = useShotgun ? 0.17 : 0.025;\n  var dmgPerPellet:Number = useShotgun ? 16 : 22;\n\n  if (useShotgun) {\n    shells = shells - 1;\n    fireCooldown = 16;\n    muzzleFrames = 4;\n    playSfx(sfx.shotgun, 0, 88);\n  } else {\n    fireCooldown = 7;\n    muzzleFrames = 3;\n    playSfx(sfx.pistol, 0, 75);\n  }\n\n  // Alert monsters only if they have line of sight OR are in the same open sector (< 7 tiles & not behind a closed door!)\n  var ei:Number = 0;\n  while (ei < enemies.length) {\n    var m:Object = enemies[ei];\n    if (m.alive) {\n      var sdx:Number = m.x - posX;\n      var sdy:Number = m.y - posY;\n      if (sdx * sdx + sdy * sdy < 64 && hasLineOfSight(m.x, m.y, posX, posY)) {\n        m.alerted = true;\n      }\n    }\n    ei = ei + 1;\n  }\n\n  var p:Number = 0;\n  while (p < pellets) {\n    var offsetAngle:Number = ((p + 0.5) / pellets - 0.5) * spreadRange * 2.0;\n    if (pellets == 1) { offsetAngle = 0; }\n    var rayCos:Number = dirX * Math.cos(offsetAngle) - dirY * Math.sin(offsetAngle);\n    var raySin:Number = dirX * Math.sin(offsetAngle) + dirY * Math.cos(offsetAngle);\n\n    var maxDist:Number = 18.0;\n    var stepD:Number = 0.1;\n    var wallDist:Number = maxDist;\n    while (stepD < maxDist) {\n      var wx:Number = Math.floor(posX + rayCos * stepD);\n      var wy:Number = Math.floor(posY + raySin * stepD);\n      var wc:Number = tileAt(wx, wy);\n      if (wc != 0 && !((wc == 4 || wc == 5) && doorOpen[wy * MAP_W + wx] >= 0.85)) {\n        wallDist = stepD;\n        break;\n      }\n      stepD = stepD + 0.12;\n    }\n\n    var bestIdx:Number = -1;\n    var bestDist:Number = wallDist;\n    ei = 0;\n    while (ei < enemies.length) {\n      var en:Object = enemies[ei];\n      if (en.alive) {\n        var vx:Number = en.x - posX;\n        var vy:Number = en.y - posY;\n        var proj:Number = vx * rayCos + vy * raySin;\n        if (proj > 0.2 && proj < bestDist) {\n          var perp:Number = Math.abs(vx * (-raySin) + vy * rayCos);\n          if (perp < 0.42) {\n            bestDist = proj;\n            bestIdx = ei;\n          }\n        }\n      }\n      ei = ei + 1;\n    }\n\n    if (bestIdx >= 0) {\n      var target:Object = enemies[bestIdx];\n      target.hp = target.hp - dmgPerPellet;\n      target.alerted = true;\n      target.painTimer = 5;\n      if (target.hp <= 0) {\n        target.alive = false;\n        kills = kills + 1;\n        playSfx(sfx.impDeath, 0, 82);\n        if (target.kind == 2) {\n          items.push({ kind: 2, x: target.x, y: target.y, taken: false });\n          showMsg(\"SERGEANT DOWN! DROPPED SHELLS\", 50);\n        } else {\n          showMsg(\"IMP SLAIN! (\" + kills + \"/\" + totalEnemies + \")\", 45);\n        }\n      } else {\n        playSfx(sfx.impPain, 0, 65);\n      }\n    }\n    p = p + 1;\n  }\n}\n\nfunction updateDoorsAndPickups():Void {\n  var i:Number = 0;\n  while (i < MAP_W * MAP_H) {\n    if (doorOpening[i] == 1) {\n      doorOpen[i] = Math.min(1.0, doorOpen[i] + 0.08);\n      if (doorOpen[i] >= 1.0) {\n        doorOpening[i] = 2;\n      }\n    }\n    i = i + 1;\n  }\n\n  i = 0;\n  while (i < items.length) {\n    var it:Object = items[i];\n    if (!it.taken) {\n      var dx:Number = it.x - posX;\n      var dy:Number = it.y - posY;\n      if (dx * dx + dy * dy < 0.52) {\n        var picked:Boolean = false;\n        if (it.kind == 1 && armor < 100) {\n          armor = Math.min(100, armor + 50);\n          showMsg(\"PICKED UP GREEN SECURITY ARMOR (+50%)\", 65);\n          picked = true;\n        } else if (it.kind == 2 && shells < 50) {\n          shells = Math.min(50, shells + 8);\n          showMsg(\"PICKED UP SHOTGUN SHELLS (+8)\", 55);\n          picked = true;\n        } else if (it.kind == 3) {\n          hasShotgun = true;\n          curWeapon = 2;\n          shells = Math.min(50, shells + 8);\n          grinTimer = 45;\n          showMsg(\"YOU GOT THE PUMP SHOTGUN!\", 90);\n          picked = true;\n        } else if (it.kind == 4 && health < 100) {\n          health = Math.min(100, health + 30);\n          showMsg(\"PICKED UP A MEDIKIT (+30% HEALTH)\", 65);\n          picked = true;\n        } else if (it.kind == 5) {\n          hasYellowKey = true;\n          showMsg(\"PICKED UP THE YELLOW KEYCARD!\", 95);\n          picked = true;\n        }\n        if (picked) {\n          it.taken = true;\n          if (i < totalItems) { itemsPicked = itemsPicked + 1; }\n          pickupFlash = 5;\n          playSfx(sfx.pickup, 0, 75);\n          drawMarineFace();\n          trace(\"[DOOM-AS2] PICKUP kind=\" + it.kind + \" items=\" + itemsPicked + \"/\" + totalItems);\n        }\n      }\n    }\n    i = i + 1;\n  }\n}\n\nfunction updateEnemiesAndProjectiles():Void {\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var e:Object = enemies[i];\n    if (e.alive) {\n      if (e.painTimer > 0) { e.painTimer = e.painTimer - 1; }\n      if (e.attackTimer > 0) { e.attackTimer = e.attackTimer - 1; }\n      var dx:Number = posX - e.x;\n      var dy:Number = posY - e.y;\n      var dist:Number = Math.sqrt(dx * dx + dy * dy);\n      var los:Boolean = (dist < 11.0) ? hasLineOfSight(e.x, e.y, posX, posY) : false;\n      if (los) { e.alerted = true; }\n\n      if (e.alerted && e.painTimer == 0) {\n        if (dist > 1.65 && e.attackTimer == 0) {\n          var spd:Number = (e.kind == 1) ? 0.036 : 0.028;\n          var mx:Number = (dx / dist) * spd;\n          var my:Number = (dy / dist) * spd;\n          if (isPassableForActor(e.x + mx, e.y, 0.28)) { e.x = e.x + mx; }\n          if (isPassableForActor(e.x, e.y + my, 0.28)) { e.y = e.y + my; }\n        }\n        e.cooldown = e.cooldown - 1;\n        if (e.cooldown <= 0 && los) {\n          e.attackTimer = 10;\n          if (e.kind == 1) {\n            e.cooldown = 48;\n            if (dist < 1.55) {\n              damagePlayer(12, e.x, e.y);\n            } else {\n              fireballs.push({\n                x: e.x + (dx / dist) * 0.35,\n                y: e.y + (dy / dist) * 0.35,\n                vx: (dx / dist) * 0.16,\n                vy: (dy / dist) * 0.16,\n                life: 95\n              });\n            }\n          } else {\n            e.cooldown = 56;\n            playSfx(sfx.shotgun, 0, 55);\n            var hitChance:Number = Math.max(0.25, 0.88 - dist * 0.06);\n            if (((tickCount * 13 + i * 7) % 100) / 100 < hitChance) {\n              damagePlayer(14, e.x, e.y);\n            }\n          }\n        }\n      }\n    }\n    i = i + 1;\n  }\n\n  var fbIdx:Number = fireballs.length - 1;\n  while (fbIdx >= 0) {\n    var fb:Object = fireballs[fbIdx];\n    fb.x = fb.x + fb.vx;\n    fb.y = fb.y + fb.vy;\n    fb.life = fb.life - 1;\n    var fCell:Number = tileAt(Math.floor(fb.x), Math.floor(fb.y));\n    var blocked:Boolean = (fCell != 0 && !((fCell == 4 || fCell == 5) && doorOpen[Math.floor(fb.y) * MAP_W + Math.floor(fb.x)] >= 0.85));\n    var pdx:Number = fb.x - posX;\n    var pdy:Number = fb.y - posY;\n    if (pdx * pdx + pdy * pdy < 0.22) {\n      damagePlayer(15, fb.x, fb.y);\n      fireballs.splice(fbIdx, 1);\n    } else if (blocked || fb.life <= 0) {\n      fireballs.splice(fbIdx, 1);\n    }\n    fbIdx = fbIdx - 1;\n  }\n}\n\n// --- 3D Raycaster + Phobos Skybox + Sprite Billboard Z-Buffer Renderer ---\nfunction render3DView():Void {\n  viewClip.clear();\n\n  // 1. Panoramic scrolling Phobos Martian Skybox (upper 168px) + shaded industrial floor deck\n  var yaw:Number = Math.atan2(dirY, dirX);\n  if (yaw < 0) { yaw = yaw + Math.PI * 2.0; }\n  var skyScrollX:Number = -Math.floor((yaw / (Math.PI * 2.0)) * 512.0 * 2.0);\n  skyMat.a = 1.25;\n  skyMat.b = 0;\n  skyMat.c = 0;\n  skyMat.d = 1.0;\n  skyMat.tx = skyScrollX;\n  skyMat.ty = 0;\n  viewClip.beginBitmapFill(skyBmp, skyMat, true, true);\n  viewClip.moveTo(0, 0);\n  viewClip.lineTo(VIEW_W, 0);\n  viewClip.lineTo(VIEW_W, VIEW_H * 0.5);\n  viewClip.lineTo(0, VIEW_H * 0.5);\n  viewClip.endFill();\n\n  var flashBoost:Number = (muzzleFrames > 0) ? 0x181208 : 0;\n  viewClip.beginGradientFill(\"linear\", [0x121012 + flashBoost, 0x352D28 + flashBoost], [100, 100], [0, 255], floorMat);\n  viewClip.moveTo(0, VIEW_H * 0.5);\n  viewClip.lineTo(VIEW_W, VIEW_H * 0.5);\n  viewClip.lineTo(VIEW_W, VIEW_H);\n  viewClip.lineTo(0, VIEW_H);\n  viewClip.endFill();\n\n  // Perspective floor depth bands for strong 3D ground motion cue\n  var band:Number = 0;\n  while (band < 5) {\n    var by0:Number = 176 + band * 28 + ((Math.floor(posX * 4 + posY * 4) * 3) % 14);\n    if (by0 < VIEW_H - 3) {\n      viewClip.beginFill(0x0B0A0C, 22 - band * 3);\n      viewClip.moveTo(0, by0);\n      viewClip.lineTo(VIEW_W, by0);\n      viewClip.lineTo(VIEW_W, by0 + 2);\n      viewClip.lineTo(0, by0 + 2);\n      viewClip.endFill();\n    }\n    band = band + 1;\n  }\n\n  // 2. 320-column DDA Wall & Recessed Sliding-Door Raycaster\n  var col:Number = 0;\n  while (col < NUM_COLS) {\n    var cameraX:Number = 2.0 * col / NUM_COLS - 1.0;\n    var rayDirX:Number = dirX + planeX * cameraX;\n    var rayDirY:Number = dirY + planeY * cameraX;\n\n    var mapX:Number = Math.floor(posX);\n    var mapY:Number = Math.floor(posY);\n\n    var deltaDistX:Number = (Math.abs(rayDirX) < 0.00001) ? 1000000.0 : Math.abs(1.0 / rayDirX);\n    var deltaDistY:Number = (Math.abs(rayDirY) < 0.00001) ? 1000000.0 : Math.abs(1.0 / rayDirY);\n\n    var stepX:Number = 0;\n    var stepY:Number = 0;\n    var sideDistX:Number = 0;\n    var sideDistY:Number = 0;\n\n    if (rayDirX < 0) {\n      stepX = -1;\n      sideDistX = (posX - mapX) * deltaDistX;\n    } else {\n      stepX = 1;\n      sideDistX = (mapX + 1.0 - posX) * deltaDistX;\n    }\n    if (rayDirY < 0) {\n      stepY = -1;\n      sideDistY = (posY - mapY) * deltaDistY;\n    } else {\n      stepY = 1;\n      sideDistY = (mapY + 1.0 - posY) * deltaDistY;\n    }\n\n    var hitTile:Number = 0;\n    var side:Number = 0;\n    var perpDist:Number = 1.0;\n    var wallX:Number = 0.0;\n    var safety:Number = 0;\n\n    while (hitTile == 0 && safety < 40) {\n      safety = safety + 1;\n      if (sideDistX < sideDistY) {\n        sideDistX = sideDistX + deltaDistX;\n        mapX = mapX + stepX;\n        side = 0;\n      } else {\n        sideDistY = sideDistY + deltaDistY;\n        mapY = mapY + stepY;\n        side = 1;\n      }\n      var candidate:Number = tileAt(mapX, mapY);\n      if (candidate == 4 || candidate == 5) {\n        var openAmt:Number = doorOpen[mapY * MAP_W + mapX];\n        var doorDist:Number = (side == 0)\n          ? (sideDistX - deltaDistX * 0.5)\n          : (sideDistY - deltaDistY * 0.5);\n        var hitPos:Number = (side == 0)\n          ? (posY + doorDist * rayDirY)\n          : (posX + doorDist * rayDirX);\n        var frac:Number = hitPos - Math.floor(hitPos);\n        if (doorDist > 0.05 && frac >= openAmt) {\n          hitTile = candidate;\n          perpDist = doorDist;\n          wallX = frac - openAmt;\n        }\n      } else if (candidate > 0) {\n        hitTile = candidate;\n        perpDist = (side == 0) ? (sideDistX - deltaDistX) : (sideDistY - deltaDistY);\n        var rawWX:Number = (side == 0) ? (posY + perpDist * rayDirY) : (posX + perpDist * rayDirX);\n        wallX = rawWX - Math.floor(rawWX);\n      }\n    }\n\n    if (perpDist < 0.08) { perpDist = 0.08; }\n    zBuf[col] = perpDist;\n\n    var lineH:Number = VIEW_H / perpDist;\n    var rawTop:Number = (VIEW_H - lineH) * 0.5;\n    var drawTop:Number = Math.max(0, Math.floor(rawTop));\n    var drawBot:Number = Math.min(VIEW_H, Math.ceil(rawTop + lineH));\n\n    // Indoor Hangar & Reactor ceiling deck (Courtyard x>=7, y<=8 stays open to Phobos skybox!)\n    var indoorCeiling:Boolean = (mapX <= 6 || mapY >= 9);\n    if (indoorCeiling && drawTop > 0) {\n      var ceilCol:Number = (mapY >= 9) ? (0x240D12 + flashBoost) : (0x1A212B + flashBoost);\n      viewClip.beginFill(ceilCol, 100);\n      viewClip.moveTo(col * COL_W, 0);\n      viewClip.lineTo((col + 1) * COL_W, 0);\n      viewClip.lineTo((col + 1) * COL_W, drawTop);\n      viewClip.lineTo(col * COL_W, drawTop);\n      viewClip.endFill();\n    }\n\n    if (drawBot > drawTop && hitTile > 0) {\n      var texType:Number = (hitTile == 6 && exitActivated) ? 7 : hitTile;\n      var texX:Number = Math.floor(wallX * 64.0);\n      if (texX < 0) { texX = 0; }\n      if (texX > 63) { texX = 63; }\n\n      var lightIdx:Number = Math.floor(perpDist * 0.55) + ((side == 1) ? 1 : 0) - ((muzzleFrames > 0) ? 2 : 0);\n      if (lightIdx < 0) { lightIdx = 0; }\n      if (lightIdx >= TexGen.LIGHT_LEVELS) { lightIdx = TexGen.LIGHT_LEVELS - 1; }\n\n      var wallBmp:BitmapData = wallBank[texType * TexGen.LIGHT_LEVELS + lightIdx];\n      var sx:Number = col * COL_W;\n      reusableMat.a = COL_W;\n      reusableMat.b = 0;\n      reusableMat.c = 0;\n      reusableMat.d = lineH / 64.0;\n      reusableMat.tx = sx - texX * COL_W;\n      reusableMat.ty = rawTop;\n\n      viewClip.beginBitmapFill(wallBmp, reusableMat, false, false);\n      viewClip.moveTo(sx, drawTop);\n      viewClip.lineTo(sx + COL_W, drawTop);\n      viewClip.lineTo(sx + COL_W, drawBot);\n      viewClip.lineTo(sx, drawBot);\n      viewClip.endFill();\n    }\n\n    col = col + 1;\n  }\n\n  // 3. Collect & Depth-Sort 3D Billboards (Enemies, Pickups, Fireballs)\n  var drawList:Array = [];\n  var invDet:Number = 1.0 / (planeX * dirY - dirX * planeY);\n\n  var i:Number = 0;\n  while (i < enemies.length) {\n    var en:Object = enemies[i];\n    var bmpE:BitmapData = null;\n    if (!en.alive) {\n      bmpE = (en.kind == 1) ? sprites.impDead : sprites.sgtDead;\n    } else if (en.painTimer > 0) {\n      bmpE = (en.kind == 1) ? sprites.impPain : sprites.sgtPain;\n    } else if (en.attackTimer > 0 || ((Math.floor(tickCount / 8) + i) % 2 == 1 && en.alerted)) {\n      bmpE = (en.kind == 1) ? sprites.imp1 : sprites.sgt1;\n    } else {\n      bmpE = (en.kind == 1) ? sprites.imp0 : sprites.sgt0;\n    }\n    pushBillboard(drawList, en.x, en.y, bmpE, invDet);\n    i = i + 1;\n  }\n\n  i = 0;\n  while (i < items.length) {\n    if (!items[i].taken) {\n      pushBillboard(drawList, items[i].x, items[i].y, sprites[\"item\" + items[i].kind], invDet);\n    }\n    i = i + 1;\n  }\n\n  i = 0;\n  while (i < fireballs.length) {\n    pushBillboard(drawList, fireballs[i].x, fireballs[i].y, sprites.fireball, invDet);\n    i = i + 1;\n  }\n\n  i = 1;\n  while (i < drawList.length) {\n    var cur:Object = drawList[i];\n    var j:Number = i - 1;\n    while (j >= 0 && drawList[j].tz < cur.tz) {\n      drawList[j + 1] = drawList[j];\n      j = j - 1;\n    }\n    drawList[j + 1] = cur;\n    i = i + 1;\n  }\n\n  i = 0;\n  while (i < drawList.length) {\n    var sp:Object = drawList[i];\n    var sprSize:Number = Math.abs(VIEW_H / sp.tz);\n    var sprLeft:Number = sp.screenX - sprSize * 0.5;\n    var sprTop:Number = (VIEW_H - sprSize) * 0.5;\n    var drawY0:Number = Math.max(0, Math.floor(sprTop));\n    var drawY1:Number = Math.min(VIEW_H, Math.ceil(sprTop + sprSize));\n\n    var cStart:Number = Math.max(0, Math.floor(sprLeft / COL_W));\n    var cEnd:Number = Math.min(NUM_COLS - 1, Math.floor((sprLeft + sprSize) / COL_W));\n\n    if (drawY1 > drawY0 && cEnd >= cStart) {\n      var scale:Number = sprSize / 64.0;\n      reusableMat.a = scale;\n      reusableMat.b = 0;\n      reusableMat.c = 0;\n      reusableMat.d = scale;\n      reusableMat.tx = sprLeft;\n      reusableMat.ty = sprTop;\n\n      var c:Number = cStart;\n      while (c <= cEnd) {\n        if (sp.tz < zBuf[c]) {\n          var spanStart:Number = c;\n          while (c <= cEnd && sp.tz < zBuf[c]) {\n            c = c + 1;\n          }\n          var x0:Number = Math.max(sprLeft, spanStart * COL_W);\n          var x1:Number = Math.min(sprLeft + sprSize, c * COL_W);\n          if (x1 > x0) {\n            viewClip.beginBitmapFill(sp.bmp, reusableMat, false, false);\n            viewClip.moveTo(x0, drawY0);\n            viewClip.lineTo(x1, drawY0);\n            viewClip.lineTo(x1, drawY1);\n            viewClip.lineTo(x0, drawY1);\n            viewClip.endFill();\n          }\n        } else {\n          c = c + 1;\n        }\n      }\n    }\n    i = i + 1;\n  }\n}\n\nfunction pushBillboard(list:Array, wx:Number, wy:Number, bmp:BitmapData, invDet:Number):Void {\n  var sx:Number = wx - posX;\n  var sy:Number = wy - posY;\n  var tz:Number = invDet * (-planeY * sx + planeX * sy);\n  if (tz <= 0.14) { return; }\n  var tx:Number = invDet * (dirY * sx - dirX * sy);\n  var screenX:Number = (VIEW_W * 0.5) * (1.0 + tx / tz);\n  if (screenX < -160 || screenX > VIEW_W + 160) { return; }\n  list.push({ tz: tz, screenX: screenX, bmp: bmp });\n}\n\n// --- Detailed Shaded First-Person Weapon & Crosshair + Screen Flash ---\nfunction renderWeaponAndFx():Void {\n  weaponClip.clear();\n  var bobX:Number = Math.sin(walkPhase) * 8.5;\n  var bobY:Number = Math.abs(Math.cos(walkPhase)) * 5.5;\n  var kickY:Number = (fireCooldown > 0) ? Math.min(20, fireCooldown * 2.0) : 0;\n  var wx:Number = 320 + bobX;\n  var wy:Number = VIEW_H + bobY + kickY;\n\n  // Crisp tactical reticle with center dot\n  weaponClip.lineStyle(1.5, 0x4ADE80, 75);\n  weaponClip.moveTo(313, 168); weaponClip.lineTo(317, 168);\n  weaponClip.moveTo(323, 168); weaponClip.lineTo(327, 168);\n  weaponClip.moveTo(320, 161); weaponClip.lineTo(320, 165);\n  weaponClip.moveTo(320, 171); weaponClip.lineTo(320, 175);\n  weaponClip.lineStyle(undefined, 0, 0);\n\n  if (muzzleFrames > 0) {\n    weaponClip.beginFill(0xEA580C, 88);\n    weaponClip.moveTo(wx - 44, wy - 98);\n    weaponClip.lineTo(wx - 14, wy - 112);\n    weaponClip.lineTo(wx, wy - 148);\n    weaponClip.lineTo(wx + 14, wy - 112);\n    weaponClip.lineTo(wx + 44, wy - 98);\n    weaponClip.lineTo(wx + 16, wy - 84);\n    weaponClip.lineTo(wx - 16, wy - 84);\n    weaponClip.endFill();\n\n    weaponClip.beginFill(0xFEF08A, 96);\n    weaponClip.moveTo(wx - 22, wy - 98);\n    weaponClip.lineTo(wx, wy - 128);\n    weaponClip.lineTo(wx + 22, wy - 98);\n    weaponClip.lineTo(wx, wy - 86);\n    weaponClip.endFill();\n  }\n\n  if (curWeapon == 2 && hasShotgun) {\n    // SHADED PUMP-ACTION COMBAT SHOTGUN\n    var pumpShift:Number = (fireCooldown >= 5 && fireCooldown <= 11) ? 14 : 0;\n    // Outer blued-steel receiver & barrel shroud\n    weaponClip.beginFill(0x1E293B, 100);\n    weaponClip.moveTo(wx - 17, wy - 98);\n    weaponClip.lineTo(wx + 17, wy - 98);\n    weaponClip.lineTo(wx + 27, wy - 34);\n    weaponClip.lineTo(wx - 27, wy - 34);\n    weaponClip.endFill();\n    // Ventilated top barrel rib + metallic highlight\n    weaponClip.beginFill(0x475569, 100);\n    weaponClip.moveTo(wx - 11, wy - 96);\n    weaponClip.lineTo(wx + 11, wy - 96);\n    weaponClip.lineTo(wx + 17, wy - 38);\n    weaponClip.lineTo(wx - 17, wy - 38);\n    weaponClip.endFill();\n    weaponClip.beginFill(0x94A3B8, 100);\n    weaponClip.moveTo(wx - 4, wy - 96);\n    weaponClip.lineTo(wx + 4, wy - 96);\n    weaponClip.lineTo(wx + 6, wy - 42);\n    weaponClip.lineTo(wx - 6, wy - 42);\n    weaponClip.endFill();\n    // Tritium front sight post\n    weaponClip.beginFill(0xEF4444, 100);\n    weaponClip.moveTo(wx - 2, wy - 102);\n    weaponClip.lineTo(wx + 2, wy - 102);\n    weaponClip.lineTo(wx + 2, wy - 96);\n    weaponClip.lineTo(wx - 2, wy - 96);\n    weaponClip.endFill();\n    // Walnut ribbed pump forend\n    weaponClip.beginFill(0x78350F, 100);\n    weaponClip.moveTo(wx - 24, wy - 58 + pumpShift);\n    weaponClip.lineTo(wx + 24, wy - 58 + pumpShift);\n    weaponClip.lineTo(wx + 31, wy - 22 + pumpShift);\n    weaponClip.lineTo(wx - 31, wy - 22 + pumpShift);\n    weaponClip.endFill();\n    weaponClip.beginFill(0xB45309, 100);\n    weaponClip.moveTo(wx - 16, wy - 55 + pumpShift);\n    weaponClip.lineTo(wx + 16, wy - 55 + pumpShift);\n    weaponClip.lineTo(wx + 21, wy - 26 + pumpShift);\n    weaponClip.lineTo(wx - 21, wy - 26 + pumpShift);\n    weaponClip.endFill();\n    // Armored leather marine gloves with brass knuckle plates\n    weaponClip.beginFill(0x5C2D16, 100);\n    weaponClip.moveTo(wx - 28, wy - 24);\n    weaponClip.lineTo(wx + 28, wy - 24);\n    weaponClip.lineTo(wx + 36, wy + 12);\n    weaponClip.lineTo(wx - 36, wy + 12);\n    weaponClip.endFill();\n    weaponClip.beginFill(0x3F6212, 100);\n    weaponClip.moveTo(wx - 20, wy - 14);\n    weaponClip.lineTo(wx + 20, wy - 14);\n    weaponClip.lineTo(wx + 24, wy + 4);\n    weaponClip.lineTo(wx - 24, wy + 4);\n    weaponClip.endFill();\n  } else {\n    // SHADED UAC 9MM SERVICE PISTOL\n    weaponClip.beginFill(0x1E293B, 100);\n    weaponClip.moveTo(wx - 13, wy - 88);\n    weaponClip.lineTo(wx + 13, wy - 88);\n    weaponClip.lineTo(wx + 19, wy - 34);\n    weaponClip.lineTo(wx - 19, wy - 34);\n    weaponClip.endFill();\n    weaponClip.beginFill(0x64748B, 100);\n    weaponClip.moveTo(wx - 9, wy - 86);\n    weaponClip.lineTo(wx + 9, wy - 86);\n    weaponClip.lineTo(wx + 13, wy - 38);\n    weaponClip.lineTo(wx - 13, wy - 38);\n    weaponClip.endFill();\n    weaponClip.beginFill(0xCBD5E1, 100);\n    weaponClip.moveTo(wx - 3, wy - 86);\n    weaponClip.lineTo(wx + 3, wy - 86);\n    weaponClip.lineTo(wx + 5, wy - 44);\n    weaponClip.lineTo(wx - 5, wy - 44);\n    weaponClip.endFill();\n    // Glowing green tritium iron sights\n    weaponClip.beginFill(0x4ADE80, 100);\n    weaponClip.moveTo(wx - 2, wy - 91);\n    weaponClip.lineTo(wx + 2, wy - 91);\n    weaponClip.lineTo(wx + 2, wy - 87);\n    weaponClip.lineTo(wx - 2, wy - 87);\n    weaponClip.endFill();\n    // Armored Doomguy hands gripping pistol\n    weaponClip.beginFill(0x6C3419, 100);\n    weaponClip.moveTo(wx - 24, wy - 36);\n    weaponClip.lineTo(wx + 24, wy - 36);\n    weaponClip.lineTo(wx + 32, wy + 12);\n    weaponClip.lineTo(wx - 32, wy + 12);\n    weaponClip.endFill();\n    weaponClip.beginFill(0x3F6212, 100);\n    weaponClip.moveTo(wx - 18, wy - 20);\n    weaponClip.lineTo(wx + 18, wy - 20);\n    weaponClip.lineTo(wx + 22, wy + 4);\n    weaponClip.lineTo(wx - 22, wy + 4);\n    weaponClip.endFill();\n  }\n\n  fxClip.clear();\n  if (gameOver) {\n    fxClip.beginFill(0x7F1D1D, 58);\n    fxClip.moveTo(0, 0); fxClip.lineTo(VIEW_W, 0); fxClip.lineTo(VIEW_W, VIEW_H); fxClip.lineTo(0, VIEW_H);\n    fxClip.endFill();\n  } else if (levelCleared) {\n    fxClip.beginFill(0x064E3B, 52);\n    fxClip.moveTo(0, 0); fxClip.lineTo(VIEW_W, 0); fxClip.lineTo(VIEW_W, VIEW_H); fxClip.lineTo(0, VIEW_H);\n    fxClip.endFill();\n  } else if (hurtFlash > 0) {\n    fxClip.beginFill(0xDC2626, hurtFlash * 6);\n    fxClip.moveTo(0, 0); fxClip.lineTo(VIEW_W, 0); fxClip.lineTo(VIEW_W, VIEW_H); fxClip.lineTo(0, VIEW_H);\n    fxClip.endFill();\n  } else if (pickupFlash > 0) {\n    fxClip.beginFill(0xFACC15, pickupFlash * 5);\n    fxClip.moveTo(0, 0); fxClip.lineTo(VIEW_W, 0); fxClip.lineTo(VIEW_W, VIEW_H); fxClip.lineTo(0, VIEW_H);\n    fxClip.endFill();\n  }\n}\n\n// --- Classic Doom Overhead Wireframe Automap (Tab / M) ---\nfunction renderAutomap():Void {\n  automapClip.clear();\n  if (!showAutomap) { return; }\n\n  var cellPx:Number = 18;\n  var ox:Number = 176;\n  var oy:Number = 26;\n\n  automapClip.beginFill(0x05070B, 90);\n  automapClip.lineStyle(2, 0xEF4444, 90);\n  automapClip.moveTo(ox - 10, oy - 10);\n  automapClip.lineTo(ox + MAP_W * cellPx + 10, oy - 10);\n  automapClip.lineTo(ox + MAP_W * cellPx + 10, oy + MAP_H * cellPx + 10);\n  automapClip.lineTo(ox - 10, oy + MAP_H * cellPx + 10);\n  automapClip.lineTo(ox - 10, oy - 10);\n  automapClip.endFill();\n  automapClip.lineStyle(undefined, 0, 0);\n\n  var y:Number = 0;\n  while (y < MAP_H) {\n    var x:Number = 0;\n    while (x < MAP_W) {\n      var t:Number = tileAt(x, y);\n      if (t != 0) {\n        var colHex:Number = 0x991B1B;\n        if (t == 4) { colHex = 0x94A3B8; }\n        else if (t == 5) { colHex = 0xEAB308; }\n        else if (t == 6) { colHex = 0x22C55E; }\n        automapClip.beginFill(colHex, (t == 4 || t == 5) && doorOpen[y * MAP_W + x] > 0.8 ? 35 : 95);\n        var px:Number = ox + x * cellPx;\n        var py:Number = oy + y * cellPx;\n        automapClip.moveTo(px, py);\n        automapClip.lineTo(px + cellPx - 1, py);\n        automapClip.lineTo(px + cellPx - 1, py + cellPx - 1);\n        automapClip.lineTo(px, py + cellPx - 1);\n        automapClip.endFill();\n      }\n      x = x + 1;\n    }\n    y = y + 1;\n  }\n\n  var ppx:Number = ox + posX * cellPx;\n  var ppy:Number = oy + posY * cellPx;\n  automapClip.lineStyle(2, 0x4ADE80, 100);\n  automapClip.moveTo(ppx, ppy);\n  automapClip.lineTo(ppx + dirX * 14, ppy + dirY * 14);\n  automapClip.lineStyle(undefined, 0, 0);\n  automapClip.beginFill(0xFFFFFF, 100);\n  automapClip.moveTo(ppx - 3, ppy - 3);\n  automapClip.lineTo(ppx + 3, ppy - 3);\n  automapClip.lineTo(ppx + 3, ppy + 3);\n  automapClip.lineTo(ppx - 3, ppy + 3);\n  automapClip.endFill();\n}\n\n// --- Sculpted Status Bar Doomguy Portrait ---\nfunction drawMarineFace():Void {\n  faceCanvas.clear();\n  // Recessed dark steel portrait bezel\n  faceCanvas.beginFill(0x0B0E14, 100);\n  faceCanvas.moveTo(-22, -25); faceCanvas.lineTo(22, -25);\n  faceCanvas.lineTo(22, 25); faceCanvas.lineTo(-22, 25);\n  faceCanvas.endFill();\n\n  // Olive UAC tactical helmet + specular dome + dark visor rim\n  faceCanvas.beginFill(0x365314, 100);\n  faceCanvas.moveTo(-19, -23); faceCanvas.lineTo(19, -23);\n  faceCanvas.lineTo(21, -8); faceCanvas.lineTo(-21, -8);\n  faceCanvas.endFill();\n  faceCanvas.beginFill(0x4D7C0F, 100);\n  faceCanvas.moveTo(-13, -22); faceCanvas.lineTo(13, -22);\n  faceCanvas.lineTo(15, -13); faceCanvas.lineTo(-15, -13);\n  faceCanvas.endFill();\n  faceCanvas.beginFill(0x1E293B, 100);\n  faceCanvas.moveTo(-18, -12); faceCanvas.lineTo(18, -12);\n  faceCanvas.lineTo(18, -8); faceCanvas.lineTo(-18, -8);\n  faceCanvas.endFill();\n\n  // Sculpted jawline & cheekbone shading\n  var skinCol:Number = (health < 35) ? 0xD99B78 : 0xF1BA93;\n  faceCanvas.beginFill(0xC68B63, 100);\n  faceCanvas.moveTo(-16, -8); faceCanvas.lineTo(16, -8);\n  faceCanvas.lineTo(13, 20); faceCanvas.lineTo(-13, 20);\n  faceCanvas.endFill();\n  faceCanvas.beginFill(skinCol, 100);\n  faceCanvas.moveTo(-13, -8); faceCanvas.lineTo(13, -8);\n  faceCanvas.lineTo(10, 18); faceCanvas.lineTo(-10, 18);\n  faceCanvas.endFill();\n\n  // Fierce angled eyebrows\n  faceCanvas.beginFill(0x451A03, 100);\n  faceCanvas.moveTo(-12, -6); faceCanvas.lineTo(-2, -4); faceCanvas.lineTo(-2, -2); faceCanvas.lineTo(-12, -4);\n  faceCanvas.moveTo(12, -6); faceCanvas.lineTo(2, -4); faceCanvas.lineTo(2, -2); faceCanvas.lineTo(12, -4);\n  faceCanvas.endFill();\n\n  // Glancing eyes\n  var eyeShift:Number = faceGlance * 2;\n  var eyeCol:Number = (health <= 0) ? 0xDC2626 : 0x0F172A;\n  faceCanvas.beginFill(0xFFFFFF, 100);\n  faceCanvas.moveTo(-11, -3); faceCanvas.lineTo(-3, -3); faceCanvas.lineTo(-3, 2); faceCanvas.lineTo(-11, 2);\n  faceCanvas.moveTo(3, -3); faceCanvas.lineTo(11, -3); faceCanvas.lineTo(11, 2); faceCanvas.lineTo(3, 2);\n  faceCanvas.endFill();\n\n  faceCanvas.beginFill(eyeCol, 100);\n  faceCanvas.moveTo(-8 + eyeShift, -2); faceCanvas.lineTo(-5 + eyeShift, -2);\n  faceCanvas.lineTo(-5 + eyeShift, 2); faceCanvas.lineTo(-8 + eyeShift, 2);\n  faceCanvas.moveTo(5 + eyeShift, -2); faceCanvas.lineTo(8 + eyeShift, -2);\n  faceCanvas.lineTo(8 + eyeShift, 2); faceCanvas.lineTo(5 + eyeShift, 2);\n  faceCanvas.endFill();\n\n  // Nose bridge\n  faceCanvas.beginFill(0xB47852, 100);\n  faceCanvas.moveTo(-2, -2); faceCanvas.lineTo(2, -2); faceCanvas.lineTo(3, 6); faceCanvas.lineTo(-3, 6);\n  faceCanvas.endFill();\n\n  if (health < 65) {\n    faceCanvas.beginFill(0xB91C1C, 90);\n    faceCanvas.moveTo(-12, 4); faceCanvas.lineTo(-6, 6); faceCanvas.lineTo(-9, 15);\n    faceCanvas.endFill();\n  }\n  if (health < 30) {\n    faceCanvas.beginFill(0x991B1B, 95);\n    faceCanvas.moveTo(4, 2); faceCanvas.lineTo(12, 5); faceCanvas.lineTo(9, 16); faceCanvas.lineTo(2, 14);\n    faceCanvas.endFill();\n  }\n\n  if (grinTimer > 0) {\n    faceCanvas.beginFill(0xFFFFFF, 100);\n    faceCanvas.moveTo(-9, 9); faceCanvas.lineTo(9, 9); faceCanvas.lineTo(7, 15); faceCanvas.lineTo(-7, 15);\n    faceCanvas.endFill();\n  } else if (hurtFlash > 0 || health <= 0) {\n    faceCanvas.beginFill(0x450A0A, 100);\n    faceCanvas.moveTo(-6, 9); faceCanvas.lineTo(6, 9); faceCanvas.lineTo(6, 16); faceCanvas.lineTo(-6, 16);\n    faceCanvas.endFill();\n  } else {\n    faceCanvas.beginFill(0x6C2D12, 100);\n    faceCanvas.moveTo(-7, 11); faceCanvas.lineTo(7, 11); faceCanvas.lineTo(6, 14); faceCanvas.lineTo(-6, 14);\n    faceCanvas.endFill();\n  }\n}\n\nfunction updateHudText():Void {\n  var nextAmmo:String = (curWeapon == 2 && hasShotgun) ? (\"\" + shells) : \"INF\";\n  if (nextAmmo != lastAmmoStr && this.ammoText != undefined) {\n    this.ammoText.text = nextAmmo;\n    lastAmmoStr = nextAmmo;\n  }\n  var nextHp:String = health + \"%\";\n  if (nextHp != lastHealthStr && this.healthText != undefined) {\n    this.healthText.text = nextHp;\n    lastHealthStr = nextHp;\n  }\n  var nextAr:String = armor + \"%\";\n  if (nextAr != lastArmorStr && this.armorText != undefined) {\n    this.armorText.text = nextAr;\n    lastArmorStr = nextAr;\n  }\n  var nextArms:String = hasShotgun ? ((curWeapon == 2) ? \"[2] SGN\" : \"[1] PST\") : \"[1] PST\";\n  if (nextArms != lastArmsStr && this.armsText != undefined) {\n    this.armsText.text = nextArms;\n    lastArmsStr = nextArms;\n  }\n  var nextKills:String = kills + \"/\" + totalEnemies + (hasYellowKey ? \" · Y-KEY\" : \" · NO KEY\");\n  if (nextKills != lastKillsStr && this.killsText != undefined) {\n    this.killsText.text = nextKills;\n    lastKillsStr = nextKills;\n  }\n  if (this.fpsText != undefined) {\n    this.fpsText.text = fpsDisplay + \" FPS · \" + lastFrameCostMs + \"ms\";\n  }\n  var nextBanner:String = \"\";\n  if (levelCleared) {\n    var kPct:Number = Math.round((kills * 100) / Math.max(1, totalEnemies));\n    var iPct:Number = Math.round((itemsPicked * 100) / Math.max(1, totalItems));\n    nextBanner = \"E1M1 HANGAR COMPLETE!  KILLS \" + kPct + \"% · ITEMS \" + iPct + \"% · TIME \" + clearTimeSec + \"s  [PRESS R]\";\n  } else if (gameOver) {\n    nextBanner = \"MARINE KILLED IN ACTION — PRESS R TO RESTART\";\n  }\n  if (nextBanner != lastBannerStr && this.bannerText != undefined) {\n    this.bannerText.text = nextBanner;\n    lastBannerStr = nextBanner;\n  }\n}\n\n// --- Input Listeners (including optional [DM-05] Pointer Lock mouselook!) ---\nthis.onKeyDown = function():Void {\n  var c:Number = Key.getCode();\n  if (c == 82) {\n    resetLevel();\n  } else if (c == 77 || c == Key.TAB) {\n    showAutomap = !showAutomap;\n  } else if (c == 49) {\n    curWeapon = 1;\n    showMsg(\"SWITCHED TO 9MM PISTOL\", 35);\n  } else if (c == 50 && hasShotgun) {\n    curWeapon = 2;\n    showMsg(\"SWITCHED TO PUMP SHOTGUN\", 35);\n  } else if (c == 76 && Mouse[\"lock\"] != undefined) { // 'L' = Toggle Mouse Pointer Lock\n    if (Mouse[\"isLocked\"]) {\n      var unlockFn:Function = Mouse[\"unlock\"];\n      unlockFn.call(Mouse);\n      showMsg(\"MOUSE LOOK UNLOCKED\", 45);\n    } else {\n      var lockFn:Function = Mouse[\"lock\"];\n      lockFn.call(Mouse);\n      showMsg(\"MOUSE LOOK LOCKED (ESC TO RELEASE)\", 55);\n    }\n  } else if (c == 69) {\n    tryUseAhead();\n  } else if (c == Key.SPACE) {\n    if (!tryUseAhead()) {\n      fireWeapon();\n    }\n  } else if (c == 70 || c == Key.CONTROL || c == Key.ENTER) {\n    fireWeapon();\n  }\n};\nKey.addListener(this);\n\nthis.onMouseDown = function():Void {\n  if (_ymouse < VIEW_H) {\n    fireWeapon();\n  }\n};\nthis.onMouseMove = function(dx:Number, dy:Number):Void {\n  if (Mouse[\"isLocked\"] && dx != undefined && dx != 0 && !gameOver && !levelCleared) {\n    rotatePlayer(dx * 0.0035);\n  }\n};\nMouse.addListener(this);\n\n// --- Main 30 FPS Game Loop ---\nthis.onEnterFrame = function():Void {\n  var frameStartMs:Number = getTimer();\n  tickCount = tickCount + 1;\n\n  if (!gameOver && !levelCleared) {\n    var moveSpd:Number = Key.isDown(Key.SHIFT) ? 0.115 : 0.082;\n    var rotSpd:Number = 0.062;\n    var moved:Boolean = false;\n\n    if (Key.isDown(Key.LEFT) || Key.isDown(81)) {\n      rotatePlayer(-rotSpd);\n    }\n    if (Key.isDown(Key.RIGHT)) {\n      rotatePlayer(rotSpd);\n    }\n\n    if (Key.isDown(87) || Key.isDown(Key.UP)) {\n      tryMovePlayer(dirX * moveSpd, dirY * moveSpd);\n      moved = true;\n    }\n    if (Key.isDown(83) || Key.isDown(Key.DOWN)) {\n      tryMovePlayer(-dirX * moveSpd, -dirY * moveSpd);\n      moved = true;\n    }\n\n    if (Key.isDown(65)) {\n      tryMovePlayer(dirY * moveSpd * 0.85, -dirX * moveSpd * 0.85);\n      moved = true;\n    }\n    if (Key.isDown(68)) {\n      tryMovePlayer(-dirY * moveSpd * 0.85, dirX * moveSpd * 0.85);\n      moved = true;\n    }\n\n    if (Key.isDown(70) || Key.isDown(Key.CONTROL)) {\n      fireWeapon();\n    }\n\n    if (moved) {\n      walkPhase = walkPhase + 0.28;\n    } else {\n      walkPhase = walkPhase * 0.85;\n    }\n\n    if (fireCooldown > 0) { fireCooldown = fireCooldown - 1; }\n    if (muzzleFrames > 0) { muzzleFrames = muzzleFrames - 1; }\n    if (hurtFlash > 0) {\n      hurtFlash = hurtFlash - 1;\n      if (hurtFlash == 0) { drawMarineFace(); }\n    }\n    if (pickupFlash > 0) { pickupFlash = pickupFlash - 1; }\n    if (grinTimer > 0) {\n      grinTimer = grinTimer - 1;\n      if (grinTimer == 0) { drawMarineFace(); }\n    }\n\n    faceTimer = faceTimer + 1;\n    if (faceTimer >= 36) {\n      faceTimer = 0;\n      faceGlance = (Math.floor(tickCount / 36) % 3) - 1;\n      drawMarineFace();\n    }\n\n    updateDoorsAndPickups();\n    updateEnemiesAndProjectiles();\n  }\n\n  if (hudMsgTimer > 0) {\n    hudMsgTimer = hudMsgTimer - 1;\n    if (hudMsgTimer == 0 && this.msgText != undefined) {\n      this.msgText.text = \"\";\n    }\n  }\n\n  render3DView();\n  renderWeaponAndFx();\n  renderAutomap();\n\n  lastFrameCostMs = getTimer() - frameStartMs;\n  framesSinceSample = framesSinceSample + 1;\n  var nowMs:Number = getTimer();\n  if (nowMs - lastFpsSampleMs >= 500) {\n    fpsDisplay = Math.round((framesSinceSample * 1000) / Math.max(1, nowMs - lastFpsSampleMs));\n    framesSinceSample = 0;\n    lastFpsSampleMs = nowMs;\n  }\n  updateHudText();\n};\n\nresetLevel();\nrender3DView();\nrenderWeaponAndFx();\n"
            }
          }
        ]
      }
    },
    {
