        "scripts": [
          {
            "frame": 0,
            "script": {
              "language": "action_script2",
              "source": "import flash.geom.Rectangle;\nimport flash.geom.ColorTransform;\nstop();\nvar passed=0,checks=0,failures=\"\";\nfunction check(name,ok){checks++;if(ok)passed++;else failures+=name+\"; \";}\nfunction report(){_root.result.text=passed+\" / \"+checks+\" checks passed\";_root.batchReport='{\"suite\":\"as2-stage-display-batch\",\"passed\":'+passed+',\"checks\":'+checks+',\"failures\":\"'+failures+'\"}';trace(_root.batchReport);}\nfunction box(name,depth,x,y,w,h,color){var c=_root.createEmptyMovieClip(name,depth);c._x=x;c._y=y;c.beginFill(color);c.moveTo(0,0);c.lineTo(w,0);c.lineTo(w,h);c.lineTo(0,h);c.lineTo(0,0);c.endFill();return c;}\nfunction label(name,depth,x,y,w,text){var t=_root.createTextField(name,depth,x,y,w,35);t.setNewTextFormat(new TextFormat(\"Arial\",16,0xD5E7FA));t.text=text;t.selectable=false;return t;}\nfunction buttonLabel(parent,name,text){var t=parent.createTextField(name,100,15,18,200,35);t.setNewTextFormat(new TextFormat(\"Arial\",16,0xD5E7FA));t.text=text;t.selectable=false;}\nStage.align=\"lt\";Stage.scaleMode=\"showAll\";\ncheck(\"Stage alignment normalization\",Stage.align==\"TL\"&&Stage.scaleMode==\"showAll\");\nStage.scaleMode=\"exactFit\";check(\"exactFit state\",Stage.scaleMode==\"exactFit\"&&Stage.width==960&&Stage.height==680);\nStage.scaleMode=\"noBorder\";check(\"noBorder state\",Stage.scaleMode==\"noBorder\");\nStage.scaleMode=\"noScale\";check(\"noScale actual viewport\",Stage.width>0&&Stage.height>0);Stage.scaleMode=\"showAll\";\nStage.showMenu=false;check(\"Context menu switch\",!Stage.showMenu);\nStage.fullScreenSourceRect=new Rectangle(0,0,960,680);var crop=Stage.fullScreenSourceRect;crop.width=10;\ncheck(\"Fullscreen source defensive copy\",Stage.fullScreenSourceRect.width==960);Stage.fullScreenSourceRect=null;\ncheck(\"Actual fullscreen metadata\",Stage.displayState==\"normal\"&&Stage.fullScreenWidth>0&&Stage.fullScreenHeight>0);\nvar viewportEvents=0,fullscreenEvents=0;\nvar stageListener={onResize:function(){viewportEvents++;_root.interaction.text=\"Resize: \"+Stage.width+\" x \"+Stage.height+\"; events \"+viewportEvents;},onFullScreen:function(full){fullscreenEvents++;_root.interaction.text=\"Fullscreen \"+full+\"; events \"+fullscreenEvents;}};Stage.addListener(stageListener);\nvar rect=new Rectangle(0,0,100,80);check(\"Rectangle AS2 alias\",rect.containsRectangle(new Rectangle(10,10,20,20))&&!rect.containsRectangle(new Rectangle(99,0,20,20)));\nvar ct=new ColorTransform(1,1,1,0.6,0,0,0,4);ct.rgb=0x55D9A7;check(\"ColorTransform rgb Rust alias\",ct.rgb==0x55D9A7&&ct.redMultiplier==0&&ct.greenOffset==217&&ct.alphaMultiplier==0.6&&ct.alphaOffset==4);\nvar menuA=box(\"menuA\",100,40,170,170,75,0x556FDB),menuB=box(\"menuB\",101,250,170,170,75,0x279C75);\nbuttonLabel(menuA,\"menuALabel\",\"Menu A: hold\");buttonLabel(menuB,\"menuBLabel\",\"Menu B: release\");\nmenuA.trackAsMenu=true;menuB.trackAsMenu=true;menuA._focusrect=true;menuB._focusrect=true;menuA.focusEnabled=true;menuB.focusEnabled=true;\ncheck(\"Menu tracking and focus flags\",menuA.trackAsMenu&&menuB.trackAsMenu&&menuA._focusrect&&menuB._focusrect);\nvar releasesA=0,releasesB=0,drags=0;\nmenuA.onPress=function(){Selection.setFocus(this);};menuB.onPress=function(){Selection.setFocus(this);};\nmenuA.onRelease=function(){releasesA++;_root.interaction.text=\"Release A=\"+releasesA+\", B=\"+releasesB;};\nmenuB.onRelease=function(){releasesB++;Selection.setFocus(this);_root.interaction.text=\"Release A=\"+releasesA+\", B=\"+releasesB+\"; drag transfers=\"+drags;};\nmenuB.onDragOver=function(){drags++;};\nvar focusEvents=0,selectionListener={onSetFocus:function(oldFocus,newFocus){focusEvents++;}};\ncheck(\"Selection listener registration\",Selection.addListener(selectionListener));Selection.setFocus(menuA);Selection.setFocus(menuB);\ntrace(\"AS2_SELECTION_OBSERVED \"+focusEvents+\" \"+Selection.getFocus());check(\"Selection focus broadcast\",focusEvents==2&&Selection.getFocus()==\"_level0.menuB\");check(\"Selection listener removal\",Selection.removeListener(selectionListener));Selection.setFocus(menuA);check(\"Selection stopped delivery\",focusEvents==2);\nvar matrix=menuA.transform.concatenatedMatrix,color=menuA.transform.concatenatedColorTransform,pixels=menuA.transform.pixelBounds;\ncheck(\"Transform actual getters\",matrix.tx==40&&matrix.ty==170&&color.alphaMultiplier==1&&pixels.width>=170&&pixels.height>=75);\n\nvar customMenuSelections=0,customMenuOpens=0;\nfunction selectedContextItem(owner,item){customMenuSelections++;_root.interaction.text=\"Context menu: \"+item.caption+\" on \"+owner._name+\"; selections \"+customMenuSelections;trace(\"AS2_CONTEXT_SELECTED \"+customMenuSelections+\" \"+item.caption);}\nvar customMenu=new ContextMenu(function(owner,menu){customMenuOpens++;_root.interaction.text=\"Context menu opened \"+customMenuOpens;});\ncustomMenu.hideBuiltInItems();\nvar customItem=new ContextMenuItem(\"Mark this card\",selectedContextItem),disabledItem=new ContextMenuItem(\"Unavailable action\",selectedContextItem,true,false,true),hiddenItem=new ContextMenuItem(\"Hidden action\",selectedContextItem,false,true,false);\ncustomMenu.customItems.push(customItem,disabledItem,hiddenItem);\nvar copiedMenu=customMenu.copy();copiedMenu.customItems[0].caption=\"Copied menu action\";\ncheck(\"Context menu independent copy\",copiedMenu!==customMenu&&copiedMenu.customItems!==customMenu.customItems&&customItem.caption==\"Mark this card\");\ncheck(\"Context item flags and copy\",disabledItem.separatorBefore&&!disabledItem.enabled&&!hiddenItem.visible&&customItem.copy().caption==customItem.caption);\ncustomMenu.builtInItems.rewind=true;check(\"Actual supported built-in flags\",customMenu.builtInItems.rewind&&!customMenu.builtInItems.play);\nmenuA.menu=customMenu;menuB.menu=copiedMenu;_root.menu=customMenu;Stage.showMenu=true;\ncheck(\"Object context-menu references\",menuA.menu===customMenu&&menuB.menu===copiedMenu&&_root.menu===customMenu);\nlabel(\"contextHelp\",280,40,615,850,\"Right-click Menu A / B for authored actions; Escape closes the menu.\");\n\nvar modes=[\"showAll\",\"noBorder\",\"exactFit\",\"noScale\"];\nfor(var i=0;i<modes.length;i++){var control=box(\"mode\"+i,110+i,40+i*210,285,185,50,0x33465F);control.mode=modes[i];control.onPress=function(){Stage.align=\"TL\";Stage.scaleMode=this.mode;_root.interaction.text=\"Stage mode \"+Stage.scaleMode+\"; logical \"+Stage.width+\" x \"+Stage.height;};buttonLabel(control,\"modeLabel\",modes[i]);}\nvar fullscreenButton=box(\"fullscreenButton\",120,670,170,220,75,0x7759A6);fullscreenButton.onPress=function(){Stage.displayState=Stage.displayState==\"normal\"?\"fullScreen\":\"normal\";};buttonLabel(fullscreenButton,\"fullscreenLabel\",\"Fullscreen / Escape\");\nvar v=_root.videoProbe;v._name=\"runtimeVideo\";v._alpha=85;v._x=40;v._y=425;v._xscale=75;v._yscale=75;v._rotation=0;v._visible=true;\ncheck(\"Video identity and placement\",v._name==\"runtimeVideo\"&&v._parent===_root&&v._x==40&&v._y==425&&v._rotation==0&&v._visible);\ncheck(\"Video scale and alpha aliases\",v._alpha==85&&v._xscale==75&&v._yscale==75&&v._width==240&&v._height==135);\ncheck(\"Video local pointer getters\",typeof v._xmouse==\"number\"&&typeof v._ymouse==\"number\");\nlabel(\"videoLabel\",230,40,575,330,\"Actual decoded Video dimensions\");\nvar conn=new NetConnection();conn.connect(null);var stream=new NetStream(conn);stream.receiveAudio(false);\nstream.onMetaData=function(meta){check(\"Video decoded size aliases\",v.width==320&&v.height==180&&meta.width==v.width&&meta.height==v.height);report();};v.attachVideo(stream);stream.play(\"media/motion.mp4\");stream.pause(true);\nvar imageA=_root.createEmptyMovieClip(\"imageA\",130),imageB=_root.createEmptyMovieClip(\"imageB\",131);imageA._x=430;imageA._y=425;imageB._x=680;imageB._y=425;imageA._xscale=imageA._yscale=260;imageB._xscale=imageB._yscale=260;imageA.forceSmoothing=false;imageB.forceSmoothing=true;\ncheck(\"Loaded-image smoothing preference\",!imageA.forceSmoothing&&imageB.forceSmoothing);\nimageA.loadMovie(\"images/first.png\");imageB.loadMovie(\"images/first.png\");\nlabel(\"imageALabel\",231,430,575,230,\"Nearest loaded image\");label(\"imageBLabel\",232,680,575,230,\"Smoothed loaded image\");\nvar poll=setInterval(function(){if(imageA.getBytesLoaded()>0&&imageB.getBytesLoaded()>0){check(\"Both image loads completed\",imageA._width>0&&imageB._width==imageA._width);clearInterval(poll);report();}},25);\nreport();\n"
            }
          }
        ]
      }
    }
